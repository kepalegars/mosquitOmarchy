#!/usr/bin/env bash
# omarchy-vm-share — mount the host's 9p folder inside the Omarchy VM guest.
#
# Run THIS INSIDE THE GUEST. It is useless on the host, which is the side that
# already works: the launcher creates ~/VMs/<vm>/shared and exports it as the
# 9p tag `hostshare`, and that part needs nothing.
#
# The guest side is what was missing. The host script's only instruction was a
# comment — "guest: mount -t 9p -o trans=virtio hostshare /mnt" — so the export
# happened on every boot and the folder never appeared, which reads exactly like
# a broken setup rather than a half-finished one. Three things were left to the
# user, and all three are easy to get wrong:
#
#   1. the kernel module. `9pnet_virtio` is not built into the kernel and is not
#      loaded on a fresh install, so the mount fails with "unknown filesystem
#      type" or "no such device" before any of the rest matters;
#   2. the version. Since Linux 5.x the 9p2000.L protocol is the default on the
#      wire and omitting it is the difference between mounting and not;
#   3. the timing. At boot the 9p port appears a moment after the unit starts, so
#      a mount attempted too early fails and never retries.
#
# Usage:
#   ./omarchy-vm-share              # mount now
#   ./omarchy-vm-share --install    # mount now + a boot unit + the clipboard agent
#   ./omarchy-vm-share --uninstall  # remove the unit and unmount
#   ./omarchy-vm-share --status     # is it mounted, and is the module there
#
# Fetch it from the host bridge (no copy needed while the VM launcher runs):
#   mkdir -p ~/VMs
#   curl -sf --retry 3 http://10.0.2.2:7789/share -o ~/VMs/omarchy-vm-share
# After --install it is copied to /usr/local/bin; the download can be removed.
set -euo pipefail

TAG="${OMARCHY_VM_SHARE_TAG:-hostshare}"
MOUNTPOINT="${OMARCHY_VM_SHARE_MOUNT:-/mnt/host}"
UNIT_NAME="omarchy-vm-share.service"
UNIT_PATH="/etc/systemd/system/$UNIT_NAME"

G='\033[1;32m'; Y='\033[1;33m'; R='\033[1;31m'; B='\033[1;34m'; N='\033[0m'
msg(){ printf "${B}==>${N} %s\n" "$*"; }
ok(){  printf " ${G}✓${N} %s\n" "$*"; }
warn(){ printf " ${Y}!${N} %s\n" "$*"; }
err(){ printf "${R}✗${N} %s\n" "$*" >&2; }

need_root(){ [[ $EUID -eq 0 ]] || { err "run this as root, or with sudo"; exit 1; }; }

# 9p is a virtio DEVICE, not a virtio-serial port: it never appears under
# /sys/class/virtio-ports (that path is for virtio-console/guest-agent ports),
# so waiting on it always timed out and the mount never even ran. Wait for the
# 9pnet_virtio driver to bind a device instead.
wait_for_device(){
  local i
  for i in $(seq 1 50); do
    compgen -G "/sys/bus/virtio/drivers/9pnet_virtio/virtio*" >/dev/null 2>&1 && return 0
    sleep 0.2
  done
  return 1
}

has_9p_support(){
  grep -qw 9p /proc/filesystems 2>/dev/null
}

load_module(){
  # There is no module named virtio_9p. The transport is 9pnet_virtio (it pulls
  # 9pnet and the 9p filesystem). Checking /sys/module/virtio_9p therefore said
  # "NOT loaded" on a guest where the 9p device was already present, and the
  # install command aborted before trying the mount.
  if has_9p_support; then
    ok "9p filesystem already available"
    return 0
  fi
  if modprobe 9pnet_virtio 2>/dev/null && has_9p_support; then
    ok "9p support loaded (9pnet_virtio)"
    return 0
  fi
  local m
  for m in 9pnet 9p; do
    if modprobe "$m" 2>/dev/null && has_9p_support; then
      ok "9p support loaded ($m)"
      return 0
    fi
  done
  err "9p kernel support is missing in this guest (9pnet_virtio / 9p)."
  err "  The host must pass:  -virtfs local,path=<dir>,mount_tag=$TAG"
  return 1
}

do_mount(){
  need_root
  if mountpoint -q "$MOUNTPOINT"; then
    ok "already mounted at $MOUNTPOINT"
    return 0
  fi
  load_module || return 1
  mkdir -p "$MOUNTPOINT"
  # Do NOT gate the mount on a sysfs path. The 9p device is a virtio device,
  # but its driver directory and naming differ across kernels/distros; the
  # previous /sys/bus/virtio/drivers/9pnet_virtio check reported "shared folder
  # not enabled" on fresh VMs where it WAS enabled. Just retry the real mount:
  # success is the only proof that matters, and it covers a device that appears
  # a moment after the module loads.
  local attempt
  for attempt in $(seq 1 40); do
    if mount -t 9p -o trans=virtio,version=9p2000.L "$TAG" "$MOUNTPOINT" 2>/dev/null; then
      ok "host folder mounted at $MOUNTPOINT"
      return 0
    fi
    sleep 0.25
  done
  err "mount failed: the host did not expose the 9p tag '$TAG'."
  err "  Check on the host: grep virtfs ~/VMs/*/start-omarchy.sh"
  err "  Try manually: mount -t 9p -o trans=virtio,version=9p2000.L $TAG $MOUNTPOINT"
  return 1
}

write_unit(){
  need_root
  cat > "$UNIT_PATH" <<EOF
# Mounts the host's 9p folder (tag: $TAG) at boot.
# Written by omarchy-vm-share --install
[Unit]
Description=Omarchy VM shared folder (9p)
# The port shows up as the virtio device is probed, so this waits rather than
# assuming it is already there.
After=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/omarchy-vm-share --mount-nodep
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF
  install -m 0755 "$(readlink -f "${BASH_SOURCE[0]}")" /usr/local/bin/omarchy-vm-share
  systemctl daemon-reload
  systemctl enable "$UNIT_NAME" >/dev/null 2>&1 || true
  ok "boot unit installed: $UNIT_PATH"
}

# The clipboard bridge is the other half of the guest setup. The host serves
# the agent next to this script, so installing both is one sudo command inside
# the VM instead of two manual steps that are easy to half-do.
install_clipboard_agent(){
  local port="${OMARCHY_VM_CLIPBOARD_PORT:-7789}"
  local user="${SUDO_USER:-}" home
  command -v curl >/dev/null 2>&1 || { warn "curl missing — clipboard agent not installed"; return 0; }
  if ! curl -sf --max-time 3 "http://10.0.2.2:${port}/ping" >/dev/null 2>&1; then
    warn "clipboard bridge unreachable — skipping the clipboard agent"
    warn "  relaunch the VM from the host, then re-run: sudo omarchy-vm-share --install"
    return 0
  fi
  if [[ -z $user ]]; then
    user="${USER:-$(id -un)}"
  fi
  home="$(getent passwd "$user" | cut -d: -f6)"
  [[ -n $home ]] || { warn "could not resolve $user's home — clipboard agent not installed"; return 0; }
  local uid
  uid="$(id -u "$user")"
  if [[ $EUID -eq 0 && $user != root ]] && command -v runuser >/dev/null 2>&1; then
    if runuser -u "$user" -- env \
         HOME="$home" \
         XDG_RUNTIME_DIR="/run/user/$uid" \
         DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
         bash -c 'mkdir -p "$HOME/.local/bin" && curl -sf --retry 3 "http://10.0.2.2:'"$port"'/agent" -o "$HOME/.local/bin/omarchy-vm-clipboard-agent" && chmod +x "$HOME/.local/bin/omarchy-vm-clipboard-agent" && "$HOME/.local/bin/omarchy-vm-clipboard-agent" --install'; then
      ok "clipboard agent installed for $user"
    else
      warn "clipboard agent install failed — run it manually as $user"
    fi
  else
    mkdir -p "$home/.local/bin"
    if curl -sf --retry 3 "http://10.0.2.2:${port}/agent" -o "$home/.local/bin/omarchy-vm-clipboard-agent" \
      && chmod +x "$home/.local/bin/omarchy-vm-clipboard-agent" \
      && HOME="$home" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$uid}" \
         DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$uid/bus}" \
         "$home/.local/bin/omarchy-vm-clipboard-agent" --install; then
      ok "clipboard agent installed for $user"
    else
      warn "clipboard agent install failed — run it manually as $user"
    fi
  fi
  return 0
}

open_shared_folder(){
  local user="${SUDO_USER:-}" uid home runtime wayland
  printf '\nShared folder: %s (host: ~/VMs/<name>/shared)\n' "$MOUNTPOINT"
  printf 'you should add it to your bookmarks!\n'
  if [[ -z $user ]] || ! command -v runuser >/dev/null 2>&1 || ! command -v xdg-open >/dev/null 2>&1; then
    warn "Open $MOUNTPOINT manually in your file manager."
    return 0
  fi
  uid="$(id -u "$user" 2>/dev/null)" || { warn "Could not resolve desktop user $user."; return 0; }
  home="$(getent passwd "$user" 2>/dev/null | cut -d: -f6)" || true
  runtime="/run/user/$uid"
  wayland="$(find "$runtime" -maxdepth 1 -type s -name 'wayland-*' -printf '%f\n' 2>/dev/null | head -1)"
  if [[ -z $home || -z $wayland ]]; then
    warn "Could not find $user's desktop session; open $MOUNTPOINT manually."
    return 0
  fi
  if runuser -u "$user" -- env \
       HOME="$home" XDG_RUNTIME_DIR="$runtime" \
       DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" WAYLAND_DISPLAY="$wayland" \
       xdg-open "$MOUNTPOINT" >/dev/null 2>&1; then
    ok "Opened shared folder in the default file manager."
  else
    warn "Could not open the file manager; open $MOUNTPOINT manually."
  fi
}

do_uninstall(){
  need_root
  if systemctl is-enabled --quiet "$UNIT_NAME" 2>/dev/null; then
    systemctl disable --now "$UNIT_NAME" >/dev/null 2>&1 || true
    ok "boot unit disabled"
  fi
  rm -f "$UNIT_PATH" /usr/local/bin/omarchy-vm-share
  systemctl daemon-reload
  ok "unit and helper removed"
  mountpoint -q "$MOUNTPOINT" && { umount "$MOUNTPOINT" && ok "unmounted $MOUNTPOINT"; }
  return 0
}

# Guest or host? This one script serves both sides: the guest mounts, the host
# reports readiness AND prints the exact commands to run inside the VM (the VM
# window has no terminal output, so the launch-time print is invisible when
# started from the app entry — this is the discoverable copy).
#
# Do NOT detect the guest by /sys/module/virtio_9p: on a fresh install the
# module is not loaded yet, so that check rejected the very command whose job
# was to load it ("runs INSIDE the VM"). Detect the virtual machine instead.
on_guest(){
  if command -v systemd-detect-virt >/dev/null 2>&1; then
    systemd-detect-virt --vm --quiet 2>/dev/null && return 0
  fi
  grep -qiE 'qemu|kvm' /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/product_name 2>/dev/null
}

do_status_host(){
  local _bport="${OMARCHY_VM_CLIPBOARD_PORT:-7789}"
  local _vms="${OMARCHY_VM_ROOT:-${MOSQUITO_VM_ROOT:-$HOME/VMs}}"
  local _d _shared _any=0
  printf 'side      : host\n'
  for _d in "$_vms"/*/; do
    [[ -f "${_d}.vm-config" ]] || continue
    _shared="${_d}shared"
    _any=1
    if [[ -d $_shared ]]; then
      printf 'shared    : %s (%d entries)\n' "$_shared" "$(ls -A "$_shared" 2>/dev/null | wc -l)"
    else
      printf 'shared    : MISSING %s (run setup-omarchy-vm.sh)\n' "$_shared"
    fi
  done
  ((_any)) || printf 'shared    : no VM yet (run setup-omarchy-vm.sh)\n'
  if command -v curl >/dev/null 2>&1 \
      && curl -sf --max-time 2 "http://127.0.0.1:${_bport}/ping" >/dev/null 2>&1; then
    printf 'bridge    : listening on 127.0.0.1:%s (launch a VM to use it)\n' "$_bport"
  else
    printf 'bridge    : NOT listening (it starts with the VM launcher)\n'
  fi
  local _run=0 _d
  for _d in "$_vms"/*/; do [[ -f "${_d}vm.pid" ]] && _run=$((_run+1)); done 2>/dev/null
  printf 'running   : %d VM(s)\n' "$_run"
  printf '\nInside the VM, run this once (shared folder + clipboard, both persistent):\n'
  printf '  mkdir -p ~/VMs && curl -sf --retry 3 http://10.0.2.2:%s/share -o ~/VMs/omarchy-vm-share && sudo bash ~/VMs/omarchy-vm-share --install\n' "$_bport"
}

do_status(){
  on_guest || { do_status_host; return 0; }
  printf 'tag       : %s\n' "$TAG"
  printf 'mountpoint: %s\n' "$MOUNTPOINT"
  if has_9p_support; then
    printf '9p support: yes\n'
  else
    printf '9p support: NO (9pnet_virtio / 9p missing)\n'
  fi
  if wait_for_device_quiet; then
    printf '9p device : present\n'
  else
    printf '9p device : absent (is SHARED_FOLDER=on on the host?)\n'
  fi
  # The host clipboard bridge serves this script and the agent download: if
  # /ping is unreachable, the VM was launched without the bridge (old
  # launcher?) or the host bridge died — re-launch from the host and retry.
  local _bport="${OMARCHY_VM_CLIPBOARD_PORT:-7789}"
  if command -v curl >/dev/null 2>&1 \
      && curl -sf --max-time 3 "http://10.0.2.2:${_bport}/ping" >/dev/null 2>&1; then
    printf 'bridge    : reachable at 10.0.2.2:%s\n' "$_bport"
  else
    printf 'bridge    : UNREACHABLE at 10.0.2.2:%s (re-launch the VM from the host, then retry)\n' "$_bport"
  fi
  if mountpoint -q "$MOUNTPOINT"; then
    printf 'mounted   : yes -> %s\n' "$MOUNTPOINT"
    ls -A "$MOUNTPOINT" 2>/dev/null | head -10 | sed 's/^/            /'
  else
    printf 'mounted   : no\n'
  fi
  systemctl is-enabled "$UNIT_NAME" >/dev/null 2>&1 \
    && printf 'boot unit : enabled\n' || printf 'boot unit : not installed\n'
}

wait_for_device_quiet(){
  compgen -G "/sys/bus/virtio/drivers/9pnet_virtio/virtio*" >/dev/null 2>&1
}

main(){
  local action="${1:-}"
  case "$action" in
    --install|--mount|--mount-nodep|--uninstall)
      on_guest || { err "$action runs INSIDE the VM — on the host only --status makes sense."; return 1; } ;;
  esac
  case "$action" in
    --install)
      do_mount && write_unit && install_clipboard_agent
      # Host-side "guest is provisioned" marker, read by the VM launcher to
      # stop nagging. It lives in the shared folder, so it is only written
      # when the shared folder itself is working.
      if mountpoint -q "$MOUNTPOINT"; then
        printf 'shared=1\nclipboard=1\n' > "$MOUNTPOINT/.mosquitomarchy-vm-setup" 2>/dev/null || true
        chmod 644 "$MOUNTPOINT/.mosquitomarchy-vm-setup" 2>/dev/null || true
        open_shared_folder
      fi
      ;;
    --mount|--mount-nodep) do_mount ;;
    --uninstall)        do_uninstall ;;
    --status)           do_status ;;
    -h|--help)          sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//' ;;
    "")                 msg "nothing requested — try --status" ;;
    *)                  err "unknown option: $action"; return 1 ;;
  esac
}

main "$@"
