#!/usr/bin/env bash
# =============================================================================
# move-audio-watcher — the Ableton Move as the desk's audio interface, on demand
# =============================================================================
# The Move exposes a class-compliant USB audio interface locked to 44.1 kHz.
# Plugging it in changes NOTHING: a notification offers it, and the switch only
# happens when its action is clicked. Unplugging offers the way back.
#
# Same event-driven model as Mixbay's card watcher (pactl subscribe, no
# polling), so both can run side by side and an idle desktop costs nothing.
#
#   move-audio-watcher             the service: watches card events
#   move-audio-watcher --use       notification action: Move as default in/out,
#                                  graph pinned to 44.1 kHz (min = max = force)
#   move-audio-watcher --revert    notification action: previous default devices
#                                  and sample rate
#   move-audio-watcher --status    what is connected and what was switched
#   move-audio-watcher --self-test
#
# Detection needs BOTH the Ableton USB vendor (2982) and an ALSA card whose
# name says Move: a random card called "…Move…" must never trigger this, and a
# Push/Note (same vendor, no audio interface) must not either.
#
# State (which devices and rate to return to) lives in
# ~/.local/state/mosquitomarchy/move-audio-{state,last}. It is written only by
# --use, so an unplugged Move with no state means nothing was switched.
# =============================================================================
set -uo pipefail

ABLETON_VENDOR="2982"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mosquitomarchy"
STATE="$STATE_DIR/move-audio-state"
LAST="$STATE_DIR/move-audio-last"
SELF="${BASH_SOURCE[0]}"

# jq filter: the card/sink/source whose name, ALSA card name or description
# mentions Move. Case-insensitive; a false positive is still gated by the USB
# vendor check before anything is switched.
MOVE_MATCH='.[]
  | select(([.name // "",
             (.properties["alsa.card_name"] // ""),
             (.properties["device.description"] // "")]
            | join(" ")) | test("move"; "i"))
  | .name'

notify(){
  local headline="$1" body="$2"
  shift 2
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    # Actions go last: --action consumes the rest of the line.
    omarchy-notification-send --app-name "Ableton Move" -g "󰓃" \
      "$headline" "$body" "$@" >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Ableton Move" "$headline" "$body" >/dev/null 2>&1 || true
  fi
}

move_usb(){
  command -v lsusb >/dev/null 2>&1 || return 1
  lsusb -d "$ABLETON_VENDOR:" 2>/dev/null | grep -q .
}

pactl_names(){ # <list: cards|sinks|sources>
  pactl -f json list "$1" 2>/dev/null | jq -r "$MOVE_MATCH" 2>/dev/null | head -n1
}

move_card(){ pactl_names cards; }
move_sink(){ pactl_names sinks; }
move_source(){ pactl_names sources; }

# The Move only counts when its AUDIO side is up: USB alone is also Push/Note.
move_ready(){
  move_usb || return 1
  [[ -n "$(move_card)" ]]
}

pw_value(){ # <metadata key> -> current value, empty when absent
  pw-metadata -n settings 0 2>/dev/null | parse_pw_value "$1"
}

parse_pw_value(){ # <key>, reads pw-metadata output on stdin
  sed -n "s/.*key:'$1' value:'\([^']*\)'.*/\1/p" | head -n1
}

# The four keys a rate pin touches. Restoring them one by one also restores
# "the graph was dynamic before" (an absent key is deleted again), which is
# what a fixed min=max would quietly destroy.
PW_KEYS=(clock.rate clock.min-rate clock.max-rate clock.force-rate)
PW_CONF="$HOME/.config/pipewire/pipewire.conf.d/90-mosquitomarchy-pipewire.conf"
PW_CONF_SAVE="$STATE_DIR/move-audio-pipewire.conf"
PW_CONF_ABSENT="$STATE_DIR/move-audio-pipewire.absent"

# set_rate <rate> [force]: pins the graph to one rate "everywhere". rate 0
# leaves it dynamic. pipewire-settings is the module that owns this (it also
# persists the choice); the raw metadata calls are the fallback.
set_rate(){
  local rate="$1" force="${2:-1}"
  if command -v pipewire-settings >/dev/null 2>&1; then
    pipewire-settings set-rate "$rate" "$force" >/dev/null 2>&1 && return 0
  fi
  if [[ $rate == 0 ]]; then
    pw-metadata -n settings 0 clock.min-rate 0 >/dev/null 2>&1 || true
    pw-metadata -n settings 0 clock.max-rate 0 >/dev/null 2>&1 || true
    pw-metadata -n settings 0 clock.force-rate 0 >/dev/null 2>&1 || true
    return 0
  fi
  pw-metadata -n settings 0 clock.min-rate "$rate" >/dev/null 2>&1 || true
  pw-metadata -n settings 0 clock.max-rate "$rate" >/dev/null 2>&1 || true
  if [[ $force == 0 ]]; then
    pw-metadata -n settings 0 clock.force-rate 0 >/dev/null 2>&1 || true
  else
    pw-metadata -n settings 0 clock.force-rate "$rate" >/dev/null 2>&1 || true
  fi
}

st_get(){ sed -n "s/^$1=//p" "$STATE" 2>/dev/null | head -n1; }

switched(){ [[ -s $STATE ]]; }

cmd_use(){
  if ! move_ready; then
    notify "Move not found" "Its USB audio interface is not up — plug it in, then try again."
    return 1
  fi
  if switched; then
    # Already the interface: re-pin rather than overwrite the remembered
    # "before" with the Move's own devices.
    set_rate 44100 1
    notify "Move is already the audio interface" "Sample rate re-pinned to 44.1 kHz."
    return 0
  fi
  local sink source prev_sink prev_source k rate
  sink=$(move_sink)
  source=$(move_source)
  prev_sink=$(pactl get-default-sink 2>/dev/null || true)
  prev_source=$(pactl get-default-source 2>/dev/null || true)

  mkdir -p "$STATE_DIR"
  {
    printf 'sink=%s\n' "$prev_sink"
    printf 'source=%s\n' "$prev_source"
    printf 'rate=%s\n' "$(pw_value clock.rate)"
    for k in "${PW_KEYS[@]}"; do
      printf 'pw.%s=%s\n' "$k" "$(pw_value "$k")"
    done
  } > "$STATE"
  # A persisted pin is rewritten by `set-rate`; keep the file itself so the
  # revert puts back the user's own config rather than a generated one.
  rm -f "$PW_CONF_ABSENT"
  if [[ -f $PW_CONF ]]; then cp -f "$PW_CONF" "$PW_CONF_SAVE"; else : > "$PW_CONF_ABSENT"; fi

  [[ -n $sink ]] && pactl set-default-sink "$sink" 2>/dev/null || true
  [[ -n $source ]] && pactl set-default-source "$source" 2>/dev/null || true
  set_rate 44100 1
  notify "Move is the audio interface" \
    "Default in/out switched, graph pinned to 44.1 kHz. Unplugging offers the way back."
}

cmd_revert(){
  if ! switched; then
    notify "Nothing to restore" "The Move was never picked as the audio interface."
    return 0
  fi
  local sink source rate k v
  sink=$(st_get sink); source=$(st_get source); rate=$(st_get rate)
  [[ -n $sink ]] && pactl set-default-sink "$sink" 2>/dev/null || true
  [[ -n $source ]] && pactl set-default-source "$source" 2>/dev/null || true

  # Keys first (min/max before rate), then the persisted file: putting the
  # config back last means the generated one never wins.
  for k in "${PW_KEYS[@]}"; do
    v=$(st_get "pw.$k")
    if [[ -n $v ]]; then
      pw-metadata -n settings 0 "$k" "$v" >/dev/null 2>&1 || true
    else
      pw-metadata -n settings 0 -d "$k" >/dev/null 2>&1 || true
    fi
  done
  if [[ -f $PW_CONF_SAVE ]]; then
    mkdir -p "$(dirname "$PW_CONF")"
    mv -f "$PW_CONF_SAVE" "$PW_CONF"
  elif [[ -f $PW_CONF_ABSENT ]]; then
    rm -f "$PW_CONF"
  fi
  rm -f "$PW_CONF_ABSENT" "$STATE"

  if [[ -n $rate && $rate != 0 ]]; then
    notify "Previous audio device restored" "Sample rate back to $rate Hz."
  else
    notify "Previous audio device restored" "Sample rate left to PipeWire again."
  fi
}

cmd_status(){
  local card
  card=$(move_card)
  jq -nc --argjson usb "$(move_usb && echo true || echo false)" \
    --arg card "$card" \
    --argjson switched "$(switched && echo true || echo false)" \
    --arg prev_sink "$(st_get sink)" --arg prev_source "$(st_get source)" \
    --arg prev_rate "$(st_get rate)" \
    '{usb:$usb,card:$card,switched:$switched,prev_sink:$prev_sink,prev_source:$prev_source,prev_rate:$prev_rate}'
}

# announce <connected|disconnected>: the notification for a real transition.
announce(){
  if [[ $1 == connected ]]; then
    notify "Move connected" \
      "Use it as the audio interface? Switches the default in/out and pins the graph to 44.1 kHz." \
      --action "Use it (44.1 kHz)" "$SELF" --use
  else
    local rate
    rate=$(st_get rate)
    if [[ -n $rate && $rate != 0 ]]; then
      notify "Move unplugged" "Still pinned to 44.1 kHz. Go back to $rate Hz and the previous device?" \
        --action "Back to $rate Hz" "$SELF" --revert
    else
      notify "Move unplugged" "Still pinned to 44.1 kHz. Go back to the previous device and sample rate?" \
        --action "Back to previous" "$SELF" --revert
    fi
  fi
}

# watch: one card event, one look, one notification per real transition.
watch(){
  local line state
  while IFS= read -r line; do
    [[ $line == *"on card"* ]] || continue
    # One plug raises several events in a row: let them settle, then read the
    # real card list once.
    sleep 1.2
    if move_ready; then state=connected; else state=disconnected; fi
    [[ "$(cat "$LAST" 2>/dev/null || true)" == "$state" ]] && continue
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$state" > "$LAST"
    announce "$state"
  done
}

main(){
  command -v pactl >/dev/null 2>&1 || exit 0
  command -v jq >/dev/null 2>&1 || exit 0

  # First look: record where things stand without saying anything, so logging
  # in with the Move already connected stays quiet. Only transitions after
  # this point are announced.
  mkdir -p "$STATE_DIR"
  if move_ready; then printf 'connected\n' > "$LAST"; else printf 'disconnected\n' > "$LAST"; fi
  pactl subscribe 2>/dev/null | watch
}

self_test(){
  local fail=0 out tmp
  out=$(printf '%s' '[{"name":"alsa_card.usb-Ableton_Move-00","properties":{"alsa.card_name":"Ableton Move"}},
                        {"name":"alsa_card.usb-Audient_EVO8-00","properties":{"alsa.card_name":"EVO8"}}]' \
    | jq -r "$MOVE_MATCH")
  [[ "$out" == "alsa_card.usb-Ableton_Move-00" ]] || fail=1
  out=$(printf '%s' '[{"name":"alsa_output.pci-0000_64_00.6.sink","properties":{"device.description":"Ryzen HD Audio Controller"}}]' \
    | jq -r "$MOVE_MATCH")
  [[ -z "$out" ]] || fail=1
  out=$(printf "%s\n" "Found \"settings\" metadata 31" \
    "update: id:0 key:'clock.rate' value:'48000' type:''" | parse_pw_value clock.rate)
  [[ "$out" == 48000 ]] || fail=1
  out=$(printf "update: id:0 key:'clock.force-rate' value:'0' type:''\n" | parse_pw_value clock.force-rate)
  [[ "$out" == 0 ]] || fail=1

  tmp=$(mktemp -d)
  STATE="$tmp/state"
  printf 'sink=a\nsource=b\nrate=48000\nforce=0\n' > "$STATE"
  [[ "$(st_get rate)" == 48000 && "$(st_get force)" == 0 && "$(st_get sink)" == a ]] || fail=1
  switched || fail=1
  rm -rf "$tmp"

  (( fail )) && { printf 'self-test failed\n' >&2; return 1; }
  printf 'self-test ok\n'
}

case "${1:-}" in
  --use)       cmd_use ;;
  --revert)    cmd_revert ;;
  --status)    cmd_status ;;
  --self-test) self_test ;;
  "")          main ;;
  *) printf 'usage: %s [--use|--revert|--status|--self-test]\n' "$0" >&2; exit 2 ;;
esac
