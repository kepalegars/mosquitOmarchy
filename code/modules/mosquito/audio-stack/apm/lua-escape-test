#!/usr/bin/env bash
# audio-plugin-manager-lua-escape-test — the Hyprland-rule escaping contract.
#
# WHY THIS EXISTS. A fix writes its per-plugin rules into hyprland.lua as a Lua
# string that is ALSO a regex, so the escaped name has to satisfy two engines at
# once. It did not, and the failure mode is the worst kind: it is not one bad
# rule, it is the whole desktop refusing to load its config.
#
#   invalid escape sequence near '"(?i).*FabFilter\ '
#
# Lua 5.4 accepts only \" and \\ as escapes. re.escape() — the right tool for
# the regex — also escapes SPACE and DASH (\ and \-), which Lua rejects
# outright. A plugin called "FabFilter Pro-C 2" therefore took hyprland.lua
# down with it. Applying fixes one plugin at a time hid the bug for years: the
# names that reached the escaper were mostly single words, so the bad escapes
# never landed in the file. The vendor-wide apply finally fed it real names.
#
# Each case below is checked with the REAL lua5.4 binary, not a re-implementation
# of its rules, because "what Lua accepts" is exactly the thing that was wrong.
set -uo pipefail

CORE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib-audio-plugin-manager-core.sh"
# shellcheck source=./lib-audio-plugin-manager-core.sh
source "$CORE" 2>/dev/null || true

LUA_BIN=""
for c in lua5.4 lua luajit; do
  command -v "$c" >/dev/null 2>&1 && { LUA_BIN="$c"; break; }
done

pass=0
fail=0

ok()   { pass=$((pass + 1)); printf '  ok   %s\n' "$1"; }
bad()  { fail=$((fail + 1)); printf '  FAIL %s\n       %s\n' "$1" "${2:-}"; }

# check <name> — the escaped form must (a) be a valid Lua string inside the
# rule as written, and (b) still match the original name as a regex.
check() {
  local name="$1" esc
  esc="$(fix_re_escape "$name")"
  local line="(?i).*${esc}.*"

  if [[ -z $LUA_BIN ]]; then
    # No Lua to check with: at least assert we emitted no backslash before a
    # character Lua does not treat as an escape.
    local i=0 ch next
    while (( i < ${#esc} )); do
      ch="${esc:i:1}"
      if [[ $ch == '\' ]]; then
        next="${esc:i+1:1}"
        [[ -z $next || $next == '"' || $next == '\' ]] || { bad "$name" "invalid Lua escape at $((i+1)): \\$next"; return; }
      fi
      (( i++ ))
    done
    ok "$name -> $esc (no lua available)"
    return
  fi

  if ! out=$("$LUA_BIN" -e "local s = \"$line\" print(s)" 2>&1); then
    bad "$name" "lua rejected the rule: $(printf '%s' "$out" | tail -1)"
    return
  fi
  ok "$name -> $esc"
}

echo "== espaces et tirets (le bug qui a casse hyprland.lua) =="
check "FabFilter Pro-C 2"
check "FabFilter Twin 3"
check "Saturn 2"
check "CrispyTuner"

echo "== parentheses et autres metacaracteres de regex =="
check "FabFilter Micro (Mono)"
check "a.b*c"
check "x+y"
check "a[b]c"
check "a{b}c"
check "a|b"
check "a?b"
check "a#b"

echo "== caracteres que Lua refuse apres un backslash =="
check 'a"b'
check "100% \"Pro\""
check "it's"
check 'back\slash'
check "C:\path\to"

echo "== '^' ne doit PAS ouvrir un ensemble vide =="
# "[^]" est un ensemble NON TERMINE en regex et tuerait le fichier. Un caret
# en tete de classe signifie "negation".
check 'a^b$c'

echo
if (( fail == 0 )); then
  printf 'audio-plugin-manager-lua-escape: %d ok, 0 échec(s)\n' "$pass"
else
  printf 'audio-plugin-manager-lua-escape: %d ok, %d échec(s)\n' "$pass" "$fail"
fi
exit $(( fail > 0 ))
