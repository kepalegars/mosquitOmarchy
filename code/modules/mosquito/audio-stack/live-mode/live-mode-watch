#!/usr/bin/env bash
# live-mode-watch — thermal watchdog + state reassertion for live mode.
# Runs in the background while live mode is active.
# Managed by code/modules/mosquito/audio-stack/live-mode/setup-live-mode.sh
#
# Reasserts the live session's own state only: performance profile,
# sleep management (lid block + stay-awake), gaps, and the Live theme.
# It never starts mega-caffeine and never applies a screen tint — live
# mode is explicitly tint-free.

set -euo pipefail

# Crash reporting (mosquitOmarchy): a failure stores a dated log and offers a
# clickable AI diagnosis. Install scripts are deliberately exempt.
_mq_crash_lib="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)/lib/crash.bash"
[[ -f $_mq_crash_lib ]] && { source "$_mq_crash_lib"; mq_crash_guard "live-mode-watch"; }

REAL_USER="${SUDO_USER:-${LOGNAME:-$USER}}"
REAL_HOME=$(eval echo "~$REAL_USER" 2>/dev/null || echo "$HOME")
STATE_DIR="$REAL_HOME/.local/state/live-mode"
CONFIG_FILE="$REAL_HOME/.config/live-mode/settings"
ACTIVE_FLAG="$STATE_DIR/active"
ROOT_HELPER="$HOME/.local/bin/live-mode-root"

# Thermal tuning: the limit is configured in the Live Manager (settings),
# default 85 °C. Recovery rides 7 °C below the limit.
# Defaults for every sourced setting, BEFORE the file is read: under
# `set -u`, referencing a key a partial settings file does not define aborts
# the whole watchdog. live-mode's own load_settings does the same.
THERMAL_LIMIT_C=85
CLOSE_APPS=yes
CLOSE_APPS_LIST=""
ROUTING_TOOL=yes
PATCHBAY_APP=mixbay+qpwgraph
POWER_PROFILE_PROMPT=yes
NO_GAPS=yes
SILENCE_NOTIFICATIONS=yes
SWITCH_THEME=yes
FENCE_PACKAGES=no
[[ -f $CONFIG_FILE ]] && source "$CONFIG_FILE" || true
case $THERMAL_LIMIT_C in 95|90|85|80|75) ;; *) THERMAL_LIMIT_C=85 ;; esac
THRESHOLD_HIGH=$(( THERMAL_LIMIT_C * 1000 ))        # start throttling (m°C)
THRESHOLD_RECOVER=$(( THERMAL_LIMIT_C * 1000 - 7000 ))
THRESHOLD_STEP=200000   # kHz stepped per interval
INTERVAL=5

is_active() { [[ -f "$ACTIVE_FLAG" ]]; }

ok()   { printf '\033[32m●\033[0m %s\n' "$*"; }
warn() { printf '\033[33m●\033[0m %s\n' "$*" >&2; }

get_temp() {
  cat /sys/class/hwmon/hwmon7/temp1_input 2>/dev/null || echo 0
}

get_hw_max() {
  cat /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq 2>/dev/null || echo 5134889
}

get_current_max() {
  cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 2>/dev/null || echo 0
}

thermal_control() {
  local temp hw_max current_cap new_cap
  temp=$(get_temp)
  hw_max=$(get_hw_max)
  current_cap=$(get_current_max)

  if (( temp >= THRESHOLD_HIGH )); then
    new_cap=$(( current_cap - THRESHOLD_STEP ))
    (( new_cap < 2000000 )) && new_cap=2000000  # don't go below 2GHz
    sudo -n "$ROOT_HELPER" thermal-cap "$new_cap" >/dev/null 2>&1 || true
  elif (( temp <= THRESHOLD_RECOVER )); then
    new_cap=$(( current_cap + THRESHOLD_STEP ))
    (( new_cap > hw_max )) && new_cap="$hw_max"
    sudo -n "$ROOT_HELPER" thermal-cap "$new_cap" >/dev/null 2>&1 || true
  fi
}

# enforce_dnd — the DND guard, on its own FAST loop.
#
# It used to be one `if` inside reassert_state, which runs on the 5s thermal
# cadence and also does profile, audio, USB and theme work. 5s is a long time to
# keep shouting at you: the bar toggle is instant, and a notification that lands
# in the gap gets through. The guard is cheap — one file read — so it gets its
# own sub-second loop and the thermal cadence stops being its clock.
#
# The shell writes ~/.local/state/omarchy/notifications/quiet.json, which is
# what we read. This used to read the LEGACY notifications.json (never written
# by the current shell), so the guard saw "off" on every pass and toggled DND
# twice a second — the blinking icon. `setDnd on` is idempotent, so a pass that
# has nothing to do changes nothing.
DND_STATE_FILE="$REAL_HOME/.local/state/omarchy/notifications/quiet.json"

# Store.js writes compact JSON ({"dnd":true}, no space), so a literal
# grep for '"dnd": true' never matched and the guard rebuilt itself on every
# tick. jq also tolerates any other key the shell adds to the file.
dnd_file_on() {
  [[ -f $DND_STATE_FILE ]] && jq -e '.dnd == true' "$DND_STATE_FILE" >/dev/null 2>&1
}

enforce_dnd() {
  [[ $SILENCE_NOTIFICATIONS != no ]] || return 0
  dnd_file_on && return 0
  omarchy-shell notifications setDnd on >/dev/null 2>&1 || true
  dnd_file_on && return 0
  [[ -f $DND_STATE_FILE ]] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  local tmp
  tmp=$(mktemp "${DND_STATE_FILE}.XXXXXX" 2>/dev/null) || return 0
  if jq '.dnd = true' "$DND_STATE_FILE" > "$tmp" 2>/dev/null; then
    mv -f "$tmp" "$DND_STATE_FILE"
  else
    rm -f "$tmp"
  fi
}

# confirm asks one yes/no question through the overlay and answers by exit
# status. Same pattern as live-mode's own confirm (this watchdog is a
# separate process and cannot source it).
confirm() {
  local message="$1" payload sel="$STATE_DIR/confirm_sel" donef="$STATE_DIR/confirm_done"
  rm -f "$sel" "$donef"
  payload=$(jq -cn --arg message "$message" --arg selectionFile "$sel" --arg doneFile "$donef" \
    '{message:$message, selectionFile:$selectionFile, doneFile:$doneFile}')
  omarchy-shell shell summon mosquito.livemode "$payload" >/dev/null 2>&1 || true
  for i in $(seq 1 60); do
    [[ -f "$donef" ]] && break
    sleep 0.5
  done
  [[ -f "$donef" ]] || return 1
  local ans
  ans=$(cat "$sel" 2>/dev/null || echo "")
  rm -f "$sel" "$donef"
  [[ "$ans" == "yes" ]]
}

# Theme reassertion helpers. Same rationale as live-mode's copies: the Live
# theme lives outside the scanned theme directory, so the link exists only for
# the duration of the `theme set` call and never shows "Live" in the picker.
LIVE_THEME_DIR="$STATE_DIR/theme"
LIVE_THEME_LINK="$REAL_HOME/.config/omarchy/themes/live"
THEME_KEYS_FLAG="$STATE_DIR/theme_keys_blocked"

live_theme_apply() {
  [[ -d $LIVE_THEME_DIR ]] || return 1
  mkdir -p "$(dirname "$LIVE_THEME_LINK")"
  rm -f "$LIVE_THEME_LINK"
  ln -sfn "$LIVE_THEME_DIR" "$LIVE_THEME_LINK"
  local rc=0
  omarchy theme set Live >/dev/null 2>&1 || rc=$?
  rm -f "$LIVE_THEME_LINK"
  return "$rc"
}

# Unbind only Omarchy's four DEFAULT theme/background combos, and only while
# they still carry that action. A shortcut the user bound himself keeps
# working; a config reload during the session is re-blocked on the next pass.
block_theme_keys() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  local binds mask key chord
  binds=$(hyprctl -j binds 2>/dev/null) || return 0
  while read -r mask key; do
    [[ -n $mask && -n $key ]] || continue
    case "$mask $key" in
      "68 SPACE"|"68 W"|"68 T") chord="SUPER + CTRL + $key" ;;
      "69 SPACE")               chord="SUPER + SHIFT + CTRL + SPACE" ;;
      *) continue ;;
    esac
    hyprctl eval "hl.unbind(\"$chord\")" >/dev/null 2>&1 || true
  done < <(jq -r '.[]
    | select((.description // "") | test("^(Theme menu|Background switcher)$"))
    | select((.modmask == 68 and (.key == "SPACE" or .key == "W" or .key == "T"))
             or (.modmask == 69 and .key == "SPACE"))
    | "\(.modmask) \(.key)"' <<< "$binds" 2>/dev/null || true)
  touch "$THEME_KEYS_FLAG"
}

reassert_state() {
  # POWER_PROFILE_PROMPT (Live Manager setting, default yes) gates the
  # forcing: with it on, a hand-changed profile triggers ONE question per
  # value — accept and the session takes performance back, refuse and the
  # watchdog leaves that value alone until it changes again. With it off,
  # the old silent forcing applies.
  local cur asked
  cur=$(powerprofilesctl get 2>/dev/null || echo "")
  if [[ -n "$cur" && "$cur" != "performance" ]]; then
    if [[ $POWER_PROFILE_PROMPT != no ]]; then
      asked=$(cat "$STATE_DIR/profile_asked" 2>/dev/null || true)
      if [[ "$asked" != "$cur" ]]; then
        printf '%s' "$cur" > "$STATE_DIR/profile_asked" 2>/dev/null || true
        if confirm "Live mode wants the performance profile (audio optimized). Switch back from \"$cur\"?"; then
          powerprofilesctl set performance 2>/dev/null || true
        fi
      fi
    else
      powerprofilesctl set performance 2>/dev/null || true
    fi
  fi
  # Stay-awake forced on (the lid inhibitor may be killed by external
  # cleanup; relaunch it if it died).
  if ! pgrep -f "[s]ystemd-inhibit --what=handle-lid-switch:sleep" >/dev/null 2>&1; then
    setsid --fork systemd-inhibit --what=handle-lid-switch:sleep \
      --who="Live mode" \
      --why="Live mode: lid closed without sleeping" \
      sleep infinity >/dev/null 2>&1 &
  fi
  [[ -f "$REAL_HOME/.local/state/omarchy/indicators/stay-awake" ]] || \
    { mkdir -p "$(dirname "$REAL_HOME/.local/state/omarchy/indicators/stay-awake")"; touch "$REAL_HOME/.local/state/omarchy/indicators/stay-awake"; }

  # Gaps off — and the same "we turned them off" record live-mode keeps, so the
  # gap restore at deactivation stays correct even if the session was ended by
  # the watchdog rather than by the user.
  if [[ ! -f "$REAL_HOME/.local/state/omarchy/toggles/hypr/window-no-gaps.lua" ]]; then
    omarchy-hyprland-window-gaps-toggle >/dev/null 2>&1 || true
    [[ $NO_GAPS != no ]] && touch "$STATE_DIR/gaps_were_on"
  fi

  # DND is enforced by enforce_dnd on its own fast loop; no second copy here
  # (the old copy read the legacy state file and toggled against enforce_dnd).

  # Live theme (re-assert if user switched away). SWITCH_THEME=no is honoured
  # here too: re-asserting the theme every pass would restart the user's
  # terminals over and over, which is precisely what that setting turns off.
  if [[ $SWITCH_THEME != no ]]; then
    local theme
    theme=$(cat "$REAL_HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || true)
    # "live" lowercase: theme set lowercases the name, so comparing to "Live"
    # was always true and re-applied the theme (and restarted every terminal)
    # on every 5s pass.
    if [[ "$theme" != "live" ]]; then
      live_theme_apply
    fi
  fi

  # Theme/background default keybinds stay unbound for the whole session, even
  # after a config reload (monitor plug, manual reload) put them back.
  block_theme_keys
}

# The same provider resolution live-mode uses: the PATCHBAY_APP setting
# (default mixbay+qpwgraph) when installed, otherwise whatever is, native
# first. Duplicated rather than sourced because the watchdog is its own
# long-running process.
patchbay_have_mixbay() {
  [[ -x $REAL_HOME/.local/bin/mosquito-mixbay ]] \
    || command -v mosquito-mixbay >/dev/null 2>&1
}
patchbay_have_qpwgraph() {
  command -v qpwgraph >/dev/null 2>&1
}
patchbay_have_native() {
  local bin
  for bin in "$REAL_HOME/.local/bin/mosquito-patchbay" "$REAL_HOME/.local/bin/mosquito-patchbay.sh"; do
    [[ -x $bin ]] && return 0
  done
  command -v mosquito-patchbay >/dev/null 2>&1
}
patchbay_specs() {
  local choice="${PATCHBAY_APP:-mixbay+qpwgraph}"
  case $choice in
    mixbay+qpwgraph)
      patchbay_have_mixbay && printf 'mosquito-mixbay|org\.omarchy\.mosquito-mixbay-tui\n'
      patchbay_have_qpwgraph && printf 'qpwgraph|qpwgraph|org\.rncbc\.qpwgraph|org\.pq_graph\.Qpwgraph\n'
      return 0 ;;
    mixbay)
      if patchbay_have_mixbay; then
        printf 'mosquito-mixbay|org\.omarchy\.mosquito-mixbay-tui\n'; return 0
      fi ;;
    qpwgraph)
      if patchbay_have_qpwgraph; then
        printf 'qpwgraph|qpwgraph|org\.rncbc\.qpwgraph|org\.pq_graph\.Qpwgraph\n'; return 0
      fi ;;
    mosquito-patchbay)
      if patchbay_have_native; then
        printf 'mosquito-patchbay|mosquito[_-]?patchbay\n'; return 0
      fi ;;
  esac
  if patchbay_have_native; then
    printf 'mosquito-patchbay|mosquito[_-]?patchbay\n'; return 0
  fi
  if patchbay_have_mixbay; then
    printf 'mosquito-mixbay|org\.omarchy\.mosquito-mixbay-tui\n'; return 0
  fi
  if patchbay_have_qpwgraph; then
    printf 'qpwgraph|qpwgraph|org\.rncbc\.qpwgraph|org\.pq_graph\.Qpwgraph\n'; return 0
  fi
  return 1
}
patchbay_provider() {
  local first
  first="$(patchbay_specs | head -n 1)"
  [[ -n $first ]] || return 1
  printf '%s\n' "$first"
}

patchbay_addr() {
  local spec re combined=""
  while IFS= read -r spec; do
    [[ -n $spec ]] || continue
    re="${spec#*|}"
    combined+="${combined:+|}$re"
  done < <(patchbay_specs 2>/dev/null)
  [[ -n $combined ]] || return 0
  hyprctl -j clients 2>/dev/null | jq -r --arg re "^($combined)$" '
    .[] | select((.class // "") | test($re)) | .address' 2>/dev/null
}

# patchbay_watch: while live mode is on, closing the mosquito patchbay
# prompts a confirmation — "yes" parks it for the rest of the session,
patchbay_watch() {
  [[ -f "$REAL_HOME/.config/live-mode/settings" ]] && source "$REAL_HOME/.config/live-mode/settings" || true
  case ${PATCHBAY_APP:-mixbay+qpwgraph} in mixbay+qpwgraph|mixbay|qpwgraph|mosquito-patchbay) ;; *) PATCHBAY_APP=mixbay+qpwgraph ;; esac
  [[ $ROUTING_TOOL == no ]] && return 0
  # -s, not -f: an empty file means "flag reset", not "the user closed it".
  [[ -s "$STATE_DIR/patchbay_closed_this_session" ]] && return 0

  local addr want have
  addr=$(patchbay_addr)
  want=$(patchbay_specs 2>/dev/null | grep -c . || true)
  have=$(printf '%s' "$addr" | grep -c . || true)

  # Every expected window still (or again) running — nothing to do. Record
  # the addresses so the file always mirrors reality.
  if (( want > 0 )) && (( have >= want )); then
    printf '%s\n' "$addr" > "$STATE_DIR/patchbay_addr"
    return 0
  fi

  # All of them vanished: ask ONCE via the confirm overlay.
  local payload sel="$STATE_DIR/confirm_sel" donef="$STATE_DIR/confirm_done" ans
  rm -f "$sel" "$donef"
  payload=$(jq -cn --arg message "Close the scratchpad audio app(s) for this Live session?" \
    --arg selectionFile "$sel" --arg doneFile "$donef" \
    '{message:$message, selectionFile:$selectionFile, doneFile:$doneFile}')
  omarchy-shell shell summon mosquito.livemode "$payload" >/dev/null 2>&1 || true
  ans=""
  for i in $(seq 1 60); do
    [[ -f "$donef" ]] && break
    sleep 0.5
  done
  ans=$(cat "$sel" 2>/dev/null || echo "")
  rm -f "$sel" "$donef"

  if [[ "$ans" == "yes" ]]; then
    touch "$STATE_DIR/patchbay_closed_this_session"
    printf '' > "$STATE_DIR/patchbay_addr"
    ok "scratchpad audio app(s) closed for this session by the user."
  else
    # Keep them running: relaunch + park (same path as activation).
    local pspec
    while IFS= read -r pspec; do
      [[ -n $pspec ]] || continue
      setsid --fork uwsm-app -- "${pspec%%|*}" >/dev/null 2>&1 || \
      setsid --fork "${pspec%%|*}" >/dev/null 2>&1 || true
    done < <(patchbay_specs)
    local i new
    for i in $(seq 1 20); do
      sleep 0.3
      new=$(patchbay_addr)
      [[ -n "$new" ]] && break
    done
    [[ -n "$new" ]] && {
      echo "$new" > "$STATE_DIR/patchbay_addr"
      # The Lua dispatcher form, inlined rather than shared: this watchdog is
      # its own process and does not source live-mode, so park_in_scratchpad()
      # is not in scope here. The classic form it replaces is a LUA SYNTAX
      # ERROR on Hyprland 0.56 ("special:scratchpad" — the colon) and was
      # swallowed by 2>&1, so the window was never parked.
      while IFS= read -r a; do
        [[ -n $a ]] || continue
        # Both providers tiled, exactly like activation: mixbay carries a
        # float+center rule and would otherwise reopen floating over qpwgraph.
        hyprctl dispatch "hl.dsp.window.float({ window = \"address:$a\", action = \"off\" })" \
          >/dev/null 2>&1 \
          || hyprctl dispatch "settiled address:$a" >/dev/null 2>&1 || true
        hyprctl dispatch "hl.dsp.window.move({ window = \"address:$a\", workspace = \"special:scratchpad\" })" \
          >/dev/null 2>&1 \
          || hyprctl dispatch "movetoworkspacesilent special:scratchpad,address:$a" >/dev/null 2>&1 || true
      done <<< "$new"
    }
  fi
}

# ---------------------------------------------------------------------------
# Main loop
# ---------------------------------------------------------------------------

# The DND guard runs on its own loop so the thermal cadence (5s) is not the
# clock it answers to. Sub-second, cheap, and it exits with the session.
(
  while is_active; do
    enforce_dnd
    sleep 0.4
  done
) &

while is_active; do
  thermal_control
  reassert_state
  patchbay_watch
  sleep "$INTERVAL"
done

# The guard is a child of this process; do not outlive the session.
pkill -P $$ -f "sleep 0.4" 2>/dev/null || true
