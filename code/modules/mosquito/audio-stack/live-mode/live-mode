# ---------------------------------------------------------------------------
# Theme (live mode: branded black wallpaper + all accents red)
#
# The Live theme is stored OUTSIDE ~/.config/omarchy/themes/ (at
# $STATE_DIR/theme), so it never shows up in `omarchy theme list` / the theme
# switcher. Omarchy resolves a theme name only from the two scanned
# directories, so a symlink ~/.config/omarchy/themes/live is created for the
# DURATION OF THE `theme set` CALL ONLY, then removed: theme set copies the
# directory into current/theme at the start, the name is all it needs.
# Keeping the link for the whole session (the old behaviour) is what made
# "Live" appear in the picker.
# ---------------------------------------------------------------------------

# omarchy theme set lowercases its argument and writes the lowercase name
# into theme.name (e.g. "live"), so every comparison below — including the
# self-heal confirm and the restore gate — must use the same exact case.
LIVE_THEME_NAME="live"
LIVE_THEME_DIR="$STATE_DIR/theme"
LIVE_THEME_LINK="$REAL_HOME/.config/omarchy/themes/live"
LIVE_THEME_BG="$LIVE_THEME_DIR/backgrounds/black.png"
PRE_THEME_FILE="$STATE_DIR/pre_theme_name"

theme_current() {
  cat "$REAL_HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || true
}

# The link only ever exists for the duration of a theme set: remove it.
drop_live_theme_link() { rm -f "$LIVE_THEME_LINK" 2>/dev/null || true; }

save_current_theme() {
  local name
  name=$(theme_current)
  [[ -n "$name" ]] && echo "$name" > "$PRE_THEME_FILE"
}

ensure_live_theme() {
  # Create the Live theme on demand if it isn't installed yet. The installer
  # ships the branded wallpaper; this is the fallback for a state dir the
  # user wiped by hand.
  if [[ ! -f "$LIVE_THEME_DIR/colors.toml" ]]; then
    mkdir -p "$LIVE_THEME_DIR" "$LIVE_THEME_DIR/backgrounds"
    cat > "$LIVE_THEME_DIR/colors.toml" <<LIVETHEME
mode = "dark"

accent = "#ff1a1a"
selection = "#3a0000"
muted = "#660000"

background = "#000000"
dark_background = "#000000"
darker_background = "#000000"
lighter_background = "#1a0000"

foreground = "#e0e0e0"
dark_foreground = "#808080"
light_foreground = "#f0f0f0"
bright_foreground = "#ffffff"

red = "#ff1a1a"
yellow = "#ff4444"
orange = "#ff3333"
green = "#cc0000"
cyan = "#ff2222"
blue = "#ff1a1a"
magenta = "#ff1a1a"
brown = "#990000"

bright_red = "#ff4444"
bright_yellow = "#ff6666"
bright_green = "#ff3333"
bright_cyan = "#ff3333"
bright_blue = "#ff4444"
bright_magenta = "#ff4444"
LIVETHEME
  fi
  if [[ ! -f "$LIVE_THEME_BG" ]]; then
    mkdir -p "$(dirname "$LIVE_THEME_BG")"
    magick -size 1920x1080 xc:"#000000" "$LIVE_THEME_BG" 2>/dev/null || \
    convert -size 1920x1080 xc:"#000000" "$LIVE_THEME_BG" 2>/dev/null || true
  fi
}

switch_to_live_theme() {
  ensure_live_theme
  # A link left behind by an interrupted run must not make the theme visible.
  drop_live_theme_link
  local current
  current=$(theme_current)
  if [[ "$current" != "$LIVE_THEME_NAME" ]]; then
    save_current_theme
    # Detached + self-healing (same rationale as restore_previous_theme:
    # theme-set post-hooks restart terminals and can race the write). The
    # script is detached, so the helper is inlined rather than sourced.
    setsid --fork bash -lc '
      link="'"$LIVE_THEME_LINK"'"
      theme="'"$LIVE_THEME_DIR"'"
      for i in $(seq 1 30); do
        rm -f "$link"
        ln -sfn "$theme" "$link"
        omarchy theme set Live >/dev/null 2>&1 || true
        rm -f "$link"
        cur=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || true)
        [[ "$cur" == "live" ]] && exit 0
        sleep 0.4
      done
      rm -f "$link"
    ' >/dev/null 2>&1 &
  fi
}

restore_previous_theme() {
  local prev
  prev=$(cat "$PRE_THEME_FILE" 2>/dev/null || true)
  if [[ -z $prev || "$prev" == "$LIVE_THEME_NAME" ]]; then
    # No usable memory (state wiped, interrupted activation). Fall back to the
    # last theme this script restored, then to any installed non-Live theme.
    prev=$(cat "$STATE_DIR/last_theme" 2>/dev/null || true)
    if [[ -z $prev || "$prev" == "$LIVE_THEME_NAME" || ! -d "${OMARCHY_PATH:-/usr/share/omarchy}/themes/$prev" && ! -d "$REAL_HOME/.config/omarchy/themes/$prev" ]]; then
      prev=$(find "$REAL_HOME/.config/omarchy/themes" "${OMARCHY_PATH:-/usr/share/omarchy}/themes" \
        -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | grep -vx "$LIVE_THEME_NAME" | sort | head -n1)
    fi
  fi
  printf '%s\n' "$prev" > "$STATE_DIR/last_theme"

  local current
  current=$(theme_current)
  if [[ "$current" == "$LIVE_THEME_NAME" && -n $prev ]]; then
    # Detached + self-healing: omarchy-theme-set's post-hooks restart
    # terminals (killing this script's terminal mid-OFF if run inline), and
    # the first write can be raced by other hooks — the background job
    # keeps setting until the theme.name lands on the pre-live value.
    setsid --fork bash -lc '
      local_restored="'"$prev"'"
      for i in $(seq 1 30); do
        omarchy theme set "$local_restored" >/dev/null 2>&1 || true
        sleep 0.4
        cur=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)
        [[ "$cur" == "$local_restored" ]] && exit 0
      done
    ' >/dev/null 2>&1 &
    ok "Restoring theme: $prev."
  fi
  rm -f "$PRE_THEME_FILE"
  # Drop the link so the Live theme entry disappears from the theme picker.
  drop_live_theme_link
}

# ---------------------------------------------------------------------------
# Theme / background default keybinds, blocked for the session
#
# `omarchy theme set` is re-asserted by the watchdog, so a theme picked from the
# menu would flick back seconds later (restarting every terminal on the way).
# Blocking the FUNCTION would also break a shortcut the user bound himself, so
# only Omarchy's four DEFAULT combos are unbound, and only while they still
# carry the Theme/Background action. Any other chord bound to those menus by
# the user keeps working; `hyprctl reload` at the end of the session restores
# the defaults from the config file.
# ---------------------------------------------------------------------------

THEME_KEYS_FLAG="$STATE_DIR/theme_keys_blocked"

block_theme_keys() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  local binds mask key chord
  binds=$(hyprctl -j binds 2>/dev/null) || return 0
  if ! command -v jq >/dev/null 2>&1; then
    return 0
  fi
  while read -r mask key; do
    [[ -n $mask && -n $key ]] || continue
    case "$mask $key" in
      "68 SPACE"|"68 W"|"68 T") chord="SUPER + CTRL + $key" ;;
      "69 SPACE")               chord="SUPER + SHIFT + CTRL + SPACE" ;;
      *) continue ;;
    esac
    hyprctl eval "hl.unbind(\"$chord\")" >/dev/null 2>&1 || true
  done < <(jq -r '.[]
    | select((.description // "") | test("^(Theme menu|Background switcher)$"))
    | select((.modmask == 68 and (.key == "SPACE" or .key == "W" or .key == "T"))
             or (.modmask == 69 and .key == "SPACE"))
    | "\(.modmask) \(.key)"' <<< "$binds" 2>/dev/null || true)
  touch "$THEME_KEYS_FLAG"
}

unblock_theme_keys() {
  # Only reload when this session actually unbound something: a reload is
  # harmless but it is not something to run on every `off` of a machine that
  # never blocked anything.
  [[ -f $THEME_KEYS_FLAG ]] || return 0
  rm -f "$THEME_KEYS_FLAG"
  command -v hyprctl >/dev/null 2>&1 || return 0
  hyprctl reload >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------------------
# Watchdog
# ---------------------------------------------------------------------------

start_watchdog() {
  if [[ -x "$WATCHER" ]]; then
    nohup "$WATCHER" >/dev/null 2>&1 &
    ok "Thermal guard started (pid $!)."
  else
    warn "live-mode-watch not found; thermal guard disabled."
  fi
}

stop_watchdog() {
  # The watchdog re-creates the stay-awake indicator file on every tick
  # (reassert_state), so if cmd_off doesn't wait for it to actually exit
  # before removing that file, the watchdog's next tick re-creates it and
  # the red coffee icon stays on long after deactivation. We both (a) wait
  # for the watchdog process to fully exit and (b) drop the active flag
  # while we wait — the flag is the watchdog's loop condition, so as soon
  # as it's gone the watchdog's next is_active check fails and reassert_state
  # never runs again. Result: the red coffee icon disappears immediately,
  # not after the next watchdog tick.
  pkill -f "live-mode-watch" 2>/dev/null || true
  rm -f "$ACTIVE_FLAG"
  local i
  for i in $(seq 1 30); do
    pgrep -f "live-mode-watch" >/dev/null 2>&1 || return 0
    sleep 0.1
  done
}

# ---------------------------------------------------------------------------
# ON
# ---------------------------------------------------------------------------

cmd_on() {
  local force="${1:-}"

  if is_active; then
    ok "Live Mode is already active."
    return 0
  fi

  # A crashed session must not leave the theme shortcuts blocked, a runtime
  # app mask behind, or the Live theme linked into the theme picker.
  unblock_theme_keys
  clear_stale_app_masks
  drop_live_theme_link

  load_settings

  # Step 1 — confirm activation (unless forced).
  #
  # The bullet list is BUILT from the effective settings, not written out. It
  # used to be one hardcoded string that always announced the patchbay, the
  # notification silencing and the gap removal — whatever the manager was
  # actually configured to do — and said nothing at all about the background
  # apps it closes, the theme it switches, or the package fence. So the prompt
  # was wrong in both directions at once: it claimed things that would not
  # happen, and stayed silent about things that would.
  #
  # Same rule as the power-profile question: say what will be done, or do not
  # claim it. Each line is kept short enough to fit the card width on one line
  # (the screen is narrow — a wrapped bullet breaks the prompt).
  if [[ "$force" != "yes" ]]; then
    _lm_bullets=(
      "Max performance (audio optimized)"
      "Thermal guard at ${THERMAL_LIMIT_C}°C"
    )
    if has_lid; then
      _lm_bullets+=("Always awake (even with the lid closed)")
    else
      _lm_bullets+=("Always awake")
    fi
    [[ $CLOSE_APPS == yes ]] && {
      # The prompt names the apps actually RUNNING and selected, not the
      # stored list: the old line announced six apps the machine did not even
      # have while silently ignoring the one that would be closed.
      _lm_closing=$(detect_background_apps | paste -sd, - | sed 's/,/, /g')
      [[ -n $_lm_closing ]] && _lm_bullets+=("Close $_lm_closing")
    }
    [[ $RELAUNCH_APPS == yes ]] && _lm_bullets+=("Relaunch closed apps on exit")
    if [[ $ROUTING_TOOL == yes ]]; then
      if [[ ${PATCHBAY_APP:-mixbay+qpwgraph} == mixbay+qpwgraph ]]; then
        _lm_bullets+=("mixbay + qpwgraph in scratchpad (SUPER + S)")
      else
        _lm_bullets+=("${PATCHBAY_APP} in scratchpad (SUPER + S)")
      fi
    fi
    [[ $NO_GAPS == yes ]] && _lm_bullets+=("Gaps disabled during the session")
    [[ $SILENCE_NOTIFICATIONS == yes ]] && _lm_bullets+=("Notifications silenced")
    [[ $SWITCH_THEME == yes ]] && _lm_bullets+=("Switch to the Live theme")
    [[ $DISABLE_PASSWORDLESS_SUDO == yes ]] && _lm_bullets+=("Disable passwordless sudo")
    # The fence is the one line that must be visible when it is on, because it
    # is the one that makes the machine refuse to install anything.
    [[ $FENCE_PACKAGES == yes ]] && _lm_bullets+=("Package installation BLOCKED for the session")
    _lm_card="Activate Live Mode?"
    for _lm_b in "${_lm_bullets[@]}"; do
      _lm_card+=$'\n'"• ${_lm_b}"
    done
    if ! confirm "$_lm_card"; then
      ok "Aborted."
      return 0
    fi
  fi

  # on_failure() removes the session flag so a failed/crashed activation can
  # never strand the "manage only while off" gate or the toggle logic, and
  # gives the theme/background shortcuts back.
  on_fail() { rm -f "$ACTIVE_FLAG"; unblock_theme_keys; }
  trap on_fail EXIT

  # Mark active first: every helper below (sleep management, watchdog,
  # theme) treats the flag as the source of truth for the session.
  echo on > "$ACTIVE_FLAG"

  # The theme/background switchers are refused for the session. Only the
  # Omarchy default chords are unbound — a shortcut the user bound himself
  # keeps working (see block_theme_keys).
  block_theme_keys

  ok "Activating Live Mode..."

  # Snapshot what is ALREADY in the scratchpad so deactivation can put it
  # back exactly (see restore_scratchpad).
  snapshot_scratchpad

  # 1. Close the selected background apps (the activation card listed them).
  close_background_apps

  # 2. Privileged setup (profile/audio/usb/battery/fence) runs while the
  #    rest of the activation proceeds — serialized steps made startup feel
  #    slow.
  sudo -n "$ROOT_HELPER" apply >/dev/null 2>&1 &
  root_job=$!

  # 3. Neutralize any warm screen tint for the session (restored afterwards).
  neutralize_tint

  # 4. Sleep management replicated from mega-caffeine (no tint, no toast).
  start_sleep_management

  # 5. Independent cosmetic/setup steps concurrently.
  [[ $NO_GAPS == yes ]] && { toggle_gaps_off & }
  { [[ $SILENCE_NOTIFICATIONS == yes ]] && force_dnd_on & } >/dev/null 2>&1
  pipewire_live_on
  frame_show &

  # 6. Scratchpad windows out of the way.
  move_scratchpad_windows

  # 7. mosquito patchbay into the scratchpad (idempotent). If the user
  #    refuses the scratchpad-occupied prompt, abort the whole activation.
  #    The status is captured: `if ! open_patchbay; then ... $?` reads the
  #    status of `!`, which is always 0, so the refusal branch never ran.
  local patchbay_rc=0
  open_patchbay || patchbay_rc=$?
  if (( patchbay_rc == 1 )); then
    return 0
  fi

  # 8. Live theme switched from a DETACHED process: omarchy-theme-set's
  #    post-hooks restart terminals, and if this script runs inside one the
  #    restart would kill the orchestrator mid-flight.
  #
  #    SWITCH_THEME=no skips the whole thing. It exists because a theme set
  #    restarts every terminal on the desktop — including the one running an
  #    activation, including a live remote/agent session. That is exactly what
  #    happens with the rest of the activation still in flight, so there needs
  #    to be a way to run everything EXCEPT the disruptive part. The previous
  #    theme is still recorded and still restored, so deactivation stays
  #    symmetric.
  if [[ $SWITCH_THEME == yes ]]; then
    switch_to_live_theme
  else
    ok "Theme switch skipped (SWITCH_THEME=no)."
  fi

  # 9. Thermal watchdog (last: it reasserts everything above). Re-block the
  #    theme shortcuts first: the gaps toggle above is an Omarchy config toggle
  #    and reloads Hyprland, which restores the default binds.
  #
  #    The performance profile is set DIRECTLY here, before the watchdog's
  #    first pass: the watchdog's power-profile question is for a hand change
  #    mid-session, not for starting the session (it used to fire seconds after
  #    `on` because the root helper runs in the background).
  block_theme_keys
  powerprofilesctl set performance 2>/dev/null || true
  start_watchdog

  wait "$root_job" 2>/dev/null || true
  if ! sudo -n "$ROOT_HELPER" status >/dev/null 2>&1; then
    warn "System state could not be applied (sudo denied) — performance steps inactive."
  fi

  # One-way hardening: after the privileged work is done, install the scoped
  # live-mode-root grant and remove every broad NOPASSWD: ALL drop-in. Nothing
  # puts them back; the session (and later `off`/the thermal guard) keeps
  # working through the scoped rule.
  if [[ $DISABLE_PASSWORDLESS_SUDO == yes ]]; then
    if ! sudo -n "$ROOT_HELPER" harden-sudo >/dev/null 2>&1; then
      warn "Passwordless sudo could not be disabled."
    fi
    # Drop the cached sudo timestamp too, so the change is immediate; the
    # scoped live-mode-root rule (NOPASSWD for its commands) is unaffected.
    sudo -k 2>/dev/null || true
  fi

  trap - EXIT
  ok "Live Mode is ON."
}

# ---------------------------------------------------------------------------
# OFF
# ---------------------------------------------------------------------------

cmd_off() {
  local force="${1:-}"
  if ! is_active; then
    # A crashed session may still have left the theme shortcuts blocked.
    unblock_theme_keys
    ok "Live Mode is already off."
    return 0
  fi

  # Simple confirmation only.
  if [[ "$force" != "yes" ]]; then
    if ! confirm "Deactivate Live Mode?"; then
      ok "Aborted."
      return 0
    fi
  fi

  ok "Deactivating Live Mode..."

  # 1. Stop watchdog
  stop_watchdog

  # 2. Give the theme/background shortcuts back. AFTER stop_watchdog: the
  #    watchdog re-blocks them on every pass, so unblocking first let it
  #    re-unbind between the reload and its own death.
  unblock_theme_keys

  # 3. Frame hide
  frame_hide

  # 4. Restore the theme that was in use before activation
  restore_previous_theme

  # 5. Notifications back to the state the session found. Forcing DND on is
  #    ours to undo; an already-on DND was the user's own setting.
  restore_dnd_state

  # 5b. Gaps, only if this session is the reason they are off.
  toggle_gaps_on

  # 5c. The scratchpad back to its pre-live contents.
  #
  # This step was DEFINED and never CALLED. The patchbay the session launched
  # therefore stayed parked in the scratchpad after deactivation, holding a
  # window the user had not asked to keep, and the recorded address survived
  # into the next session — which is what makes "an empty scratchpad returns
  # empty" untrue. A patchbay that was ALREADY there before the session is left
  # alone, because the user put it there.
  restore_scratchpad

  # 5d. Opt-in: start again the apps this session closed at activation.
  relaunch_closed_apps

  # 6. Sleep management off (also ends any mega-caffeine session)
  stop_sleep_management

  # 7. Restore the screen tint that was neutralized
  restore_tint

  # 7b. PipeWire settings: give back the pre-live force/persist state.
  pipewire_live_off

  # 8. Privileged: restore profile, audio, usb, battery, thermal, fence
  sudo -n "$ROOT_HELPER" restore >/dev/null 2>&1 || warn "Partial restore (sudo denied for some ops)."

  # 9. Remove active flag
  rm -f "$ACTIVE_FLAG"

  ok "Live Mode is OFF."
}

# ---------------------------------------------------------------------------
# STATUS
# ---------------------------------------------------------------------------

cmd_status() {
  if is_active; then
    echo "Live Mode: ON"
    sudo -n "$ROOT_HELPER" status 2>/dev/null || echo "{}"
  else
    echo "Live Mode: OFF"
  fi
}

# ---------------------------------------------------------------------------
# MANAGE
# ---------------------------------------------------------------------------
# The Live Manager TUI configures the NEXT session and is meant to be used
# while live mode is OFF. While a session is active, opening it would fight
# the running watchdog, so an OK notice explains that instead.

cmd_manage() {
  local replace="${1:-}"
  if is_active; then
    confirm_ok $'Live Mode Manager can\'t be opened while Live Mode is active.\nIt configures the next session — stop Live Mode first.'
    return 0
  fi
  if [[ ! -x "$TUI_BIN" ]]; then
    err "Manage TUI not found: $TUI_BIN"
    return 1
  fi
  # One TUI per manager: --replace closes any other copy silently, otherwise
  # ask before taking over.
  manager_single_instance_gate "$replace"
  # Launch the manager in a terminal (foot, falling back to xterm) when this
  # call is detached — e.g. from the Omarchy menu. No geometry override: foot
  # keeps Omarchy's own font, padding and scale. The TUI runs as a child (not
  # exec) so the EXIT trap can drop the PID file when it ends.
  if [[ -t 0 && -t 1 ]]; then
    "$TUI_BIN"
    exit $?
  elif command -v foot >/dev/null 2>&1; then
    foot --app-id=org.omarchy.mosquito-live-mode-tui -e "$TUI_BIN"
    exit $?
  elif command -v xterm >/dev/null 2>&1; then
    xterm -e "$TUI_BIN"
    exit $?
  else
    err "No terminal emulator (foot/xterm) available to open the manager."
    return 1
  fi
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

case "${1:-}" in
  on)      cmd_on "${2:-}" ;;
  off)     cmd_off "${2:-}" ;;
  status)  cmd_status ;;
  --active)
    # THE ANSWER IS THE EXIT CODE, NOT THE OUTPUT.
    #
    # The omarchy menu batches every row's "checked" expression into one script
    # and evaluates each as `if { <expression>; } then echo <id>:c:1; ...`, so
    # what decides a tick is the command's STATUS. Printing "false" and exiting
    # 0 therefore reads as TRUE: the row sat permanently ticked, claiming a
    # live session when none was, and clicking it offered to turn off
    # something that had never been on. The comment that used to sit here
    # claimed the menu took stdout as the boolean, which is exactly backwards
    # and is why the bug survived.
    #
    # mega-caffeine's --active already answers by exit status (1 when
    # inactive), which is why only this one row was stuck on.
    # exit, not return: this dispatch is a bare `case` at the top level, not a
    # function body. Anything else is a shell error and exits non-zero, which
    # would have read as "active" — the same bug as before, in a new costume.
    if is_active; then
      exit 0
    fi
    exit 1
    ;;
  toggle)  is_active && cmd_off || cmd_on ;;
  manage)  cmd_manage "${2:-}" ;;
  *)       usage ;;
esac
