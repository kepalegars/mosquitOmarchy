#!/usr/bin/env bash
# live-mode — Omarchy live mode orchestrator (performance-audio session).
# Invoked by user: live-mode on|off|status|toggle|manage
# sudoers NOPASSWD entry for live-mode-root handles privileged ops.
# Managed by code/modules/mosquito/audio-stack/live-mode/setup-live-mode.sh
#
# Live mode deliberately does NOT run mega-caffeine. It replicates only
# mega-caffeine's sleep management (lid-close inhibition + stay-awake
# indicator) under its own name, never applies a screen tint, and turns any
# running mega-caffeine session off when it ends. The manage TUI configures
# the NEXT session and is meant to be used while live mode is off.

set -euo pipefail

REAL_USER="${SUDO_USER:-${LOGNAME:-$USER}}"
REAL_HOME=$(eval echo "~$REAL_USER" 2>/dev/null || echo "$HOME")
STATE_DIR="$REAL_HOME/.local/state/live-mode"
CONFIG_DIR="$REAL_HOME/.config/live-mode"
CONFIG_FILE="$CONFIG_DIR/settings"
ACTIVE_FLAG="$STATE_DIR/active"
ROOT_HELPER="$HOME/.local/bin/live-mode-root"
WATCHER="$HOME/.local/bin/live-mode-watch"
TUI_BIN="$HOME/.local/bin/mosquito-live-mode-tui"
FRAME_OVERLAY_ID="mosquito.livemode"
MEGA_CAFFEINE="$HOME/.local/bin/mega-caffeine"
PIPEWIRE_SETTINGS="$REAL_HOME/.local/bin/mosquitomarchy-pipewire-settings"
CAFFEINE_STATE_DIR="$REAL_HOME/.local/state/caffeine"

# Single-instance PID file for the Live Manager TUI (see the gate below).
MANAGER_PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/mosquito-live-mode.pid"
MANAGER_SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"

mkdir -p "$STATE_DIR"

usage() {
  cat >&2 <<EOF
Usage: live-mode <command>

Commands:
  on [yes]      Activate live mode (confirmation unless 'yes' given)
  off [yes]     Deactivate live mode (confirmation unless 'yes' given)
  status        Show current live mode state
  --active      Exit 0 when a session is live, 1 otherwise. The omarchy
                menu reads the EXIT CODE of a row's "checked" expression,
                so that is the answer -- printing true/false is ignored.
  toggle        Toggle live mode on/off
  manage [--replace]  Open the Live Manager (configures the next session; live mode must be off)
                      --replace closes any other open Live Manager first
EOF
  exit 1
}

# ---------------------------------------------------------------------------
# Settings (written by the Live Manager TUI, read here and by the watchdog)
# ---------------------------------------------------------------------------

THERMAL_LIMIT_C=85
CLOSE_APPS=yes
CLOSE_APPS_LIST="Superwhisper"
ROUTING_TOOL=yes
PATCHBAY_APP=mixbay+qpwgraph
NO_GAPS=yes
SILENCE_NOTIFICATIONS=yes
SWITCH_THEME=yes
RELAUNCH_APPS=no
DISABLE_PASSWORDLESS_SUDO=yes
PIPEWIRE_AUTOLOCK=yes

load_settings() {
  # Defaults FIRST, then the file, then normalisation.
  #
  # The order matters under `set -u`: the normalisation lines used to reference
  # each variable before anything had assigned it, so a settings file written by
  # an older version — one missing a key — aborted the whole command with
  # "VAR: unbound variable". Reading a variable is what trips it, not the
  # assignment that would have supplied the default. Assigning first means a
  # partial file is a normal file.
  #
  # The fence default is "no" and, unlike the others, only an explicit "yes"
  # turns it on: this one blocks pacman, and defaulting a setting that breaks
  # package management because a file says nothing is exactly the mistake the
  # unconditional fence already made once.
  THERMAL_LIMIT_C=85
  CLOSE_APPS=yes
  CLOSE_APPS_LIST="Superwhisper"
  ROUTING_TOOL=yes
  PATCHBAY_APP=mixbay+qpwgraph
  NO_GAPS=yes
  SILENCE_NOTIFICATIONS=yes
  SWITCH_THEME=yes
  RELAUNCH_APPS=no
  DISABLE_PASSWORDLESS_SUDO=yes
  PIPEWIRE_AUTOLOCK=yes
  FENCE_PACKAGES=no
  [[ -f $CONFIG_FILE ]] && source "$CONFIG_FILE" || true

  case $THERMAL_LIMIT_C in 95|90|85|80|75) ;; *) THERMAL_LIMIT_C=85 ;; esac
  [[ $CLOSE_APPS == no ]] || CLOSE_APPS=yes
  # Keep every saved name, installed or not. The Live Manager only lists
  # installed apps, but a name whose app is temporarily gone must survive here
  # so it is still selected when the app comes back. Never filter it against a
  # hardcoded list.
  # The remaining four: only an explicit "no" turns them off, so a settings file
  # written by an older version keeps the behaviour it had.
  [[ $ROUTING_TOOL == no ]] || ROUTING_TOOL=yes
  # Which apps fill the patchbay slot: mixbay+qpwgraph (mosquito mixbay
  # plus the qpwgraph PipeWire graph, the default), mixbay or qpwgraph alone,
  # or mosquito-patchbay (the future native routing surface). Anything else
  # falls back to the combo default; a choice that is not installed falls
  # through to whatever IS, inside patchbay_specs — the setting names the
  # preference, not a hard requirement.
  case $PATCHBAY_APP in mixbay+qpwgraph|mixbay|qpwgraph|mosquito-patchbay) ;; *) PATCHBAY_APP=mixbay+qpwgraph ;; esac
  [[ $NO_GAPS == no ]] || NO_GAPS=yes
  [[ $SILENCE_NOTIFICATIONS == no ]] || SILENCE_NOTIFICATIONS=yes
  [[ $SWITCH_THEME == no ]] || SWITCH_THEME=yes
  # Opt-in: only an explicit "yes" relaunches the apps the session closed.
  [[ $RELAUNCH_APPS == yes ]] || RELAUNCH_APPS=no
  # On by default: only an explicit "no" keeps broad passwordless sudo.
  [[ $DISABLE_PASSWORDLESS_SUDO == no ]] || DISABLE_PASSWORDLESS_SUDO=yes
  [[ $PIPEWIRE_AUTOLOCK == no ]] || PIPEWIRE_AUTOLOCK=yes
  # The fence inverts that rule on purpose — see above.
  [[ $FENCE_PACKAGES == yes ]] || FENCE_PACKAGES=no
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

is_active() { [[ -f "$ACTIVE_FLAG" ]]; }

# A laptop reports a lid switch under /proc/acpi; a desktop does not. Used to
# say only what is true in the activation card (no lid = no lid sentence).
has_lid() {
  local f
  for f in /proc/acpi/button/lid/*/state; do
    [[ -e $f ]] && return 0
  done
  return 1
}

ok()   { printf '\033[32m●\033[0m %s\n' "$*"; }
warn() { printf '\033[33m●\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[31m●\033[0m %s\n' "$*" >&2; }

confirm() {
  local message="$1" payload sel="$STATE_DIR/confirm_sel" donef="$STATE_DIR/confirm_done"
  rm -f "$sel" "$donef"
  payload=$(jq -cn --arg message "$message" --arg selectionFile "$sel" --arg doneFile "$donef" \
    '{message:$message, selectionFile:$selectionFile, doneFile:$doneFile}')
  omarchy-shell shell summon mosquito.livemode "$payload" >/dev/null 2>&1 || true
  for i in $(seq 1 60); do
    [[ -f "$donef" ]] && break
    sleep 0.5
  done
  [[ -f "$donef" ]] || return 1
  local ans
  ans=$(cat "$sel" 2>/dev/null || echo "")
  rm -f "$sel" "$donef"
  [[ "$ans" == "yes" ]]
}

# Single-button notice via the same confirm overlay (okOnly): shows an OK-only
# card, waits for the user to acknowledge. Used for "can't do this" notices.
confirm_ok() {
  local message="$1" payload sel="$STATE_DIR/confirm_sel" donef="$STATE_DIR/confirm_done"
  rm -f "$sel" "$donef"
  payload=$(jq -cn --arg message "$message" --arg selectionFile "$sel" --arg doneFile "$donef" \
    '{message:$message, selectionFile:$selectionFile, doneFile:$doneFile, okOnly:true}')
  omarchy-shell shell summon mosquito.livemode "$payload" >/dev/null 2>&1 || true
  for i in $(seq 1 60); do
    [[ -f "$donef" ]] && break
    sleep 0.5
  done
  rm -f "$sel" "$donef"
}

# ── Single-instance handling for the Live Manager TUI (manage only) ─────────
# One TUI per manager: a normal `manage` that finds another copy already
# running asks whether to close it first; `manage --replace` closes it
# without asking; answering no abandons the new instance. Detection is an
# exact /proc/<pid>/cmdline argv-field match on the TUI binary (absolute path
# or bare basename), so a plain pgrep substring hit can never match an
# unrelated wrapper that merely mentions the path. A PID file records the
# live instance; a stale record is dropped rather than trusted, so a crashed
# instance never blocks a new launch. The on/off/status paths never reach this.
manager_is_our_pid() {
  # True when PID carries the manager TUI binary or this dispatcher as a
  # whole, exact argv field — never on a mere substring.
  local p="$1" field
  [[ -r /proc/$p/cmdline ]] || return 1
  while IFS= read -r -d '' field; do
    case $field in
      "$TUI_BIN"|"${TUI_BIN##*/}") return 0 ;;
    esac
    if [[ $MANAGER_SELF == /* && $field == "$MANAGER_SELF" ]]; then return 0; fi
  done < "/proc/$p/cmdline"
  return 1
}

manager_tui_pids() {
  local p rec
  local -a pids=()
  while IFS= read -r p; do
    [[ -n $p && $p != "$$" ]] || continue
    if manager_is_our_pid "$p"; then pids+=("$p"); fi
  done < <(pgrep -f -- "${TUI_BIN##*/}" 2>/dev/null || true)
  if [[ -f $MANAGER_PIDFILE ]]; then
    rec=$(cat "$MANAGER_PIDFILE" 2>/dev/null || true)
    if [[ $rec =~ ^[0-9]+$ ]] && [[ $rec != "$$" ]] && manager_is_our_pid "$rec"; then
      pids+=("$rec")
    else
      rm -f "$MANAGER_PIDFILE"
    fi
  fi
  if ((${#pids[@]})); then
    printf '%s\n' "${pids[@]}" | sort -u
  fi
  return 0
}

manager_pidfile_cleanup() { rm -f "$MANAGER_PIDFILE"; }

manager_single_instance_gate() {
  local replace="$1" pids p
  trap manager_pidfile_cleanup EXIT
  pids=$(manager_tui_pids)
  if [[ -n $pids ]]; then
    if [[ $replace != --replace ]]; then
      if ! confirm "Another Live Mode Manager instance is already open. Close it and continue?"; then
        warn "Another Live Manager is already open — leaving it alone."
        exit 0
      fi
    fi
    while IFS= read -r p; do
      [[ -n $p ]] || continue
      kill "$p" 2>/dev/null || true
    done <<< "$pids"
    for _ in $(seq 1 20); do
      if [[ -z $(manager_tui_pids) ]]; then break; fi
      sleep 0.1
    done
    for p in $(manager_tui_pids); do kill -9 "$p" 2>/dev/null || true; done
  fi
  printf '%s\n' "$$" > "$MANAGER_PIDFILE"
}

# One entry per installed app in the Omarchy app menu, as
#   Name<TAB>match1 match2
# where the matches are the Exec basename and StartupWMClass, lowercased. The
# fixed process-name table this replaces missed every app installed outside it.
app_catalog() {
  local dirs=() d f
  dirs+=("${XDG_DATA_HOME:-$HOME/.local/share}/applications")
  IFS=: read -r -a _xdg_dirs <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for d in "${_xdg_dirs[@]}"; do
    [[ -n $d ]] && dirs+=("$d/applications")
  done
  for d in "${dirs[@]}"; do
    for f in "$d"/*.desktop; do
      [[ -f $f ]] || continue
      awk -F= '
        /^\[/ { inentry = ($0 == "[Desktop Entry]"); next }
        !inentry { next }
        /^Name=/ { if (name == "") name = substr($0, 6) }
        /^Exec=/ { if (exec == "") exec = substr($0, 6) }
        /^StartupWMClass=/ { wm = substr($0, 16) }
        /^Type=/ { type = substr($0, 6) }
        /^(NoDisplay|Hidden)=true/ { hidden = 1 }
        END {
          if (name == "" || type != "Application" || hidden) exit
          raw = exec
          # Strip quoted arguments before splitting: Exec values such as
          # --font="JetBrainsMono Nerd Font" hold spaces INSIDE the quotes, and
          # a raw split then takes "Nerd" for the program name and the whole
          # entry never matches the process it is supposed to close.
          gsub(/"[^"]*"/, "", exec)
          gsub(/\047[^\047]*\047/, "", exec)
          n = split(exec, part, /[ \t]+/)
          exe = ""
          for (i = 1; i <= n; i++) {
            t = part[i]
            if (t == "" || t ~ /^[A-Za-z_][A-Za-z0-9_]*=/ || t ~ /^-/) continue
            sub(/.*\//, "", t)
            # Skip the wrappers, not the program they start. The Superwhisper
            # desktop entry is Exec=foot ... env SW_TUI_LOGO=font superwhisper
            # settings: stopping at "foot" made the app catalog match EVERY
            # terminal on the machine, so "close Superwhisper" would have
            # killed every foot window and left Superwhisper running.
            if (tolower(t) ~ /^(sh|bash|dash|zsh|python|python3|flatpak|env|uwsm|uwsm-app|gio|gtk4-launch|xdg-terminal-exec|foot|alacritty|kitty|ghostty|wezterm|xterm|konsole|gnome-terminal|terminator|tilix)$/) continue
            exe = t
            break
          }
          casefold = tolower(exe)
          matches = casefold
          if (wm != "") matches = matches " " tolower(wm)
          gsub(/^ +/, "", matches)
          if (matches != "") print name "\t" matches "\t" raw
        }' "$f"
    done
  done | sort -u
}

# Saved list: current "|" format (names may contain spaces), falling back to the
# old space-separated one.
app_selected() {
  local name="$1"
  case "$CLOSE_APPS_LIST" in
    *"|"*) [[ "|$CLOSE_APPS_LIST|" == *"|$name|"* ]] ;;
    *)     [[ " $CLOSE_APPS_LIST " == *" $name "* ]] ;;
  esac
}

# Print "pid<TAB>app name" for each running menu app whose executable or WM
# class matches the catalog entry. The process is identified by /proc/<pid>/comm
# too, because pgrep -a prints the full argv (wrappers change argv[0]).
_running_menu_apps() {
  local catalog pid rest base comm name matches m
  catalog="$(app_catalog)"
  [[ -n $catalog ]] || return 0
  while read -r pid rest; do
    [[ -n $pid && -n $rest ]] || continue
    base="$(basename -- "${rest%% *}")"; base="${base,,}"
    comm="$(cat "/proc/$pid/comm" 2>/dev/null || true)"; comm="${comm,,}"
    while IFS=$'\t' read -r name matches _exec; do
      [[ -n $name ]] || continue
      for m in $matches; do
        if [[ $base == "${m,,}" || $comm == "${m,,}" ]]; then
          printf '%s\t%s\n' "$pid" "$name"
          break
        fi
      done
    done <<< "$catalog"
  done < <(pgrep -a -u "$REAL_USER" 2>/dev/null || true)
}

detect_background_apps() {
  # Names only (no pid), so the kill prompt reads cleanly.
  local selected pid name
  declare -A seen=()
  while IFS=$'\t' read -r pid name; do
    [[ -n $name ]] || continue
    app_selected "$name" || continue
    seen["$name"]=1
  done < <(_running_menu_apps)
  printf '%s\n' "${!seen[@]}" | sort
}

# The apps a session closed, in a form `off` can undo/relaunch them from. One
# line per app: "<unit|exec>\t<name>\t<command>". A systemd user unit is
# preferred (Superwhisper ships one, and starting it brings back the daemon AND
# its bar indicator); a plain desktop Exec is the fallback for apps started
# directly.
CLOSED_APPS_RECORD="$STATE_DIR/closed_apps"

app_exec() {
  # The desktop entry's Exec line, for the relaunch fallback.
  app_catalog | awk -F'\t' -v n="$1" '$1 == n { print $3; exit }'
}

# The systemd user unit a process belongs to, if any.
pid_unit() {
  sed -n 's|.*/\([^/]*\.service\)$|\1|p' "/proc/$1/cgroup" 2>/dev/null | head -n1
}

# True when a unit plausibly belongs to the app, never to the session around
# it. A process can live under the compositor's or the terminal's service
# (Superwhisper's shortcut bridge ran under wayland-wm@hyprland.desktop.service),
# and masking THAT would take the desktop down. Require the unit name to carry
# one of the app's own executable/WM-class tokens.
unit_matches_app() {
  local unit="${1,,}" name="$2" m
  [[ -n $unit ]] || return 1
  case $unit in
    user@*|wayland-wm*|graphical-session*|dbus*|pipewire*|wireplumber*) return 1 ;;
  esac
  for m in $(app_catalog | awk -F'\t' -v n="$name" '$1 == n { print $2; exit }'); do
    [[ -n $m ]] || continue
    [[ $unit == *"${m,,}"* ]] && return 0
  done
  return 1
}

# exec_of_app <name> — the desktop Exec with the menu field codes (%f, %U, …)
# stripped: they are placeholders the shell would have expanded, and running
# them literally opens a file named "%f".
exec_of_app() {
  local e
  e=$(app_exec "$1")
  printf '%s' "$e" | sed -E 's/%[fFuUdDnNickvm]//g; s/^ +| +$//g'
}

# App names closed by a session that died before `off` are still masked (a
# runtime mask under /run). Clear those before a new session reuses the record.
clear_stale_app_masks() {
  [[ -s $CLOSED_APPS_RECORD ]] || return 0
  local kind name cmd
  while IFS=$'\t' read -r kind name cmd; do
    [[ $kind == unit ]] && systemctl --user unmask --runtime "$cmd" >/dev/null 2>&1 || true
  done < "$CLOSED_APPS_RECORD"
  rm -f "$CLOSED_APPS_RECORD"
}

close_background_apps() {
  [[ $CLOSE_APPS == no ]] && return 0
  local list
  list=$(detect_background_apps)
  [[ -z "$list" ]] && return 0
  : > "$CLOSED_APPS_RECORD"
  local pid name unit e
  declare -A pids=() units=()
  while IFS=$'\t' read -r pid name; do
    [[ -n $pid && -n $name ]] || continue
    app_selected "$name" || continue
    case " ${pids[$name]:-} " in *" $pid "*) continue ;; esac
    pids["$name"]+="${pids[$name]:+ }$pid"
    if [[ -z ${units[$name]:-} ]]; then
      unit=$(pid_unit "$pid")
      if [[ -n $unit ]] && unit_matches_app "$unit" "$name"; then
        units["$name"]=$unit
      fi
    fi
  done < <(_running_menu_apps)
  for name in "${!pids[@]}"; do
    if [[ -n ${units[$name]:-} ]]; then
      # A plain kill is not enough for a supervised app: systemd brings
      # Superwhisper back two seconds later (Restart=on-failure). A RUNTIME
      # mask under /run keeps it down for the session; `off` always removes it.
      if systemctl --user mask --runtime --now "${units[$name]}" >/dev/null 2>&1 \
        || [[ $(systemctl --user is-enabled "${units[$name]}" 2>/dev/null) == masked* ]]; then
        printf 'unit\t%s\t%s\n' "$name" "${units[$name]}" >> "$CLOSED_APPS_RECORD"
        ok "Closed $name"
        continue
      fi
      warn "Could not stop ${units[$name]} — killing its processes instead"
    fi
    local closed=0
    for pid in ${pids[$name]}; do
      if kill "$pid" 2>/dev/null; then closed=1; fi
    done
    if (( closed )); then
      e=$(exec_of_app "$name")
      [[ -n $e ]] && printf 'exec\t%s\t%s\n' "$name" "$e" >> "$CLOSED_APPS_RECORD"
      ok "Closed $name"
    else
      warn "Could not close $name"
    fi
  done
  sleep 1
}

relaunch_closed_apps() {
  [[ -s $CLOSED_APPS_RECORD ]] || return 0
  local kind name cmd running
  running=$(detect_background_apps)
  while IFS=$'\t' read -r kind name cmd; do
    [[ -n $kind && -n $cmd ]] || continue
    case $kind in
      unit)
        # Always unmask: keeping a service masked is never the point of
        # closing it, whether or not the user asked for a relaunch.
        systemctl --user unmask --runtime "$cmd" >/dev/null 2>&1 || true
        [[ $RELAUNCH_APPS == yes ]] || continue
        systemctl --user is-active --quiet "$cmd" 2>/dev/null && continue
        if systemctl --user start "$cmd" >/dev/null 2>&1; then
          ok "Relaunched $name"
        else
          warn "Could not relaunch $name"
        fi
        ;;
      exec)
        [[ $RELAUNCH_APPS == yes ]] || continue
        grep -qxF "$name" <<< "$running" && continue
        if setsid --fork bash -c "$cmd" >/dev/null 2>&1; then
          ok "Relaunched $name"
        else
          warn "Could not relaunch $name"
        fi
        ;;
    esac
  done < "$CLOSED_APPS_RECORD"
  rm -f "$CLOSED_APPS_RECORD"
}

# ---------------------------------------------------------------------------
# Screen tint — live mode must NEVER show the warm/red caffeine tint
# ---------------------------------------------------------------------------

current_tint() {
  hyprctl hyprsunset temperature 2>/dev/null | grep -oE '[0-9]+' | head -n1 || true
}

neutralize_tint() {
  local cur
  cur=$(current_tint)
  # Only neutralize when a warm tint is actually applied (≠ 6500K identity).
  if [[ -n $cur && $cur != 6500 ]]; then
    echo "$cur" > "$STATE_DIR/tint_before"
    hyprctl hyprsunset temperature 6500 >/dev/null 2>&1 || true
    ok "Screen tint neutralized for the session."
  fi
}

restore_tint() {
  local saved
  saved=$(cat "$STATE_DIR/tint_before" 2>/dev/null || true)
  rm -f "$STATE_DIR/tint_before"
  if [[ -n $saved ]]; then
    hyprctl hyprsunset temperature "$saved" >/dev/null 2>&1 || true
    ok "Screen tint restored."
  fi
}

# ---------------------------------------------------------------------------
# Gaps
# ---------------------------------------------------------------------------

gaps_are_off() {
  [[ -f "$REAL_HOME/.local/state/omarchy/toggles/hypr/window-no-gaps.lua" ]]
}

# Gaps are restored by TOGGLING BACK, so the only thing that matters is
# remembering whether WE turned them off. Without that record, deactivation
# either leaves the desktop gapless forever or re-enables gaps the user had
# already turned off themselves. The flag is per-session state, so it is
# removed at the start of every activation (see snapshot_scratchpad's
# neighbours) and written only when the toggle actually fires.
toggle_gaps_off() {
  if ! gaps_are_off; then
    omarchy-hyprland-window-gaps-toggle >/dev/null 2>&1 || true
    # The flag means "gaps were ON before this session, so this session owes a
    # toggle back". It is CREATED here and consumed by toggle_gaps_on.
    touch "$GAPS_WERE_ON_FLAG"
    ok "Window gaps disabled (restored on exit)."
  else
    ok "Gaps already disabled — left as they were."
  fi
}

toggle_gaps_on() {
  # Only ever touches gaps this session removed. A user who already had no gaps
  # keeps no gaps after live mode, which is their own setting and not ours to
  # undo.
  [[ -f "$GAPS_WERE_ON_FLAG" ]] || return 0
  omarchy-hyprland-window-gaps-toggle >/dev/null 2>&1 || true
  rm -f "$GAPS_WERE_ON_FLAG"
  ok "Window gaps restored."
}

# ---------------------------------------------------------------------------
# Scratchpad helpers
# ---------------------------------------------------------------------------

# move_scratchpad_windows: the pre-live convention pushes windows whose title
# starts with "-scratch" onto the last empty workspace so they stop stealing
# focus during the session.
# hypr_dispatch <lua-expression> [classic-fallback] — run a Hyprland dispatcher.
#
# WHY THIS EXISTS. Every call in this file used the classic one-token syntax
# (`hyprctl dispatch movetoworkspacesilent "special:scratchpad,address:0x..."`).
# Hyprland 0.56 (this machine) no longer accepts it: the argument goes through a
# Lua parser, and "special:scratchpad" is a Lua SYNTAX ERROR because of the
# colon, so the call died with
#
#   error: [string "return hl.dispatch(movetoworkspacesilent spec..."]:1:
#          ')' expected near 'special'
#
# Every one of those calls was silenced with `>/dev/null 2>&1 || true`, so the
# patchbay simply never got parked and the scratchpad lifecycle did nothing
# while reporting nothing. The Lua form is
# `hl.dsp.window.move({ window = "address:0x..", workspace = "special:.." })`.
#
# The classic form is kept as a fallback so the script still works on an older
# Hyprland. Returns 0 when a dispatcher was accepted; never prints, never fatal.
hypr_dispatch() {
  local out
  command -v hyprctl >/dev/null 2>&1 || return 1
  out=$(hyprctl dispatch "$1" 2>&1) || true
  case "$out" in
    *error*|*unknown*|*"nil value"*|*"expected a dispatcher"*|*"window not found"*) ;;
    *) return 0 ;;
  esac
  [[ -n ${2:-} ]] || return 1
  out=$(hyprctl dispatch "$2" 2>&1) || true
  case "$out" in
    *error*|*unknown*|*"nil value"*|*"expected a dispatcher"*) return 1 ;;
  esac
  return 0
}

# park_in_scratchpad <address> — move one window to the scratchpad silently.
park_in_scratchpad() {
  local addr="$1"
  [[ -n $addr ]] || return 1
  hypr_dispatch \
    "hl.dsp.window.move({ window = \"address:$addr\", workspace = \"special:scratchpad\" })" \
    "movetoworkspacesilent special:scratchpad,address:$addr"
}

# tile_window <address> — force a patchbay window back into the tiling layout.
# mixbay carries a float+center window rule (its scratchpad variant), so
# without this the scratchpad showed a floating mixer on top of a tiled graph
# instead of the two side by side.
tile_window() {
  local addr="$1"
  [[ -n $addr ]] || return 1
  hypr_dispatch \
    "hl.dsp.window.float({ window = \"address:$addr\", action = \"off\" })" \
    "settiled address:$addr"
}

# close_window <address>
close_window() {
  local addr="$1"
  [[ -n $addr ]] || return 1
  hypr_dispatch \
    "hl.dsp.window.close({ window = \"address:$addr\" })" \
    "closewindow address:$addr"
}

move_scratchpad_windows() {
  local clients workspaces last_empty scratchpad_ids
  clients=$(hyprctl -j clients 2>/dev/null) || return 0
  workspaces=$(hyprctl -j workspaces 2>/dev/null) || return 0

  scratchpad_ids=$(echo "$clients" | jq -r '.[] | select(.title | startswith("-scratch")) | .address' 2>/dev/null) || return 0
  [[ -z "$scratchpad_ids" ]] && return 0

  last_empty=$(echo "$workspaces" | jq -r '.[].id' | sort -n | while read wid; do
    local count
    count=$(echo "$clients" | jq -r --argjson wid "$wid" '[.[] | select(.workspace.id == $wid)] | length' 2>/dev/null || echo "1")
    [[ "$count" == "0" ]] && { echo "$wid"; break; }
  done) || true

  [[ -z "$last_empty" ]] && { warn "No empty workspace for scratchpad windows."; return 0; }

  while IFS= read -r addr; do
    [[ -n "$addr" ]] && hypr_dispatch \
      "hl.dsp.window.move({ window = \"address:$addr\", workspace = \"$last_empty\" })" \
      "movetoworkspace $last_empty address:$addr" >/dev/null 2>&1 || true
  done <<< "$scratchpad_ids"
  ok "Scratchpad windows moved to workspace $last_empty."
}

# ---------------------------------------------------------------------------
# mosquito patchbay + scratchpad lifecycle
#
# The patchbay is the PipeWire routing surface, started by live mode and
# parked in Omarchy's scratchpad (SUPER + S to toggle). It is our own
# `mosquito-patchbay` when it is installed, qpwgraph until then.
# The scratchpad's pre-session contents are snapshotted so deactivation
# returns the workspace to exactly what it was before (a tool that was
# running before keeps running; nothing is left behind if the scratchpad
# was empty).
# ---------------------------------------------------------------------------

GAPS_WERE_ON_FLAG="$STATE_DIR/gaps_were_on"

SCRATCHPAD_SNAPSHOT="$STATE_DIR/scratchpad_before.json"
PATCHBAY_ADDR_FILE="$STATE_DIR/patchbay_addr"
PATCHBAY_PREEXISTED="$STATE_DIR/patchbay_preexisting"
PATCHBAY_CLOSED_FLAG="$STATE_DIR/patchbay_closed_this_session"

special_clients() {
  # Lists scratchpad clients as "address|class|initial_title|pid".
  hyprctl -j clients 2>/dev/null | jq -r '
    .[] | select(.workspace.name == "scratchpad")
    | "\(.address)|\(.class)|\(.initialTitle // .title)|\(.pid)"' 2>/dev/null
}

# mosquito patchbay — WHICH commands provide it.
#
# The PATCHBAY_APP setting (Live Mode Manager settings, default
# mixbay+qpwgraph) names the preference: mosquito-mixbay (the mosquito USB
# audio bay, the session's desk tool) plus qpwgraph (the PipeWire graph),
# either one alone, or mosquito-patchbay (the future native routing surface).
# The setting is a preference, not a hard requirement: a choice that is not
# installed falls through to whatever IS, in the old priority order, and a
# machine with nothing installed is told how to get it.
#
# Echoes one "<command>|<class-regex>" line per provider: the launcher and
# the window-class matcher differ per provider, and a provider whose window
# cannot be recognised is worse than none at all (it would be launched and
# never parked).
patchbay_have_mixbay() {
  [[ -x $REAL_HOME/.local/bin/mosquito-mixbay ]] \
    || command -v mosquito-mixbay >/dev/null 2>&1
}
patchbay_have_qpwgraph() {
  command -v qpwgraph >/dev/null 2>&1
}
patchbay_have_native() {
  local bin
  for bin in "$REAL_HOME/.local/bin/mosquito-patchbay" "$REAL_HOME/.local/bin/mosquito-patchbay.sh"; do
    [[ -x $bin ]] && return 0
  done
  command -v mosquito-patchbay >/dev/null 2>&1
}
patchbay_specs() {
  local choice="${PATCHBAY_APP:-mixbay+qpwgraph}"
  case $choice in
    mixbay+qpwgraph)
      patchbay_have_mixbay && printf 'mosquito-mixbay|org\.omarchy\.mosquito-mixbay-tui\n'
      patchbay_have_qpwgraph && printf 'qpwgraph|qpwgraph|org\.rncbc\.qpwgraph|org\.pq_graph\.Qpwgraph\n'
      return 0 ;;
    mixbay)
      if patchbay_have_mixbay; then
        printf 'mosquito-mixbay|org\.omarchy\.mosquito-mixbay-tui\n'; return 0
      fi ;;
    qpwgraph)
      if patchbay_have_qpwgraph; then
        printf 'qpwgraph|qpwgraph|org\.rncbc\.qpwgraph|org\.pq_graph\.Qpwgraph\n'; return 0
      fi ;;
    mosquito-patchbay)
      if patchbay_have_native; then
        printf 'mosquito-patchbay|mosquito[_-]?patchbay\n'; return 0
      fi ;;
  esac
  # The choice is not installed: fall back to whatever is, native first.
  if patchbay_have_native; then
    printf 'mosquito-patchbay|mosquito[_-]?patchbay\n'; return 0
  fi
  if patchbay_have_mixbay; then
    printf 'mosquito-mixbay|org\.omarchy\.mosquito-mixbay-tui\n'; return 0
  fi
  if patchbay_have_qpwgraph; then
    printf 'qpwgraph|qpwgraph|org\.rncbc\.qpwgraph|org\.pq_graph\.Qpwgraph\n'; return 0
  fi
  return 1
}
# patchbay_provider — the first spec, for call sites that only need one.
# Prefer patchbay_specs when the combo can yield two.
patchbay_provider() {
  local first
  first="$(patchbay_specs | head -n 1)"
  [[ -n $first ]] || return 1
  printf '%s\n' "$first"
}

# patchbay_install_hint — what to run when neither provider is installed.
patchbay_install_hint() {
  printf 'run the mixbay module (Setup > mosquito), or pacman -S qpwgraph as fallback'
}

patchbay_addr() {
  # Addresses of the running patchbay windows (any workspace), one per line,
  # empty if none. The class list is built from every active provider, so a
  # mixbay+qpwgraph combo matches both windows.
  local spec re combined=""
  while IFS= read -r spec; do
    [[ -n $spec ]] || continue
    re="${spec#*|}"
    combined+="${combined:+|}$re"
  done < <(patchbay_specs 2>/dev/null)
  [[ -n $combined ]] || return 0
  hyprctl -j clients 2>/dev/null | jq -r --arg re "^($combined)$" '
    .[] | select((.class // "") | test($re)) | .address' 2>/dev/null
}

# Backwards-compatible alias: qpwgraph was the only provider for a long time,
# and live-mode-watch referenced the old name.
qpwgraph_addr() { patchbay_addr; }

# The commands that launch the patchbay providers for the current choice.
patchbay_launch() {
  local spec bin launched=0
  while IFS= read -r spec; do
    [[ -n $spec ]] || continue
    bin="${spec%%|*}"
    if setsid --fork uwsm-app -- "$bin" >/dev/null 2>&1 || setsid --fork "$bin" >/dev/null 2>&1; then
      launched=1
    fi
  done < <(patchbay_specs) || true
  (( launched )) || return 1
}

snapshot_scratchpad() {
  : > "$PATCHBAY_ADDR_FILE"
  # rm, NOT `: >`. This flag means "the user closed the patchbay for THIS
  # session" and the watchdog sets it only after asking. Truncating it CREATED
  # an empty file, and every check for it is `[[ -f ... ]]` — so the flag read
  # as "already closed" at the very start of every single activation.
  # open_routing_tool() then returned 2 (skipped) before it ever looked for
  # qpwgraph, the patchbay was never launched or parked, and nothing was
  # printed: the feature was dead on every run and silent about it.
  rm -f "$PATCHBAY_CLOSED_FLAG"
  rm -f "$PATCHBAY_PREEXISTED"
  # Per-session state: a previous session that died without restoring must not
  # make this one think it owes a gap toggle — same for the power-profile
  # question, which re-arms every session — nor relaunch apps it never closed.
  rm -f "$GAPS_WERE_ON_FLAG" "$STATE_DIR/profile_asked" "$CLOSED_APPS_RECORD"
  special_clients > "$SCRATCHPAD_SNAPSHOT"
}

# scratchpad_occupied_by_others: reports the class|initialTitle lines of
# scratchpad clients other than the patchbay itself (so a provider's own
# window already there does not count as "occupied"). Matched against the
# CURRENT providers' class regexes, so a mixbay parked by an earlier session
# is recognised just like qpwgraph is.
scratchpad_occupied_by_others() {
  local spec re combined=""
  while IFS= read -r spec; do
    [[ -n $spec ]] || continue
    re="${spec#*|}"
    combined+="${combined:+|}$re"
  done < <(patchbay_specs 2>/dev/null || true)
  local line
  while IFS= read -r line; do
    [[ -z $line ]] && continue
    local addr class init_title pid
    IFS='|' read -r addr class init_title pid <<< "$line"
    if [[ -n $combined ]] && printf '%s' "$class" | grep -Eq "^(${combined})$" 2>/dev/null; then
      continue
    fi
    printf "%s\n" "$class"
  done < <(special_clients)
}

open_patchbay() {
  # Returns 0 = patched (parked in scratchpad or opened in current
  # workspace after user consent), 1 = user refused (activation must abort),
  # 2 = skipped (config disabled / no provider installed / not needed).
  [[ $ROUTING_TOOL == no ]] && return 2

  # Already parked in the scratchpad under this session → nothing to do.
  local existing addr all_pre=1
  existing=$(patchbay_addr)
  if [[ -n "$existing" ]]; then
    : > "$PATCHBAY_ADDR_FILE"
    while IFS= read -r addr; do
      [[ -n $addr ]] || continue
      tile_window "$addr" >/dev/null 2>&1 || true
      if grep -qF "$addr" "$SCRATCHPAD_SNAPSHOT" 2>/dev/null; then
        printf '%s\n' "$addr" >> "$PATCHBAY_ADDR_FILE"
      else
        park_in_scratchpad "$addr" >/dev/null 2>&1 || true
        printf '%s\n' "$addr" >> "$PATCHBAY_ADDR_FILE"
        all_pre=0
      fi
    done <<< "$existing"
    if (( all_pre )); then
      touch "$PATCHBAY_PREEXISTED"
      ok "Scratchpad audio app already parked in the scratchpad."
    else
      ok "Scratchpad audio app parked in the scratchpad (SUPER + S)."
    fi
    return 0
  fi

  # The user closed the patchbay during a PREVIOUS session and asked not to be
  # bothered again: honour that, but only if the flag actually carries content.
  # Existence alone used to mean "closed", which is the bug above.
  if [[ -s "$PATCHBAY_CLOSED_FLAG" ]]; then
    return 2
  fi
  if ! patchbay_specs >/dev/null 2>&1 || [[ -z $(patchbay_specs 2>/dev/null) ]]; then
    # No provider installed. Say so and say how to fix it: a silently missing
    # patchbay reads as "live mode just does not do that any more".
    warn "No scratchpad audio app available — the scratchpad step is skipped."
    warn "  Install one with: $(patchbay_install_hint)"
    return 2
  fi

  # The scratchpad may already hold another app (a chat, a music player, a
  # scratch terminal…) → ask the user BEFORE moving anything there. The apps
  # open in the current workspace instead, on accept; refuse → the caller
  # aborts the whole activation.
  local occupants=""
  occupants=$(scratchpad_occupied_by_others | sort -u | tr '\n' ' ')
  if [[ -n "$occupants" ]]; then
    if ! confirm $"The scratchpad is already occupied (the scratchpad audio apps can't be parked there). They will open in the CURRENT workspace. Continue?"; then
      warn "Live Mode activation cancelled (scratchpad occupied)."
      return 1
    fi
    ok "Opening the scratchpad audio apps in the current workspace (scratchpad kept as-is)."
  fi

  local spec names=""
  while IFS= read -r spec; do
    [[ -n $spec ]] || continue
    names+="${names:+, }${spec%%|*}"
  done < <(patchbay_specs)
  ok "Scratchpad audio: launching $names."
  patchbay_launch

  # Qt apps map their windows AFTER the process is up, and on a loaded
  # machine that took longer than 6 s here, so the loop gave up and reported
  # "could not be detected" for a patchbay that was about to appear. 20 x
  # 0.3s was simply too short. It is now 15 s, and the address is recorded
  # as soon as it shows up so the rest of the session has it.
  local want i found=0
  want=$(patchbay_specs 2>/dev/null | grep -c .)
  for i in $(seq 1 50); do
    sleep 0.3
    existing=$(patchbay_addr)
    found=$(printf '%s' "$existing" | grep -c . || true)
    (( found >= want )) && break
  done

  if [[ -n "$existing" ]]; then
    : > "$PATCHBAY_ADDR_FILE"
    while IFS= read -r addr; do
      [[ -n $addr ]] || continue
      printf '%s\n' "$addr" >> "$PATCHBAY_ADDR_FILE"
      # Both providers are tiled, never floating: a floating mixbay over a
      # tiled graph was the scratchpad the user was actually getting.
      tile_window "$addr" >/dev/null 2>&1 || true
      # Park it only if the scratchpad is free (no occupants).
      if [[ -z $(scratchpad_occupied_by_others) ]]; then
        park_in_scratchpad "$addr" >/dev/null 2>&1 || true
      fi
    done <<< "$existing"
    if [[ -z $(scratchpad_occupied_by_others) ]]; then
      ok "Scratchpad audio apps parked in the scratchpad (SUPER + S)."
    else
      ok "Scratchpad audio apps opened in the current workspace (scratchpad left as it was)."
    fi
  else
    warn "$names launched, but no window could be detected."
  fi
  return 0
}

# restore_scratchpad: at deactivation, remove what live mode added and put
# back what was there before. A patchbay already there is left alone; ones
# the session spawned are closed so an empty scratchpad returns empty.
restore_scratchpad() {
  local ours
  while IFS= read -r ours; do
    [[ -n $ours ]] || continue
    if ! grep -qF "$ours" "$SCRATCHPAD_SNAPSHOT" 2>/dev/null; then
      hyprctl -j clients 2>/dev/null | jq -e --arg a "$ours" \
        'map(select(.address == $a)) | length > 0' >/dev/null 2>&1 && {
        close_window "$ours" >/dev/null 2>&1 || true
        ok "Session's scratchpad audio app closed (scratchpad back to its pre-live state)."
      }
    fi
  done < "$PATCHBAY_ADDR_FILE" 2>/dev/null || true
  : > "$PATCHBAY_ADDR_FILE"; : > "$SCRATCHPAD_SNAPSHOT"; rm -f "$PATCHBAY_CLOSED_FLAG"
}


# ---------------------------------------------------------------------------
# Notifications DND
#
# Omarchy keeps the do-not-disturb state in
# ~/.local/state/omarchy/notifications/quiet.json and exposes
# `notifications isDnd` / `setDnd` on the shell IPC. This module used to read
# and write the LEGACY ~/.local/state/omarchy/notifications.json, which the
# current shell never touches: the guard therefore always saw "off" and
# toggled DND on every pass — twice a second — which is the blinking icon.
# The pre-session state is recorded so `off` can put DND back where it was.
# ---------------------------------------------------------------------------

DND_STATE_FILE="$REAL_HOME/.local/state/omarchy/notifications/quiet.json"
DND_PREV_FILE="$STATE_DIR/dnd_before"

dnd_is_on() {
  local v
  v=$(omarchy-shell notifications isDnd 2>/dev/null || true)
  case "$v" in
    on) return 0 ;;
    off) return 1 ;;
  esac
  [[ -f $DND_STATE_FILE ]] && jq -e '.dnd == true' "$DND_STATE_FILE" >/dev/null 2>&1
}

# dnd_write <on|off> — last resort when the IPC is unavailable: write the
# state file the shell reads, keeping the other keys quiet.json carries.
dnd_write() {
  local want="$1" val tmp
  [[ -f $DND_STATE_FILE ]] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  [[ $want == on ]] && val=true || val=false
  tmp=$(mktemp "${DND_STATE_FILE}.XXXXXX" 2>/dev/null) || return 0
  if jq --argjson v "$val" '.dnd = $v' "$DND_STATE_FILE" > "$tmp" 2>/dev/null; then
    mv -f "$tmp" "$DND_STATE_FILE" && return 0
  fi
  rm -f "$tmp"
}

# dnd_set <on|off> — idempotent through the shell IPC. The old code called the
# TOGGLE command, so a guard that ran while the state it expected was not
# visible flipped DND on and off continuously.
dnd_set() {
  local want="$1" cur
  cur=$(omarchy-shell notifications setDnd "$want" 2>/dev/null || true)
  [[ $cur == "$want" ]] && return 0
  omarchy-toggle-notification-silencing >/dev/null 2>&1 || true
  [[ $want == on ]] && dnd_is_on && return 0
  [[ $want == off ]] && ! dnd_is_on && return 0
  dnd_write "$want"
}

save_dnd_state() {
  dnd_is_on && echo on > "$DND_PREV_FILE" || echo off > "$DND_PREV_FILE"
}

# FORCE DND ON for the session. The watchdog re-asserts it on its own fast
# loop, so the only way out of DND is to end live mode, which is the point.
force_dnd_on() {
  [[ $SILENCE_NOTIFICATIONS == no ]] && return 0
  save_dnd_state
  dnd_is_on && return 0
  dnd_set on
  ok "Notifications silenced (forced for the whole session)."
}

# Put back the state the session found. Only a pre-session "off" needs
# undoing: forcing DND on is ours, leaving an already-on DND on is the user's
# own setting.
restore_dnd_state() {
  if [[ $SILENCE_NOTIFICATIONS == no ]]; then
    rm -f "$DND_PREV_FILE"
    return 0
  fi
  local prev
  prev=$(cat "$DND_PREV_FILE" 2>/dev/null || true)
  rm -f "$DND_PREV_FILE"
  [[ $prev == off ]] && dnd_set off
  return 0
}

# ---------------------------------------------------------------------------
# PipeWire settings widget
#
# When the pipewire-settings module is installed, its backend owns the graph's
# rate/quantum. Live mode puts it in live mode: the values are frozen (forced)
# for the session and the persisted config is set aside, so the bar widget can
# lock its controls and nothing writes a new "remember on restart" file behind
# the session's back. `off` restores both states.
# ---------------------------------------------------------------------------
pipewire_live_on() {
  [[ -x $PIPEWIRE_SETTINGS ]] || return 0
  "$PIPEWIRE_SETTINGS" live-on >/dev/null 2>&1 || warn "PipeWire settings: live mode could not be applied."
}

pipewire_live_off() {
  [[ -x $PIPEWIRE_SETTINGS ]] || return 0
  "$PIPEWIRE_SETTINGS" live-off >/dev/null 2>&1 || warn "PipeWire settings: pre-live state could not be restored."
}

# ---------------------------------------------------------------------------
# Sleep management — replicated from mega-caffeine, under live mode's name
#
# • systemd-inhibit blocks the lid from suspending (computer stays on with
#   the lid closed).
# • The stay-awake indicator file is forced on and restored afterwards, so
#   the bar shows the red coffee icon with the "Live Mode ON" tooltip.
# • No tint, no toast, no duration prompt — that is regular mega-caffeine
#   behaviour, which live mode must not trigger.
# ---------------------------------------------------------------------------

STAYAWAKE_FILE="$REAL_HOME/.local/state/omarchy/indicators/stay-awake"
STAYAWAKE_PREV_FILE="$CAFFEINE_STATE_DIR/stayawake_prev"
INHIBIT_PID_FILE="$CAFFEINE_STATE_DIR/inhibit.pid"

stayawake_state() { [[ -f "$STAYAWAKE_FILE" ]] && echo on || echo off; }

apply_stayawake() {
  local cur
  cur=$(stayawake_state)
  [[ $cur == "$1" ]] && return 0
  if [[ $1 == on ]]; then
    mkdir -p "$(dirname "$STAYAWAKE_FILE")"
    touch "$STAYAWAKE_FILE"
  else
    rm -f "$STAYAWAKE_FILE"
  fi
}

start_sleep_management() {
  # If a regular mega-caffeine session is running, end it first — its tint
  # and its own stay-awake bookkeeping would fight this session.
  if "$MEGA_CAFFEINE" --status 2>/dev/null | grep -q '"enabled":true'; then
    CAFFEINE_LIVE_FORCE_OFF=1 "$MEGA_CAFFEINE" off >/dev/null 2>&1 || true
    ok "Running mega-caffeine session ended (live mode manages sleep itself)."
  fi

  setsid --fork systemd-inhibit --what=handle-lid-switch:sleep \
    --who="Live mode" \
    --why="Live mode: lid closed without sleeping" \
    sleep infinity >/dev/null 2>&1 &
  echo $! > "$INHIBIT_PID_FILE"

  if [[ ! -f "$STAYAWAKE_PREV_FILE" ]]; then
    mkdir -p "$CAFFEINE_STATE_DIR"
    stayawake_state > "$STAYAWAKE_PREV_FILE"
  fi
  apply_stayawake on
  ok "Stays awake — closing the lid no longer suspends."
}

stop_sleep_management() {
  pkill -f "[s]ystemd-inhibit --what=handle-lid-switch:sleep" >/dev/null 2>&1 || true
  local pid
  pid=$(cat "$INHIBIT_PID_FILE" 2>/dev/null || true)
  [[ -n "$pid" ]] && kill "$pid" 2>/dev/null || true
  rm -f "$INHIBIT_PID_FILE"
  local prev
  prev=$(cat "$STAYAWAKE_PREV_FILE" 2>/dev/null || echo off)
  rm -f "$STAYAWAKE_PREV_FILE"
  apply_stayawake "$prev"

  # Mega caffeine must not survive the live session either.
  if "$MEGA_CAFFEINE" --status 2>/dev/null | grep -q '"enabled":true'; then
    CAFFEINE_LIVE_FORCE_OFF=1 "$MEGA_CAFFEINE" off >/dev/null 2>&1 || true
  fi
}

