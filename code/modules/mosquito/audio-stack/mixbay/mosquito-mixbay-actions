#!/usr/bin/env bash
# mosquito-mixbay-actions — non-interactive backend for scripts & live-mode.
#
# Thin passthrough to the mosquito-mixbay-tui binary's CLI modes (see
# tui-go/cli.go, which owns the full list: devices-json, status-json, set,
# mixer, save/load, reset-defaults, profiles-*, cards-connected-json,
# patchbay-*). Stable name so hooks never depend on the TUI binary name.
#
#   mosquito-mixbay-actions --help      # the authoritative command list
#   mosquito-mixbay-actions status-json [--device evo8]
#   mosquito-mixbay-actions set volume -20 [--device evo8]
#   mosquito-mixbay-actions mixer input1 --volume -6 --pan 0
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$DIR/mosquito-mixbay-tui" "$@"
