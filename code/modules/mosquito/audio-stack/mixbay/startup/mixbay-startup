#!/usr/bin/env bash
# =============================================================================
# mixbay-startup — login autostart and scratchpad launch for Mixbay
# =============================================================================
# Two independent preferences in ~/.config/mosquitomixbay/ui.json:
#   launch_at_startup   (default true)  → add/remove the Hyprland autostart line
#   launch_in_scratchpad(default true)  → park the TUI in special:scratchpad
#
# Usage:
#   mixbay-startup --apply   # sync the autostart line with ui.json
#   mixbay-startup --run     # launched by Hyprland at login
#   mixbay-startup --place   # park/unpark the running TUI from ui.json
# =============================================================================
set -euo pipefail

HOME_DIR="${HOME}"
CONF="${XDG_CONFIG_HOME:-$HOME_DIR/.config}"
UI="$CONF/mosquitomixbay/ui.json"
AUTOSTART="$CONF/hypr/autostart.lua"
BIN="$HOME_DIR/.local/bin/mixbay-startup"
START="-- >>> mosquitOmarchy mixbay autostart"
END="-- <<< mosquitOmarchy mixbay autostart"

pref(){
  local key="$1" def="$2"
  if [[ -f $UI ]] && command -v jq >/dev/null 2>&1; then
    jq -r --arg k "$key" --arg d "$def" 'if has($k) then (.[$k]|tostring) else $d end' "$UI"
  else
    printf '%s\n' "$def"
  fi
}

remove_block(){
  [[ -f $AUTOSTART ]] || return 0
  local tmp; tmp="$(mktemp)"
  awk -v start="$START" -v end="$END" '
    $0 == start { skip=1; next }
    $0 == end   { skip=0; next }
    !skip       { print }
  ' "$AUTOSTART" > "$tmp"
  mv "$tmp" "$AUTOSTART"
}

apply(){
  local on; on="$(pref launch_at_startup true)"
  mkdir -p "$(dirname "$AUTOSTART")"
  touch "$AUTOSTART"
  remove_block
  if [[ $on == true ]]; then
    {
      printf '%s\n' "$START"
      printf 'o.launch_on_start("%s --run")\n' "$BIN"
      printf '%s\n' "$END"
    } >> "$AUTOSTART"
    printf 'autostart: on\n'
  else
    printf 'autostart: off\n'
  fi
}

# Window classes: the TUI and its scratchpad variant. Both are Mixbay windows;
# matching the prefix means a window launched with the other app-id still gets
# parked (turning "launch in scratchpad" on must move the window already open).
window_addrs(){
  command -v hyprctl >/dev/null 2>&1 || return 0
  hyprctl clients -j 2>/dev/null | jq -r '
    .[] | select(((.class // "") | startswith("org.omarchy.mosquito-mixbay")))
    | .address' 2>/dev/null || true
}

# hypr_move <address> <workspace> — Lua dispatcher first, classic fallback.
hypr_move(){
  local addr="$1" ws="$2"
  hyprctl dispatch "hl.dsp.window.move({ window = \"address:$addr\", workspace = \"$ws\" })" >/dev/null 2>&1 \
    || hyprctl dispatch "movetoworkspacesilent $ws,address:$addr" >/dev/null 2>&1 \
    || true
}

place(){
  local addrs scratch ws
  addrs="$(window_addrs)"
  [[ -n $addrs ]] || return 0
  scratch="$(pref launch_in_scratchpad true)"
  if [[ $scratch == true ]]; then
    while IFS= read -r addr; do
      [[ -n $addr ]] && hypr_move "$addr" "special:scratchpad"
    done <<< "$addrs"
    return 0
  fi
  ws="$(hyprctl workspaces -j 2>/dev/null | jq -r '[.[]|select(.id > 0)]|sort_by(.id)|.[0].id // 1' 2>/dev/null || echo 1)"
  while IFS= read -r addr; do
    [[ -n $addr ]] && hypr_move "$addr" "$ws"
  done <<< "$addrs"
}

run(){
  [[ "$(pref launch_at_startup true)" == true ]] || exit 0
  # Already open (toggled settings, or autostart raced a manual launch): park
  # or unpark the live window instead of spawning a duplicate.
  if [[ -n "$(window_addrs)" ]]; then place; exit 0; fi
  local scratch; scratch="$(pref launch_in_scratchpad true)"
  local term app
  if command -v foot >/dev/null 2>&1; then term=foot; else term=xterm; fi
  command -v "$term" >/dev/null 2>&1 || exit 0
  if [[ $scratch == true ]]; then
    app="org.omarchy.mosquito-mixbay-scratchpad"
  else
    app="org.omarchy.mosquito-mixbay-tui"
  fi
  if [[ $term == foot ]]; then
    "$term" --app-id="$app" -e "$HOME_DIR/.local/bin/mosquito-mixbay-tui" >/dev/null 2>&1 &
  else
    "$term" -e "$HOME_DIR/.local/bin/mosquito-mixbay-tui" >/dev/null 2>&1 &
  fi
  # Wait for Hyprland to map the window: at login hyprctl can lag the exec by
  # several seconds on a cold session.
  local i
  for i in $(seq 1 60); do
    sleep 0.25
    [[ -n "$(window_addrs)" ]] && break
  done
  place
}

case "${1:-}" in
  --apply) apply ;;
  --run) run ;;
  --place) place ;;
  --remove) remove_block; printf 'autostart: off\n' ;;
  -h|--help) sed -n '2,17p' "$0" ;;
  *) printf 'usage: %s --apply|--run|--place|--remove\n' "$0" >&2; exit 2 ;;
esac
