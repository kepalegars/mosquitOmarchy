#!/usr/bin/env bash
# =============================================================================
# mixbay-startup — login autostart and scratchpad launch for Mixbay
# =============================================================================
# Two independent preferences in ~/.config/mosquitomixbay/ui.json:
#   launch_at_startup   (default true)  → add/remove the Hyprland autostart line
#   launch_in_scratchpad(default true)  → park the TUI in special:scratchpad
#
# Usage:
#   mixbay-startup --apply   # sync the autostart line with ui.json
#   mixbay-startup --run     # launched by Hyprland at login
#   mixbay-startup --open    # launched by the Omarchy menu (reveals the window)
#   mixbay-startup --place   # park/unpark the running TUI from ui.json
#   mixbay-startup --external CMD  # launch an external GUI and place the windows
# =============================================================================
set -euo pipefail

HOME_DIR="${HOME}"
CONF="${XDG_CONFIG_HOME:-$HOME_DIR/.config}"
UI="$CONF/mosquitomixbay/ui.json"
AUTOSTART="$CONF/hypr/autostart.lua"
BIN="$HOME_DIR/.local/bin/mixbay-startup"
START="-- >>> mosquitOmarchy mixbay autostart"
END="-- <<< mosquitOmarchy mixbay autostart"

pref(){
  local key="$1" def="$2"
  if [[ -f $UI ]] && command -v jq >/dev/null 2>&1; then
    jq -r --arg k "$key" --arg d "$def" 'if has($k) then (.[$k]|tostring) else $d end' "$UI"
  else
    printf '%s\n' "$def"
  fi
}

remove_block(){
  [[ -f $AUTOSTART ]] || return 0
  local tmp; tmp="$(mktemp)"
  awk -v start="$START" -v end="$END" '
    $0 == start { skip=1; next }
    $0 == end   { skip=0; next }
    !skip       { print }
  ' "$AUTOSTART" > "$tmp"
  mv "$tmp" "$AUTOSTART"
}

apply(){
  local on; on="$(pref launch_at_startup true)"
  mkdir -p "$(dirname "$AUTOSTART")"
  touch "$AUTOSTART"
  remove_block
  if [[ $on == true ]]; then
    {
      printf '%s\n' "$START"
      printf 'o.launch_on_start("%s --run")\n' "$BIN"
      printf '%s\n' "$END"
    } >> "$AUTOSTART"
    printf 'autostart: on\n'
  else
    printf 'autostart: off\n'
  fi
}

# Window classes: the TUI and its scratchpad variant. Both are Mixbay windows;
# matching the prefix means a window launched with the other app-id still gets
# parked (turning "launch in scratchpad" on must move the window already open).
window_addrs(){
  command -v hyprctl >/dev/null 2>&1 || return 0
  hyprctl clients -j 2>/dev/null | jq -r '
    .[] | select(((.class // "") | startswith("org.omarchy.mosquito-mixbay")))
    | .address' 2>/dev/null || true
}

# hypr_move <address> <workspace> — Lua dispatcher first, classic fallback.
hypr_move(){
  local addr="$1" ws="$2"
  hyprctl dispatch "hl.dsp.window.move({ window = \"address:$addr\", workspace = \"$ws\" })" >/dev/null 2>&1 \
    || hyprctl dispatch "movetoworkspacesilent $ws,address:$addr" >/dev/null 2>&1 \
    || true
}

place(){
  local addrs scratch ws
  addrs="$(window_addrs)"
  [[ -n $addrs ]] || return 0
  scratch="$(pref launch_in_scratchpad true)"
  if [[ $scratch == true ]]; then
    while IFS= read -r addr; do
      [[ -n $addr ]] && hypr_move "$addr" "special:scratchpad"
    done <<< "$addrs"
    return 0
  fi
  ws="$(hyprctl workspaces -j 2>/dev/null | jq -r '[.[]|select(.id > 0)]|sort_by(.id)|.[0].id // 1' 2>/dev/null || echo 1)"
  while IFS= read -r addr; do
    [[ -n $addr ]] && hypr_move "$addr" "$ws"
  done <<< "$addrs"
}

spawn(){
  local scratch; scratch="$(pref launch_in_scratchpad true)"
  local term app
  if command -v foot >/dev/null 2>&1; then term=foot; else term=xterm; fi
  command -v "$term" >/dev/null 2>&1 || exit 0
  if [[ $scratch == true ]]; then
    app="org.omarchy.mosquito-mixbay-scratchpad"
  else
    app="org.omarchy.mosquito-mixbay-tui"
  fi
  if [[ $term == foot ]]; then
    "$term" --app-id="$app" -e "$HOME_DIR/.local/bin/mosquito-mixbay" >/dev/null 2>&1 &
  else
    "$term" -e "$HOME_DIR/.local/bin/mosquito-mixbay" >/dev/null 2>&1 &
  fi
  # Wait for Hyprland to map the window: at login hyprctl can lag the exec by
  # several seconds on a cold session.
  local i
  for i in $(seq 1 60); do
    sleep 0.25
    [[ -n "$(window_addrs)" ]] && break
  done
  place
}

run(){
  [[ "$(pref launch_at_startup true)" == true ]] || exit 0
  # Already open (toggled settings, or autostart raced a manual launch): park
  # or unpark the live window instead of spawning a duplicate.
  if [[ -n "$(window_addrs)" ]]; then place; exit 0; fi
  spawn
}

# open: what the Omarchy menu calls. Unlike --run it ignores the autostart
# preference, respects launch_in_scratchpad, and reveals the window.
open_mixbay(){
  if [[ -n "$(window_addrs)" ]]; then place; else spawn; fi
  # Let the async move land before asking which special workspace is shown;
  # otherwise the freshly moved window is still hidden and the toggle below
  # can flip an already-open scratchpad shut.
  sleep 0.4
  local addr scratch special
  addr="$(window_addrs | head -1)"
  [[ -n $addr ]] || exit 0
  scratch="$(pref launch_in_scratchpad true)"
  if [[ $scratch == true ]]; then
    special="$(hyprctl monitors -j 2>/dev/null | jq -r '[.[]|select(.specialWorkspace.name=="special:scratchpad")]|length' 2>/dev/null || echo 0)"
    if [[ ${special:-0} == 0 ]]; then
      hyprctl dispatch 'hl.dsp.workspace.toggle_special("scratchpad")' >/dev/null 2>&1 || true
    fi
  fi
  hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1 || true
}

# --- external GUIs (oscmix GTK/Qt, web app) ----------------------------------
# With handle_external_windows on (default), Mixbay decides where the mixer
# goes: if the TUI is in the scratchpad, the new window takes the lowest empty
# workspace and keeps the focus; otherwise it tiles normally and Mixbay parks
# itself in the scratchpad, without stealing the focus, with a notification
# saying which shortcut brings it back.

all_addrs(){
  command -v hyprctl >/dev/null 2>&1 || return 0
  hyprctl clients -j 2>/dev/null | jq -r '.[].address' 2>/dev/null || true
}

on_scratchpad(){
  command -v hyprctl >/dev/null 2>&1 || return 1
  hyprctl clients -j 2>/dev/null | jq -e --arg a "$1" \
    'any(.[]; .address == $a and ((.workspace.name // "") == "special:scratchpad"))' \
    >/dev/null 2>&1
}

# empty_workspace — lowest positive workspace with no window on it.
empty_workspace(){
  local occupied n
  occupied="$(hyprctl clients -j 2>/dev/null | jq -r '.[].workspace.id' 2>/dev/null || true)"
  for n in $(seq 1 50); do
    grep -qx -- "$n" <<<"$occupied" || { printf '%s\n' "$n"; return 0; }
  done
  printf '1\n'
}

# new_window <addresses-before> — the first address that was not there before,
# polled for 10s so a slow GTK/Chromium start still counts.
new_window(){
  local before="$1" i a
  for i in $(seq 1 40); do
    sleep 0.25
    while IFS= read -r a; do
      [[ -n $a ]] || continue
      grep -qxF -- "$a" <<<"$before" || { printf '%s\n' "$a"; return 0; }
    done < <(all_addrs)
  done
  return 1
}

external(){
  local cmd="$1" handle before addr new ws
  shift
  handle="$(pref handle_external_windows true)"
  before="$(all_addrs)"
  if command -v setsid >/dev/null 2>&1; then
    setsid "$cmd" "$@" >/dev/null 2>&1 &
  else
    "$cmd" "$@" >/dev/null 2>&1 &
  fi
  [[ $handle == true ]] || exit 0
  command -v hyprctl >/dev/null 2>&1 || exit 0
  addr="$(window_addrs | head -1)"
  [[ -n $addr ]] || exit 0
  new="$(new_window "$before")" || exit 0
  if on_scratchpad "$addr"; then
    ws="$(empty_workspace)"
    hyprctl dispatch "hl.dsp.window.move({ window = \"address:$new\", workspace = \"$ws\" })" >/dev/null 2>&1 \
      || hyprctl dispatch "movetoworkspace $ws,address:$new" >/dev/null 2>&1 || true
    hyprctl dispatch "workspace $ws" >/dev/null 2>&1 || true
    hyprctl dispatch focuswindow "address:$new" >/dev/null 2>&1 || true
  else
    # Silent on purpose: the external window must keep the focus.
    hypr_move "$addr" "special:scratchpad"
    command -v notify-send >/dev/null 2>&1 \
      && notify-send "Mixbay" "Moved to the scratchpad — SUPER + S to bring it back" \
      || true
  fi
}

case "${1:-}" in
  --apply) apply ;;
  --run) run ;;
  --open) open_mixbay ;;
  --place) place ;;
  --external) shift; [[ $# -ge 1 ]] || { printf 'usage: %s --external CMD [args...]\n' "$0" >&2; exit 2; }; external "$@" ;;
  --remove) remove_block; printf 'autostart: off\n' ;;
  -h|--help) sed -n '2,19p' "$0" ;;
  *) printf 'usage: %s --apply|--run|--open|--place|--external CMD|--remove\n' "$0" >&2; exit 2 ;;
esac
