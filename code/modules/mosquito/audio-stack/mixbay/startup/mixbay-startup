#!/usr/bin/env bash
# =============================================================================
# mixbay-startup — login autostart and scratchpad launch for Mixbay
# =============================================================================
# Two independent preferences in ~/.config/mosquitomixbay/ui.json:
#   launch_at_startup   (default true)  → add/remove the Hyprland autostart line
#   launch_in_scratchpad(default true)  → park the TUI in special:scratchpad
#
# Usage:
#   mixbay-startup --apply   # sync the autostart line with ui.json
#   mixbay-startup --run     # launched by Hyprland at login
#   mixbay-startup --open    # launched by the Omarchy menu (reveals the window)
#   mixbay-startup --place   # park/unpark the running TUI from ui.json
#   mixbay-startup --install-card ID  # notification click: open + queue a profile
#   mixbay-startup --open-card ID     # notification click: open + show that card
#   mixbay-startup --use-card ID      # notification button: make it default + open its UI
#   mixbay-startup --select-card ID   # notification button: make it default only
#   mixbay-startup --levels-guard-repair  # notification button: re-install the guard
#   mixbay-startup --levels-guard-stop    # notification button: never ask again
#   mixbay-startup --external CMD  # launch an external GUI and place the windows
# =============================================================================
set -euo pipefail

HOME_DIR="${HOME}"
CONF="${XDG_CONFIG_HOME:-$HOME_DIR/.config}"
UI="$CONF/mosquitomixbay/ui.json"
AUTOSTART="$CONF/hypr/autostart.lua"
BIN="$HOME_DIR/.local/bin/mixbay-startup"
FOUNDATION="$HOME_DIR/.local/bin/mixbay-audio-foundation"
MOVE_AUDIO="$HOME_DIR/.local/bin/move-audio"
START="-- >>> mosquitOmarchy mixbay autostart"
END="-- <<< mosquitOmarchy mixbay autostart"

pref(){
  local key="$1" def="$2"
  if [[ -f $UI ]] && command -v jq >/dev/null 2>&1; then
    jq -r --arg k "$key" --arg d "$def" 'if has($k) then (.[$k]|tostring) else $d end' "$UI"
  else
    printf '%s\n' "$def"
  fi
}

remove_block(){
  [[ -f $AUTOSTART ]] || return 0
  local tmp; tmp="$(mktemp)"
  awk -v start="$START" -v end="$END" '
    $0 == start { skip=1; next }
    $0 == end   { skip=0; next }
    !skip       { print }
  ' "$AUTOSTART" > "$tmp"
  mv "$tmp" "$AUTOSTART"
}

apply(){
  local on; on="$(pref launch_at_startup true)"
  mkdir -p "$(dirname "$AUTOSTART")"
  touch "$AUTOSTART"
  remove_block
  if [[ $on == true ]]; then
    {
      printf '%s\n' "$START"
      printf 'o.launch_on_start("%s --run")\n' "$BIN"
      printf '%s\n' "$END"
    } >> "$AUTOSTART"
    printf 'autostart: on\n'
  else
    printf 'autostart: off\n'
  fi
}

# Window classes: the TUI and its scratchpad variant. Both are Mixbay windows;
# matching the prefix means a window launched with the other app-id still gets
# parked (turning "launch in scratchpad" on must move the window already open).
window_addrs(){
  command -v hyprctl >/dev/null 2>&1 || return 0
  hyprctl clients -j 2>/dev/null | jq -r '
    .[] | select(((.class // "") | startswith("org.omarchy.mosquito-mixbay")))
    | .address' 2>/dev/null || true
}

# hypr_move <address> <workspace> — silent: parking Mixbay must not steal the
# focus from the window the user just opened.
hypr_move(){
  local addr="$1" ws="$2"
  hyprctl dispatch "movetoworkspacesilent $ws,address:$addr" >/dev/null 2>&1 \
    || hyprctl dispatch "hl.dsp.window.move({ window = \"address:$addr\", workspace = \"$ws\", follow = false })" >/dev/null 2>&1 \
    || true
}

place(){
  local addrs scratch ws
  addrs="$(window_addrs)"
  [[ -n $addrs ]] || return 0
  scratch="$(pref launch_in_scratchpad true)"
  if [[ $scratch == true ]]; then
    while IFS= read -r addr; do
      [[ -n $addr ]] && hypr_move "$addr" "special:scratchpad"
    done <<< "$addrs"
    return 0
  fi
  ws="$(hyprctl workspaces -j 2>/dev/null | jq -r '[.[]|select(.id > 0)]|sort_by(.id)|.[0].id // 1' 2>/dev/null || echo 1)"
  while IFS= read -r addr; do
    [[ -n $addr ]] && hypr_move "$addr" "$ws"
  done <<< "$addrs"
}

spawn(){
  local scratch; scratch="$(pref launch_in_scratchpad true)"
  local term app cmd
  if command -v foot >/dev/null 2>&1; then term=foot; else term=xterm; fi
  command -v "$term" >/dev/null 2>&1 || exit 0
  if [[ $scratch == true ]]; then
    app="org.omarchy.mosquito-mixbay-scratchpad"
  else
    app="org.omarchy.mosquito-mixbay-tui"
  fi
  if [[ $term == foot ]]; then
    printf -v cmd '%q --app-id=%q -e %q' "$term" "$app" "$HOME_DIR/.local/bin/mosquito-mixbay"
  else
    printf -v cmd '%q -e %q' "$term" "$HOME_DIR/.local/bin/mosquito-mixbay"
  fi
  # With launch_in_scratchpad the window is BORN in the scratchpad through an
  # exec rule; it used to appear on the current workspace and get moved by
  # place() afterwards. place() stays as the fallback for a Hyprland that
  # refuses the rule. Classic `exec [workspace …]` is a Lua syntax error on
  # Hyprland 0.56.
  if [[ $scratch == true ]] && command -v hyprctl >/dev/null 2>&1 \
     && hyprctl dispatch "hl.dsp.exec_cmd(\"[workspace special:scratchpad silent] $cmd\")" >/dev/null 2>&1; then
    :
  elif [[ $term == foot ]]; then
    "$term" --app-id="$app" -e "$HOME_DIR/.local/bin/mosquito-mixbay" >/dev/null 2>&1 &
  else
    "$term" -e "$HOME_DIR/.local/bin/mosquito-mixbay" >/dev/null 2>&1 &
  fi
  # Wait for Hyprland to map the window: at login hyprctl can lag the exec by
  # several seconds on a cold session.
  local i
  for i in $(seq 1 60); do
    sleep 0.25
    [[ -n "$(window_addrs)" ]] && break
  done
  place
}

run(){
  [[ "$(pref launch_at_startup true)" == true ]] || exit 0
  # Already open (toggled settings, or autostart raced a manual launch): park
  # or unpark the live window instead of spawning a duplicate.
  if [[ -n "$(window_addrs)" ]]; then place; exit 0; fi
  spawn
}

# open: what the Omarchy menu calls. Unlike --run it ignores the autostart
# preference, respects launch_in_scratchpad, and reveals the window.
open_mixbay(){
  if [[ -n "$(window_addrs)" ]]; then place; else spawn; fi
  # Let the async move land before asking which special workspace is shown;
  # otherwise the freshly moved window is still hidden and the toggle below
  # can flip an already-open scratchpad shut.
  sleep 0.4
  local addr scratch special
  addr="$(window_addrs | head -1)"
  [[ -n $addr ]] || exit 0
  scratch="$(pref launch_in_scratchpad true)"
  if [[ $scratch == true ]]; then
    special="$(hyprctl monitors -j 2>/dev/null | jq -r '[.[]|select(.specialWorkspace.name=="special:scratchpad")]|length' 2>/dev/null || echo 0)"
    if [[ ${special:-0} == 0 ]]; then
      hyprctl dispatch 'hl.dsp.workspace.toggle_special("scratchpad")' >/dev/null 2>&1 || true
    fi
  fi
  hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1 || true
}

# --- external GUIs (oscmix GTK/Qt, web app) ----------------------------------
# With handle_external_windows on (default), Mixbay decides where the mixer
# goes: if the TUI is in the scratchpad, the new window takes the lowest empty
# workspace and keeps the focus; otherwise it tiles normally and Mixbay parks
# itself in the scratchpad, without stealing the focus, with a notification
# saying which shortcut brings it back.

all_addrs(){
  command -v hyprctl >/dev/null 2>&1 || return 0
  hyprctl clients -j 2>/dev/null | jq -r '.[].address' 2>/dev/null || true
}

on_scratchpad(){
  command -v hyprctl >/dev/null 2>&1 || return 1
  hyprctl clients -j 2>/dev/null | jq -e --arg a "$1" \
    'any(.[]; .address == $a and ((.workspace.name // "") == "special:scratchpad"))' \
    >/dev/null 2>&1
}

# empty_workspace — lowest positive workspace with no window on it.
empty_workspace(){
  local occupied n
  occupied="$(hyprctl clients -j 2>/dev/null | jq -r '.[].workspace.id' 2>/dev/null || true)"
  for n in $(seq 1 50); do
    grep -qx -- "$n" <<<"$occupied" || { printf '%s\n' "$n"; return 0; }
  done
  printf '1\n'
}

# new_window <addresses-before> — the first address that was not there before,
# polled for 10s so a slow GTK/Chromium start still counts.
new_window(){  local before="$1" i a
  for i in $(seq 1 40); do
    sleep 0.25
    while IFS= read -r a; do
      [[ -n $a ]] || continue
      grep -qxF -- "$a" <<<"$before" || { printf '%s\n' "$a"; return 0; }
    done < <(all_addrs)
  done
  return 1
}

launch_external(){
  if command -v setsid >/dev/null 2>&1; then
    setsid "$@" >/dev/null 2>&1 &
  else
    "$@" >/dev/null 2>&1 &
  fi
}

external(){
  local cmd="$1" handle before addr new ws
  shift
  handle="$(pref handle_external_windows true)"
  [[ $handle == true ]] || { launch_external "$cmd" "$@"; exit 0; }
  command -v hyprctl >/dev/null 2>&1 || { launch_external "$cmd" "$@"; exit 0; }
  addr="$(window_addrs | head -1)"
  [[ -n $addr ]] || { launch_external "$cmd" "$@"; exit 0; }
  if on_scratchpad "$addr"; then
    before="$(all_addrs)"
    launch_external "$cmd" "$@"
    new="$(new_window "$before")" || exit 0
    ws="$(empty_workspace)"
    hyprctl dispatch "hl.dsp.window.move({ window = \"address:$new\", workspace = \"$ws\" })" >/dev/null 2>&1 \
      || hyprctl dispatch "movetoworkspace $ws,address:$new" >/dev/null 2>&1 || true
    hyprctl dispatch "workspace $ws" >/dev/null 2>&1 || true
    hyprctl dispatch focuswindow "address:$new" >/dev/null 2>&1 || true
    exit 0
  fi
  # Mixbay is not in the scratchpad: park it BEFORE the GUI exists, silently.
  # Its window then opens and tiles on the active workspace with the focus,
  # instead of losing it to a Mixbay moved afterwards.
  hypr_move "$addr" "special:scratchpad"
  command -v notify-send >/dev/null 2>&1 \
    && notify-send "Mixbay" "TUI moved to scratchpad — SUPER + S to bring it back" \
    || true
  launch_external "$cmd" "$@"
}

# request_card <file> <id> — queue one notification-click request, reveal (or
# spawn) Mixbay, then wake a running TUI so it acts without a restart.
request_card(){
  local file="$1" id="${2:-}" pidfile pid
  [[ $id =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || { printf 'invalid card id: %s\n' "$id" >&2; exit 2; }
  mkdir -p "$CONF/mosquitomixbay"
  printf '{"id":"%s"}\n' "$id" > "$CONF/mosquitomixbay/$file"
  open_mixbay
  pidfile="${XDG_RUNTIME_DIR:-/tmp}/mosquito-mixbay-tui.pid"
  [[ -f $pidfile ]] || exit 0
  pid="$(cat "$pidfile" 2>/dev/null || true)"
  [[ -n $pid ]] && kill -USR1 "$pid" 2>/dev/null || true
}

# install_card <id> — the card watcher's notification click: remember the
# profile, reveal (or spawn) Mixbay, then wake the running TUI so it runs the
# same import + integration path as the profiles screen.
install_card(){
  request_card pending-install.json "${1:-}" --install-card
}

# open_card <id> — an already-installed card's notification click: reveal
# Mixbay and land on that card's page.
open_card(){
  request_card pending-open.json "${1:-}" --open-card
}

# ui_launcher <opener-id> — the build owns this closed set; a profile only
# names which ones it offers (ui.openers), never a command.
ui_launcher(){
  case "$1" in
    web) printf '%s\n' mixbay-oscmix-web ;;
    gtk) printf '%s\n' mixbay-oscmix-gtk ;;
    qt)  printf '%s\n' mixbay-oscmix-qt ;;
  esac
}

# default_ui <id> — the UI chosen for this card in Mixbay's Controls page.
# Without a choice, the profile's first opener wins (the build's oscmix cards
# fall back to the web UI), exactly like the selector shows it.
default_ui(){
  local id="$1" sel="" card
  if [[ -f $UI ]] && command -v jq >/dev/null 2>&1; then
    sel="$(jq -r --arg id "$id" '.default_ui[$id] // empty' "$UI" 2>/dev/null || true)"
  fi
  if [[ -z $sel ]]; then
    card="$CONF/mosquitomixbay/cards/$id/upstream/card.json"
    if [[ -f $card ]] && command -v jq >/dev/null 2>&1; then
      sel="$(jq -r '.ui.openers[0].id // empty' "$card" 2>/dev/null || true)"
      if [[ -z $sel && "$(jq -r '.spec.setup // ""' "$card" 2>/dev/null)" == oscmix ]]; then
        sel=web
      fi
    fi
  fi
  printf '%s\n' "$sel"
}

# select_card <id> — make it the default audio interface, without opening
# anything. The Move has no UI of its own: its helper selects the interface and
# pins the rate.
select_card(){
  local id="${1:-}"
  [[ $id =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || { printf 'usage: %s --select-card ID\n' "$0" >&2; exit 2; }
  if [[ $id == move ]]; then
    [[ -x $MOVE_AUDIO ]] && "$MOVE_AUDIO" --use >/dev/null 2>&1 || true
  else
    [[ -x $FOUNDATION ]] && "$FOUNDATION" --set-default "$id" >/dev/null 2>&1 || true
  fi
}

# use_card <id> — a known card's "Open UI & Use it": make it the default audio
# interface, then open the UI chosen in its Controls page; without a choice,
# reveal its card page.
use_card(){
  local id="${1:-}" launcher=""
  select_card "$id"
  launcher="$(ui_launcher "$(default_ui "$id")")"
  if [[ -n $launcher ]] && command -v "$launcher" >/dev/null 2>&1; then
    external "$launcher"
    exit 0
  fi
  open_card "$id"
}

# --- Levels Guard notice buttons -------------------------------------------
# stop asking: the sentinel the card watcher checks. A state file, not a
# ui.json key: the TUI rewrites ui.json from its struct and would drop it.
levels_guard_stop(){
  mkdir -p "$CONF/mosquitomixbay"
  : > "$CONF/mosquitomixbay/levels-guard-off"
}

# repair: run the owning module from the checkout mosquitomarchy-actions points
# at. The health `heal` path is the fallback when only the deployed copy exists
# (it re-applies the module too, and the module needs no root).
levels_guard_repair(){
  local actions="$HOME_DIR/.local/bin/mosquitomarchy-actions" root="" script=""
  [[ -e $actions ]] && root="$(cd "$(dirname "$(readlink -f "$actions")")/../.." 2>/dev/null && pwd)" || true
  [[ -n $root ]] && script="$root/code/modules/mosquito/audio-stack/levels-guard/setup-levels-guard.sh"
  if [[ -f $script ]]; then
    bash "$script" -y >/dev/null 2>&1 || true
    return 0
  fi
  if command -v mosquitomarchy-actions >/dev/null 2>&1; then
    mosquitomarchy-actions heal levels-guard >/dev/null 2>&1 || true
  fi
}

case "${1:-}" in
  --apply) apply ;;
  --run) run ;;
  --open) open_mixbay ;;
  --place) place ;;
  --install-card) shift; install_card "$@" ;;
  --open-card) shift; open_card "$@" ;;
  --use-card) shift; use_card "$@" ;;
  --select-card) shift; select_card "$@" ;;
  --levels-guard-repair) levels_guard_repair ;;
  --levels-guard-stop) levels_guard_stop ;;
  --external) shift; [[ $# -ge 1 ]] || { printf 'usage: %s --external CMD [args...]\n' "$0" >&2; exit 2; }; external "$@" ;;
  --remove) remove_block; printf 'autostart: off\n' ;;
  -h|--help) sed -n '2,20p' "$0" ;;
  *) printf 'usage: %s --apply|--run|--open|--place|--install-card ID|--open-card ID|--use-card ID|--select-card ID|--levels-guard-repair|--levels-guard-stop|--external CMD|--remove\n' "$0" >&2; exit 2 ;;
esac
