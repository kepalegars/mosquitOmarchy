#!/usr/bin/env bash
# =============================================================================
# mixbay-oscmix-qt — open the Qt UI for a Class Compliant RME Fireface
# =============================================================================
# The Qt frontend is published by the oscmix project as a self-contained
# AppImage in its nightly release. It bundles oscmix/alsarawio/alsaseqio and
# starts the bridge for every card it finds, so there is nothing to start here.
# =============================================================================
set -euo pipefail

APPIMAGE="$HOME/.local/lib/oscmix/oscmix-qt.AppImage"

warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }

# Mixbay opens the UI detached from the TUI: say why on the desktop too.
fail() {
  warn "$*"
  command -v notify-send >/dev/null 2>&1 && notify-send "oscmix Qt UI" "$*" || true
}

if [[ ! -x $APPIMAGE ]]; then
  fail "The oscmix Qt UI is not installed (the project has not published an AppImage for this release). Use Open GTK mixer, or run Set up / repair oscmix."
  exit 1
fi

# AppImages need FUSE; without it, extract-and-run still works.
if [[ ! -e /dev/fuse ]] || ! command -v fusermount >/dev/null 2>&1; then
  export APPIMAGE_EXTRACT_AND_RUN=1
fi

exec "$APPIMAGE" "$@"
