#!/usr/bin/env bash
# =============================================================================
# mixbay-oscmix-gtk — open the RME Fireface UCX II mixer (oscmix-desk)
# =============================================================================
# oscmix-desk's own launcher checks the desk, reuses or starts the backend and
# opens the GTK mixer. This wrapper only locates it and explains the two ways
# it can fail to find the interface (driver mode / not connected).
#
# The interface must be in Class Compliant mode (SETUP on the unit).
#
# Usage:
#   mixbay-oscmix-gtk   open the mixer
# =============================================================================
set -euo pipefail

BIN_DIR="$HOME/.local/bin"

warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }

resolve() {
  local p
  p="$(command -v "$1" 2>/dev/null || true)"
  [[ -n $p ]] && { printf '%s\n' "$p"; return 0; }
  [[ -x $BIN_DIR/$1 ]] && printf '%s\n' "$BIN_DIR/$1"
}

hint() {
  if command -v lsusb >/dev/null 2>&1 && lsusb -d 2a39:3f82 >/dev/null 2>&1; then
    warn "The UCX II is plugged in but running in USB driver mode (2a39:3f82)."
    warn "Linux only sees it in Class Compliant mode: on the unit SETUP → Options"
    warn "→ CC Mode = ON. It re-enumerates as 2a39:3fd9 and gets an ALSA card."
  elif ! grep -qi 'fireface' /proc/asound/cards 2>/dev/null; then
    warn "The UCX II is not visible to ALSA."
    warn "Check that it is connected in Class Compliant mode (SETUP → Options"
    warn "→ CC Mode) and appears in: aconnect -l   (client 'Fireface UCX II')"
  fi
}

case "${1:-}" in
  -h|--help) sed -n '2,14p' "$0"; exit 0 ;;
  "") ;;
  *) warn "Unknown option: $1"; exit 2 ;;
esac

launch="$(resolve oscmix-launch)" \
  || { warn "oscmix-desk is not installed — run Set up / repair oscmix-desk."; exit 1; }

# oscmix-launch replaces itself with the GTK mixer; when it cannot, it
# notifies and exits non-zero, and the hint says why the card may be missing.
if ! "$launch"; then
  hint
  exit 1
fi
