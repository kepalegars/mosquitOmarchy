#!/usr/bin/env bash
# =============================================================================
# move-audio — the Ableton Move as the desk's audio interface, on request
# =============================================================================
# Part of Mixbay's Move profile. The Move exposes a class-compliant USB audio
# interface locked to 44.1 kHz; this helper is the only thing that switches to
# it, and it never runs by itself: Mixbay's card watcher offers it when the
# Move appears, and the audio panel calls it when the Move is picked there.
#
#   move-audio --use       Move = default in/out, graph pinned to 44.1 kHz.
#                          Remembers the previous devices, the four clock keys
#                          and the persisted PipeWire config.
#   move-audio --revert    Put all of that back (the unplug answer).
#   move-audio --release   Same restore, silently, and forget the session:
#                          live mode calls this so a 44.1 kHz Move never pins
#                          the live graph. Deactivation does NOT re-select it.
#   move-audio --status    JSON: connected? selected? what would revert do?
#   move-audio --self-test
#
# Detection needs BOTH the Ableton USB vendor (2982) and an ALSA card whose
# name says Move: a Push/Note has the vendor but no audio card, and no other
# card is allowed to trigger the rate pin.
#
# State lives in ~/.local/state/mosquitomarchy/move-audio-state. Only --use
# writes it, so an unplugged Move with no state means nothing was switched.
# =============================================================================
set -uo pipefail

ABLETON_VENDOR="2982"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mosquitomarchy"
STATE="$STATE_DIR/move-audio-state"
# Last default devices seen while the Move was NOT selected. The audio panel
# switches the default before this helper runs, so at --use time the "previous"
# default can already be the Move itself; the watcher keeps this record so the
# revert target is the device the panel replaced, not the Move.
PREV_DEFAULT="$STATE_DIR/move-previous-default"
APP="Mixbay"

# jq filter: the card/sink/source whose name, ALSA card name or description
# mentions Move.
MOVE_MATCH='.[]
  | select(([.name // "",
             (.properties["alsa.card_name"] // ""),
             (.properties["device.description"] // "")]
            | join(" ")) | test("move"; "i"))
  | .name'

notify(){
  local headline="$1" body="$2"
  shift 2
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send --app-name "$APP" -g "󰓃" \
      "$headline" "$body" "$@" >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -a "$APP" "$headline" "$body" >/dev/null 2>&1 || true
  fi
}

move_usb(){
  command -v lsusb >/dev/null 2>&1 || return 1
  lsusb -d "$ABLETON_VENDOR:" 2>/dev/null | grep -q .
}

pactl_names(){ # <list: cards|sinks|sources>
  pactl -f json list "$1" 2>/dev/null | jq -r "$MOVE_MATCH" 2>/dev/null | head -n1
}

move_card(){ pactl_names cards; }
move_sink(){ pactl_names sinks; }
move_source(){ pactl_names sources; }

# The Move only counts when its AUDIO side is up.
move_ready(){
  move_usb || return 1
  [[ -n "$(move_card)" ]]
}

pw_value(){ # <metadata key> -> current value, empty when absent
  pw-metadata -n settings 0 2>/dev/null | parse_pw_value "$1"
}

parse_pw_value(){ # <key>, reads pw-metadata output on stdin
  sed -n "s/.*key:'$1' value:'\([^']*\)'.*/\1/p" | head -n1
}

# The four keys a rate pin touches. Restoring them one by one also restores
# "the graph was dynamic before" (an absent key is deleted again), which is
# what a fixed min=max would quietly destroy.
PW_KEYS=(clock.rate clock.min-rate clock.max-rate clock.force-rate)
PW_CONF="$HOME/.config/pipewire/pipewire.conf.d/90-mosquitomarchy-pipewire.conf"
PW_CONF_SAVE="$STATE_DIR/move-audio-pipewire.conf"
PW_CONF_ABSENT="$STATE_DIR/move-audio-pipewire.absent"

# set_rate <rate> [force]: pins the graph to one rate "everywhere". rate 0
# leaves it dynamic. pipewire-settings is the module that owns this (it also
# persists the choice); the raw metadata calls are the fallback.
set_rate(){
  local rate="$1" force="${2:-1}"
  if command -v pipewire-settings >/dev/null 2>&1; then
    pipewire-settings set-rate "$rate" "$force" >/dev/null 2>&1 && return 0
  fi
  if [[ $rate == 0 ]]; then
    pw-metadata -n settings 0 clock.min-rate 0 >/dev/null 2>&1 || true
    pw-metadata -n settings 0 clock.max-rate 0 >/dev/null 2>&1 || true
    pw-metadata -n settings 0 clock.force-rate 0 >/dev/null 2>&1 || true
    return 0
  fi
  pw-metadata -n settings 0 clock.min-rate "$rate" >/dev/null 2>&1 || true
  pw-metadata -n settings 0 clock.max-rate "$rate" >/dev/null 2>&1 || true
  if [[ $force == 0 ]]; then
    pw-metadata -n settings 0 clock.force-rate 0 >/dev/null 2>&1 || true
  else
    pw-metadata -n settings 0 clock.force-rate "$rate" >/dev/null 2>&1 || true
  fi
}

st_get(){ sed -n "s/^$1=//p" "$STATE" 2>/dev/null | head -n1; }
switched(){ [[ -s $STATE ]]; }

# The rate "before" is what the previous default output was RUNNING at, not
# clock.rate: the graph's configured rate can be 96 kHz while a forced rate (or
# the card's own clock) keeps everything at 44.1, and then the go-back offer
# named a rate the user was never at. A forced rate wins; otherwise read the
# previous sink, and only then fall back to the graph default.
sink_rate(){
  [[ -n ${1:-} ]] || return 0
  pactl -f json list sinks 2>/dev/null \
    | jq -r --arg n "$1" '.[] | select(.name == $n) | .sample_specification.rate' 2>/dev/null \
    | head -n1
}
current_rate(){
  local forced
  forced=$(pw_value clock.force-rate)
  if [[ -n $forced && $forced != 0 ]]; then printf '%s\n' "$forced"; return 0; fi
  forced=$(sink_rate "$(pactl get-default-sink 2>/dev/null || true)")
  [[ -n $forced ]] && { printf '%s\n' "$forced"; return 0; }
  pw_value clock.rate
}

# prev_targets <default sink> <default source> -> "sink<TAB>source" to revert
# to. When the panel already made the Move the default, fall back to the last
# non-Move selection the watcher recorded; without that record there is no way
# to name what was replaced, so the Move is kept (and no go-back is offered).
prev_targets(){
  local ps="$1" po="$2" fs fsr
  if [[ -z $ps || ${ps,,} == *move* ]]; then
    fs=$(sed -n 's/^sink=//p' "$PREV_DEFAULT" 2>/dev/null | head -n1)
    fsr=$(sed -n 's/^source=//p' "$PREV_DEFAULT" 2>/dev/null | head -n1)
    if [[ -n $fs ]]; then
      ps=$fs
      [[ -z $po || ${po,,} == *move* ]] && po=$fsr
    fi
  fi
  printf '%s\t%s\n' "$ps" "$po"
}

restore(){
  local sink source
  sink=$(st_get sink); source=$(st_get source)
  [[ -n $sink ]] && pactl set-default-sink "$sink" 2>/dev/null || true
  [[ -n $source ]] && pactl set-default-source "$source" 2>/dev/null || true
  local k v
  for k in "${PW_KEYS[@]}"; do
    v=$(st_get "pw.$k")
    if [[ -n $v ]]; then
      pw-metadata -n settings 0 "$k" "$v" >/dev/null 2>&1 || true
    else
      pw-metadata -n settings 0 -d "$k" >/dev/null 2>&1 || true
    fi
  done
  # Keys first (min/max before rate), then the persisted file: putting the
  # config back last means the generated one never wins.
  if [[ -f $PW_CONF_SAVE ]]; then
    mkdir -p "$(dirname "$PW_CONF")"
    mv -f "$PW_CONF_SAVE" "$PW_CONF"
  elif [[ -f $PW_CONF_ABSENT ]]; then
    rm -f "$PW_CONF"
  fi
  rm -f "$PW_CONF_ABSENT" "$STATE"
}

cmd_use(){
  if ! move_ready; then
    notify "Ableton Move not found" "Its USB audio interface is not up — plug it in, then try again."
    return 1
  fi
  if switched; then
    set_rate 44100 1
    return 0
  fi
  local sink source prev_sink prev_source k prev_rate
  sink=$(move_sink)
  source=$(move_source)
  IFS=$'\t' read -r prev_sink prev_source < <(
    prev_targets "$(pactl get-default-sink 2>/dev/null || true)" \
                 "$(pactl get-default-source 2>/dev/null || true)")
  prev_rate=$(sink_rate "$prev_sink")
  [[ -n $prev_rate ]] || prev_rate=$(current_rate)

  mkdir -p "$STATE_DIR"
  {
    printf 'sink=%s\n' "$prev_sink"
    printf 'source=%s\n' "$prev_source"
    printf 'rate=%s\n' "$prev_rate"
    for k in "${PW_KEYS[@]}"; do
      printf 'pw.%s=%s\n' "$k" "$(pw_value "$k")"
    done
  } > "$STATE"
  rm -f "$PW_CONF_ABSENT"
  if [[ -f $PW_CONF ]]; then cp -f "$PW_CONF" "$PW_CONF_SAVE"; else : > "$PW_CONF_ABSENT"; fi

  [[ -n $sink ]] && pactl set-default-sink "$sink" 2>/dev/null || true
  [[ -n $source ]] && pactl set-default-source "$source" 2>/dev/null || true
  set_rate 44100 1
  notify "Using Ableton Move's audio interface" \
    "Sample rate pinned to 44.1kHz (unplug the Move to unpin automatically)."
}

cmd_revert(){
  switched || return 0
  restore
}

cmd_release(){
  switched || return 0
  restore
}

cmd_status(){
  local card
  card=$(move_card)
  jq -nc --argjson usb "$(move_usb && echo true || echo false)" \
    --arg card "$card" \
    --argjson switched "$(switched && echo true || echo false)" \
    --arg prev_sink "$(st_get sink)" --arg prev_source "$(st_get source)" \
    --arg prev_rate "$(st_get rate)" \
    --arg current_rate "$(current_rate)" \
    '{usb:$usb,card:$card,switched:$switched,prev_sink:$prev_sink,prev_source:$prev_source,prev_rate:$prev_rate,current_rate:$current_rate}'
}

self_test(){
  local fail=0 out tmp
  out=$(printf '%s' '[{"name":"alsa_card.usb-Ableton_Move-00","properties":{"alsa.card_name":"Ableton Move"}},
                        {"name":"alsa_card.usb-Audient_EVO8-00","properties":{"alsa.card_name":"EVO8"}}]' \
    | jq -r "$MOVE_MATCH")
  [[ "$out" == "alsa_card.usb-Ableton_Move-00" ]] || fail=1
  out=$(printf '%s' '[{"name":"alsa_output.pci-0000_64_00.6.sink","properties":{"device.description":"Ryzen HD Audio Controller"}}]' \
    | jq -r "$MOVE_MATCH")
  [[ -z "$out" ]] || fail=1
  out=$(printf '%s\n' 'Found "settings" metadata 31' \
    "update: id:0 key:'clock.rate' value:'48000' type:''" | parse_pw_value clock.rate)
  [[ "$out" == 48000 ]] || fail=1
  tmp=$(mktemp -d)
  STATE="$tmp/state"
  PREV_DEFAULT="$tmp/prev"
  printf 'sink=prev-sink\nsource=prev-source\n' > "$PREV_DEFAULT"
  out=$(prev_targets "alsa_output.usb-Ableton_Move.sink" "alsa_input.usb-Ableton_Move.source")
  [[ "$out" == $'prev-sink\tprev-source' ]] || fail=1
  out=$(prev_targets "alsa_output.pci.sink" "alsa_input.pci.source")
  [[ "$out" == $'alsa_output.pci.sink\talsa_input.pci.source' ]] || fail=1
  printf 'sink=a\nsource=b\nrate=48000\npw.clock.min-rate=\n' > "$STATE"
  [[ "$(st_get rate)" == 48000 && "$(st_get sink)" == a ]] || fail=1
  switched || fail=1
  [[ -z "$(st_get pw.clock.min-rate)" ]] || fail=1
  rm -rf "$tmp"
  (( fail )) && { printf 'self-test failed\n' >&2; return 1; }
  printf 'self-test ok\n'
}

case "${1:-}" in
  --use)       cmd_use ;;
  --revert)    cmd_revert ;;
  --release)   cmd_release ;;
  --status)    cmd_status ;;
  --self-test) self_test ;;
  *) printf 'usage: %s [--use|--revert|--release|--status|--self-test]\n' "$0" >&2; exit 2 ;;
esac
