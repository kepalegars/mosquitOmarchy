#!/usr/bin/env bash
# =============================================================================
# mixbay-card-watcher — notify when a Mixbay-supported interface is plugged in
# =============================================================================
# Installed as a systemd user service by setup-mosquitomixbay.sh. It listens to
# PipeWire card events (pactl subscribe) instead of polling, so an idle desktop
# costs nothing and a card is seen as soon as PipeWire sees it.
#
# Behavior follows ~/.config/mosquitomixbay/ui.json:
#   watcher_mode       always | only_open | off
#   detect_cards       false → nothing is detected or logged
#   notify_cards       false → detection still logs, but no connection notice
#   notify_disconnected false → no notice when an interface goes away
#
# A missing profile makes the notification click open Mixbay, install it and
# land on the card's page; an installed card's click opens that page directly.
# The missing-profile notice is persistent (critical, no timeout).
# =============================================================================
set -uo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
UI="$CONF/mosquitomixbay/ui.json"
SEEN="$CONF/mosquitomixbay/watcher-connected.json"
BIN="${HOME}/.local/bin"
ACTIONS="$BIN/mosquito-mixbay-actions"
FOUNDATION="$BIN/mixbay-audio-foundation"
STARTUP="$BIN/mixbay-startup"
MOVE_AUDIO="$BIN/move-audio"          # Mixbay's Move profile helper
COMPAT="$BIN/mosquito-mixbay-compat"  # installs/records a profile step
MOVE_STATE="$CONF/mosquitomixbay/watcher-move"
MOVE_PREV="${XDG_STATE_HOME:-$HOME/.local/state}/mosquitomarchy/move-previous-default"

pref(){
  local key="$1" def="$2"
  if [[ -f $UI ]] && command -v jq >/dev/null 2>&1; then
    jq -r --arg k "$key" --arg d "$def" \
      'if has($k) then (.[$k]|tostring) else $d end' "$UI" 2>/dev/null \
      || printf '%s\n' "$def"
  else
    printf '%s\n' "$def"
  fi
}

# Mixbay is open when the dispatcher pidfile points at a live process, or a
# TUI runs without the dispatcher (a plain `mosquito-mixbay-tui` in a terminal).
mixbay_open(){
  local p="${XDG_RUNTIME_DIR:-/tmp}/mosquito-mixbay.pid" pid
  if [[ -f $p ]]; then
    pid="$(cat "$p" 2>/dev/null || true)"
    [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null && return 0
  fi
  pgrep -f -- "${BIN}/mosquito-mixbay-tui" >/dev/null 2>&1
}

# Icons follow the desktop's Nerd Font: a speaker for a card that appeared,
# the same speaker crossed out when it goes away. Monochrome, so the shell
# tints them with the active Omarchy theme like its own bar icons.
ICON_CARD='󰓃'
ICON_CARD_OFF='󰓄'

notify_body(){
  local display="$1" kind="$2"
  case $kind in
    install)
      printf '%s connected — no Mixbay profile installed. Click this notification to install it.\n' "$display"
      ;;
    installed|update)
      printf '%s connected — handled by Mixbay. Click to open its UI and use it.\n' "$display"
      ;;
    unsupported)
      printf '%s connected — not supported by Mixbay yet.\n' "$display"
      ;;
    disconnected)
      printf '%s disconnected.\n' "$display"
      ;;
  esac
}

send_notification(){
  local id="$1" display="$2" kind="$3" body glyph args=() exec=()
  body="$(notify_body "$display" "$kind")"
  glyph="$ICON_CARD"
  [[ $kind == disconnected ]] && glyph="$ICON_CARD_OFF"
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    args=(--app-name Mixbay -g "$glyph")
    case $kind in
      install)
        # Critical is the only Omarchy urgency with no timeout: the missing
        # profile stays on screen until the user dismisses or clicks it.
        args+=(-u critical -t 0)
        exec=(--exec "$STARTUP" --install-card "$id")
        ;;
      installed|update)
        # Clicking the card runs the first action, so it opens Mixbay AND
        # makes the card the default. "Use it" repeats only the default
        # change, for when the window would just get in the way.
        exec=(--action "Open" "$STARTUP" --use-card "$id" \
              --action "Use it" "$STARTUP" --select-card "$id")
        ;;
      unsupported)
        exec=(--exec "$STARTUP" --open)
        ;;
    esac
    # --exec consumes the rest of the line, so headline and body come first.
    omarchy-notification-send "${args[@]}" "Mixbay" "$body" "${exec[@]}" >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null 2>&1; then
    args=(-a Mixbay -i audio-card-symbolic)
    [[ $kind == disconnected ]] && args=(-a Mixbay -i audio-volume-muted-symbolic)
    [[ $kind == install ]] && args+=(-u critical -t 0)
    notify-send "${args[@]}" "Mixbay" "$body" >/dev/null 2>&1 || true
  fi
}

# rows <json>: accept both the current row objects and the old key-only seen
# file, so an upgrade does not misread every card as still present.
rows(){
  jq -c '[.[] | if type=="string" then {key:.} else . end]' <<<"$1" 2>/dev/null \
    || printf '[]\n'
}

# new_cards <current-json> <previous-rows-json>: the rows that were not there
# before. A card that raises several connect events still notifies once.
new_cards(){
  jq -c --argjson prev "$2" \
    '[.[] | select(.key as $k | ($prev | map(.key) | index($k) | not))]' <<<"$1" 2>/dev/null \
    || printf '[]\n'
}

# gone_cards <current-json> <previous-rows-json>: rows that disappeared. Old
# key-only entries have no display name, so an upgrade does not announce them.
gone_cards(){
  jq -c --argjson cur "$1" \
    '[.[] | select((.display // "") != "") | select(.key as $k | ($cur | map(.key) | index($k) | not))]' <<<"$2" 2>/dev/null \
    || printf '[]\n'
}

# scan: every connected USB interface, supported or not (--all). The watcher
# must stay useful for an unrecognized card too: it still says it was seen.
scan(){
  timeout 20 "$ACTIONS" cards-connected-json --all 2>/dev/null
}

# ── Ableton Move ───────────────────────────────────────────────────────────
# The Move is not a mixer Mixbay can drive; it is a 44.1 kHz USB audio
# interface. Its connection notice IS the offer to use it, and it replaces
# Mixbay's generic card notice entirely (one notification, one decision).
# The profile (watcher/move-audio) is offered once, at the first connection,
# and installed by Mixbay itself.

move_connected(){
  command -v lsusb >/dev/null 2>&1 || return 1
  lsusb -d 2982: 2>/dev/null | grep -q . || return 1
  grep -qi 'ableton move' /proc/asound/cards 2>/dev/null
}

# The audio offer belongs to the Move profile, which is the card page AND the
# helper: uninstalling the profile in the library must silence it, or "remove"
# would only hide the page.
move_installed(){
  [[ -x $MOVE_AUDIO ]] || return 1
  "$ACTIONS" profiles-list-local 2>/dev/null | jq -e 'any(.[]; .id == "move")' >/dev/null 2>&1
}

khz(){
  local r="$1"
  if (( r % 1000 == 0 )); then printf '%d' $((r / 1000)); else
    awk -v r="$r" 'BEGIN { printf "%.1f", r / 1000 }'
  fi
}

move_notice_connect(){
  if ! move_installed; then
    if command -v omarchy-notification-send >/dev/null 2>&1; then
      omarchy-notification-send --app-name Mixbay -g "$ICON_CARD" -u critical -t 0 \
        "Ableton Move connected" \
        "No Mixbay Move profile installed. Install it to offer its audio interface." \
        --action "Install profile" "$COMPAT" --apply move >/dev/null 2>&1 || true
    fi
    return 0
  fi
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send --app-name Mixbay -g "$ICON_CARD" \
      "Ableton Move connected" \
      "Use its audio interface? (Pins the sample rate to 44.1kHz)" \
      --action "Use it" "$MOVE_AUDIO" --use >/dev/null 2>&1 || true
  fi
}

move_notice_disconnect(){
  move_installed || return 0
  local st switched prev cur state_file asked=0
  state_file="${XDG_STATE_HOME:-$HOME/.local/state}/mosquitomarchy/move-audio-state"
  grep -qx 'asked=1' "$state_file" 2>/dev/null && asked=1
  st=$("$MOVE_AUDIO" --status 2>/dev/null || printf '{}')
  switched=$(jq -r '.switched // false' <<<"$st" 2>/dev/null || echo false)
  prev=$(jq -r '.prev_rate // empty' <<<"$st" 2>/dev/null || true)
  cur=$(jq -r '.current_rate // empty' <<<"$st" 2>/dev/null || true)
  command -v omarchy-notification-send >/dev/null 2>&1 || return 0
  # Offer the way back only when there IS one: the Move had been chosen, our
  # 44.1 kHz pin is still what the graph runs on, and the rate to return to is
  # neither that pin nor the current one. A stale state file must not raise a
  # "go back to 48 kHz" for a session that never pinned anything, and the rate
  # named is the one measured before the switch — never a constant.
  if [[ $asked == 0 && $switched == true && -n $prev && $prev != 0 && $prev != 44100 \
        && $cur == 44100 ]]; then
    # One question per switch, not per unplug: an ignored offer leaves the pin
    # in place, and re-asking on every later unplug is nagging.
    printf 'asked=1\n' >> "$state_file"
    omarchy-notification-send --app-name Mixbay -g "$ICON_CARD_OFF" \
      "Ableton Move disconnected" "Go back to $(khz "$prev")kHz?" \
      --action "Go back" "$MOVE_AUDIO" --revert >/dev/null 2>&1 || true
  fi
  # Nothing else: an unplug with no pin, or a pin this helper did not set, has
  # no action to offer, and a "disconnected" notice with no action is noise.
}

# announce_move: one notice per real transition. The state file is seeded at
# service start, so logging in with the Move plugged (or absent) stays quiet.
announce_move(){
  local now prev
  move_connected && now=connected || now=disconnected
  prev=$(cat "$MOVE_STATE" 2>/dev/null || true)
  [[ $now == "$prev" ]] && return 0
  mkdir -p "$(dirname "$MOVE_STATE")"
  printf '%s\n' "$now" > "$MOVE_STATE"
  if [[ $now == connected ]]; then
    move_notice_connect
  else
    move_notice_disconnect
  fi
}

# announce <current-json> <previous-json>: update the seen set and notify for
# cards that just appeared or disappeared, subject to the settings.
announce(){
  local current="$1" previous="$2" prev new gone mode open id display kind
  prev="$(rows "$previous")"
  new="$(new_cards "$current" "$prev")"
  gone="$(gone_cards "$current" "$prev")"
  # The Move has its own notice (the audio-interface offer). Leaving it in
  # these lists would announce it twice, once as an unsupported card.
  local move_filter='[.[] | select((((.key // "") + " " + (.display // "")) | test("move"; "i")) | not)]'
  new="$(jq -c "$move_filter" <<<"$new" 2>/dev/null || printf '[]\n')"
  gone="$(jq -c "$move_filter" <<<"$gone" 2>/dev/null || printf '[]\n')"
  jq -c . <<<"$current" > "$SEEN" 2>/dev/null || true

  mode="$(pref watcher_mode always)"
  [[ $mode == off ]] && return 0
  [[ "$(pref detect_cards true)" == true ]] || return 0
  open=false; mixbay_open && open=true
  [[ $mode == only_open && $open == false ]] && return 0
  # Detection (not the notice): keep the foundation's connection history
  # current even when Mixbay is closed.
  "$FOUNDATION" --track >/dev/null 2>&1 || true

  if [[ -n $new && $new != '[]' && "$(pref notify_cards true)" == true ]]; then
    # No empty middle field here: bash treats a tab as IFS whitespace and would
    # collapse consecutive tabs, shifting an unsupported card's empty version.
    while IFS=$'\t' read -r id display kind; do
      send_notification "$id" "$display" "$kind"
    done < <(jq -r '.[] | [.id,.display,.kind]|@tsv' <<<"$new")
  fi
  if [[ -n $gone && $gone != '[]' && "$(pref notify_disconnected true)" == true ]]; then
    while IFS=$'\t' read -r id display; do
      send_notification "$id" "$display" disconnected
    done < <(jq -r '.[] | [.id,.display]|@tsv' <<<"$gone")
  fi
  # One Mixbay notice for the Move, replacing both the generic connect and
  # disconnect ones.
  announce_move
}

# The audio panel selects a device by changing the default sink/source; no
# panel code belongs to Mixbay, so the selection is read from PipeWire. Picking
# the Move there pins 44.1 kHz exactly like the notification does. Picking
# anything else changes NOTHING: only an unplug may put the previous rate back.
# move_remember_default: keep the last default devices seen while the Move is
# NOT selected. The panel changes the default before move-audio --use runs, so
# this record is the only way --use can still name what it replaced (the device
# to go back to on unplug).
move_remember_default(){
  move_installed || return 0
  local sink source
  sink=$(pactl get-default-sink 2>/dev/null || true)
  source=$(pactl get-default-source 2>/dev/null || true)
  [[ -n $sink && ${sink,,} != *move* && ${source,,} != *move* ]] || return 0
  mkdir -p "$(dirname "$MOVE_PREV")"
  printf 'sink=%s\nsource=%s\n' "$sink" "$source" > "$MOVE_PREV"
}

move_pinned_by_panel(){
  move_installed || return 0
  local sink source
  sink=$(pactl get-default-sink 2>/dev/null || true)
  source=$(pactl get-default-source 2>/dev/null || true)
  [[ ${sink,,} == *move* || ${source,,} == *move* ]] || return 0
  "$MOVE_AUDIO" --status 2>/dev/null | jq -e '.switched == true' >/dev/null 2>&1 && return 0
  "$MOVE_AUDIO" --use >/dev/null 2>&1 || true
}

main(){
  command -v pactl >/dev/null 2>&1 || exit 0
  command -v jq >/dev/null 2>&1 || exit 0
  [[ -x $ACTIONS ]] || exit 0

  mkdir -p "$(dirname "$MOVE_STATE")"
  if move_connected; then printf 'connected\n' > "$MOVE_STATE"; else printf 'disconnected\n' > "$MOVE_STATE"; fi
  move_remember_default

  local current
  if current="$(scan)"; then
    if [[ -f $SEEN ]]; then
      # A restart (PipeWire, update) can happen right after a plug: compare
      # with the last run so that card is not silently swallowed. On the very
      # first run there is no seen set, so the desk waking up stays quiet.
      announce "$current" "$(cat "$SEEN" 2>/dev/null || printf '[]\n')"
    else
      jq -c . <<<"$current" > "$SEEN" 2>/dev/null || true
    fi
  fi

  local line
  pactl subscribe 2>/dev/null | while IFS= read -r line; do
    case $line in
      *"on card"*)
        # One plug raises several events in a row: let them settle, then read
        # the real card list once.
        sleep 0.8
        current="$(scan)" || continue
        announce "$current" "$(cat "$SEEN" 2>/dev/null || printf '[]\n')"
        ;;
      *"on server"*)
        # Default device changed (the Omarchy audio panel). Only the Move
        # needs an action here.
        sleep 0.4
        move_pinned_by_panel
        move_remember_default
        ;;
    esac
  done
}

self_test(){
  local fail=0 b cur prev new gone
  b="$(notify_body 'RME Fireface UCX II' install)"
  [[ $b == *"no Mixbay profile installed"* && $b == *"Click this notification to install"* ]] || fail=1
  [[ $b != *"not open"* && $b != *"handled by Mixbay"* ]] || fail=1
  b="$(notify_body 'RME Fireface UCX II' installed)"
  [[ $b == *"handled by Mixbay"* && $b == *"open its UI and use it"* ]] || fail=1
  [[ $b != *"not open"* ]] || fail=1
  b="$(notify_body 'No Name Card' unsupported)"
  [[ $b == *"not supported by Mixbay yet"* && $b != *"open its UI"* ]] || fail=1
  b="$(notify_body 'ESI UGM192' disconnected)"
  [[ $b == *"disconnected"* ]] || fail=1
  cur='[{"key":"a","id":"evo8","display":"Audient EVO 8","kind":"installed"},
       {"key":"b","id":"ugm192","display":"ESI UGM192","kind":"install"}]'
  prev='[{"key":"a","id":"evo8","display":"Audient EVO 8","kind":"installed"},
        {"key":"c","id":"ssl12","display":"SSL 12","kind":"installed"}]'
  new="$(new_cards "$cur" "$prev")"
  gone="$(gone_cards "$cur" "$prev")"
  [[ $(jq length <<<"$new") == 1 && $(jq -r '.[0].id' <<<"$new") == ugm192 ]] || fail=1
  [[ $(jq length <<<"$gone") == 1 && $(jq -r '.[0].id' <<<"$gone") == ssl12 ]] || fail=1
  # An old key-only seen file must not announce every old card as unplugged.
  gone="$(gone_cards "$cur" '["a","c"]')"
  [[ $(jq length <<<"$gone") == 0 ]] || fail=1
  # --exec must come after the headline/body: it consumes the rest of the line.
  # A known card instead uses two --action buttons: the body click (first)
  # opens + uses, the second only selects.
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    local stub argv=() i head_i=-1 exec_i=-1 actions=0 uses=0 selects=0
    stub="$(mktemp)"
    omarchy-notification-send(){ printf '%s\n' "$@" >"$stub"; }
    send_notification evo8 'Audient EVO 8' install
    mapfile -t argv <"$stub"
    for i in "${!argv[@]}"; do
      [[ ${argv[i]} == Mixbay ]] && head_i=$i
      [[ ${argv[i]} == --exec ]] && exec_i=$i
    done
    ((head_i > -1 && exec_i > head_i)) || fail=1
    send_notification evo8 'Audient EVO 8' installed
    unset -f omarchy-notification-send
    mapfile -t argv <"$stub"
    rm -f "$stub"
    for i in "${!argv[@]}"; do
      case ${argv[i]} in
        --action) actions=$((actions + 1)) ;;
        --use-card) uses=$((uses + 1)) ;;
        --select-card) selects=$((selects + 1)) ;;
      esac
    done
    ((actions == 2 && uses == 1 && selects == 1)) || fail=1
  fi
  ((fail)) && { printf 'self-test failed\n' >&2; return 1; }
  printf 'self-test ok\n'
}

case "${1:-}" in
  --self-test) self_test ;;
  "") main ;;
  *) printf 'usage: %s [--self-test]\n' "$0" >&2; exit 2 ;;
esac
