    transport.append(V("DrawMode", Value=False))
    ls.append(transport)
    ls.append(V("SessionScrollPos", X=0, Y=0))
    ls.append(V("SelectedBreakpointValue", Value=0))
    ls.append(ET.Element("SignalModulations"))
