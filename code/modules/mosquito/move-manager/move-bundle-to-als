def load_song(path: str) -> tuple[str, dict]:
    """Return (set_name, song dict) from a bundle, .abl or prepared .als."""
    base = os.path.basename(path)
    if zipfile.is_zipfile(path):
        with zipfile.ZipFile(path) as zf:
            candidates = [n for n in zf.namelist() if n.lower().endswith((".abl", ".als"))]
            candidates.sort(key=lambda n: (n.lower() != "song.abl", len(n)))
            if not candidates:
                raise ValueError("no Song.abl/.abl/.als entry in the bundle")
            doc = candidates[0]
            return os.path.splitext(base)[0], json.loads(zf.read(doc).decode("utf-8", "replace"))
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        return os.path.splitext(base)[0], json.load(fh)


def build_liveset(ids: Ids, song: dict) -> ET.Element:
    tempo = float(song.get("tempo", 120.0))
    ts = song.get("timeSignature", {}) or {}
    numerator = int(ts.get("upper", 4))
    denominator = int(ts.get("lower", 4) or 4)

    tracks_el = ET.Element("Tracks")
    track_models = [t for t in song.get("tracks", []) if t.get("kind") == "midi"]
    for i, t in enumerate(track_models):
        name = t.get("name") or f"Track {i + 1}"
        color = t.get("color")
        if color is None:
            color = -1
        try:
            color = int(color)
        except (TypeError, ValueError):
            color = -1
        slots: list[ET.Element] = []
        clip_slots_data = t.get("clipSlots", [])
        for j, slot in enumerate(clip_slots_data):
            clip = slot.get("clip")
            slots.append(clip_slot(ids, j,
                                   midi_clip(ids, clip.get("notes", []),
                                             numerator=numerator, denominator=denominator)
                                   if clip else None))
        tracks_el.append(midi_track(ids, i, name, color, slots))

    n_slots = max((len(t.get("clipSlots", [])) for t in track_models), default=8)
    n_slots = max(n_slots, 1)

    ls = ET.Element("LiveSet")
    ls.append(V("NextPointeeId", Value=ids.n + 5000))
    ls.append(V("OverwriteProtectionNumber", Value=1))
    ls.append(V("LomId", Value=0))
    ls.append(V("LomIdView", Value=0))
    ls.append(tracks_el)
    ls.append(main_track(ids, tempo, numerator, denominator, n_slots))
    ls.append(prehear_track(ids, n_slots))
    sends = ET.Element("SendsPre")
    ls.append(sends)
    scenes = ET.Element("Scenes")
    for i in range(n_slots):
        scenes.append(scene(ids, i))
    ls.append(scenes)
    transport = ET.Element("Transport")
    transport.append(V("PhaseNudgeTempo", Value=10))
    transport.append(V("LoopOn", Value=True))
    transport.append(V("LoopStart", Value=0))
