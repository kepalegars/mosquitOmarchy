def convert(path: str, outdir: str) -> str:
    name, song = load_song(path)
    if name.lower().endswith(".als") and not zipfile.is_zipfile(path):
        raise ValueError("native Live .als files are not converted — open them in Ableton first")

    ids = Ids()
    ls = build_liveset(ids, song)
    root = ET.Element("Ableton",
                     {"MajorVersion": ALSBON_MAJOR, "MinorVersion": ALSBON_MINOR,
                      "SchemaChangeCount": SCHEMA_CHANGE_COUNT, "Creator": CREATOR})
    root.append(ls)

    ET.indent(root, space="\t")
    xml = b"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" + ET.tostring(root, encoding="utf-8")

    os.makedirs(outdir, exist_ok=True)
    out = os.path.join(outdir, f"{os.path.splitext(name)[0]}.als")
    with gzip.GzipFile(filename=out, mode="wb", mtime=0) as fh:
        fh.write(xml)
    return out


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("set", help=".abletonbundle/.ablbundle (zip) or .abl/Song.abl file")
    ap.add_argument("-o", "--output", default=".", help="output directory (default: current)")
    args = ap.parse_args()

    try:
        out = convert(args.set, args.output)
    except (OSError, ValueError, json.JSONDecodeError, KeyError, ET.ParseError) as e:
        print(f"move-bundle-to-als: error: {e}", file=sys.stderr)
        return 1
    print(out)
    return 0


if __name__ == "__main__":
    sys.exit(main())