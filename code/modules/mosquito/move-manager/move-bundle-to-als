    pt.append(V("IsContentSelectedInDocument", Value=True))
    pt.append(V("PreferredContentViewMode", Value=0))
    delay = ET.Element("TrackDelay")
    delay.append(V("Manual", Value=0))
    pt.append(delay)
    pt.append(V("Name", Value="PreHear"))
    pt.append(V("Color", Value=1107296256))
    pt.append(ET.Element("AutomationEnvelopes"))
    pt.append(V("TrackGroupId", Value=-1))
    pt.append(V("TrackUnfolded", Value=True))
    pt.append(V("DevicesListWrapper", LomId=0))
    pt.append(V("ClipSlotsListWrapper", LomId=0))
    pt.append(V("ArrangementClipsListWrapper", LomId=0))
    pt.append(V("TakeLanesListWrapper", LomId=0))
    pt.append(V("ViewData", Value="{}"))
    pt.append(ET.Element("TakeLanes"))
    pt.append(V("LinkedTrackGroupId", Value=0))
    pt.append(device_chain(ids, slots))
    return pt


