#!/usr/bin/env bash
# =============================================================================
# reboot-into-windows — set the one-shot UEFI BootNext to Windows and reboot.
# =============================================================================
# The System menu entry starts this in a floating terminal. It shows a 15 s
# countdown with a yes/no confirmation (timeout and "n" cancel, nothing is
# written), then:
#   1. writes BootNext for the "Windows Boot Manager" entry (efibootmgr),
#   2. verifies that BootNext stuck and that the boot order is untouched,
#   3. reboots through Omarchy's own reboot (or systemctl reboot --no-wall).
#
# Only BootNext is touched: the saved boot order, the active flags and the
# firmware timeout stay as they are. The firmware consumes the variable on the
# next boot, so the boot after that follows the normal order again.
#
# Usage:
#   reboot-into-windows              # list, countdown, confirm, reboot
#   reboot-into-windows --list       # show the Windows entry, do nothing
#   reboot-into-windows --yes        # no countdown/prompt (non-interactive)
#   reboot-into-windows --dry-run    # print what would be run
#   reboot-into-windows --clear-next # drop a BootNext left armed
# =============================================================================
set -euo pipefail

EFIBOOTMGR="${EFIBOOTMGR:-efibootmgr}"
COUNTDOWN="${REBOOT_INTO_WINDOWS_COUNTDOWN:-15}"
REBOOT_CMD="${REBOOT_INTO_WINDOWS_REBOOT:-}"

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
ok()   { printf ' \033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf ' \033[1;33m!\033[0m %s\n' "$*" >&2; }
err()  { printf ' \033[1;31m✗\033[0m %s\n' "$*" >&2; }

pause_on_error() {
  [[ -t 0 && -t 1 ]] || return 0
  printf '\nPress Enter to close…'
  read -r _ || true
}

MODE=run
for a in "$@"; do case "$a" in
  --list) MODE=list ;;
  --yes|-y) MODE=yes ;;
  --dry-run) MODE=dry ;;
  --clear-next) MODE=clear ;;
  -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
  *) err "Unknown option: $a"; exit 2 ;;
esac; done

command -v "$EFIBOOTMGR" >/dev/null 2>&1 || {
  err "efibootmgr is not installed (UEFI only)."
  pause_on_error
  exit 1
}

# Root via cached sudo when possible, otherwise the session polkit prompt.
# A cached sudo that still refuses the write (rare) falls through to pkexec.
efi_write() {
  if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
    "$EFIBOOTMGR" "$@"
    return
  fi
  if sudo -n true 2>/dev/null && sudo -n "$EFIBOOTMGR" "$@" 2>/dev/null; then
    return 0
  fi
  pkexec "$EFIBOOTMGR" "$@"
}

# Read the firmware once. A non-UEFI machine makes efibootmgr fail; report it
# instead of pretending the Windows entry is missing.
if ! FIRMWARE="$("$EFIBOOTMGR" 2>&1)"; then
  err "Cannot read the UEFI boot entries:"
  printf '%s\n' "$FIRMWARE" >&2
  pause_on_error
  exit 1
fi

# Prefer an active "Windows Boot Manager" (the Windows installer's own name),
# then any active entry mentioning Windows. Format:
#   Boot0001* Windows Boot Manager  HD(1,GPT,...)/File(\EFI\Microsoft\...)
WIN_ID=""
WIN_LABEL=""
while IFS= read -r line; do
  [[ $line =~ ^Boot([0-9A-Fa-f]{4})(\*?)[[:space:]]+(.*)$ ]] || continue
  id="${BASH_REMATCH[1]^^}"
  active="${BASH_REMATCH[2]}"
  label="${BASH_REMATCH[3]%%$'\t'*}"
  label="${label%"${label##*[![:space:]]}"}"
  label="${label#"${label%%[![:space:]]*}"}"
  shopt -s nocasematch
  if [[ $label == *"windows boot manager"* ]]; then
    if [[ $active == "*" ]]; then WIN_ID="$id"; WIN_LABEL="$label"; break; fi
    [[ -z $WIN_ID ]] && { WIN_ID="$id"; WIN_LABEL="$label"; }
  elif [[ -z $WIN_ID && $label == *windows* ]]; then
    WIN_ID="$id"; WIN_LABEL="$label"
  fi
  shopt -u nocasematch
done <<< "$FIRMWARE"

if [[ -z $WIN_ID ]]; then
  err "No Windows Boot Manager entry found in the UEFI boot menu."
  echo "  Install Windows on this machine (or restore its EFI entry) first."
  echo "  Entries seen:"
  sed -n 's/^Boot[0-9A-Fa-f]\{4\}\*\{0,1\}[[:space:]]\{1,\}//p' <<< "$FIRMWARE" | sed 's/^/    - /'
  pause_on_error
  exit 1
fi

current_next="$(sed -n 's/^BootNext:[[:space:]]*\([0-9A-Fa-f]\{4\}\).*/\1/p' <<< "$FIRMWARE" | head -1)"

case $MODE in
  list)
    info "Windows entry: Boot${WIN_ID} — ${WIN_LABEL}"
    [[ -n $current_next ]] && info "Next boot is already armed: BootNext=${current_next}"
    exit 0
    ;;
  clear)
    if [[ -z $current_next ]]; then ok "No BootNext is armed."; exit 0; fi
    info "Clearing BootNext=${current_next}"
    if ! efi_write --delete-bootnext; then
      err "Could not clear BootNext (authorization declined or efibootmgr failed)."
      pause_on_error
      exit 1
    fi
    ok "BootNext cleared."
    exit 0
    ;;
  dry)
    info "Would arm Boot${WIN_ID} (${WIN_LABEL}) for the next boot, then reboot."
    echo "  $EFIBOOTMGR --bootnext ${WIN_ID}"
    echo "  omarchy-system-reboot   (or systemctl reboot --no-wall)"
    exit 0
    ;;
esac

# ---------------------------------------------------------------------------
# Confirmation with a countdown. The countdown is the cooling-off period:
# nothing is written until it reaches zero AND the answer is "yes". A
# timeout is a "no" (the safe answer), and n/Esc cancel immediately.
# ---------------------------------------------------------------------------
CONFIRMED=0
if [[ $MODE == yes ]]; then
  CONFIRMED=1
else
  [[ -t 0 && -t 1 ]] || { err "Not a terminal: use --yes for a non-interactive run."; exit 1; }
  secs="$COUNTDOWN"
  [[ $secs =~ ^[0-9]+$ ]] || secs=15
  printf '\n'
  info "Windows entry: Boot${WIN_ID} — ${WIN_LABEL}"
  printf '  Reboot into Windows in %d s. The saved boot order is not changed.\n' "$secs"
  printf '  Confirm? [y/N]  '
  while (( secs > 0 )); do
    if read -r -t 1 -n 1 key; then
      case $key in
        y|Y) CONFIRMED=1; printf '\n'; break ;;
        n|N|q|Q|$'\e') printf '\n'; break ;;
      esac
    fi
    secs=$((secs - 1))
    printf '\r  Confirm? [y/N]  %2d s  ' "$secs"
  done
  printf '\r%*s\r' 40 ''
fi

if (( CONFIRMED == 0 )); then
  warn "Cancelled — next boot was not armed."
  exit 0
fi

# ---------------------------------------------------------------------------
# Write BootNext, then verify. A write that did not stick must never reboot:
# the machine would come back to Omarchy and the user would think it worked.
# ---------------------------------------------------------------------------
before_order="$(sed -n 's/^BootOrder:[[:space:]]*//p' <<< "$FIRMWARE" | head -1)"

info "Arming next boot: Boot${WIN_ID}"
if ! efi_write --bootnext "$WIN_ID"; then
  err "Could not arm BootNext (authorization declined or efibootmgr failed)."
  pause_on_error
  exit 1
fi

after="$("$EFIBOOTMGR" 2>&1)" || {
  err "efibootmgr failed after writing BootNext."
  pause_on_error
  exit 1
}
after_next="$(sed -n 's/^BootNext:[[:space:]]*\([0-9A-Fa-f]\{4\}\).*/\1/p' <<< "$after" | head -1)"
after_order="$(sed -n 's/^BootOrder:[[:space:]]*//p' <<< "$after" | head -1)"

if [[ ${after_next^^} != "$WIN_ID" ]]; then
  err "BootNext did not stick (read back: '${after_next:-none}') — the reboot was not started."
  pause_on_error
  exit 1
fi
if [[ -n $before_order && "$after_order" != "$before_order" ]]; then
  err "The firmware boot order changed — the reboot was not started."
  echo "  before: $before_order" >&2
  echo "  after:  $after_order" >&2
  pause_on_error
  exit 1
fi
ok "Next boot armed: Boot${WIN_ID}. Rebooting…"

if [[ -n $REBOOT_CMD ]]; then
  # Test/advanced hook: keep it a single argv, never a shell string.
  exec $REBOOT_CMD
elif command -v omarchy-system-reboot >/dev/null 2>&1; then
  exec omarchy-system-reboot
else
  exec systemctl reboot --no-wall
fi
