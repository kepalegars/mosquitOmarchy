#!/usr/bin/env bash
# Power-profile helper for the mosquito.power Omarchy plugin.
# Output is plain key\tvalue per line for Model.parseKeyValue.
set -euo pipefail

_crash_lib="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/lib/crash.bash"
[[ -f $_crash_lib ]] && { source "$_crash_lib"; mq_crash_guard "power-helper"; }

REAL_HOME="${HOME:-}"
if [[ -z $REAL_HOME ]]; then
  REAL_USER="${SUDO_USER:-${LOGNAME:-$USER}}"
  REAL_HOME=$(eval echo "~${REAL_USER}" 2>/dev/null || echo "$HOME")
fi
LIVE_ACTIVE="$REAL_HOME/.local/state/live-mode/active"
LIVE_SETTINGS="$REAL_HOME/.config/live-mode/settings"

profile_status() {
  printf 'profile\t%s\n' "$(powerprofilesctl get 2>/dev/null || echo unknown)"
  printf 'live\t%s\n' "$( [[ -f $LIVE_ACTIVE ]] && echo on || echo off )"
}

confirm() {
  local message="$1" dir="${XDG_RUNTIME_DIR:-/tmp}/mosquito-power-helper.$$"
  local sel donef payload ans=""
  sel="$dir/answer"; donef="$dir/done"
  mkdir -p "$dir" || return 1
  rm -f "$sel" "$donef"
  payload=$(jq -cn --arg message "$message" --arg selectionFile "$sel" --arg doneFile "$donef" \
    '{message:$message,selectionFile:$selectionFile,doneFile:$doneFile}') || { rm -rf "$dir"; return 1; }
  omarchy-shell shell summon mosquito.confirm "$payload" >/dev/null 2>&1 || true
  local i
  for i in $(seq 1 60); do [[ -f $donef ]] && break; sleep 0.5; done
  [[ -f $donef ]] && ans=$(cat "$sel" 2>/dev/null || true)
  rm -rf "$dir"
  [[ $ans == yes ]]
}

profile_set() {
  local source="${1:-ac}" want="${2:-}"
  [[ -n $want ]] || { printf 'error\tprofile-set needs a profile\n' >&2; exit 1; }
  if [[ -f $LIVE_ACTIVE && $want == power-saver ]]; then
    printf 'error\tPower-saver is unavailable while Live Mode is on.\nerror\tEnd the session first: live-mode off\n' >&2
    profile_status
    return 1
  fi
  if [[ -f $LIVE_ACTIVE ]]; then
    local prompt=yes current
    if [[ -f $LIVE_SETTINGS ]]; then
      # shellcheck source=/dev/null
      source "$LIVE_SETTINGS" 2>/dev/null || true
      [[ ${POWER_PROFILE_PROMPT:-yes} == no ]] && prompt=no
    fi
    current=$(powerprofilesctl get 2>/dev/null || echo unknown)
    if [[ $prompt != no && $want != "$current" ]]; then
      local question="Live Mode is ON and holds the machine at the performance profile."
      question+=$'\n\n'"Switch to '$want' (currently '$current') anyway?"
      if ! confirm "$question"; then
        printf 'profile\t%s\nnote\tLeft the power profile alone.\n' "$current"
        return 0
      fi
    fi
  fi
  omarchy-powerprofiles-set "$source" "$want" >/dev/null 2>&1 || {
    echo "error\tcould not set power profile to $want" >&2; return 1;
  }
  sleep 0.2
  profile_status
}

case "${1:-}" in
  profile)
    case "${2:-}" in
      set) profile_set "${3:-ac}" "${4:-}" ;;
      state) profile_status ;;
      *) echo "Usage: $0 profile set <ac|battery> <profile> | profile state" >&2; exit 1 ;;
    esac
    ;;
  *) echo "Usage: $0 profile {set <ac|battery> <profile>|state}" >&2; exit 1 ;;
esac
