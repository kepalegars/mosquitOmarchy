      // >>> mosquito-hotspot-zone >>> (managed by setup-wifi-hotspot.sh — re-applied on reinstall, do not edit by hand)
      //
      // Wi-Fi hotspot zone, forked from Guneshbari/omarchy-network (header
      // with band qualifier + gear + switch, subtitle, options): same look,
      // the forked mosquito-hotspot backend. Two mosquito adaptations: the
      // repeater/create_ap flows are out (no create_ap here — plain NM access
      // point), and the gear toggles the options below instead of opening
      // inline editors (editing happens in the mosquito-hotspot-tui terminal
      // UI, via the "Edit…" row). No keyboard-cursor wiring, like the rest
      // of this panel's mosquito additions.
      QtObject {
        id: hotspot

        property bool hasAp: false
        property string ssid: "Omarchy-Hotspot"
        property string password: ""
        property string band: "bg"
        property bool active: false
        property int clients: 0
        property bool busy: false
        property string statusMsg: ""
        property bool statusIsError: false
        property bool showOptions: false
        property bool passwordVisible: false
        property string errBuf: ""
        property string backend: Quickshell.env("MOSQUITO_HOTSPOT") ||
            (Quickshell.env("HOME") + "/.local/bin/mosquito-hotspot")

        function bandName(b) { return b === "a" ? "5 GHz" : "2.4 GHz" }
        function update(text) {
          try {
            var st = JSON.parse(String(text).trim())
            hotspot.hasAp = !!st.hasAp
            hotspot.ssid = st.ssid || "Omarchy-Hotspot"
            hotspot.password = st.password || ""
            hotspot.band = st.band || "bg"
            hotspot.active = !!st.active
            hotspot.clients = st.clients || 0
            if (st.active) { hotspot.statusMsg = ""; hotspot.statusIsError = false }
          } catch (e) {}
          hotspot.busy = false
        }
        function refresh() {
          if (hotspotProc.running) return
          hotspot.errBuf = ""
          hotspotProc.command = [hotspot.backend, "status"]
          hotspotProc.running = true
        }
        function toggle() {
          if (hotspot.busy || hotspotProc.running) return
          hotspot.busy = true
          hotspot.errBuf = ""
          hotspot.statusMsg = hotspot.active ? "Stopping hotspot..." : "Starting hotspot..."
          hotspot.statusIsError = false
          hotspotProc.command = [hotspot.backend, "toggle"]
          hotspotProc.running = true
        }
        function toggleOptions() { hotspot.showOptions = !hotspot.showOptions }
        function togglePassword() { hotspot.passwordVisible = !hotspot.passwordVisible }
        function openSetup() {
          Quickshell.execDetached(["foot", "-e", Quickshell.env("HOME") + "/.local/bin/mosquito-hotspot-tui"])
        }

        property Process hotspotProc: Process {
          stdout: StdioCollector {
            waitForEnd: true
            onStreamFinished: hotspot.update(text)
          }
          stderr: StdioCollector {
            waitForEnd: true
            onStreamFinished: function(text) { hotspot.errBuf += String(text || "") }
          }
          // Surface stderr only on failure (the backend chats on stderr
          // while working); then re-read, like after every run.
          onExited: function(code) {
            if (code !== 0 && hotspot.errBuf.trim() !== "") {
              hotspot.statusMsg = hotspot.errBuf.trim().split("\n")[0]
              hotspot.statusIsError = true
            }
            hotspot.errBuf = ""
            if (hotspot.busy) hotspot.refresh()
          }
        }
        property Timer hotspotPoll: Timer {
          interval: 5000
          repeat: true
          running: root.opened
          onTriggered: hotspot.refresh()
        }
        property Timer hotspotOpenDelay: Timer {
          interval: 150
          repeat: false
          running: root.opened
          onTriggered: hotspot.refresh()
        }
      }

      PanelSeparator {
        visible: root.kind === "wifi" && hotspot.hasAp
        foreground: root.bar.foreground
      }

      Column {
        id: hotspotSection
        visible: root.kind === "wifi" && hotspot.hasAp
        width: parent.width
        spacing: Style.space(8)

        // Header line: title on the left, band label + gear + switch on the
        // right — the wifi-band line's exact geometry (small qualifier
        // label sized like AUTOMATIC, switch measured off it, same spacing
        // and glyph-centering offsets). No badge pill: the two boxes fought
        // each other.
        Item {
          width: parent.width
          implicitHeight: Math.max(hotspotHeader.implicitHeight, hotspotStateRow.implicitHeight)

          PanelSectionHeader {
            id: hotspotHeader
            text: "WI-FI HOTSPOT"
            foreground: root.bar.foreground
            fontFamily: root.bar.fontFamily
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
          }

          Row {
            id: hotspotStateRow
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            spacing: Style.space(6)

            PanelSectionHeader {
              id: hotspotStateLabel
              text: hotspot.band === "a" ? "5 GHZ" : "2.4 GHZ"
              foreground: root.bar.foreground
              fontFamily: root.bar.fontFamily
              anchors.verticalCenter: parent.verticalCenter
            }

            Text {
              id: hotspotGear
              text: "\uf013"
              color: root.bar.foreground
              opacity: hotspotGearArea.containsMouse ? 1 : 0.55
              font.family: root.bar.fontFamily
              font.pixelSize: hotspotStateLabel.font.pixelSize
              anchors.verticalCenter: hotspotStateLabel.verticalCenter
              anchors.verticalCenterOffset: Math.round(hotspotStateLabel.topPadding / 2)

              MouseArea {
                id: hotspotGearArea
                anchors.fill: parent
                hoverEnabled: true
                cursorShape: Qt.PointingHandCursor
                onClicked: hotspot.toggleOptions()
              }

              PanelToolTip {
                visible: hotspotGearArea.containsMouse
                text: hotspot.showOptions ? "Hide hotspot options" : "Show hotspot options"
                fontFamily: root.bar.fontFamily
              }
            }

            ToggleSwitch {
              id: hotspotSwitch
              trackHeight: Math.round(hotspotStateLabel.font.pixelSize * 1.2)
              cursorPad: Style.space(3)
              anchors.verticalCenter: hotspotStateLabel.verticalCenter
              anchors.verticalCenterOffset: Math.round(hotspotStateLabel.topPadding / 2)
              checked: hotspot.active
              busy: hotspot.busy
              foreground: root.bar.foreground
              onToggled: hotspot.toggle()

              PanelToolTip {
                visible: hotspotSwitch.containsMouse
                text: hotspot.active
                  ? ("Hotspot on" + (hotspot.clients > 0 ? " (" + hotspot.clients + " connected)" : "") + " — turn off")
                  : "Turn the hotspot on"
                fontFamily: root.bar.fontFamily
              }
            }
          }
        }

        // Subtitle: what the hotspot is doing. Nothing when off — no
        // "hotspot off" line taking space for stating the obvious.
        Text {
          textFormat: Text.PlainText
          visible: hotspot.statusMsg === "" && hotspot.active
          text: "Broadcasting " + hotspot.ssid + (hotspot.clients > 0 ? " · " + hotspot.clients + " connected" : "")
          color: Qt.darker(root.bar.foreground, 1.4)
          font.family: root.bar.fontFamily
          font.pixelSize: Style.font.caption
          wrapMode: Text.WordWrap
          width: parent.width
        }

        // Status message: working ("Starting…") or the backend's error.
        Text {
          textFormat: Text.PlainText
          text: hotspot.statusMsg
          color: hotspot.statusIsError ? Color.urgent : Color.accent
          font.family: root.bar.fontFamily
          font.pixelSize: Style.font.caption
          wrapMode: Text.WordWrap
          width: parent.width
          visible: text !== ""
        }

        // Options, toggled by the gear: current values, read-only, plus the
        // terminal editor entry. Values are edited in mosquito-hotspot-tui.
        Column {
          visible: hotspot.showOptions
          width: parent.width
          spacing: Style.space(6)

          Item {
            width: parent.width
            implicitHeight: Math.max(hsSsidLabel.implicitHeight, hsSsidValue.implicitHeight)

            Text {
              id: hsSsidLabel
              text: "hsSsidLabel"
              color: Qt.darker(root.bar.foreground, 1.4)
              font.family: root.bar.fontFamily
              font.pixelSize: Style.font.caption
              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
            }

            Text {
              id: hsSsidValue
              textFormat: Text.PlainText
              text: hotspot.ssid
              color: root.bar.foreground
              font.family: root.bar.fontFamily
              font.pixelSize: Style.font.body
              anchors.right: parent.right
              anchors.verticalCenter: parent.verticalCenter
            }
          }
          Item {
            width: parent.width
            implicitHeight: Math.max(hsPwdLabel.implicitHeight, hsPwdValue.implicitHeight)

            Text {
              id: hsPwdLabel
              text: "Password"
              color: Qt.darker(root.bar.foreground, 1.4)
              font.family: root.bar.fontFamily
              font.pixelSize: Style.font.caption
              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
            }

            Text {
              id: hsPwdValue
              textFormat: Text.PlainText
              text: hotspot.password === "" ? "(not set)" : (hotspot.passwordVisible ? hotspot.password : "••••••••")
              color: root.bar.foreground
              font.family: root.bar.fontFamily
              font.pixelSize: Style.font.body
              anchors.right: parent.right
              anchors.verticalCenter: parent.verticalCenter
            }

            Text {
              id: hsPwdEye
              text: hotspot.passwordVisible ? "[hide]" : "[show]"
              color: root.bar.foreground
              opacity: hsPwdEyeArea.containsMouse ? 1 : 0.55
              font.family: root.bar.fontFamily
              font.pixelSize: Style.font.caption
              anchors.right: hsPwdValue.left
              anchors.rightMargin: Style.space(6)
              anchors.verticalCenter: hsPwdValue.verticalCenter
              MouseArea {
                id: hsPwdEyeArea
                anchors.fill: parent
                hoverEnabled: true
                cursorShape: Qt.PointingHandCursor
                onClicked: hotspot.togglePassword()
              }
              PanelToolTip {
                visible: hsPwdEyeArea.containsMouse
                text: hotspot.passwordVisible ? "Hide password" : "Show password"
                fontFamily: root.bar.fontFamily
              }
            }
          }
          Item {
            width: parent.width
            implicitHeight: Math.max(hsBandLabel.implicitHeight, hsBandValue.implicitHeight)

            Text {
              id: hsBandLabel
              text: "hsBandLabel"
              color: Qt.darker(root.bar.foreground, 1.4)
              font.family: root.bar.fontFamily
              font.pixelSize: Style.font.caption
              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
            }

            Text {
              id: hsBandValue
              textFormat: Text.PlainText
              text: hotspot.band === "a" ? "5 GHz" : "2.4 GHz"
              color: root.bar.foreground
              font.family: root.bar.fontFamily
              font.pixelSize: Style.font.body
              anchors.right: parent.right
              anchors.verticalCenter: parent.verticalCenter
            }
          }
          Item {
            width: parent.width
            implicitHeight: Math.max(hsClientsLabel.implicitHeight, hsClientsValue.implicitHeight)

            Text {
              id: hsClientsLabel
              text: "hsClientsLabel"
              color: Qt.darker(root.bar.foreground, 1.4)
              font.family: root.bar.fontFamily
              font.pixelSize: Style.font.caption
              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
            }

            Text {
              id: hsClientsValue
              textFormat: Text.PlainText
              text: hotspot.active ? String(hotspot.clients) : "—"
              color: root.bar.foreground
              font.family: root.bar.fontFamily
              font.pixelSize: Style.font.body
              anchors.right: parent.right
              anchors.verticalCenter: parent.verticalCenter
            }
          }

          Text {
            text: "Edit settings in terminal…"
            color: Color.accent
            font.family: root.bar.fontFamily
            font.pixelSize: Style.font.body
            width: parent.width
            horizontalAlignment: Text.AlignRight
            MouseArea {
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onClicked: hotspot.openSetup()
            }
          }
        }
      }
      // <<< mosquito-hotspot-zone <<<
