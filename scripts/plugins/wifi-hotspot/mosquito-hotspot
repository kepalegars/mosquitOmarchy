}
IFS= read -r pwd
pwd=$(printf "%s" "$pwd" | tr -d "\r\n")
action="$1"; con="$2"; ssid="$3"; band="$4"
if [[ "$action" != "save" && "$action" != "toggle" && "$action" != "stop" ]]; then exit 1; fi
con=$(printf "%s" "$con" | tr -d "\r\n")
if [[ -z "$con" || "$con" == -* ]]; then con="Hotspot"; fi
ssid=$(printf "%s" "$ssid" | tr -d "\r\n")
if [[ -z "$ssid" || ${#ssid} -gt 32 || "$ssid" =~ [^[:print:]] ]]; then ssid="Omarchy-Hotspot"; fi
if [[ "$band" != "a" ]]; then band="bg"; fi
ap_helper='# create-ap-root <start|stop> [create_ap args]
# Runs as root (pkexec). create_ap keeps shared state in /tmp/create_ap.common.conf
# and, on cleanup, runs kill -9 on whatever PID is written in its *.pid files. Any
# local user can pre-create that directory in /tmp, so it is verified (or replaced)
# here, inside the privileged context, before create_ap ever touches it. No
# passphrase is passed through here: create_ap reads it from a private --config file.
set -u
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 022
common=/tmp/create_ap.common.conf

harden_common() {
  local mode f
  if [[ ! -k /tmp ]]; then
    echo "Refusing to run: /tmp is not sticky" >&2
    return 1
  fi
  if [[ -L "$common" ]]; then
    rm -f -- "$common" || return 1
  fi
  if [[ -e "$common" ]]; then
    mode=$(stat -c %a -- "$common" 2>/dev/null || echo 777)
    if [[ ! -d "$common" || "$(stat -c %u -- "$common" 2>/dev/null)" != 0 || $(( 8#$mode & 8#022 )) -ne 0 ]]; then
      rm -rf --one-file-system -- "$common" || return 1
    fi
  fi
  if [[ ! -e "$common" ]]; then
    mkdir -m 0755 -- "$common" 2>/dev/null || true
  fi
  if [[ -L "$common" || ! -d "$common" || "$(stat -c %u -- "$common" 2>/dev/null)" != 0 ]]; then
    echo "Refusing to run: cannot secure $common" >&2
    return 1
  fi
  for f in "$common"/*.pid; do
    [[ -e "$f" || -L "$f" ]] || continue
    if [[ -L "$f" || ! -f "$f" || "$(stat -c %u -- "$f" 2>/dev/null)" != 0 ]]; then
      rm -f -- "$f"
    fi
  done
  return 0
}

is_create_ap_pid() {
  [[ "$1" =~ ^[0-9]+$ && -r "/proc/$1/cmdline" ]] || return 1
  tr "\0" " " < "/proc/$1/cmdline" 2>/dev/null | grep -q create_ap
}

owned_by_root() {
  [[ -e "$1" && ! -L "$1" && "$(stat -c %u -- "$1" 2>/dev/null)" == 0 ]]
}

# Stale dnsmasq left behind by a create_ap instance that is no longer running.
reap_stale_dnsmasq() {
  local d pid dp
  for d in /tmp/create_ap.*.conf.*; do
    [[ -d "$d" ]] && owned_by_root "$d" || continue
    pid=$(cat "$d/pid" 2>/dev/null)
    is_create_ap_pid "$pid" && continue
    owned_by_root "$d/dnsmasq.pid" || continue
    dp=$(cat "$d/dnsmasq.pid" 2>/dev/null)
    [[ "$dp" =~ ^[0-9]+$ && -r "/proc/$dp/cmdline" ]] || continue
    if tr "\0" " " < "/proc/$dp/cmdline" 2>/dev/null | grep -q dnsmasq; then
      kill "$dp" 2>/dev/null || true
    fi
  done
}

# Only a root-owned create_ap that nobody else can write to is ever executed.
create_ap_bin=""
for c in /usr/local/bin/create_ap /usr/bin/create_ap; do
  if [[ -f "$c" && -x "$c" && ! -L "$c" && "$(stat -c %u -- "$c" 2>/dev/null)" == 0 ]] \
    && (( ( 8#$(stat -c %a -- "$c" 2>/dev/null || echo 777) & 8#022 ) == 0 )); then
    create_ap_bin="$c"
    break
  fi
done
if [[ -z "$create_ap_bin" ]]; then
  echo "create_ap is not installed (or is writable by non-root users)" >&2
  exit 1
fi

case "${1:-}" in
  start)
    shift
    harden_common || exit 1
    reap_stale_dnsmasq
    exec "$create_ap_bin" "$@"
    ;;
  stop)
    harden_common || exit 1
    for d in /tmp/create_ap.*.conf.*; do
      [[ -d "$d" ]] && owned_by_root "$d" && owned_by_root "$d/pid" || continue
      pid=$(cat "$d/pid" 2>/dev/null)
      is_create_ap_pid "$pid" && "$create_ap_bin" --stop "$pid" >/dev/null 2>&1
    done
    reap_stale_dnsmasq
    exit 0
    ;;
  *)
    exit 2
    ;;
esac
'
dev=$(nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2=="wifi"{print $1; exit}')
if [[ -n "$dev" && ! "$dev" =~ ^[a-zA-Z0-9_.-]+$ ]]; then dev=""; fi

# No built-in default passphrase: an empty one becomes a random per-device secret.
generated="false"
prepare_password() {
  if [[ -z "$pwd" ]]; then
    # Nothing supplied: keep the passphrase already saved in the profile.
    pwd=$(nmcli -s -g 802-11-wireless-security.psk connection show id "$con" 2>/dev/null | head -n 1)
  fi
  if [[ -z "$pwd" ]]; then
    pwd=$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 16)
    generated="true"
  fi
  if [[ ${#pwd} -lt 8 || ${#pwd} -gt 63 || "$pwd" =~ [^[:print:]] ]]; then
    echo "Invalid password: must be 8-63 printable ASCII characters" >&2
    exit 1
  fi
}

# Persist SSID/band/passphrase in the NetworkManager profile. The passphrase goes
# through the scriptable `connection edit` editor on stdin (printf is a builtin), so
# it never appears in any argv.
save_profile() {
  local nm_out err_detail
  if ! nmcli connection show id "$con" >/dev/null 2>&1; then
    if ! nm_out=$(nmcli con add type wifi con-name "$con" autoconnect no ssid "$ssid" \
      802-11-wireless.mode ap 802-11-wireless.band "$band" \
      802-11-wireless-security.key-mgmt wpa-psk \
      802-11-wireless-security.proto rsn \
      802-11-wireless-security.pairwise ccmp \
      802-11-wireless-security.group ccmp \
      802-11-wireless-security.pmf 1 \
      ipv4.method shared ipv6.method ignore ${dev:+ifname "$dev"} 2>&1); then
      err_detail=$(echo "$nm_out" | grep -m 1 -i "error:" | sed 's/^[Ee]rror:[[:space:]]*//')
      echo "Failed to create hotspot connection: ${err_detail:-$nm_out}" >&2
      exit 1
    fi
  else
    nmcli con modify id "$con" 802-11-wireless.ssid "$ssid" 802-11-wireless.band "$band" \
      802-11-wireless-security.key-mgmt wpa-psk \
      802-11-wireless-security.proto rsn \
      802-11-wireless-security.pairwise ccmp \
      802-11-wireless-security.group ccmp \
      802-11-wireless-security.pmf 1 \
      ipv6.method ignore >/dev/null 2>&1 || true
  fi
  if ! printf "set 802-11-wireless-security.psk %s\nsave\nquit\n" "$pwd" | nmcli connection edit id "$con" >/dev/null 2>&1; then
    echo "Failed to configure hotspot password" >&2
    exit 1
  fi
}

if [[ "$action" == "save" ]]; then
  prepare_password
  save_profile
  exit 0
fi

# A running create_ap instance is only trusted if its state dir and pid file are
# root-owned and the pid really is a root create_ap process.
ap_pid=""; ap_dir=""
find_ap() {
  local d pid
  ap_pid=""; ap_dir=""
  for d in /tmp/create_ap.*.conf.*; do
    [[ -d "$d" && ! -L "$d" && -f "$d/pid" && ! -L "$d/pid" ]] || continue
    [[ $(stat -c '%u' "$d" 2>/dev/null) -eq 0 && $(stat -c '%u' "$d/pid" 2>/dev/null) -eq 0 ]] || continue
    pid=$(cat "$d/pid" 2>/dev/null)
    [[ -n "$pid" && "$pid" =~ ^[0-9]+$ && -d "/proc/$pid" ]] || continue
    [[ $(stat -c '%u' "/proc/$pid" 2>/dev/null) -eq 0 ]] || continue
    grep -q "create_ap" "/proc/$pid/cmdline" 2>/dev/null || continue
    ap_pid="$pid"; ap_dir="$d"
    return 0
  done
  return 1
}

is_running="false"
if find_ap; then
  is_running="true"
elif nmcli -t -f NAME,ACTIVE connection show 2>/dev/null | grep -q -F -x "${con}:yes"; then
  is_running="true"
fi

if [[ "$action" == "stop" ]] || [[ "$action" == "toggle" && "$is_running" == "true" ]]; then
  if [[ -n "$ap_pid" ]]; then
    pkexec bash -c "$ap_helper" create-ap-root stop >/dev/null 2>&1 || true
  fi
  nmcli con down id "$con" >/dev/null 2>&1 || true
  exit 0
fi

prepare_password

eth_dev=$(detect_eth)
wifi_connected="false"
if [[ -n "$dev" ]] && nmcli -t -f DEVICE,STATE dev status 2>/dev/null | grep -q -F -x "${dev}:connected"; then
  wifi_connected="true"
fi

# Wired uplink -> create_ap (iptables NAT, forwarding and DHCP/DNS are all handled
# there, same as the Wi-Fi repeater). NetworkManager's own "shared" mode is only the
# fallback when linux-wifi-hotspot is not installed and there is no Wi-Fi uplink.
use_cap="false"
if [[ -x /usr/local/bin/create_ap || -x /usr/bin/create_ap ]]; then
  if [[ -n "$eth_dev" || "$wifi_connected" == "true" ]]; then use_cap="true"; fi
elif [[ -z "$eth_dev" && "$wifi_connected" == "true" ]]; then
  # MOSQUITO adaptation of the upstream fork: upstream refuses here (a
  # simultaneous repeater needs create_ap), but a plain NM access point
  # still works — it takes over the radio, so Wi-Fi drops while the
  # hotspot runs and returns after. A working AP beats a refusal; install
  # linux-wifi-hotspot for true repeater chaining instead.
  echo "note: no create_ap — plain NM hotspot (Wi-Fi disconnects while it runs)" >&2
fi

if [[ "$use_cap" == "true" ]]; then
  if [[ -z "$dev" ]]; then
    echo "No Wi-Fi adapter found" >&2
    exit 1
  fi
  [[ "$generated" == "true" ]] && save_profile
  phy=$(cat /sys/class/net/"$dev"/phy80211/name 2>/dev/null || echo "phy0")
  if [[ ! "$phy" =~ ^phy[0-9]+$ ]]; then phy="phy0"; fi
  uplink="$dev"
  freq_band="default"
  freq=""
  hostapd_n="1"
  ht_capab="[SHORT-GI-20]"
  dhcp_dns=""
  if [[ -n "$eth_dev" ]]; then
    # Wired uplink: configured like the linux-wifi-hotspot GUI does it
    # (`create_ap <wifi> <inet> ssid pass --mkconfig`), but with 802.11n explicitly
    # enabled (hostapd_n="1") to avoid capping link speeds to legacy 54 Mbps.
    uplink="$eth_dev"
    hostapd_n="1"
    ht_capab="[HT40+]"
    dhcp_dns="gateway"
    if nmcli radio wifi 2>/dev/null | grep -qi disabled; then
      nmcli radio wifi on >/dev/null 2>&1 || true
      sleep 1
    fi
    if [[ "$band" == "a" ]] && ! iw phy "$phy" info 2>/dev/null | grep -A 40 "Frequencies:" | grep -E "5[0-9]{3}(\.[0-9]+)? MHz" | grep -v -e "no IR" -e "disabled" | grep -q "MHz"; then
      band="bg"
    fi
    want_band="2.4"
    if [[ "$band" == "a" ]]; then want_band="5"; fi
    if [[ "$wifi_connected" == "true" ]]; then
      # The AP shares the radio with the station link. Keep that link when it is on
      # the requested band (create_ap follows its channel); otherwise drop it, since
      # many adapters cannot run the AP on a second channel.
      sta_freq=$(iw dev "$dev" link 2>/dev/null | grep -i "freq:" | awk '{print $2}' | cut -d. -f1)
      sta_band="2.4"
      if [[ "$sta_freq" =~ ^[0-9]+$ && "$sta_freq" -ge 5000 ]]; then sta_band="5"; fi
      if [[ "$sta_band" != "$want_band" ]]; then
        nmcli dev disconnect "$dev" >/dev/null 2>&1 || true
        sleep 1
      fi
      freq_band="$want_band"
    elif [[ "$want_band" == "5" ]]; then
      freq_band="5"
    fi
  else
    # Wi-Fi repeater: the AP has to share the channel of the active Wi-Fi link.
    freq=$(iw dev "$dev" link 2>/dev/null | grep -i "freq:" | awk '{print $2}' | cut -d. -f1)
    if [[ -n "$freq" && "$freq" =~ ^[0-9]+$ ]]; then
      ch_info=$(iw phy "$phy" info 2>/dev/null | grep -E "\* ${freq}\.[0-9]+ MHz")
      if [[ "$ch_info" == *"no IR"* ]]; then
        echo "Cannot repeat: current 5GHz Wi-Fi channel is restricted (no-IR) by card firmware. Connect to 2.4GHz Wi-Fi to repeat." >&2
        exit 1
      fi
    fi
    up_dns=$(resolvectl dns "$uplink" 2>/dev/null | awk '{$1=""; print $0}' | tr ' ' '\n' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | grep -v '^127\.' | paste -sd, -)
    if [[ -n "$up_dns" ]]; then dhcp_dns="$up_dns"; else dhcp_dns="1.1.1.1,8.8.8.8"; fi
  fi

  # Pick a hotspot subnet that does not collide with any existing route.
  gw="192.168.12.1"
  for n in 12 13 14 15 16; do
    if ! ip -4 route show 2>/dev/null | grep -q "192\.168\.${n}\."; then
      gw="192.168.${n}.1"
      break
    fi
  done

  cap_sec_dir=$(mktemp -d /tmp/create_ap_sec.XXXXXX) || exit 1
  chmod 700 "$cap_sec_dir"
  cap_conf="$cap_sec_dir/ap.conf"
  cap_log="$cap_sec_dir/ap.log"
  : > "$cap_conf"
  : > "$cap_log"
  chmod 600 "$cap_conf" "$cap_log"
  trap 'rm -rf "$cap_sec_dir"' EXIT HUP INT QUIT TERM
  # Keep create_ap's startup output where the user can read it after a failure
  # (written by the user, never by the root helper).
  save_log() {
    local sd="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-network"
    mkdir -p -m 700 "$sd" 2>/dev/null && cp -f "$cap_log" "$sd/hotspot-last.log" 2>/dev/null && chmod 600 "$sd/hotspot-last.log" 2>/dev/null
    return 0
  }
  # create_ap reads this file with a plain `read` (no -r): double backslashes so
  # SSIDs and passphrases containing one survive intact.
  cap_ssid=${ssid//\\/\\\\}
  cap_pwd=${pwd//\\/\\\\}
  # Same keys, same order as `create_ap --mkconfig` writes (verified against upstream).
  {
    printf "CHANNEL=default\n"
    printf "GATEWAY=%s\n" "$gw"
    printf "WPA_VERSION=2\n"
    printf "ETC_HOSTS=0\n"
    printf "DHCP_DNS=%s\n" "$dhcp_dns"
    printf "NO_DNS=0\n"
    printf "NO_DNSMASQ=0\n"
    printf "HIDDEN=0\n"
    printf "MAC_FILTER=0\n"
    printf "MAC_FILTER_ACCEPT=/etc/hostapd/hostapd.accept\n"
    printf "ISOLATE_CLIENTS=0\n"
    printf "SHARE_METHOD=nat\n"
    printf "IEEE80211N=%s\n" "$hostapd_n"
    printf "IEEE80211AC=0\n"
    printf "IEEE80211AX=0\n"
    printf "HT_CAPAB=%s\n" "$ht_capab"
    printf "VHT_CAPAB=\n"
    printf "VHT_CHWIDTH=80\n"
    printf "DRIVER=nl80211\n"
    printf "NO_VIRT=0\n"
    printf "COUNTRY=\n"
    printf "FREQ_BAND=%s\n" "$freq_band"
    printf "NEW_MACADDR=\n"
    printf "DAEMONIZE=1\n"
    printf "DAEMON_PIDFILE=\n"
    printf "DAEMON_LOGFILE=/dev/null\n"
    printf "DNS_LOGFILE=\n"
    printf "NO_HAVEGED=0\n"
    printf "WIFI_IFACE=%s\n" "$dev"
    printf "INTERNET_IFACE=%s\n" "$uplink"
    printf "SSID=%s\n" "$cap_ssid"
    printf "PASSPHRASE=%s\n" "$cap_pwd"
    printf "USE_PSK=0\n"
    printf "ADDN_HOSTS=\n"
    printf "DHCP_HOSTS=\n"
  } > "$cap_conf"
  # Only the path of the private config file crosses the pkexec argv boundary.
  pkexec bash -c "$ap_helper" create-ap-root start --config "$cap_conf" > "$cap_log" 2>&1
  pk_status=$?
  if [[ $pk_status -ne 0 ]] && grep -qi "not authorized" "$cap_log" 2>/dev/null; then
    echo "Hotspot start cancelled: polkit authorization denied or dismissed." >&2
    exit 1
  fi
  for i in {1..14}; do
    sleep 0.5
    if find_ap; then
      viface=$(cat "$ap_dir/wifi_iface" 2>/dev/null)
      if [[ -n "$viface" && "$viface" =~ ^[a-zA-Z0-9_.-]+$ && -d "/sys/class/net/$viface" ]]; then
        # An AP that is "on" but cannot hand out addresses is worse than a clear error:
        # the AP interface must still hold the gateway address and dnsmasq must be
        # listening on UDP 67.
        have_ip="false"; have_dhcp="false"
        for k in 1 2 3 4 5 6; do
          if ip -4 -o addr show dev "$viface" 2>/dev/null | grep -q "inet ${gw}/"; then have_ip="true"; else have_ip="false"; fi
          if ! command -v ss >/dev/null 2>&1; then have_dhcp="true"
          elif ss -H -uln 2>/dev/null | awk '{print $4}' | grep -q -E ':67$'; then have_dhcp="true"
          else have_dhcp="false"; fi
          if [[ "$have_ip" == "true" && "$have_dhcp" == "true" ]]; then exit 0; fi
          sleep 0.5
        done
        pkexec bash -c "$ap_helper" create-ap-root stop >/dev/null 2>&1 || true
        save_log
        if [[ "$have_ip" != "true" ]]; then
          echo "Hotspot stopped: $viface lost its address ${gw}. Another network service (NetworkManager, iwd or systemd-networkd) is reconfiguring the access-point interface." >&2
        else
          echo "Hotspot stopped: no DHCP server is listening on UDP 67. Check for another DHCP/dnsmasq service and for a firewall blocking UDP 67 on $viface." >&2
        fi
        exit 1
      fi
    fi
  done
  save_log
  if grep -qi "rf-kill" "$cap_log" 2>/dev/null; then
    echo "Cannot start repeater: Wi-Fi is soft-blocked by rfkill. Run 'rfkill unblock wifi'." >&2
  elif grep -qi "does not fully support virtual interfaces" "$cap_log" 2>/dev/null; then
    echo "Hotspot error: Wi-Fi card cannot run an access point on this band/channel at the same time." >&2
  elif grep -qi "not authorized" "$cap_log" 2>/dev/null; then
    echo "Hotspot start cancelled: polkit authorization denied or dismissed." >&2
  else
    err_line=$(grep -m 1 -E "^(ERROR|RTNETLINK):" "$cap_log" 2>/dev/null | sed -e 's/^ERROR:[[:space:]]*//')
    if [[ -n "$err_line" ]]; then
      echo "Hotspot error: $err_line" >&2
    elif [[ -n "$freq" ]]; then
      cur_band="2.4GHz"; if [[ "$freq" -gt 5000 ]]; then cur_band="5GHz"; fi
      echo "Repeater failed: Wi-Fi card cannot broadcast AP while connected to $cur_band (${freq} MHz)." >&2
    else
      echo "Failed to start hotspot: verify your Wi-Fi interface and Ethernet connection." >&2
    fi
  fi
  exit 1
else
  # Fallback: plain NetworkManager hotspot (no linux-wifi-hotspot installed).
  nmcli radio wifi on >/dev/null 2>&1 || true
  if [[ "$wifi_connected" == "true" ]]; then
    nmcli dev disconnect "$dev" >/dev/null 2>&1 || true
  fi
  if [[ "$band" == "a" && -n "$dev" ]]; then
    phy=$(cat /sys/class/net/"$dev"/phy80211/name 2>/dev/null || echo "phy0")
    if [[ "$phy" =~ ^phy[0-9]+$ ]] && ! iw phy "$phy" info 2>/dev/null | grep -A 40 "Frequencies:" | grep -E "5[0-9]{3}(\.[0-9]+)? MHz" | grep -v -e "no IR" -e "disabled" | grep -q "MHz"; then
      band="bg"
    fi
  fi
  save_profile
  if ! nm_out=$(nmcli con up id "$con" 2>&1); then
    err_detail=$(echo "$nm_out" | grep -m 1 -i "error:" | sed 's/^[Ee]rror:[[:space:]]*//')
    echo "Failed to start hotspot: ${err_detail:-$nm_out}" >&2
    exit 1
  fi
fi
HOTSPOT_APPLY_EOF
)

json_name(){
  # adopted connection id from a status JSON on stdin (defaults like upstream)
  jq -r '.name // "Hotspot"' 2>/dev/null || echo Hotspot
}

cmd_status(){
  # MOSQUITO addition to the forked query: "configured" tells the settings
  # TUI whether a hotspot profile exists at all (defaults vs current
  # values). The panel's updateHotspot ignores unknown fields, like upstream.
  local out con
  out="$(bash -c "$HOTSPOT_QUERY")"
  con="$(printf '%s' "$out" | json_name)"
  if nmcli connection show id "$con" >/dev/null 2>&1; then
    printf '%s' "$out" | jq -c '. + {configured: true}'
  else
    printf '%s' "$out" | jq -c '. + {configured: false}'
  fi
}

cmd_toggle(){
  local con="${1:-}" ssid="${2:-}" band="${3:-bg}"
  if [[ -z $con ]]; then
    con="$(bash -c "$HOTSPOT_QUERY" 2>/dev/null | json_name)"
  fi
  # Empty stdin = keep the saved passphrase (or generate per the script).
  printf '' | bash -c "$HOTSPOT_APPLY" hotspot-apply toggle "$con" "$ssid" "$band"
}

cmd_save(){
  local ssid="${1:-}" band="${2:-bg}" con="${3:-}"
  if [[ -z $con ]]; then
    con="$(bash -c "$HOTSPOT_QUERY" 2>/dev/null | json_name)"
  fi
  local pwd=""
  IFS= read -r pwd || true
  printf '%s\n' "$pwd" | bash -c "$HOTSPOT_APPLY" hotspot-apply save "$con" "$ssid" "$band"
}

case "${1:-status}" in
  status) cmd_status ;;
  toggle) shift; cmd_toggle "$@" ;;
  save)   shift; cmd_save "$@" ;;
  -h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "unknown command: $1 (status|toggle|save)" >&2; exit 1 ;;
esac
