#!/usr/bin/env bash
# mosquito-hotspot — Wi-Fi hotspot backend: status / toggle / save.
#
# FORKED from Guneshbari/omarchy-network (MIT, (c) 2026 Gunesh Bari):
# the hotspot query + apply scripts below are that project's Model.js
# hotspotQueryScript/hotspotApplyScript, extracted verbatim (JS string
# escapes decoded, nothing else changed). That is the backend the user
# asked to fork; the previous NM-only mosquito backend is gone.
#
# The password travels on stdin (a line), never in argv (world-readable in
# /proc) — same contract as upstream: the QML/TUI pipes it in.
#
#   mosquito-hotspot status              # fork JSON (active, ssid, band, ...)
#   echo "$PSK" | mosquito-hotspot save <ssid> <band: a|bg> [con]
#   mosquito-hotspot toggle [con] [ssid] [band]   # empty password kept/generated by the script
set -euo pipefail

HOTSPOT_QUERY=$(cat <<'HOTSPOT_QUERY_EOF'
# Wired-uplink detection, shared by the hotspot and wired scripts.
# Reads the kernel's view (/sys/class/net) instead of nmcli's STATE column, so a
# link that NetworkManager reports as "connected (externally)" or "unmanaged"
# (systemd-networkd, dhcpcd, a dock...) is still found. Physical NICs only: virtual
# devices (veth, bridges, tunnels...) have no /sys/.../device node.
net_is_physical_eth() {
  local p="$1" n="${1##*/}"
  [[ -n "$n" && -d "$p" ]] || return 1
  [[ -e "$p/device" && ! -d "$p/wireless" && ! -d "$p/phy80211" ]] || return 1
  [[ "$n" =~ ^(veth|docker|br-|virbr|lo|dummy|tap|tun|tailscale|wg|zt) ]] && return 1
  [[ "$(cat "$p/type" 2>/dev/null)" == 1 ]] || return 1
  return 0
}
# Prints the live ethernet device (default-route device first), nothing if none is up.
detect_eth() {
  local sysnet=/sys/class/net def p n st
  def=$(ip -4 route show default 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
  for p in "$sysnet/$def" "$sysnet"/*; do
    n=${p##*/}
    net_is_physical_eth "$p" || continue
    st=$(cat "$p/operstate" 2>/dev/null)
    if [[ "$st" != up ]]; then
      [[ "$st" == unknown && "$(cat "$p/carrier" 2>/dev/null)" == 1 ]] || continue
    fi
    ip -4 -o addr show dev "$n" scope global 2>/dev/null | grep -q . || continue
    printf "%s" "$n"
    return 0
  done
  return 1
}
# Prints the first physical ethernet NIC regardless of link state (idle-NIC fallback).
first_eth() {
  local p
  for p in /sys/class/net/*; do
    net_is_physical_eth "$p" || continue
    printf "%s" "${p##*/}"
    return 0
  done
  return 1
}
