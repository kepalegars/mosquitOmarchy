  [[ -f "$f" && ! -L "$f" && "$(stat -c %u "$f" 2>/dev/null)" == 0 ]] || continue
  [[ "$f" =~ ^/tmp/create_ap\.[A-Za-z0-9_.-]+\.conf\.[A-Za-z0-9]+/dnsmasq\.leases$ ]] || continue
