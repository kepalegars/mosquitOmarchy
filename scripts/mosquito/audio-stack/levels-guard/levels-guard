#!/bin/bash
# =============================================================================
# mosquitOmarchy - levels-guard
# =============================================================================
# Media-key guard installed by setup-levels-guard.sh. When the default
# output/source is a Mixbay-managed interface, the native volume keys are
# blocked unless the user enabled "Allow native volume controls" in Mixbay.
# The blocked OSD shows its icon and text at 100%, with the level bar at 0%,
# so the key still answers visually. Other interfaces delegate to Omarchy
# unchanged.
#
# This guard only covers the control surfaces (media keys + Omarchy audio
# panel). Direct pactl/wpctl calls and applications are never intercepted.
# =============================================================================
set -u

mode="${1:-output}"
shift || true

prefs="${XDG_CONFIG_HOME:-$HOME/.config}/mosquitomixbay/ui.json"

allow_native() {
  [[ -r $prefs ]] && grep -Eq '"allow_native_volume"[[:space:]]*:[[:space:]]*true' "$prefs"
}

output_sink() {
  if command -v omarchy-audio-output-sink >/dev/null 2>&1; then
    omarchy-audio-output-sink 2>/dev/null
  elif command -v pactl >/dev/null 2>&1; then
    pactl get-default-sink 2>/dev/null
  fi
}

managed_interface() {
  local prefix="$1" name="${2,,}"
  [[ $name == "$prefix"* ]] || return 1
  [[ $name == *audient_evo* || $name == *fireface* || $name == *ugm192* || $name == *quantum_es* ]]
}

blocked_osd(){
  command -v omarchy-shell >/dev/null 2>&1 || return 0
  local payload
  case "$1" in
    input) payload='{"icon":"microphone","message":"","value":0,"progressText":"100%","max":100}' ;;
    *)     payload='{"icon":"volume","message":"","value":0,"progressText":"100%","max":100}' ;;
  esac
  omarchy-shell -q osd show "$payload" >/dev/null 2>&1 || true
}

case "$mode" in
  output)
    ignore=0
    if managed_interface alsa_output.usb- "$(output_sink)" && ! allow_native; then
      ignore=1
    fi
    if ((ignore)); then blocked_osd output; exit 0; fi
    command -v omarchy-audio-output-volume >/dev/null 2>&1 || exit 0
    exec omarchy-audio-output-volume "$@"
    ;;
  input)
    ignore=0
    if managed_interface alsa_input.usb- "$(pactl get-default-source 2>/dev/null)" && ! allow_native; then
      ignore=1
    fi
    if ((ignore)); then blocked_osd input; exit 0; fi
    command -v omarchy-audio-input-mute >/dev/null 2>&1 || exit 0
    exec omarchy-audio-input-mute "$@"
    ;;
  *)
    echo "Usage: levels-guard <output|input> [args...]" >&2
    exit 2
    ;;
esac
