#!/usr/bin/env bash
# omarchy-vm-focus — toggle where the SUPER+… shortcuts go (host ↔ in-VM
# Omarchy) and say so in a compositor notification (hyprctl notify draws on
# top of the VM window even when it is fullscreen).
#
# Bound to SUPER + ALT + V both in the normal submap and inside the
# "omarchy-vm" submap (the script self-detects the current one), so pressing
# it always toggles and reports the new focus.
set -u

# Crash reporting (mosquitOmarchy): a failure stores a dated log and offers a
# clickable AI diagnosis. Install scripts are deliberately exempt.
_mq_crash_lib="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/crash.bash"
[[ -f $_mq_crash_lib ]] && { source "$_mq_crash_lib"; mq_crash_guard "omarchy-vm-focus"; }

notify(){ hyprctl notify -1 2500 "rgb(33ccff)" "$1" >/dev/null 2>&1 || true; }

# A VM submap only makes sense when a VM window is actually open somewhere
# (a normal workspace or the scratchpad). With no VM visible anywhere,
# every SUPER+… shortcut belongs to Omarchy natively — silently refuse so
# the native set is never shadowed for nothing.
vm_visible() {
  # The window class is whatever QEMU sets, which is plain "qemu" — NOT
  # anything namespaced. The previous filter looked for org.omarchy.* and
  # winvm only, so a real, open VM window never matched: the script answered
  # "no VM window open" while one was plainly on screen, and the focus toggle
  # refused to do anything.
  #
  # Title matching is deliberately not used. It looks like a good fallback, but
  # the pattern has to survive two levels of shell quoting before jq sees it, and
  # the double escaping that requires is exactly what breaks it: "\\(" inside
  # a single-quoted heredoc reaches jq as two characters, so it matches a
  # literal backslash followed by a group instead of an open parenthesis. The
  # class is unambiguous, so the title is not needed.
  # `any`, not `map(...) | length > 0`. The latter maps each window to a BOOLEAN
  # and then counts the windows, so it is > 0 whenever any window exists at all —
  # it reported a VM open with six unrelated windows on screen and none of them
  # was a VM. `any` asks the question that was meant.
  hyprctl -j clients 2>/dev/null | jq -e '
    any(.[];
        (.class // "") as $c
        | $c == "qemu"
          or $c == "qemu-system-x86_64"
          or $c == "winvm"
          or ($c | startswith("org.omarchy.vm"))
    )' >/dev/null 2>&1
}
if ! vm_visible; then
  notify "Focus: HOST — no VM window open (native Omarchy shortcuts)"
  exit 0
fi

cur="$(hyprctl submap 2>/dev/null || echo default)"
if [[ $cur == "omarchy-vm" ]]; then
  hyprctl eval 'hl.dispatch(hl.dsp.submap("reset"))' >/dev/null 2>&1 || true
  notify "Focus: HOST — native Omarchy shortcuts"
else
  hyprctl eval 'hl.dispatch(hl.dsp.submap("omarchy-vm"))' >/dev/null 2>&1 || true
  notify "Focus: VM — the guest Omarchy gets SUPER+…"
fi
