#!/usr/bin/env bash
# mosquito-audio-plugin-manager-actions — non-interactive backend for the Go TUI
# (mosquito-audio-plugin-manager-tui, tui-go/). Same role and same stub-primitive
# design as the sibling mosquito-move-manager-actions — see that file's own
# header for the full rationale. In short: Go makes every decision (which
# plugin, which prefix, confirm/cancel); this script performs the
# mechanical action once a decision is made, by sourcing the exact same
# lib-audio-plugin-manager-core.sh the TUI's dispatcher uses and calling its
# functions directly — no business logic duplicated here. (These stubs also
# win over the core's own guarded ui_* primitives: the core only defines
# them when ${MOSQUITO_AUDIO_PLUGIN_MANAGER_NATIVE_UI} is set, which the
# dispatcher — never this file — sets.)
set -euo pipefail

ui_confirm() { return 1; }
ui_info() { :; }
ui_select() { echo "BUG: ui_select reached in actions mode ($*)" >&2; return 2; }
ui_input() { echo "BUG: ui_input reached in actions mode ($*)" >&2; return 2; }
ui_ready_or_die() { :; }

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib-audio-plugin-manager-core.sh"

state_init
# A prefs file existing BEFORE load_prefs ran means this machine was already
# set up under this manager (or an earlier version): the first-launch wizard
# must NOT re-offer itself on every upgrade. On a genuinely fresh machine the
# file only appears because load_prefs() itself initializes it, which is
# exactly the "wizard wanted" case.
prefs_existed=false
[[ -f $PREFS_FILE ]] && prefs_existed=true
load_prefs


# ── Wine-program parents, computed ONCE per invocation ──────────────────────
#
# The list actions used to call wine_program_parent_of() once per row as
# parent="$(wine_program_parent_of ...)" — a sub-shell per row, so the memoised
# wine-source index died with it and a four-prefix / ~1450-file walk ran for
# EVERY row. That is the whole cost of the plugin list: 20-37 s to draw 53
# plugins, re-run in full every time the page was shown.
#
# wine_parent_map answers the same question for a whole list in ONE walk, and
# the answers are cached on disk keyed by a hash of the value list, so a second
# page of the same list costs nothing. Top-level function (the dispatcher is a
# `case`, not a function), hence global names.
_wpm_cache_file=""
_wpm_cache_populate(){
  local src="$1" key tmp
  [[ -s $src ]] || return 0
  key="$(md5sum < "$src" | cut -c1-16)"
  _wpm_cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/mosquito-audio-plugin-manager/parents-$key.tsv"
  [[ -s "$_wpm_cache_file" ]] && return 0
  mkdir -p "$(dirname "$_wpm_cache_file")" 2>/dev/null || return 0
  tmp="$_wpm_cache_file.tmp"
  wine_parent_map < "$src" > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  mv -f "$tmp" "$_wpm_cache_file" 2>/dev/null || rm -f "$tmp"
}

_wpm_parent_of(){
  local v="$1" k v2
  [[ -n ${_wpm_cache_file:-} && -s $_wpm_cache_file ]] || return 0
  while IFS=$'\t' read -r k v2; do
    [[ $k == "$v" ]] && { printf '%s' "$v2"; return 0; }
  done < "$_wpm_cache_file"
  return 0
}

cmd="${1:-}"
shift || true

case "$cmd" in
  status-json)
    spf_installed=false
    command -v spf >/dev/null 2>&1 && spf_installed=true
    # How many parked entries the quarantine holds right now, so the Go TUI
    # can grey its "Empty the quarantine" row out instead of offering a
    # destructive button that would delete nothing.
    quarantine_entries=0
    for qd in "$HOME/.cache/vst-quarantine" "$HOME/.cache/audio-plugin-manager-quarantine"; do
      [[ -d $qd ]] || continue
      qc=$(find "$qd" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)
      quarantine_entries=$((quarantine_entries + qc))
    done
    jq -nc --arg file_picker "$(current_file_picker)" \
      --argjson superfile_installed "$spf_installed" \
      --argjson hide_vst2 "$HIDE_VST2" --argjson hide_32bit "$HIDE_32BIT" \
      --arg sort_mode "$PLUGIN_SORT_MODE" \
      --arg plugins_root "$PLUGINS_ROOT" --arg downloads_dir "$DOWNLOADS_DIR" \
      --arg plugin_win_handler "${PLUGIN_WIN_HANDLER:-hyprland}" \
      --argjson wizard_done "$([[ ${WIZARD_DONE:-0} == 1 ]] || $prefs_existed && echo true || echo false)" \
      --argjson quarantine_entries "$quarantine_entries" \
      --argjson auto_fix_on "$([[ $(apm_fix_pref_get AUTO_FIX) == yes ]] && echo true || echo false)" \
      --argjson auto_gui_input "$([[ $(apm_fix_pref_get AUTO_GUI_INPUT yes) == yes ]] && echo true || echo false)" \
      --argjson fix_prompt_on "$([[ $(apm_fix_pref_get FIX_PROMPT) == yes ]] && echo true || echo false)" \
      --arg default_prefix "$(default_prefix)" \
      --arg default_prefix_set "${DEFAULT_PREFIX:-}" \
      '{file_picker:$file_picker,superfile_installed:$superfile_installed,hide_vst2:$hide_vst2,hide_32bit:$hide_32bit,sort_mode:$sort_mode,plugins_root:$plugins_root,downloads_dir:$downloads_dir,plugin_win_handler:$plugin_win_handler,wizard_done:$wizard_done,quarantine_entries:$quarantine_entries,auto_fix_on:$auto_fix_on,fix_prompt_on:$fix_prompt_on,auto_gui_input:$auto_gui_input,default_prefix:$default_prefix,default_prefix_set:$default_prefix_set}'
    ;;

  set-plugins-root)
    migrate_plugins_root "${1:?new plugins folder required}"
    ;;

  wizard-finish)
    # First-launch wizard's single step, called by the Go TUI's runner once
    # the user confirms the plugins folder (default or chosen): point the
    # manager at it WITHOUT the migration path of set-plugins-root (a fresh
    # setup has no plugin files to move), flag the wizard as done so
    # status-json stops offering it, then point every ALREADY-INSTALLED DAW
    # at the shared root by every external, non-destructive means available
    # — streaming one plain-text line per program (the runner displays them
    # as-is). Programs whose plugin folders can't be automated (Bitwig) are
    # named so the user can finish them by hand. Never touches an Ableton
    # .run file.
    root="${1:-$PLUGINS_ROOT}"
    root="${root%/}"
    [[ -n $root ]] || { echo "wizard-finish: plugins folder required" >&2; exit 2; }
    mkdir -p "$root"
    PLUGINS_ROOT="$root"
    WIZARD_DONE=1
    save_prefs
    init_plugins_root
    apply_plugins_root
    found=0
    # ── REAPER ────────────────────────────────────────────────────────────
    reaper_ini="$HOME/.config/REAPER/reaper.ini"
    if command -v reaper >/dev/null 2>&1 || [[ -f $reaper_ini ]]; then
      found=1
      mkdir -p "$(dirname "$reaper_ini")" "$HOME/.vst" "$HOME/.vst3" "$HOME/.clap"
      [[ -f $reaper_ini ]] || : > "$reaper_ini"
      python3 - "$reaper_ini" "$HOME" <<'PYWIZARD'
import os
import sys
import shutil

path, home = sys.argv[1], sys.argv[2]
keys = {"vstpath": ".vst", "vst3path": ".vst3", "clappath": ".clap"}
src = path + ".mosquito.bak"
if not os.path.exists(src):
    shutil.copy2(path, src)
with open(path, encoding="utf-8") as f:
    lines = f.read().splitlines()
out = []
changed = False
pending = dict(keys)
for ln in lines:
    for k, sub in list(pending.items()):
        if ln.startswith(k + "="):
            raw = ln[len(k) + 1:]
            parts = raw.split(",") if "," in raw else raw.split("|")
            seen, cur = set(), []
            for d in parts:
                d = d.strip().strip('"').rstrip("\\")
                if d and d not in seen:
                    seen.add(d)
                    cur.append(d)
            add = os.path.join(home, sub)
            if add not in seen:
                cur.append(add)
                changed = True
            ln = k + "=" + ",".join(cur)
            del pending[k]
            break
    out.append(ln)
for k, sub in pending.items():
    out.append(k + "=" + os.path.join(home, sub))
    changed = True
if changed:
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(out) + "\n")
PYWIZARD
      printf '✓  REAPER — reaper.ini now scans the yabridge chainloaders (%s, %s, %s)\n' "$HOME/.vst" "$HOME/.vst3" "$HOME/.clap"
    else
      printf '·  REAPER — not installed, nothing to point at the plugins folder\n'
    fi
    # ── Ableton Live (Windows build on wine prefix ~/.wine-ableton) ──────
    if [[ -d "$HOME/.wine-ableton/drive_c" ]]; then
      found=1
      linker="$SCRIPT_DIR/link-vst-shared.sh"
      if [[ ! -x $linker ]]; then
        linker="$HOME/mosquitOmarchy/scripts/apps/audio-plugin-manager/link-vst-shared.sh"
      fi
      if [[ -x $linker ]] && AUDIOSTACK_VST_ROOT="$root" bash "$linker" >/dev/null 2>&1; then
        printf '✓  Ableton Live — its shared VST folders (Common Files) now symlink into %s\n' "$root"
      else
        printf '·  Ableton Live — prefix found, but the shared-VST linker is unavailable\n'
      fi
    else
      printf '·  Ableton Live — not installed, nothing to point at the plugins folder\n'
    fi
    # ── Bitwig Studio ─────────────────────────────────────────────────────
    if command -v bitwig-studio >/dev/null 2>&1 || [[ -d "$HOME/.config/Bitwig" ]]; then
      found=1
      printf '→  Bitwig Studio — set its plugin folders in Preferences → Plug-ins: %s (and its vst / vst3 / clap subfolders)\n' "$root"
    else
      printf '·  Bitwig Studio — not installed, nothing to point at the plugins folder\n'
    fi
    if (( ! found )); then
      printf 'Finished — with your DAWs installed, they would have been pointed at %s automatically.\n' "$root"
    fi
    printf 'Finished — the plugins folder is %s.\n' "$root"
    ;;

  set-downloads-dir)
    DOWNLOADS_DIR="${1:?folder required}"
    save_prefs
    ;;

  set-default-prefix)
    # $1 = path, or the single word "auto" to go back to the automatic rule.
    #
    # Refuses a path that is not a wine prefix we can see. Writing a DEFAULT_PREFIX
    # that no longer exists is worse than writing none: default_prefix() hands it
    # straight to wine, which creates an empty prefix on the next install instead
    # of failing, and the user gets a manager that quietly stopped isolating
    # plugin installs from their other wine apps.
    case "${1:-auto}" in
      auto|"") DEFAULT_PREFIX="" ;;
      *)
        p="$1"
        [[ -d $p ]] || { warn "not a directory: $p"; exit 1; }
        # A wine prefix has a drive_c. ~/.wine-vst and friends do; a stray folder
        # does not, and installing into it produces a broken prefix.
        if [[ ! -d "$p/drive_c" ]]; then
          warn "$p does not look like a wine prefix (no drive_c)."
          exit 1
        fi
        DEFAULT_PREFIX="$p"
        ;;
    esac
    save_prefs
    dp="$(default_prefix)"
    jq -nc --arg path "$dp" --arg set "${DEFAULT_PREFIX:-}" '{path:$path,configured:$set}'
    ;;

  list-execs-in-prefix)
    # Every .exe under <prefix>/drive_c, as JSON, for "launch an executable".
    #
    # drive_c/windows is EXCLUDED: it is the emulated C:\Windows, and on a real
    # prefix it holds ~200 system exes (notepad.exe, wbem\mofcomp.exe, …) that
    # nobody wants in a menu whose purpose is launching a plugin's own GUI.
    # Measured 224 exes with that folder included, of which 4 were real.
    #
    # Depth-limited as well, for the same reason: an installer's bundled helpers
    # can sit several folders down. $1 = prefix, empty meaning the default one.
    pfx="${1:-}"; [[ -n $pfx ]] || pfx="$(default_prefix)"
    dc="$pfx/drive_c"
    if [[ ! -d $dc ]]; then
      jq -nc --arg prefix "$pfx" --arg err "no drive_c in this prefix" \
        '{prefix:$prefix, error:$err, execs:[]}'
      exit 0
    fi
    # print0/read -d '' so a filename with a space (the normal case:
    # "iZotope Neutron v5.0.0 CE.exe") survives. The sort key is a lowercased
    # basename, so the listing groups by program rather than by folder depth.
    while IFS= read -r -d '' f; do
      [[ -n $f ]] || continue
      rel="${f#"$dc"/}"
      case "${rel,,}" in
        windows/*|windows) continue ;;
      esac
      jq -nc --arg path "$f" \
                --arg display "$(bn=$(basename "$rel"); bn=${bn%.exe}; bn=${bn%.EXE}; bn=${bn%.Exe}; printf %s "$bn")" \
                --arg rel "$rel" \
                --arg key "$(printf '%s' "$(basename "$rel")" | tr '[:upper:]' '[:lower:]')" \
        '{path:$path, display:$display, rel:$rel, sortKey:$key}'
    done < <(find "$dc" -path "$dc/windows" -prune -o \
                   -maxdepth 8 -type f -iname '*.exe' -print0 2>/dev/null) |
      sort -t'	' -k1
    ;;

  launch-exe)
    # $1 = prefix (empty = default), $2 = path to the .exe, wherever it is.
    #
    # Launched detached on purpose: this is a plugin's own GUI, which stays open
    # for as long as the user needs it. Waiting on it would keep the manager
    # blocked on a Runner that never returns.
    pfx="${1:-}"; [[ -n $pfx ]] || pfx="$(default_prefix)"
    exe="${2:?exe path required}"
    [[ -f $exe ]] || { echo "no such executable: $exe" >&2; exit 1; }

    # An exe OUTSIDE the prefix is accepted, and that is the whole point: an
    # installer or a tool the user just downloaded lives in ~/Downloads, not in
    # drive_c, and refusing it made the row useless for the most obvious file to
    # point it at.
    #
    # wine takes a Z: path, and the Z: drive IS the prefix's own drive_c. So an
    # exe outside it is reached by giving wine its REAL path and letting the
    # loader resolve it: the file is not moved, copied or linked into the prefix,
    # and nothing is written anywhere. It simply RUNS as if it were in there —
    # which is what "run this exe with the dedicated wine" means.
    #
    # What it still refuses: a path that is not a file. No such thing as a
    # directory or a missing path, whatever it looks like.
    case "$exe" in
      "$pfx/drive_c"/*) target="$exe" ;;
      /*)                target="$exe" ;;
      *)                 target="$PWD/$exe" ;;
    esac

    # WINEPREFIX selects the prefix. The CWD is the exe's own folder, because a
    # program that resolves data files relative to itself stops finding them when
    # launched from the manager's folder.
    msg "launching: $(basename "$exe") (in $(basename "$pfx"))"
    WINEPREFIX="$pfx" setsid -f bash -c 'cd "$(dirname "$1")" && exec wine "$1"' _ "$target" \
      >/dev/null 2>&1 </dev/null
    ;;

  pick-folder)
    # Generic folder picker for the two Settings entries above (plugins
    # root / downloads dir) -- same dialog chain as pick-any-plugin-file,
    # directory mode instead of file mode.
    dir=""
    title="${1:-Pick a folder}"
    start="${2:-$HOME}"
    if command -v omarchy-file-select >/dev/null 2>&1 && { [[ -n ${DISPLAY:-} || -n ${WAYLAND_DISPLAY:-} || -n ${OMARCHY_WL:-} ]]; }; then
      dir=$(omarchy-file-select --title "$title" --directory 2>/dev/null | head -1)
    elif command -v zenity >/dev/null 2>&1; then
      dir=$(zenity --file-selection --directory --title="$title" --filename="$start/" 2>/dev/null) || true
    fi
    jq -nc --arg path "${dir:-}" '{path:$path}'
    ;;

  toggle-hide-vst2)
    [[ $HIDE_VST2 == true ]] && HIDE_VST2=false || HIDE_VST2=true
    save_prefs
    ;;

  toggle-hide-32bit)
    [[ $HIDE_32BIT == true ]] && HIDE_32BIT=false || HIDE_32BIT=true
    save_prefs
    ;;

  page)
    # "page <which> <verb> ..." — run a list verb with that page's stored sort
    # applied first. One place, so every page can't forget to set it.
    which="${1:?page required}"; shift
    apply_page_sort "$which"
    _apm_page="$which" "$0" "$@"
    ;;

  get-sort)
    # The sort a given PAGE last chose (plugins / uninstall / fixes).
    page="${1:?page required}"
    v="$(sort_mode_for_page "$page")"
    printf '%s\n' "$v"
    ;;

  set-sort-for-page)
    # Remember one page's choice without touching the others.
    page="${1:?page required}"; mode="${2:?mode required}"
    save_sort_for_page "$page" "$mode"
    ;;

  set-sort-and-list)
    # Sets PLUGIN_SORT_MODE then immediately re-lists -- one round trip for
    # the btop-style "arrow key cycles sort live" interaction, instead of a
    # separate set + separate re-fetch.
    PLUGIN_SORT_MODE="${1:?vendor, name, format or date required}"
    save_prefs
    _apm_rows="${TMPDIR:-/tmp}/apm-rows.$$"
    _apm_vals="${TMPDIR:-/tmp}/apm-vals.$$"
    all_plugin_list_rows_sorted > "$_apm_rows"
    cut -f6 < "$_apm_rows" > "$_apm_vals"
    _wpm_cache_populate "$_apm_vals"
    while IFS=$'\t' read -r sortkey gkey label origin fmt enabled value _v _k; do
      [[ -n $value ]] || continue
      parent="$(_wpm_parent_of "$value")"
      jq -nc --arg display "[$origin/$fmt]  $label" --arg value "$value" \
        --arg origin "$origin" --arg format "$fmt" --argjson enabled "$enabled" \
        --arg kind "plugin" --arg parent "$parent" \
        '{display: ($display + (if $enabled then "" else "  (hidden)" end)), value:$value, origin:$origin, format:$format, enabled:$enabled, kind:$kind, parent:$parent}'
    done < "$_apm_rows"
    rm -f "$_apm_rows" "$_apm_vals"
    wine_program_rows_json
    ;;

  set-file-picker)
    mode="${1:?default or superfile required}"
    mkdir -p "$(dirname "$FILE_PICKER_MODE_FILE")"
    printf '%s\n' "$mode" > "$FILE_PICKER_MODE_FILE"
    ;;

  ensure-superfile)
    ensure_superfile_installed
    ;;

  list-all-plugins)
    # The unified Plugin list -- VST + native together, one row shape, per
    # explicit request ("la plugin list est donc commune"). value is
    # self-describing ("vst:<type>:<path>" or "native:<path>") so
    # uninstall-batch/toggle-hidden never have to guess the origin back out
    # of a bare path.
    _apm_rows="${TMPDIR:-/tmp}/apm-rows.$$"
    _apm_vals="${TMPDIR:-/tmp}/apm-vals.$$"
    all_plugin_list_rows_sorted > "$_apm_rows"
    cut -f6 < "$_apm_rows" > "$_apm_vals"
    _wpm_cache_populate "$_apm_vals"
    while IFS=$'\t' read -r sortkey gkey label origin fmt enabled value _v _k; do
      [[ -n $value ]] || continue
      parent="$(_wpm_parent_of "$value")"
      jq -nc --arg display "[$origin/$fmt]  $label" --arg value "$value" \
        --arg origin "$origin" --arg format "$fmt" --argjson enabled "$enabled" \
        --arg kind "plugin" --arg parent "$parent" \
        '{display: ($display + (if $enabled then "" else "  (hidden)" end)), value:$value, origin:$origin, format:$format, enabled:$enabled, kind:$kind, parent:$parent}'
    done < "$_apm_rows"
    rm -f "$_apm_rows" "$_apm_vals"
    wine_program_rows_json
    ;;

  plugin-detail)
    target="${1:?}"
    jq -nc --arg text "$(basename "$target")"$'\n\n'"$target" '{text:$text}'
    ;;

  readme-text)
    jq -nc --arg vst2 "$VST_VST2" --arg vst3 "$VST_VST3" --arg clap "$VST_CLAP" \
      '{text: ("Where to point your DAW plugin folders:\n\n  vst\t→ " + $vst2 + "\n  vst3\t→ " + $vst3 + "\n  clap\t→ " + $clap)}'
    ;;

    # Windows-program-folder entries (a whole wine install, not just one
    # plugin file). Parent assignment is the shared wine_program_parent_of
    # heuristic (see lib-audio-plugin-manager-core.sh) — the exact same
    # helper list-all-plugins uses for the "Installed plugins" setup list,
    # so the uninstall tree and the setup list can never drift apart:
    #   1. a plugin file whose install path IS under a scan_wine_programs
    #      folder belongs to that folder (direct ancestry);
    #   2. OR when its DAT mentions the product stem (case-insensitive);
    #   3. OR the classic "installed-with" cluster: the folder's
    #      unins000.exe mtime within ±1 hour of the plugin file's mtime;
    #   4. OR the plugin's vendor folder name matches the installer folder.
  list-uninstallable)
    apply_page_sort "${_apm_page:-uninstall}"
    _apm_rows="${TMPDIR:-/tmp}/apm-rows.$$"
    _apm_vals="${TMPDIR:-/tmp}/apm-vals.$$"
    all_plugin_list_rows_sorted > "$_apm_rows"
    cut -f6 < "$_apm_rows" > "$_apm_vals"
    _wpm_cache_populate "$_apm_vals"
    while IFS=$'\t' read -r sortkey gkey label origin fmt enabled value _v _k; do
      [[ -n $value ]] || continue
      parent="$(_wpm_parent_of "$value")"
      jq -nc --arg display "[$origin/$fmt]  $label" --arg value "$value" \
              --arg kind "plugin" --arg parent "$parent" \
        '{display:$display,value:$value,kind:$kind,parent:$parent}'
    done < "$_apm_rows"
    rm -f "$_apm_rows" "$_apm_vals"
    wine_program_rows_json
    ;;

  list-plugin-folders)
    apply_page_sort "${_apm_page:-plugins}"
    # The list the plugin MANAGER draws: one row per logical plugin, carrying
    # the formats it is installed in, grouped under a folder per vendor.
    #
    # The other list actions emit one row per FILE, so a plugin installed as
    # vst2 + vst3 + clap appeared three times under the same name: the same
    # plugin had to be picked three times to act on it, and a vendor's count
    # read as a file count. One row per plugin is the unit a person thinks in.
    #
    # "variants" is every installed file of that plugin (semicolon-separated
    # "vst:<type>:<path>"), so the Go side can hide, show or uninstall all of
    # them from the single row.
    #
    # The whole list is printed by ONE jq.
    #
    # It used to be one jq PER ROW, so drawing the plugin list meant spawning a
    # JSON printer once per plugin — 27 spawns for 27 rows, and start-up cost
    # dwarfing the work. The rows are now tagged with their kind and handed to a
    # single filter, which emits them in the same order: plugins first, then one
    # folder per vendor.
    _apm_g="${TMPDIR:-/tmp}/apm-groups.$$"
    _apm_v="${TMPDIR:-/tmp}/apm-vals.$$"
    plugin_group_rows > "$_apm_g"
    cut -f6 < "$_apm_g" > "$_apm_v"
    _wpm_cache_populate "$_apm_v"

    # The wine-parent lookup is a per-row shell read over the already-built
    # cache, so it spawns nothing. It is a plain linear walk, which is fine
    # because a suite is tens of rows, not thousands.
    _wpm_parents=()
    if [[ -s ${_wpm_cache_file:-} ]]; then
      while IFS=$'\t' read -r _wp_k _wp_v; do
        [[ -n $_wp_k ]] && _wpm_parents+=("$_wp_k=$_wp_v")
      done < "$_wpm_cache_file"
    fi
    _wpm_parent_lookup() {
      local want="$1" pair
      for pair in ${_wpm_parents+"${_wpm_parents[@]}"}; do
        [[ ${pair%%=*} == "$want" ]] && { printf '%s' "${pair#*=}"; return 0; }
      done
      return 0
    }
    {
      # p<tab>label<tab>value<tab>vendor<tab>formats<tab>enabled<tab>variants<tab>wineParent
      # f<tab>display<tab>vendor:<name>
      #
      # Parent is the VENDOR row value and has to match the folder rows emitted
      # below ("vendor:<name>"). It used to be the wine program folder
      # ("win:/…/FabFilter"), which that set never contains, so every plugin came
      # out parentless: the vendor row showed a 0/N count and expanding it
      # revealed nothing.
      # The group column is "vendor" or "vendor/subgroup" (a suite that keeps
      # several product lines in one folder). The vendor is the TREE's top
      # level; the subgroup is a folder INSIDE it. Emitting "iZotope/Neutron 5"
      # as the folder itself produced two sibling iZotope rows instead of one
      # you can open, which is not what "sorted inside the vendor" means.
      while IFS=$'\t' read -r _sk _gk _label grp formats enabled value _variants _key; do
        [[ -n $value ]] || continue
        vendor="${grp%%/*}"
        subgroup=""
        [[ $grp == */* ]] && subgroup="${grp#*/}"
        printf 'p\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
          "$_label" "$value" "$vendor" "$formats" "$enabled" "$_variants" "$(_wpm_parent_lookup "$value")" "$subgroup"
      done < "$_apm_g"
      # One folder row per VENDOR (never per subgroup), the tree's top level.
      awk -F'\t' '{sub(/\/.*$/, "", $4); print $4}' "$_apm_g" | sort -u | while IFS= read -r grp; do
        [[ -n $grp ]] || continue
        printf 'f\t%s\tvendor:%s\n' "$([[ $grp == native ]] && printf Native || printf '%s' "$grp")" "$grp"
      done
    } | jq -R -s -c 'split("\n")
        | map(select(length > 0) | split("\t"))
        | map(
            if .[0] == "f" then
              {display: .[1], value: .[2], kind: "folder", parent: ""}
            else
              {display: .[1], value: .[2], kind: "plugin", vendor: .[3],
               formats: .[4], enabled: (.[5] == "true"), variants: .[6],
               parent: ("vendor:" + .[3]), wineParent: .[7],
               group: (if (.[8] // "") == "" then null else .[8] end)}
            end)[]'
    rm -f "$_apm_g" "$_apm_v"
    ;;

  uninstall-batch)
    # One or more "vst:<type>:<path>", "native:<path>" or "win:<path>"
    # tokens (list-all-plugins/list-uninstallable's own value shape) --
    # routes each to the right uninstall function, so a batch pick (Tab in
    # the Go TUI) can remove several plugins of mixed origin in one go.
    (($#)) || { echo "at least one plugin required" >&2; exit 2; }
    rc=0
    # ONE sync for the whole batch.
    #
    # Every plugin used to run the full post-install, and that ends in a
    # complete `yabridgectl sync` which re-reads every prefix. Removing a suite
    # therefore synced once per plugin — the bulk of the time an uninstall took.
    # The removals are all that matters between the steps; only the final state
    # has to reach yabridge, so it is synced once here.
    # No `local` here: this dispatcher is a top-level `case`, not a function,
    # and `local` outside a function is a hard bash error.
    APM_DEFER_SYNC=1
    export APM_DEFER_SYNC
    # A fresh run has not quarantined anything yet.
    APM_SEEN_FOLDERS=
    export APM_SEEN_FOLDERS
    _apm_ub_deferred=0
    for tgt in "$@"; do
      case "$tgt" in
        vst:*)    _apm_ub_deferred=1; uninstall_target "${tgt#vst:}" || rc=1 ;;
        win:*)    uninstall_target "win:${tgt#win:}" || rc=1 ;;
        native:*) uninstall_native_plugin "${tgt#native:}" || rc=1 ;;
        *)        echo "unrecognized target: $tgt" >&2; rc=1 ;;
      esac
    done
    if ((_apm_ub_deferred)); then
      msg "syncing once for the whole batch…"
      unset APM_DEFER_SYNC
      post_install
    fi
    unset _apm_ub_deferred
    exit $rc
    ;;

  open-folder)
    # $1 = a list value ("win:<dir>", "vst:<type>:<path>", "native:<path>")
    # or a bare path: opens the plugin's containing folder in the system
    # file manager. The Go TUI's uninstall screen invokes this with "x" on
    # the highlighted row.
    target="${1:?path required}"
    case "$target" in
      win:*)    dir="${target#win:}" ;;
      vst:*)    f="${target#vst:}"; f="${f#*:}"; dir="$(dirname "$f")" ;;
      native:*) dir="$(dirname "${target#native:}")" ;;
      *)        dir="$target" ;;
    esac
    if open_folder_path "$dir"; then
      echo "opened: $dir"
    else
      echo "no file manager found — folder: $dir"
    fi
    ;;

  list-prefixed-plugins)
    while IFS= read -r k; do
      [[ -n $k ]] || continue
      prefix="$(state_plugin_prefix "$k")"
      [[ -n $prefix ]] || continue
      jq -nc --arg display "$(plugin_prefix_label "$k")   ->  $(basename "$prefix")" --arg key "$k" --arg prefix "$prefix" \
        '{display:$display,key:$key,prefix:$prefix}'
    done <<< "$(state_list_keys)"
    ;;

  list-prefixes)
    # The DEFAULT prefix FIRST (recommended); a plugin's known prefix carries
    # a RECOMMENDED note when the installer matches a recorded plugin.
    # The installer is $1 here, NOT $2: the dispatcher does `cmd="${1:-}"; shift`
    # before the case, so every option reads its arguments from $1. Reading $2
    # here always found an empty string, `rec` stayed empty, and the RECOMMENDED
    # marker never reached the list -- which is why a known plugin's prefix was
    # never highlighted, for any plugin.
    rec=""
    [[ -n ${1:-} ]] && rec="$(recommended_prefix_for "$1")" || rec=""
    dp="$(default_prefix)"
    ordered=()
    [[ -n $rec ]] && ordered+=("$rec")
    for p in "${WINE_PREFIXES[@]}"; do
      [[ $p == "$rec" ]] && continue
      [[ $p == "$dp" ]] && continue
      ordered+=("$p")
    done
    # The recommended prefix is very often the default one. It is already in
    # `ordered` by then, and appending the default unconditionally listed it
    # twice -- the same path under the same RECOMMENDED label, so selecting the
    # second entry installed into a prefix the list had already shown.
    seen_dp=0
    for p in "${ordered[@]}"; do [[ $p == "$dp" ]] && seen_dp=1; done
    [[ $seen_dp == 0 ]] && ordered+=("$dp")
    for p in "${ordered[@]}"; do
      note=""
      if [[ -n $rec && $p == "$rec" ]]; then
        note="  (RECOMMENDED — matches this plugin)"
      fi
      jq -nc --arg path "$p" --arg label "$(basename "$p")$note" '{path:$path,label:$label}'
    done
    ;;
  default-prefix)
    jq -nc --arg path "$(default_prefix)" '{path:$path}'
    ;;

  pick-exe-in-prefix)
    # $1 = prefix (empty = default). A file picker limited to .exe, starting in
    # the prefix's drive_c so the user browses the prefix's own filesystem.
    #
    # Same chain as the other pickers (portal → omarchy → zenity), because the
    # point of this option is that nautilus/superfile ONLY designate the file:
    # the manager stays on top and does the wine launch itself. So this returns
    # the path and the TUI runs launch-exe with it — it does not ask the file
    # manager to run anything.
    pfx="${1:-}"; [[ -n $pfx ]] || pfx="$(default_prefix)"
    start="$pfx/drive_c"
    [[ -d $start ]] || start="$pfx"
    file=""
    title="Pick an executable to run in $(basename "$pfx")"
    if command -v omarchy-file-select >/dev/null 2>&1 && { [[ -n ${DISPLAY:-} || -n ${WAYLAND_DISPLAY:-} || -n ${OMARCHY_WL:-} ]]; }; then
      file=$(omarchy-file-select --title "$title" --extensions "exe" 2>/dev/null | head -1)
    elif command -v omarchy-menu-file >/dev/null 2>&1; then
      file=$(omarchy-menu-file "$title" "$start" "exe" 2>/dev/null | head -1)
    elif command -v zenity >/dev/null 2>&1; then
      file=$(zenity --file-selection --title="$title" --filename="$start/" --file-filter '*.exe' 2>/dev/null) || true
    fi
    jq -nc --arg path "${file:-}" --arg prefix "$pfx" '{path:$path, prefix:$prefix}'
    ;;

  install-into-prefix)
    # $1 = installer file, $2 = the prefix the user picked from the list.
    #
    # Validates the pick is a real wine prefix before the Go side commits to it,
    # so a stale list entry cannot point the install at a directory that does not
    # exist. The install itself is the SAME `install` verb as every other path —
    # this only echoes the validated path back so the TUI has one code path for
    # "I know which prefix now, start the install".
    file="${1:?installer required}"
    pfx="${2:?prefix required}"
    if [[ ! -d "$pfx/drive_c" ]]; then
      echo "not a wine prefix (no drive_c): $pfx" >&2
      exit 1
    fi
    jq -nc --arg path "$pfx" '{path:$path}'
    ;;

  # ── known-plugin detection (the install wizard's RECOMMENDED prefix) ──────
  # The TUI asks these two before showing the prefix choice. They MUST exit 0
  # and answer in JSON, otherwise the wizard silently degrades to "no
  # recommendation" (the bug: neither verb existed, so the RECOMMENDED line
  # never appeared for Serum / SmartEQ).
  recommended-prefix)
    # A known plugin gets a recommendation on three axes, not one.  Reporting
    # only the prefix is what made the wizard look like it "did not detect
    # Serum": the prefix was already right, so nothing on screen changed, while
    # the thing that actually mattered -- that Serum 2's editor is a
    # DirectComposition surface needing the d2d1-nspa runtime -- was not
    # expressible in the old two-column table.
    file="${1:?installer path required}"
    rec="$(known_plugin_record "$file" 2>/dev/null || true)"
    known=false; [[ -n $rec ]] && known=true
    IFS='|' read -r token prefix_rel runtime needs32 fixes recommended note <<<"$rec"
    # The leading dot of ".wine-vst" is part of the directory name, so the
    # relative prefix is joined verbatim; stripping it yielded ~/wine-vst.
    prefix=""
    if [[ -n $prefix_rel ]]; then
      case "$prefix_rel" in /*) prefix="$prefix_rel" ;; *) prefix="$HOME/$prefix_rel" ;; esac
    fi
    # The active runtime, so the TUI can say "already using it" vs "switching".
    active_rt="$(apm_wine_runtime 2>/dev/null || echo system)"
    rt_installed=false
    if [[ $runtime == ableton && -x "$HOME/.local/opt/wine-d2d1-nspa-11.13/bin/wine" ]]; then
      rt_installed=true
    fi
    jq -nc --arg prefix "$prefix" --arg file "$file" --argjson known "$known" \
      --arg token "${token:-}" --arg runtime "${runtime:-}" --arg needs32 "${needs32:-}" \
      --arg note "${note:-}" --arg activeRuntime "$active_rt" --argjson runtimeInstalled "$rt_installed" \
      '{prefix:$prefix, known:$known, file:$file, default:(env.HOME + "/.wine-vst"),
        token:$token, runtime:(if $runtime=="" then null else $runtime end),
        needs32:(if $needs32=="" or $needs32=="unknown" then null else ($needs32=="yes") end),
        note:(if $note=="" then null else $note end),
        activeRuntime:$activeRuntime, runtimeInstalled:$runtimeInstalled}'
    ;;

  recommended-runtime)
    file="${1:?installer path required}"
    rt="$(recommended_runtime_for "$file" 2>/dev/null || true)"
    jq -nc --arg runtime "$rt" --arg active "$(apm_wine_runtime 2>/dev/null || echo system)" \
      '{runtime:(if $runtime=="" then null else $runtime end), active:$active,
        changeNeeded:(if $runtime!="" and $runtime!=$active then true else false end)}'
    ;;

  yabridge-check)
    yabridge_check_json
    ;;

  yabridge-state)
    yabridge_state_json
    ;;

  yabridge-ensure)
    # Fast, throttled remote check + rebuild when master moved (the "frequent
    # seamless update" hook). `force` bypasses the throttle, used by post_install.
    yabridge_ensure "${1:-}" >/dev/null 2>&1 || true
    yabridge_state_json
    ;;

  plugin-health)
    plugin_health_json "${1:?plugin name or path required}"
    ;;

  check-all-plugins)
    # One JSON line per known plugin in the shared folders, for a health report.
    # No `local` here: this dispatcher is a top-level `case`, not a function,
    # and `local` outside a function is a hard bash error -- the command failed
    # outright with "local: can only be used in a function".
    _apm_p=""
    while IFS= read -r _apm_p; do
      [[ -n $_apm_p ]] || continue
      plugin_health_json "$_apm_p"
    done < <(list_shared_plugin_files 2>/dev/null | sort -u)
    unset _apm_p
    ;;

  recommended-fixes)
    # The fixes worth offering for this installer, before it is even run.
    # $1 = installer path (falls back to matching against the plugin name once
    # installed, via list-plugin-fixes).
    file="${1:?installer path required}"
    fixes_for_installer_json "$file"
    ;;

  known-plugin-record)
    # The raw row from known-plugins.tsv, for docs and debugging.
    file="${1:?installer path required}"
    rec="$(known_plugin_record "$file" 2>/dev/null || true)"
    if [[ -z $rec ]]; then
      jq -nc --arg file "$file" '{file:$file, known:false}'
    else
      IFS='|' read -r token prefix_rel runtime needs32 fixes recommended note <<<"$rec"
      jq -nc --arg file "$file" --arg token "$token" --arg prefix_rel "$prefix_rel" \
        --arg runtime "$runtime" --arg needs32 "$needs32" --arg fixes "$fixes" \
        --arg recommended "$recommended" --arg note "$note" \
        '{file:$file, known:true, token:$token, prefix:$prefix_rel, runtime:$runtime,
          needs32:$needs32, fixes:($fixes|split(" ")|map(select(length>0))),
          recommended:($recommended|split(" ")|map(select(length>0))), note:$note}'
    fi
    ;;

  is-known-plugin)
    file="${1:?installer path required}"
    if is_known_plugin "$file"; then
      echo "known"
    fi
    ;;

  known-plugin-name)
    # The PRODUCT name to use in the post-install question.
    #
    # The file the installer happened to write first is not the name the user
    # recognises, and for a suite it is whichever module sorted first. The
    # record's first column is the token the library is written against, which
    # is the product ("crisptuner"), so that is what the question says.
    file="${1:?installer or plugin path required}"
    rec="$(known_plugin_record "$file" 2>/dev/null || true)"
    if [[ -n $rec ]]; then
      IFS='|' read -r token _pr _rt _n32 _fx _rec2 _note <<<"$rec"
      printf '%s\n' "${token:-}"
    fi
    ;;

  known-plugins)
    # Every token the detection knows about (for the TUI hint / docs).
    recommended_prefix_for_plugins
    ;;

  create-prefix)
    name="${1:?name required}"
    slug="$(printf '%s' "$name" | tr ' ' '-' | tr -cd '[:alnum:]-' | tr '[:upper:]' '[:lower:]')"
    [[ -n $slug ]] || { echo "empty prefix name" >&2; exit 2; }
    newp="$HOME/.wine-$slug"
    if [[ ! -d "$newp/drive_c" ]]; then
      echo "Creating wine prefix: $newp"
      WINEPREFIX="$newp" wineboot -u >/dev/null 2>&1 || echo "(wineboot returned a non-zero code — continuing)"
    fi
    jq -nc --arg path "$newp" '{path:$path}'
    ;;

  install)
    file="${1:?installer path required}"
    prefix="${2:?prefix required}"
    tag="${3:-}"
    if [[ ! -d "$prefix/drive_c" ]]; then
      echo "Creating wine prefix: $prefix"
      WINEPREFIX="$prefix" wineboot -u >/dev/null 2>&1 || echo "(wineboot returned a non-zero code — continuing)"
    fi
    install_plugin "$file" "$prefix" "$tag"
    ;;

  get-fix-prefs)
    jq -nc --arg auto "$(apm_fix_pref_get AUTO_FIX)" --arg prompt "$(apm_fix_pref_get FIX_PROMPT)" \
      --arg gui "$(apm_fix_pref_get AUTO_GUI_INPUT yes)" \
      '{auto_fix:$auto, fix_prompt:$prompt, auto_gui_input:$gui}'
    ;;
  set-fix-prefs)
    # $1 = AUTO_FIX|FIX_PROMPT, $2 = yes|no
    apm_fix_pref_set "${1:?key required}" "${2:?value yes|no required}" >/dev/null 2>&1 \
      || { echo "could not save the fix preference" >&2; exit 1; }
    jq -nc --arg auto "$(apm_fix_pref_get AUTO_FIX)" --arg prompt "$(apm_fix_pref_get FIX_PROMPT)" \
      --arg gui "$(apm_fix_pref_get AUTO_GUI_INPUT yes)" \
      '{auto_fix:$auto, fix_prompt:$prompt, auto_gui_input:$gui}'
    ;;

  get-wine-runtime)
    jq -nc --arg rt "$(apm_wine_runtime)" '{runtime:$rt}'
    ;;
  set-wine-runtime)
    apm_set_wine_runtime "${1:?runtime system|ableton required}" >/dev/null 2>&1
    jq -nc --arg rt "$(apm_wine_runtime)" '{runtime:$rt}'
    ;;
  set-plugin-handler)
    # $1 = classic|hyprland (persisted through prefs, applied to future
    # installs AND re-applied to the shared yabridge.toml write)
    set_plugin_handler "${1:?handler mode required}"
    ;;

  list-fixes)
    # The general fix catalog shown by the "Apply fixes for Wine VSTs" screen.
    fixes_list_json
    ;;

  list-plugin-fixes)
    # $1 = plugin label; every fix with an "applied" flag for that plugin.
    fixes_for_plugin_json "${1:?plugin required}"
    ;;

  list-applied-fix-plugins)
    # One JSON line {"plugin": <stem>} per plugin that has at least one fix
    # recorded as applied. The fixes plugin chooser badges those rows in the
    # theme accent; a single cheap call avoids N list-plugin-fixes round trips.
    #
    # One jq for the whole set, not one per plugin: a jq process costs about as
    # much as the work it does, so the per-plugin form spent its budget on
    # start-up — a suite of twenty-one paid twenty-one spawns, which is where
    # most of the wait on the plugin list went.
    fixes_applied_plugins |
      jq -R -s -c 'split("\n") | map(select(length > 0) | {plugin: .})[]'
    ;;

  list-applied-global-fixes)
    # One JSON line per GLOBAL fix, {"id":..,"applied":bool}.
    #
    # Separate from list-applied-fix-plugins by design rather than by accident.
    # That verb SKIPS "__global__" — correctly, since a global cursor option
    # must not badge every plugin row — but it left the fixes screen with no
    # source at all for "is the global one on": the per-plugin list was empty,
    # and an empty list is indistinguishable from never-applied. This answers the
    # question where the marker actually lives.
    fixes_state_init
    while IFS='|' read -r id _t scope _d _c _p _r _v; do
      [[ -n $id ]] || continue
      [[ $scope == global ]] || continue
      if fix_is_global_applied "$id"; then a=true; else a=false; fi
      jq -nc --arg id "$id" --argjson applied "$a" '{id:$id, applied:$applied}'
    done < <(fixes_catalog)
    ;;

  list-vendor-plugins)
    # Every plugin of one vendor, as list-plugin-folders rows. Used to build the
    # vendor-wide fix catalog, which is the union over exactly this set.
    vendor="${1:?vendor required}"
    _apm_lv="${TMPDIR:-/tmp}/apm-lv.$$"
    plugin_group_rows > "$_apm_lv"
    awk -F'\t' -v v="$vendor" '$3==v' "$_apm_lv" | while IFS=$'\t' read -r sk label grp formats enabled value variants; do
      [[ -n $value ]] || continue
      jq -nc --arg display "$label" --arg value "$value" --arg vendor "$grp" \
        --arg formats "$formats" --argjson enabled "$enabled" --arg variants "$variants" \
        '{display:$display, value:$value, kind:"plugin", vendor:$vendor, formats:$formats, enabled:$enabled, variants:$variants}'
    done
    rm -f "$_apm_lv"
    ;;

  plugin-vendor)
    # $1 = a plugin list value. Echoes the vendor folder it groups under.
    #
    # Needed because the post-install question must offer the fixes for the
    # WHOLE VENDOR, not just the one plugin that was just installed: the user
    # installed a suite, and asking per plugin means the same dialog for every
    # member of it.
    target="${1:?plugin value required}"
    _apm_pv="${TMPDIR:-/tmp}/apm-pv.$$"
    plugin_group_rows > "$_apm_pv"
    awk -F'\t' -v val="$target" '$6==val{print $3; exit}' "$_apm_pv"
    rm -f "$_apm_pv"
    ;;

  apply-fixes)
    # $1 = plugin label, then one or more fix ids (idempotent).
    plugin="${1:?plugin required}"; shift
    fix_apply "$plugin" "$@"
    ;;

  apply-fixes-vendor)
    # $1 = vendor, then one or more fix ids. Applies the fixes to EVERY plugin of
    # that vendor, in one call.
    #
    # The user installed a whole suite (FabFilter) and wants the fix for the
    # suite, not the same dialog per plugin. Applying a fix is per-plugin under
    # the hood, so this is a loop over the vendor's plugins rather than a new
    # kind of fix — the recorded state, the Hyprland rule and the "applied for:"
    # comment are all exactly what a single-plugin apply produces.
    vendor="${1:?vendor required}"; shift
    (($#)) || { echo "apply-fixes-vendor needs at least one fix id." >&2; exit 2; }
    _apm_rows="${TMPDIR:-/tmp}/apm-vendor-rows.$$"
    _apm_plugs="${TMPDIR:-/tmp}/apm-vendor-plugs.$$"
    plugin_group_rows > "$_apm_rows"
    # Only the label is needed to apply: fix_apply() takes the plugin NAME. The
    # value ("vst:vst2:/path") is only for hide/show/uninstall.
    awk -F'\t' -v v="$vendor" '$3==v{print $2}' "$_apm_rows" > "$_apm_plugs"
    if [[ ! -s $_apm_plugs ]]; then
      warn "no plugin found for vendor '$vendor'."
      rm -f "$_apm_rows" "$_apm_plugs"
      exit 1
    fi
    rc=0
    n=0
    while IFS= read -r label; do
      [[ -n $label ]] || continue
      if fix_apply "$label" "$@"; then
        n=$((n+1))
      else
        rc=1
        warn "could not apply the fixes to $label"
      fi
    done < "$_apm_plugs"
    rm -f "$_apm_rows" "$_apm_plugs"
    [[ $rc -eq 0 ]] && ok "fixes applied to $n plugin(s) from $vendor."
    exit $rc
    ;;

  remove-fixes)
    # $1 = plugin label, then one or more fix ids (idempotent).
    plugin="${1:?plugin required}"; shift
    fix_remove "$plugin" "$@"
    ;;

  apply-fixes-plugins)
    # $@ = fix ids. Plugin LABELS on stdin, one per line. The plugins the fix
    # does not already cover.
    #
    # This exists for the PARTIAL fix. A vendor-wide visit merges one report per
    # plugin, so a fix can be recorded on some of a suite and not the others —
    # and the only two ways to change that were "apply to every plugin of the
    # vendor", which flipped a half-applied fix to fully applied across the
    # whole suite, or "remove from the one plugin you picked by hand", which on
    # a vendor visit named NO plugin at all and failed with "plugin required".
    # Neither is what a partial row means.
    #
    # Taking the labels on stdin keeps an arbitrary set expressible without
    # inventing a separator between "the fixes" and "the plugins".
    (($#)) || { echo "apply-fixes-plugins needs at least one fix id." >&2; exit 2; }
    _apm_fpl_fix=("$@")
    _apm_fpl_n=0
    _apm_fpl_rc=0
    while IFS= read -r _apm_fpl_label; do
      [[ -n $_apm_fpl_label ]] || continue
      if fix_apply "$_apm_fpl_label" "${_apm_fpl_fix[@]}"; then
        _apm_fpl_n=$((_apm_fpl_n + 1))
      else
        _apm_fpl_rc=1
        warn "could not apply the fixes to $_apm_fpl_label"
      fi
    done
    ok "fixes applied to $_apm_fpl_n plugin(s)."
    exit $_apm_fpl_rc
    ;;

  remove-fixes-plugins)
    # $@ = fix ids. Plugin LABELS on stdin, one per line. The plugins the fix
    # IS already on — the other half of apply-fixes-plugins, and the operation
    # a vendor visit could not express at all before.
    (($#)) || { echo "remove-fixes-plugins needs at least one fix id." >&2; exit 2; }
    _apm_rpl_fix=("$@")
    _apm_rpl_n=0
    _apm_rpl_rc=0
    while IFS= read -r _apm_rpl_label; do
      [[ -n $_apm_rpl_label ]] || continue
      if fix_remove "$_apm_rpl_label" "${_apm_rpl_fix[@]}"; then
        _apm_rpl_n=$((_apm_rpl_n + 1))
      else
        _apm_rpl_rc=1
        warn "could not remove the fixes from $_apm_rpl_label"
      fi
    done
    ok "fixes removed from $_apm_rpl_n plugin(s)."
    exit $_apm_rpl_rc
    ;;

  pick-any-plugin-file)
    # One unified picker for BOTH plugin universes -- the Go TUI decides
    # what to do with the result by extension (exe/msi -> wine install;
    # lv2/clap/vst3/zip/tar/tar.gz/tgz -> native install), the user never
    # has to say which kind it is up front. Only reached when the picker
    # preference is "default" — the Go TUI handles "superfile" itself
    # (pickFileViaSuperfileEmbedded(), tea.ExecProcess, its own terminal),
    # so it never spawns a separate window.
    file=""
    title="Install a plugin — pick a Windows installer (exe/msi) or a native plugin (lv2/clap/vst3/archive)"
    if command -v omarchy-file-select >/dev/null 2>&1 && { [[ -n ${DISPLAY:-} || -n ${WAYLAND_DISPLAY:-} || -n ${OMARCHY_WL:-} ]]; }; then
      # The portal chooser has no "starting folder" option to pass --
      # DOWNLOADS_DIR only shapes the fallback pickers below.
      file=$(omarchy-file-select --title "$title" --extensions "exe msi lv2 clap vst3 zip tar.gz tgz" 2>/dev/null | head -1)
    elif command -v omarchy-menu-file >/dev/null 2>&1; then
      file=$(omarchy-menu-file "$title" "$DOWNLOADS_DIR:$HOME/" "exe msi lv2 clap vst3 zip tar.gz tgz" 2>/dev/null | head -1)
    elif command -v zenity >/dev/null 2>&1; then
      file=$(zenity --file-selection --title="$title" --filename="$DOWNLOADS_DIR/" 2>/dev/null) || true
    fi
    jq -nc --arg path "${file:-}" '{path:$path}'
    ;;

  list-standalones)
    while IFS=$'\t' read -r base f; do
      [[ -n $f ]] || continue
      jq -nc --arg display "$base" --arg value "$f" '{display:$display,value:$value}'
    done <<< "$(executable_list)"
    ;;

  launch-standalone)
    exe="${1:?exe path required}"
    setsid wine start /unix "$exe" >/dev/null 2>&1 &
    disown
    echo "launched (standalone window may open)"
    ;;

  list-standalones-detailed)
    # Every registered standalone, saying whether its file is still there and
    # whether it is a manager, so a stale row can be told from a live one.
    while IFS=$'\t' read -r base f; do
      [[ -n $f ]] || continue
      miss=false
      [[ -e $f ]] || miss=true
      mgr=false
      is_manager_exe "$f" && mgr=true
      jq -nc --arg display "$base" --arg value "$f" \
             --argjson missing "$miss" --argjson manager "$mgr" \
        '{display:$display, value:$value, missing:$missing, manager:$manager}'
    done <<< "$(executable_list)"
    ;;

  manager-installed)
    # Is this vendor's manager already in the prefix?
    #
    # Re-running an installed manager as a fresh installer installs nothing and
    # leaves every plugin it writes untracked, so the warning is worth raising
    # before the prefix question rather than after a wasted run.
    v="${1:?vendor required}"
    if [[ -n $(find "$(default_prefix)/drive_c/ProgramData" -maxdepth 2 -iname "*${v}*" 2>/dev/null | head -1) ]]; then
      echo yes
    else
      echo no
    fi
    ;;

  forget-standalone)
    # Untrack one executable. The file stays where it is: this clears a row,
    # it does not uninstall anything.
    exe="${1:?exe path required}"
    base="${exe##*/}"
    state_forget_standalone "$base" || true
    jq -nc --arg v "$exe" '{forgotten:$v}'
    ;;

  list-managers)
    # Managers are listed apart from the toggleable executables: they belong in
    # "Launch a standalone plugin" and NOT in the Omarchy menu, because opening
    # one from the menu drops the watcher that registers what it installs.
    while IFS=$'\t' read -r base f; do
      [[ -n $f ]] || continue
      [[ -e $f ]] || continue
      is_manager_exe "$f" || continue
      jq -nc --arg display "$base" --arg value "$f" '{display:$display, value:$value, manager:true}'
    done <<< "$(executable_list)"
    ;;

  list-executables-toggle)
    while IFS=$'\t' read -r base f; do
      [[ -n $f ]] || continue
      slug="$APPS_DIR/$DESKTOP_SLUG-$(basename "${base%.exe}" | tr ' ' '-' | tr -cd '[:alnum:]-').desktop"
      shown=false
      [[ -f $slug ]] && shown=true
      jq -nc --arg display "$base" --arg value "$f" --argjson shown "$shown" '{display:$display,value:$value,shown:$shown}'
    done <<< "$(executable_list)"
    ;;

  toggle-executable)
    # Delegates to the core, which owns the .desktop shape.
    #
    # This verb had its own copy of the writer and the Go TUI calls THIS one,
    # so the fixes made in the core — the name without the extension, the
    # generated icon — were never applied to anything: this copy still wrote
    # "Name=$base" and no Icon= at all, and it kept overwriting entries the
    # core had repaired.
    exe="${1:?exe path required}"
    toggle_executable_menu "$exe"
    ;;

  move-plugin)
    move_plugin "${1:?key required}" "${2:?from prefix required}" "${3:?to prefix required}"
    ;;

  reconcile-missing)
    # Same shape as reconcile-orphans: decide in the shell, print with ONE jq.
    # This also runs on every launch.
    #
    # Read straight out of the snapshot arrays. The previous form asked the log
    # per key through "$(state_bulk_files …)", and a command substitution is a
    # fork: one per tracked plugin, before the menu appeared. No `local` here
    # either — the dispatcher is a top-level `case`, not a function, and `local`
    # there is an error that aborts the whole action.
    state_bulk_load
    _apm_rm_miss=()
    for _apm_rm_k in ${_state_keys_all[@]+"${!_state_keys_all[@]}"}; do
      _apm_rm_f=""
      while IFS= read -r _apm_rm_f2; do
        [[ -n $_apm_rm_f2 && -e $_apm_rm_f2 ]] && { _apm_rm_f=1; break; }
      done <<< "${_state_files_all[$_apm_rm_k]}"
      [[ -n $_apm_rm_f ]] || _apm_rm_miss+=("$_apm_rm_k")
    done
    for _apm_rm_k in ${_apm_rm_miss[@]+"${_apm_rm_miss[@]}"}; do
      # The label is the last path segment, which is what plugin_prefix_label
      # computed — inlined so it costs no fork.
      printf '%s\t%s\n' "$_apm_rm_k" "${_apm_rm_k##*/}"
    done |
      jq -R -s -c 'split("\n")
        | map(select(length > 0) | split("\t"))
        | map({key: .[0], label: .[1]})[]'
    ;;

  rekey-files)
    # One log entry per FILE, each under its own plugin_key.
    #
    # Installs used to write every file an installer dropped under the key of
    # whichever file it wrote first, so a suite became ONE entry holding every
    # path while the scan produces one key per file. Everything but the first
    # was then permanently untracked: it came back on every launch, and
    # installing again wrote the same single entry.
    #
    # A collapsed entry is dropped ONLY when every file it holds now has an
    # entry of its own. Matching on "this file's key exists in the log" is not
    # enough: a single-file entry matches ITSELF, so every healthy entry looked
    # safe to drop and the log was emptied — 41 entries to 1, twice, before the
    # rule was fixed.
    state_init
    _apm_rk=0
    while IFS= read -r _apm_rk_key; do
      [[ -n $_apm_rk_key ]] || continue
      while IFS= read -r _apm_rk_f; do
        [[ -n $_apm_rk_f ]] || continue
        _apm_rk_new="$(plugin_key "$_apm_rk_f")"
        [[ -n $_apm_rk_new && $_apm_rk_new != "$_apm_rk_key" ]] || continue
        state_register_install "$_apm_rk_new" \
          "$(jq -r --arg k "$_apm_rk_key" '.plugins[$k].prefix // ""' "$STATE_FILE")" "$_apm_rk_f"
        _apm_rk=$((_apm_rk + 1))
      done < <(jq -r --arg k "$_apm_rk_key" '.plugins[$k].files[]?' "$STATE_FILE")
    done < <(jq -r '.plugins | keys[]' "$STATE_FILE")
    # Second pass over a SNAPSHOT of the keys: the deletion below edits the
    # file this loop reads.
    jq -r '.plugins | keys[]' "$STATE_FILE" > "${TMPDIR:-/tmp}/apm-rekey-keys.$$"
    while IFS= read -r _apm_rk_key; do
      [[ -n $_apm_rk_key ]] || continue
      _apm_rk_drop=1
      # Counted up front: the loop below breaks early on the first
      # disqualifying file, so counting inside it only ever reached 1 and the
      # "still collapsed" branch never ran.
      _apm_rk_n=$(jq -r --arg k "$_apm_rk_key" '.plugins[$k].files | length' "$STATE_FILE")
      while IFS= read -r _apm_rk_f; do
        [[ -n $_apm_rk_f ]] || continue
        _apm_rk_want="$(plugin_key "$_apm_rk_f")"
        # This file's own entry must exist AND be a DIFFERENT one: otherwise
        # dropping this row would take the only record of that file with it.
        if [[ -z $_apm_rk_want || $_apm_rk_want == "$_apm_rk_key" ]]; then
          _apm_rk_drop=0
          break
        fi
        jq -e --arg k "$_apm_rk_want" '.plugins[$k]' "$STATE_FILE" >/dev/null 2>&1 || _apm_rk_drop=0
        [[ $_apm_rk_drop == 1 ]] || break
      done < <(jq -r --arg k "$_apm_rk_key" '.plugins[$k].files[]?' "$STATE_FILE")
      if [[ $_apm_rk_drop == 1 && $_apm_rk_n -gt 1 ]]; then
        jq -S --arg k "$_apm_rk_key" 'del(.plugins[$k])' "$STATE_FILE" > "$STATE_FILE.tmp.$$" \
          && mv "$STATE_FILE.tmp.$$" "$STATE_FILE"
      elif [[ $_apm_rk_n -gt 1 ]]; then
        # Still holds its own file, so it cannot go — but it also still lists
        # every file it used to absorb, which are now other entries' business.
        # Keep only the paths this key actually owns.
        _apm_rk_mine="${TMPDIR:-/tmp}/apm-rekey-mine.$$"
        : > "$_apm_rk_mine"
        while IFS= read -r _apm_rk_f; do
          [[ -n $_apm_rk_f ]] || continue
          [[ "$(plugin_key "$_apm_rk_f")" == "$_apm_rk_key" ]] && printf '%s\n' "$_apm_rk_f" >> "$_apm_rk_mine"
        done < <(jq -r --arg k "$_apm_rk_key" '.plugins[$k].files[]?' "$STATE_FILE")
        if [[ -s $_apm_rk_mine ]]; then
          # --rawfile, not --slurpfile: the file holds one PATH PER LINE, and
          # slurpfile parses it as JSON ("Bad JSON in --slurpfile"). jq turns the
          # text into the array itself, splitting on newlines.
          jq -S --arg k "$_apm_rk_key" --rawfile f "$_apm_rk_mine" \
            '.plugins[$k].files = ($f | split("\n") | map(select(length > 0)))' "$STATE_FILE" > "$STATE_FILE.tmp.$$" \
            && mv "$STATE_FILE.tmp.$$" "$STATE_FILE"
        fi
        rm -f "$_apm_rk_mine"
      fi
    done < "${TMPDIR:-/tmp}/apm-rekey-keys.$$"
    rm -f "${TMPDIR:-/tmp}/apm-rekey-keys.$$"
    jq -nc --argjson n "$_apm_rk" '{rekeyed:$n}'
    ;;

  add-missing)
    # Keep a missing plugin in the shared log (it belongs to another machine
    # or will be synced/mounted back later), but stop flagging it on this one:
    # its tracked files are emptied, mirroring how a fresh registration looks
    # before any file is picked. The key + prefix remain listed as installed.
    keep_missing_keys "$@"
    jq -nc --argjson n "$#" '{kept:$n}'
    ;;

  remove-missing)
    # Remove a missing plugin everywhere (this computer + the shared log) and
    # clean up any standalone .desktop menu entry it generated.
    purge_missing_keys "$@"
    jq -nc --argjson n "$#" '{removed:$n}'
    ;;

  reconcile-orphans)
    # ONE ROW PER PLUGIN, like every other list in this TUI.
    #
    # It walked scan_plugins, which is one line per FILE, so a plugin present
    # as vst2 + vst3 + clap was announced as three separate untracked plugins —
    # 50 rows for 23 plugins on this machine, most of them the same name with a
    # different extension. The user reads that as the manager having lost the
    # plot, and they then have to tick the same plugin three times.
    #
    # The row is the same shape list-plugin-folders emits, and the value is the
    # plugin's own list value so "add" can act on it the way every other screen
    # acts on a plugin.
    _apm_ro="${TMPDIR:-/tmp}/apm-orphans.$$"
    plugin_group_rows > "$_apm_ro"
    # Field 8 is the canonical plugin_key the state log indexes on.
    #
    # One jq for the whole sweep, not one per row — and this action runs on
    # EVERY launch, so its per-row spawns were paid before the menu even
    # appeared. The shell loop still decides what is an orphan (it has to ask
    # the state log, which jq cannot see), it just hands the survivors to a
    # single filter.
    while IFS=$'\t' read -r sortkey gkey label grp formats enabled value variants key; do
      [[ -n $value ]] || continue
      # state_bulk_has, not state_has: one jq for the whole log instead of one
      # per plugin. Safe here because this sweep writes nothing.
      state_bulk_has "$key" && continue
      printf '%s\t%s\t%s\t%s\t%s\n' "$label" "$value" "$grp" "$formats" "$variants"
    done < "$_apm_ro" |
      jq -R -s -c 'split("\n")
        | map(select(length > 0) | split("\t"))
        | map({display: .[0], value: .[1], kind: "plugin", vendor: .[2],
               formats: .[3], variants: .[4]})[]'
    rm -f "$_apm_ro"
    ;;

  add-orphan)
    # $1 = a plugin list value ("vst:<type>:<path>") or a bare path, as the
    # reconcile screen holds it.
    #
    # Registers EVERY file of that plugin, not just the one that was picked. The
    # reconcile screen is one row per plugin, so adding one row used to leave
    # the other formats untracked — the plugin then came BACK on the next open
    # as an orphan, once per format. That is the "it still says untracked"
    # loop this closes.
    target="${1:?file required}"
    path="$target"
    case "$target" in
      vst:*:*) path="${target#vst:*:}" ;;
      native:*) path="${target#native:}" ;;
    esac
    # plugin_group_rows already merged the plugin's formats into field 7
    # (semicolon-separated). Reading them from there is exact: re-matching by
    # label across rows was not, because two plugins can share a name
    # ("FabFilter Micro" and "FabFilter Micro (Mono)").
    _apm_ao="${TMPDIR:-/tmp}/apm-ao.$$"
    plugin_group_rows > "$_apm_ao"
    files="$(awk -F'\t' -v v="$target" '$6==v{print $7; exit}' "$_apm_ao" | tr ';' '\n')"
    rm -f "$_apm_ao"
    [[ -n $files ]] || files="$target"

    first=""
    prefix="$(default_prefix)"
    src="$(wine_source_of "$path" 2>/dev/null)" || src=""
    [[ -n $src ]] && prefix="${src%%/drive_c/*}"
    while IFS= read -r f; do
      [[ -n $f ]] || continue
      bare="$f"
      case "$f" in
        vst:*:*) bare="${f#vst:*:}" ;;
        native:*) bare="${f#native:}" ;;
      esac
      [[ -n $first ]] || first="$bare"
      state_register_install "$(plugin_key "$bare")" "$prefix" "$bare"
    done <<< "$files"
    echo "added to the manager: $(basename "$first")"
    ;;

  watch-manager)
    # Launch a manager app with the plugins folder watched, so whatever it
    # installs while it is open is registered instead of coming back as
    # untracked next time.
    exe="${1:?manager exe required}"
    pfx="${2:-$(default_prefix)}"
    source "$(dirname "${BASH_SOURCE[0]}")/lib-audio-plugin-manager-core.sh"
    load_prefs
    watch_for_plugins "$exe" "$pfx"
    jq -nc --arg exe "$exe" '{watched:$exe}'
    ;;

  adopt-plugins)
    # Register every plugin found on disk into the log, in ONE pass, grouped per
    # plugin, and report what happened.
    #
    # This is the "I already have a pile of plugins, stop asking me about them
    # one at a time" answer. The orphan screen asked for a tick per FILE, so a
    # suite installed outside the manager came back on EVERY launch: 50 rows for
    # 23 plugins, and the user had to walk the list each time. A log that knows
    # about the machine's plugins is the fix; the screen is only for a genuine
    # reconciliation, not for adoption.
    #
    # Non-destructive and idempotent: running it twice registers nothing the
    # second time.
    _apm_ad="${TMPDIR:-/tmp}/apm-adopt.$$"
    plugin_group_rows > "$_apm_ad"
    n=0
    while IFS=$'\t' read -r sortkey gkey label grp formats enabled value variants key; do
      [[ -n $key ]] || continue
      state_has "$key" && continue
      # A native plugin lives in the system tree, not in a wine prefix. Filing
      # it under the default prefix would claim it was installed by an
      # installer, and the uninstall tree would then offer to remove a wine
      # program that never contained it.
      # No `local`: the action dispatcher is a top-level `case`, not a function,
      # and `local` there is an error that aborts the whole action.
      pfx="$(default_prefix)"
      case "$value" in
        native:*) pfx="" ;;
        *) pfx="$(default_prefix)" ;;
      esac
      first=""
      while IFS= read -r f; do
        [[ -n $f ]] || continue
        bare="$f"
        case "$f" in
          vst:*:*) bare="${f#vst:*:}" ;;
          native:*) bare="${f#native:}" ;;
        esac
        [[ -n $first ]] || first="$bare"
        state_register_install "$(plugin_key "$bare")" "$pfx" "$bare"
      done <<< "$(printf '%s' "$variants" | tr ';' '\n')"
      # n=$((n+1)), NOT (( n++ )): under `set -e` the arithmetic command
      # returns the value it was BEFORE the increment, so (( n++ )) on n=0
      # returns 1 and KILLS the script. The first plugin registered and the
      # action stopped there, reporting one of twenty-three.
      n=$((n + 1))
    done < "$_apm_ad"
    rm -f "$_apm_ad"
    jq -nc --argjson n "$n" '{registered:$n}'
    ;;

  cleanup)
    # "cleanup!" -- fix every plugin/log inconsistency, non-destructively
    # (missing stay in the log, untracked files get registered, dangling
    # launchers removed). Only the final JSON report line is echoed.
    cleanup | tail -1
    ;;

  empty-quarantine)
    # Permanently delete everything parked by previous uninstalls
    # (~/.cache/vst-quarantine and ~/.cache/audio-plugin-manager-quarantine).
    # Deliberately destructive — the Go TUI double-confirms before calling.
    # Only the final JSON report line is echoed.
    empty_quarantine | tail -1
    ;;

  install-native-plugin)
    # These core functions print their own ok()/status lines to stdout
    # before a final bare path -- only that last line is the real return
    # value (see e.g. install_native_plugin_from_file, toggle_native_plugin_enabled,
    # toggle_vst_plugin_hidden in lib-audio-plugin-manager-core.sh).
    dest="$(install_native_plugin_from_file "${1:?file required}" | tail -1)"
    jq -nc --arg path "$dest" '{path:$path}'
    ;;

  toggle-native-plugin)
    new="$(toggle_native_plugin_enabled "${1:?plugin path required}" | tail -1)"
    jq -nc --arg path "$new" '{path:$path}'
    ;;

  toggle-vst-hidden)
    new="$(toggle_vst_plugin_hidden "${1:?plugin path required}" | tail -1)"
    jq -nc --arg path "$new" '{path:$path}'
    ;;

  *)
    echo "mosquito-audio-plugin-manager-actions: unknown action '$cmd'" >&2
    exit 2
    ;;
esac
