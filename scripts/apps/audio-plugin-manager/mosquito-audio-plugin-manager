#!/usr/bin/env bash
# mosquito-audio-plugin-manager — the single, stable entry point.
#
# The TUI (mosquito-audio-plugin-manager-tui, a real Bubble Tea program — Go,
# tui-go/) is the ONLY interface. The old bash/gum "native" overlay
# interface and the interface mode file (~/.config/audio-plugin-manager/interface)
# were removed: there is no interface switching anywhere anymore. This is
# the ONLY file any launcher (the standalone .desktop Entries generated by
# `mosquito-audio-plugin-manager launch`/`install`, a keybinding, running it by
# hand) ever needs to point at. Same architecture as the sibling
# mosquito-move-manager — see that dispatcher's header for the shared
# rationale.
#
# - No arguments → the interactive menu, i.e. the TUI. TUI mode needs an
#   actual terminal to render into: if this dispatcher is already running
#   inside one (stdin+stdout both a tty), it execs the TUI binary
#   directly; otherwise (a fully detached launch with no tty at all) it
#   opens a terminal itself, directly (foot, falling back to xterm — the
#   same pair `gui-run.bash` already relies on elsewhere in this repo),
#   `exec`ing straight into that terminal with no extra process hop. It is
#   deliberately NOT routed through Omarchy's `omarchy-launch-or-focus-tui`
#   (see the move dispatcher's header for the tested, reproduced-corruption
#   reasoning).
#
# - With arguments → a one-shot flag action (launch/install/status — see
#   the core's --help), NOT the interface. These run through the shared
#   core (lib-audio-plugin-manager-core.sh) exactly as before, with the core's own
#   real prompt primitives enabled (the Omarchy overlay / zenity /
#   plain-tty chain — see that file's "UI PRIMITIVE CONTRACT"). The core
#   is sourced here (not exec'd) and its `main` called explicitly: unlike
#   the move core it does not auto-run.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── Single-instance handling (interactive launches only) ────────────────────
# One TUI per manager: a normal launch that finds another copy already
# running asks whether to close it first; --replace closes it without asking;
# answering no abandons the new instance. Detection is an exact
# /proc/<pid>/cmdline argv-field match on the TUI binary (absolute path or
# bare basename), so a plain pgrep substring hit can never match an unrelated
# wrapper whose command line merely mentions the path. A PID file records the
# live instance; a stale record is dropped rather than trusted, so a crashed
# instance never blocks a new launch. Flag actions never reach this code.
MGR_TUI_BIN="$DIR/mosquito-audio-plugin-manager-tui"
MGR_SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
MGR_PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/mosquito-audio-plugin-manager.pid"

_mgr_pidfile_cleanup() { rm -f "$MGR_PIDFILE"; }

_mgr_is_our_pid() {
  # True when PID carries this manager's TUI binary or this dispatcher as a
  # whole, exact argv field — never on a mere substring.
  local p="$1" field
  [[ -r /proc/$p/cmdline ]] || return 1
  while IFS= read -r -d '' field; do
    case $field in
      "$MGR_TUI_BIN"|"${MGR_TUI_BIN##*/}") return 0 ;;
    esac
    if [[ $MGR_SELF == /* && $field == "$MGR_SELF" ]]; then return 0; fi
  done < "/proc/$p/cmdline"
  return 1
}

_mgr_running_tui_pids() {
  local p rec
  local -a pids=()
  while IFS= read -r p; do
    [[ -n $p && $p != "$$" ]] || continue
    if _mgr_is_our_pid "$p"; then pids+=("$p"); fi
  done < <(pgrep -f -- "${MGR_TUI_BIN##*/}" 2>/dev/null || true)
  if [[ -f $MGR_PIDFILE ]]; then
    rec=$(cat "$MGR_PIDFILE" 2>/dev/null || true)
    if [[ $rec =~ ^[0-9]+$ ]] && [[ $rec != "$$" ]] && _mgr_is_our_pid "$rec"; then
      pids+=("$rec")
    else
      rm -f "$MGR_PIDFILE"
    fi
  fi
  if ((${#pids[@]})); then
    printf '%s\n' "${pids[@]}" | sort -u
  fi
  return 0
}

_mgr_single_instance_gate() {
  local replace="$1" pids p
  trap _mgr_pidfile_cleanup EXIT
  pids=$(_mgr_running_tui_pids)
  if [[ -n $pids ]]; then
    if [[ $replace != true ]]; then
      # Short button labels so the shared mosquito.confirm overlay (fixed
      # button width) never clips them; the message carries the full intent.
      if ! ui_confirm "Another mosquito Audio Plugin Manager instance is already open. Close it and continue?" "Keep" "Close & continue"; then
        echo "mosquito-audio-plugin-manager: another instance is already open — leaving it alone." >&2
        exit 0
      fi
    fi
    while IFS= read -r p; do
      [[ -n $p ]] || continue
      kill "$p" 2>/dev/null || true
    done <<< "$pids"
    for _ in $(seq 1 20); do
      if [[ -z $(_mgr_running_tui_pids) ]]; then break; fi
      sleep 0.1
    done
    for p in $(_mgr_running_tui_pids); do kill -9 "$p" 2>/dev/null || true; done
  fi
  printf '%s\n' "$$" > "$MGR_PIDFILE"
}

# --replace: interactive launch that closes any other instance without asking.
REPLACE=false
if [[ ${1:-} == --replace ]]; then
  REPLACE=true
  shift
fi

if [[ $# -eq 0 ]]; then
  # Interactive path: the TUI is the only interface. Source the core with the
  # native-UI flag so its real ui_confirm/ui_info primitives are defined —
  # both the Hyprland gate and the single-instance confirm below need them.
  # The flag-driven paths below re-source the core with the same flag.
  export MOSQUITO_AUDIO_PLUGIN_MANAGER_NATIVE_UI=1
  # shellcheck source=/dev/null
  source "$DIR/lib-audio-plugin-manager-core.sh"
  unset MOSQUITO_AUDIO_PLUGIN_MANAGER_NATIVE_UI

  # Hyprland guard: these plugins' window rules and GUI fixes are written for
  # Hyprland and nothing was tested on another compositor/WM. Detect the
  # session (HYPRLAND_INSTANCE_SIGNATURE, or a live hyprctl) and, when it is
  # not Hyprland, warn clearly and ask before doing anything.
  if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] \
     && ! { command -v hyprctl >/dev/null 2>&1 && hyprctl version >/dev/null 2>&1; }; then
    if ! ui_confirm "These plugins are designed for Hyprland (window rules, plugin GUI handling). Nothing was tested on another compositor or window manager. Continue anyway?" "Quit" "Continue"; then
      ui_info "mosquito Audio Plugin Manager: no Hyprland session detected — nothing was changed."
      exit 0
    fi
  fi

  # One TUI per manager: --replace closes any other copy silently, otherwise
  # ask before taking over.
  _mgr_single_instance_gate "$REPLACE"

  # Interactive launch → the TUI, the only interface. The TUI runs as a
  # child (not exec) so the EXIT trap can drop the PID file when it ends.
  if [[ -t 0 && -t 1 ]]; then
    "$MGR_TUI_BIN"
    exit $?
  elif command -v foot >/dev/null 2>&1; then
    # Open the terminal as a perfect square (92x92 chars) — small but wide
    # enough to show the whole ASCII title + every option of the first menu
    # (the title is 82 chars wide; 92 leaves room for the centered picker).
    foot -W 100x30 --app-id=org.omarchy.mosquito-audio-plugin-manager-tui -e "$MGR_TUI_BIN"
    exit $?
  elif command -v xterm >/dev/null 2>&1; then
    xterm -e "$MGR_TUI_BIN"
    exit $?
  else
    echo "mosquito-audio-plugin-manager: no terminal emulator found (foot/xterm) to open the TUI in." >&2
    exit 1
  fi
fi

# Flag-driven one-shot action: run through the shared core with its real
# prompt primitives enabled (install/launch/status/--version/--help).
export MOSQUITO_AUDIO_PLUGIN_MANAGER_NATIVE_UI=1
source "$DIR/lib-audio-plugin-manager-core.sh"
main "$@"