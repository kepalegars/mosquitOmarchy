#!/usr/bin/env bash
# mosquitomarchy-actions — non-interactive backend for the mosquitOmarchy Go
# TUI (tui-go/). NOT an interface at all: it has no interactive UI (no gum /
# launcher prompts) and is never launched directly by a user. It exists so
# the Go program never has to reimplement any of mosquitomarchy-setup.sh's
# business logic (modules, categories, status, backup/restore, uninstall,
# repo updates) — it sources the exact same mosquitomarchy-setup.sh the launcher
# uses, in LIB_ONLY mode, and calls the same functions the interactive paths
# call.
#
# The split: Go owns every DECISION (which category, which items, confirm/
# cancel) — that is the actual "interface". This script only performs ACTIONS
# once a decision is already made.
#
# Two kinds of subcommands:
#   • read-only queries  → JSON to stdout for Go to parse (one record per
#     line, or a single object — see each case). Nothing else prints.
#   • actions            → thin direct calls into the sourced functions.
#     Output is the modules' own stdout/stderr prose, which the TUI's Runner
#     streams live. YES is forced to 1 so every "ask?" auto-yes and child
#     scripts receive -y; no prompt can ever block a pipe.
set -euo pipefail

SCRIPT_SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SELF")" && pwd)"
# Frozen BEFORE sourcing mosquitomarchy-setup.sh below: that file sets its own
# global SCRIPT_DIR (the repo root) on source, clobbering this one, so any
# late use of $SCRIPT_DIR would resolve to the wrong tree.
ACTIONS_DIR="$SCRIPT_DIR"
SETUP="$SCRIPT_DIR/../../../mosquitomarchy-setup.sh"
# Deployed run (~/.local/bin/mosquitomarchy-actions is a real COPY here, not
# a symlink): ~/.. from ~/.local/bin is NOT the repo — search known repos.
if [[ ! -f $SETUP ]]; then
  for cand in "$HOME/mosquitOmarchy/mosquitomarchy-setup.sh" \
              "$HOME/mosquitOmarchy/scripts/apps/mosquitomarchy/../../../mosquitomarchy-setup.sh"; do
    [[ -f $cand ]] && { SETUP="$cand"; break; }
  done
fi
APP_DIR="$(cd "$(dirname "$SETUP")" && pwd)"

# gui-run.bash (sourced by mosquitomarchy-setup.sh) would `exec foot …` the
# moment it sees a non-tty stdin/stdout — exactly our case (child of the
# TUI's Runner). Tell it we are already "in a terminal" (the TUI is it).
export GUI_RUN_EXEC=1
# patch-ableton.sh re-execs itself in a disposable `foot` window when it has no
# tty but a DISPLAY — which would open a window instead of streaming into the
# TUI's Runner. Tell it we are held so it runs inline.
export ABLE_PATCH_HELD=1
export MOSQUITOMARCHY_LIB_ONLY=1
# Tell the engine it is driven by the TUI: suppress the launcher's FINAL REPORT
# and "Left to do by hand" checklist (see final_report).
export MOSQUITOMARCHY_TUI=1

# Library-only source: defines every function, skips the flag parsing and the
# auto-run `main "$@"`. `set -e` is transferred by the sourced `set -euo
# pipefail` at its top — every query below must therefore be written to
# succeed even for empty results.
# shellcheck source=../../mosquitomarchy-setup.sh
# Deployed copy (~/.local/bin/mosquitomarchy-actions) is a symlink INTO the
# repo — dirname "$(readlink -f "$0")" resolves the repo, so the source sits
# there even when the caller invoked the bin path directly.
if [[ ! -f $SETUP ]]; then
  alt="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")/../../../mosquitomarchy-setup.sh"
  [[ -f $alt ]] && SETUP="$alt"
fi
source "$SETUP"

# ── JSON helpers (single-line, no trailing comma, escaped) ────────────────
#
# Pure bash, no fork. This used to be `printf '%s' "$1" | sed -e …`, and cmd_setup
# calls json_str four times per row across ~46 rows — roughly 250 forks, each
# paying bash's fork/exec cost. Measured on this machine that was ~43s of a ~50s
# `mosquitomarchy-actions setup`: the Setup screen sat blank for the better part
# of a minute, and the cost was spread thin enough across the trace that it read
# as "every operation is slow" rather than "one thing forks too often".
#
# Bash parameter expansion does the same two substitutions without a subprocess.
# Backslash first, because escaping the quote afterwards must not double-escape
# the backslashes this one introduces — same reason sed listed them in that order.
json_esc(){ local s=${1//\\/\\\\}; printf '%s' "${s//\"/\\\"}"; }
json_str(){ printf '"%s"' "$(json_esc "$1")"; }

# json_str_into writes the same thing as json_str, into the global JS, without a
# command substitution.
#
# This exists because on this machine a `$( )` costs ~60ms: the shell forks, and
# with a subshell plus an external pipeline underneath it the Setup tree's ~206
# json_str call sites turned into ~24 seconds of nothing but fork overhead — the
# screen sat blank for half a minute for a tree of 46 strings.
#
# printf with a trailing newline, then strip the last byte with ${JS%?}. Bash can
# do that inline, where it cannot do command capture cheaply.
json_str_into(){ local s=${1//\\/\\\\}; JS="\"${s//\"/\\\"}\""; }

# json_obj N field... prints one JSON object, fields already quoted.
#
# The KEYS are quoted here rather than passed in already quoted, so a call site
# reads `json_obj folder "$jf" label "$jl"` and there is no way to forget the
# quotes on a key. Values must already be json_str_into output, quotes included.
json_obj(){
  local out='{'
  while (( $# >= 2 )); do
    [[ $out == '{' ]] || out+=','
    out+="\"$1\":$2"
    shift 2
  done
  printf '%s}' "$out"
}

# json_obj_into is json_obj writing into the global JO. Same reason as
# json_str_into: a `$( )` is ~60ms here, and the Setup tree alone did ~60 of
# them just to assemble field strings.
json_obj_into(){
  local out='{'
  while (( $# >= 2 )); do
    [[ $out == '{' ]] || out+=','
    out+="\"$1\":$2"
    shift 2
  done
  JO="$out}"
}

# A JSON BOOLEAN, unquoted. json_str() always wraps its argument in quotes,
# which is right for a string and wrong for a bool: passing `excluded` through
# it emitted "excluded":"false", a string, and the Go StatusRec declares
# Excluded bool — so the entire Status screen failed to decode with
# "cannot unmarshal string into Go struct field StatusRec.excluded of type bool".
json_bool(){ [[ $1 == true ]] && printf 'true' || printf 'false'; }

# ── Route sudo to pkexec (native polkit prompt) for this backend ───────────
# The TUI's Runner gives the child no tty, so a plain `sudo` password prompt
# can never appear. Elevation is now primed ONCE per run by mq_sudo_prime
# (scripts/lib/elevate.bash) through a GUI askpass, and the resulting sudo cache
# serves every later root step. That helper also installs its own `sudo`->
# pkexec shim as a fallback when sudo cannot be primed, so no shim is generated
# here anymore.

# ─── Module status ─────────────────────────────────────────────────────────
# One JSON record per line: {"id":..,"label":..,"state":..,"excluded":bool}
cmd_status(){
  load_excluded
  apply_includes
  local row id state detail label excl cat
  for row in "${MODULES[@]}"; do
    id="${row%%:*}" label="${row#*:}"
    # module_state may append ":detail" (e.g. "partial:missing foo bar"). The
    # State screen's `i` shows that detail, so both halves travel in the JSON
    # instead of the detail being dropped here.
    state="$(module_state "$id")"
    detail=""
    if [[ $state == *:* ]]; then detail="${state#*:}"; state="${state%%:*}"; fi
    cat="$(module_category "$id")"
    excl=false
    is_excluded "$id" && excl=true
    # Every string field goes through json_str. `excluded` is the one that was
    # missed: a bare $excl emitted "excluded":"false" (a STRING), and the Go
    # StatusRec has Excluded bool — so the whole Status screen died on
    # "json: cannot unmarshal string into Go struct field StatusRec.excluded".
    printf '{"id":%s,"label":%s,"state":%s,"detail":%s,"category":%s,"excluded":%s}\n' \
      "$(json_str "$id")" "$(json_str "$label - v$(module_version "$id")")" \
      "$(json_str "$state")" "$(json_str "$detail")" "$(json_str "$cat")" "$(json_bool "$excl")"
  done
}

# ─── Setup categories ──────────────────────────────────────────────────────
# {"id":..,"label":..}
cmd_categories(){
  local c id label
  local -a rows=()
  for c in "${CATEGORIES[@]}"; do
    id="${c%%|*}"; label="${c#*|}"; label="${label%%|*}"
    rows+=("$label"$'\t'"$(printf '{"id":%s,"label":%s}' "$(json_str "$id")" "$(json_str "$label")")")
  done
  local line
  while IFS= read -r line; do
    [[ -n $line ]] && printf '%s\n' "${line#*$'\t'}"
  done < <(printf '%s\n' "${rows[@]}" | LC_ALL=C sort -f)
}

# ─── Candidate items of one category ──────────────────────────────────────
# Fills CAND_KEYS/CAND_LABELS then prints {"key":..,"label":..}
cmd_candidates(){
  TREE_MODE=setup
  local cat="${1:-}"
  category_candidates "$cat"
  local i
  local -a rows=()
  for ((i=0; i<${#CAND_KEYS[@]}; i++)); do
    # CAND_LABELS is "<name>  —  <description>". The row must show the name
    # only: the description is what the `i` popup is for, and inlined it made
    # every TUIs row a full sentence. SetupItemRec already has an Info field,
    # it was simply never filled, so `i` had nothing to show but the label.
    # Both halves must come from the SAME string: truncating $lab first and
    # then asking for the part after the separator found nothing left to split.
    local lab="${CAND_LABELS[$i]}" desc=""
    if [[ $lab == *"  —  "* ]]; then
      desc="${CAND_LABELS[$i]#*  —  }"
      lab="${CAND_LABELS[$i]%%  —  *}"
    fi
    rows+=("${CAND_LABELS[$i]}"$'\t'"$(printf '{"key":%s,"label":%s,"info":%s}' \
      "$(json_str "${CAND_KEYS[$i]}")" "$(json_str "$lab")" "$(json_str "$desc")")")
  done
  local line
  while IFS= read -r line; do
    [[ -n $line ]] && printf '%s\n' "${line#*$'\t'}"
  done < <(printf '%s\n' "${rows[@]}" | LC_ALL=C sort -f)
}

# ─── Quick fixes ──────────────────────────────────────────────────────────
# fix_applied <id>: 0 when the fix's own marker is present on this machine.
# The uninstall tree lists applied fixes only — offering to remove something
# that was never applied is a dead row with a confusing log.
fix_applied(){
  case "$1" in
    hyprland-crash)
      [[ -f "$HOME/.config/omarchy/hooks/post-boot.d/zzz-fix-hyprland-crash" ]] ;;
    ableton-wine-scroll)
      [[ -f "$HOME/.local/state/omarchy-ableton-scroll/backup.tsv" ]] ;;
    1px-seam)
      grep -q -- "mosquitomarchy-1px-seam" "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/looknfeel.lua" 2>/dev/null ;;
    *) return 1 ;;
  esac
}

# Flat list (the TUI groups by its own category logic if needed).
cmd_fixes(){
  local e id
  for e in "${FIXES[@]:-}"; do
    id="${e%%:*}"
    printf '{"key":%s,"label":%s,"cat":%s,"info":%s}\n' \
      "$(json_str "$id")" "$(json_str "${e#*:}")" "$(json_str "$(fix_category "$id")")" \
      "$(json_str "${e#*:}")"
  done
}

# -----------------------------------------------------------------------------
# Create a theme from an image — the 4-step flow on the TUI's main menu
# -----------------------------------------------------------------------------
# The TUI owns every decision (which folder, which image, which name) so this
# only ever runs create-theme.sh with all three already chosen. It is
# deliberately NOT the old interactive create-theme.sh: a child of the TUI has
# no tty for gum, and gum picking a wallpaper from a hidden popup inside a TUI
# is exactly the kind of thing that silently picks the wrong file.
cmd_theme_images(){
  local dir="${1:-}"
  [[ -n $dir ]] || return 0
  [[ -d $dir ]] || return 0          # a folder that vanished lists as empty
  local f base
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    base="$(basename "${f%.*}")"
    # The proposed theme name: what the TUI pre-fills the name field with.
    local proposed
    proposed="$(printf '%s\n' "$base" | tr '[:upper:]' '[:lower:]' \
      | sed -E 's/[^a-z0-9]+/ /g; s/^ +| +$//g; s/ (.)/\U\1/g; s/^(.)/\U\1/')"
    printf '{"file":%s,"name":%s,"proposed":%s}\n' \
      "$(json_str "$(basename "$f")")" "$(json_str "$base")" "$(json_str "${proposed:-$base}")"
  done < <(find "$dir" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' \
             -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | sort)
}

# The folder Theming opens on, when the user has picked one. Empty means "the
# automatic default" (see themeFolderCandidates in the TUI).
#
# A preference, stored next to the other mosquitomarchy state rather than in the
# repo: it describes this machine, and nothing else reads it.
THEME_DEFAULT_DIR_FILE=""

theme_default_dir_file(){
  printf '%s\n' "${THEME_DEFAULT_DIR_FILE:-$HOME/.config/mosquitomarchy/theme-default-dir}"
}

# ─── Backup options (persisted) ─────────────────────────────────────────────
# The TUI's "Backup options" screen used to keep its choices in the model, so
# they survived leaving the page but died with the process: the next run started
# from the defaults again, whatever the user had just told it. Storing them is
# the difference between an option and a preference.
#
# A JSON file under ~/.config/mosquitomarchy, next to theme-default-dir and
# for the same reason: these describe THIS machine, and nothing else reads them.
# ~/.local/state is for flags and markers, not choices.
BACKUP_OPTS_FILE=""

backup_opts_file(){
  printf '%s\n' "${BACKUP_OPTS_FILE:-$HOME/.config/mosquitomarchy/backup-options.json}"
}

# get -> the stored JSON, or nothing at all when there is none. Silence is a
# valid answer (no preference saved yet) so it must NOT exit non-zero: the TUI
# reads the empty output as "use the defaults".
cmd_backup_opts(){
  local f mode="${1:-get}" arg="${2:-}"
  f="$(backup_opts_file)"
  case "$mode" in
    get)
      # `if`, not `[[ -r $f ]] && cat …`: with no file yet the && chain returns
      # 1, and the TUI reads that as a failed query rather than as "no
      # preference saved yet", which is the normal state on a first run.
      if [[ -r $f ]]; then cat "$f"; fi
      ;;
    set)
      # The TUI builds the JSON and hands it over as one argv element, so there
      # is no quoting to get wrong here — but an empty payload is refused,
      # because writing it would leave a file that reads as "no options" while
      # looking like a stored preference.
      [[ -n $arg ]] || { err "backup-opts set needs a JSON payload"; return 1; }
      mkdir -p "$(dirname "$f")" 2>/dev/null || true
      if ! printf '%s\n' "$arg" > "$f"; then
        err "cannot write $f"
        return 1
      fi
      ;;
    clear|"")
      rm -f "$f"
      ;;
  esac
}

backup_sel_file(){
  printf '%s\n' "${BACKUP_SEL_FILE:-$HOME/.config/mosquitomarchy/backup-selection.json}"
}

# ─── The ticked rows of the Backup content screen ──────────────────────────
# Saved the moment a row is touched, not when a backup is made. The screen used
# to rebuild its ticks from the LAST ARCHIVE every time it opened, so a
# selection made — or a row deliberately UNticked — was gone the moment you left
# the page, and gone for good if you quit the TUI instead of running the backup.
# A list the user assembles over several passes cannot be thrown away between
# passes.
#
# Stored as the item keys ("APP foo", "TUI septabee", "WEB …") because that is
# what beginBackup writes to apps.selected: one vocabulary, so there is no
# second format to keep in step.
cmd_backup_sel(){
  local f mode="${1:-get}" arg="${2:-}"
  f="$(backup_sel_file)"
  case "$mode" in
    get)
      # A missing file means "nothing saved yet", NOT a failure: the caller
      # treats an empty answer as "fall back to the last archive", and a
      # non-zero status here would make that fallback unreachable.
      [[ -r $f ]] && cat "$f"
      return 0 ;;
    set)
      [[ -n $arg ]] || { err "backup-sel set needs a JSON payload"; return 1; }
      mkdir -p "$(dirname "$f")" 2>/dev/null || true
      printf '%s\n' "$arg" > "$f" || { err "cannot write $f"; return 1; } ;;
    clear|"") rm -f "$f" ;;
  esac
}

cmd_theme_default_dir(){
  local f mode="${1:-get}" arg="${2:-}"
  f="$(theme_default_dir_file)"
  case "$mode" in
    get)
      # Empty output is a valid answer here (no preference set), so it exits 0
      # with nothing rather than being read as a failure by the TUI.
      if [[ -r $f ]]; then cat "$f"; fi
      ;;
    set)
      [[ -n $arg ]] || { err "theme-default-dir set needs a folder"; exit 2; }
      mkdir -p "$(dirname "$f")" 2>/dev/null || true
      printf '%s\n' "$arg" > "$f"
      ;;
    auto|"")
      rm -f "$f"
      ;;
  esac
}

# A file chooser for the theme flow: one image, or one folder. Nautilus and
# superfile are NOT used here — they cannot return a choice to a TUI, and the
# manager has to keep running to build the theme afterwards. The portal chooser
# and zenity can, so those are what the chain is.
#
# "$1" = file|folder, "$2" = start directory.
cmd_theme_pick(){
  local kind="${1:-file}" start="${2:-$HOME}" out=""
  local -a exts=()
  if [[ $kind == folder ]]; then
    exts=(--directory)
    title="Theming — choose the folder holding your images"
  else
    exts=(--extensions "png jpg jpeg webp")
    title="Theming — choose an image"
  fi
  if command -v omarchy-file-select >/dev/null 2>&1 \
     && { [[ -n ${DISPLAY:-} || -n ${WAYLAND_DISPLAY:-} || -n ${OMARCHY_WL:-} ]]; }; then
    out="$(omarchy-file-select --title "$title" "${exts[@]}" 2>/dev/null | head -1)"
  elif command -v zenity >/dev/null 2>&1; then
    if [[ $kind == folder ]]; then
      out="$(zenity --file-selection --directory --title="$title" 2>/dev/null)" || true
    else
      out="$(zenity --file-selection --title="$title" \
        --file-filter 'Images | *.png *.jpg *.jpeg *.webp' 2>/dev/null)" || true
    fi
  fi
  # Empty output means "cancelled", which is NOT an error: the TUI treats an
  # empty path as "go back where you were" rather than as a failure to report.
  printf '%s\n' "${out:-}"
}

# cmd_theme_create <dir> <image> <name> [apply] [unlock on|off]
#
# Runs the generator with --log so the TUI's "See log" row has a real file to
# show. Without the apply flag create-theme.sh only BUILDS the theme: applying
# runs every Omarchy theme hook, so it stays the user's explicit choice.
cmd_theme_create(){
  local dir="${1:-}" image="${2:-}" name="${3:-}" apply="${4:-}"
  [[ -n $dir && -n $image && -n $name ]] || { err "theme-create: dir, image and name are all required"; return 2; }
  local script="$THEME_DIR/create-theme.sh"
  [[ -f $script ]] || { err "theme-create: $script not found"; return 2; }

  mkdir -p "$HOME/.local/state/mosquitomarchy"
  local log="$HOME/.local/state/mosquitomarchy/theme-create.log"
  : > "$log"

  # $5 = unlock (on|off). Defaults to on so an older caller keeps the complete
  # theme; the TUI passes the toggle's own value.
  local unlock="${5:-on}"
  local args=(--dir "$dir" --image "$image" --name "$name" --log "$log" --no-apply)
  [[ $apply == apply ]] && args+=(--apply)
  if [[ $unlock == off ]]; then args+=(--no-unlock-style); else args+=(--unlock-style); fi

  YES=1 RESULTS=() MODULE_FAILURES=0
  # Not run_module: this is not a module of the plan, it is a one-off action
  # that happens to live in the theme folder. Keep it out of RESULTS so it does
  # not show up as "theme" in the final report.
  if bash "$script" "${args[@]}"; then
    echo "THEME_SLUG=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')"
    echo "THEME_LOG=$log"
    return 0
  fi
  MODULE_FAILURES=1
  echo "THEME_LOG=$log"
  return 1
}

# The user's own themes, for the Theming → Uninstall screen.
#
# Stock Omarchy themes are NOT removable and are not offered here: they live in
# /usr/share/omarchy/themes, belong to the package, and come back on update.
# Only ~/.config/omarchy/themes is the user's, and only that is listed.
cmd_theme_list(){
  local dir="$HOME/.config/omarchy/themes" n
  [[ -d $dir ]] || exit 0
  # omarchy-theme-current answers the DISPLAY name ("Achraff 67"), not the
  # directory slug ("achraff-67"), so comparing the two directly marks nothing
  # as current. Normalise both to a comparable form: lower case, no spaces,
  # underscores and dashes equivalent.
  local cur norm n
  cur="$(omarchy-theme-current 2>/dev/null || echo -)"
  norm(){ printf '%s' "${1,,}" | tr -d ' _-'; }
  local want; want="$(norm "$cur")"
  while IFS= read -r n; do
    [[ -n $n ]] || continue
    # A symlink is a clone pointing into the stock tree: removing it would
    # delete nothing and break the link, and it is not really "the user's".
    [[ -L "$dir/$n" ]] && continue
    jq -nc --arg name "$n" --argjson current "$([[ "$(norm "$n")" == "$want" ]] && echo true || echo false)" \
      '{name:$name, current:$current}'
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort -f)
}

# cmd_theme_remove <name...> — remove the user's themes, via Omarchy's own
# remover rather than an rm, so the guards it has (a name that cannot climb out
# of the themes dir, a currently-applied theme) still apply.
cmd_theme_remove(){
  local n rc=0
  (($#)) || { err "theme-remove: at least one theme required"; return 2; }
  for n in "$@"; do
    if omarchy-theme-remove "$n" >/dev/null 2>&1; then
      echo "removed: $n"
    else
      rc=1
      echo "could not remove: $n" >&2
    fi
  done
  return $rc
}

# cmd_theme_restore_stock — copy the stock themes back into the user's tree.
#
# This is the repair half of "uninstall": omarchy-theme-remove takes a theme out
# of ~/.config/omarchy/themes, and the way to get the stock ones back is to copy
# them in from /usr/share. Restoring is per-theme and skips any already present,
# so it is safe to run more than once and never overwrites something the user
# edited.
cmd_theme_restore_stock(){
  local src="$HOME/.local/share/omarchy/themes"
  local dest="$HOME/.config/omarchy/themes"
  local base
  [[ -d /usr/share/omarchy/themes ]] || { err "no stock themes directory"; return 1; }
  [[ -d $src ]] || { mkdir -p "$src" || return 1; }
  local n=0
  while IFS= read -r base; do
    [[ -n $base ]] || continue
    if [[ -e "$dest/$base" ]]; then continue; fi
    cp -r "/usr/share/omarchy/themes/$base" "$dest/$base" && n=$((n+1))
  done < <(find /usr/share/omarchy/themes -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort -f)
  # Record which stock themes are available, so the TUI can offer the restore
  # row even when nothing needs restoring yet.
  printf '{\n'
  local first=1
  while IFS= read -r base; do
    [[ -n $base ]] || continue
    [[ $first == 1 ]] || printf ',\n'
    first=0
    printf '  "%s": %s' "$base" "$([[ -e "$dest/$base" ]] && echo true || echo false)"
  done < <(find /usr/share/omarchy/themes -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort -f)
  printf '\n}\n'
  ok "restored $n stock theme(s)"
}

# cmd_theme_apply <name> — the "Apply theme" row of the success prompt.
cmd_theme_apply(){
  local name="${1:-}"
  [[ -n $name ]] || { err "theme-apply: name required"; return 2; }
  omarchy theme set "$name"
}

# ─── Full setup tree (folders = categories, children = installable items) ──
# One JSON record per line:
#   folder: {"folder":id,"label":label,"accent":bool}
#   item:   {"folder":id,"key":key,"label":name,"info":description}
# The label/info split mirrors the bash launcher's "name  —  description"
# convention (CAND_LABELS) so the TUI shows only the name inline and keeps the
# longer description behind the "i" key instead of crowding the row.
# ─── Setup tree cache ───────────────────────────────────────────────────────
#
# The tree is the same data every time: which catalogs exist, which fixes are
# declared, and one repo version. None of that changes while the user is just
# looking at the screen, and the TUI asks for it again on every visit to Setup
# and every visit to Uninstall.
#
# So it is cached on disk, and invalidated by an FINGERPRINT rather than by a
# clock alone: the catalogs, the fixes block and VERSION are what the tree is
# derived from, so a change to any of them must show up on the next read even
# if the cache is seconds old. The TTL is only a backstop for the case where
# something outside those files changes a module's presence.
#
# "ajouts" is handled by that fingerprint, which is the honest signal: adding a
# line to guis.catalog, tuis.catalog or webapps.catalog changes the checksum
# immediately, with no refresh to wait for and no stale-list window.
# tree_fingerprint is the key for the cached tree: everything the tree is derived
# from. Pure bash — no md5sum, no stat. This runs on every Setup and Uninstall
# visit, so it has to be cheaper than what it guards; `stat -c` + `md5sum`
# measured 3.7s here, two external forks to build a value bash assembles inline.
#
# Keying on each catalog's CONTENT LENGTH is what makes it free: ${#var} is a
# builtin, and adding or removing a catalog line changes the length, so a new app
# shows up on the very next read with nothing to refresh. An edit that only
# rewrites a line in place keeps the length, so the declared FIXES and CATEGORIES
# counts and the repo version are mixed in, and the reaper in cache_store covers
# a same-length edit that then goes unnoticed for longer than that.
tree_fingerprint(){
  local f out='k1' body
  for f in "$CAT_FILE_GUI" "$CAT_FILE_TUI" "$CAT_FILE_WEB"; do
    if [[ -f $f && -r $f ]]; then
      body="$(<"$f")"          # a redirect, no fork
      out+="|${f##*/}:${#body}"
    else
      out+="|${f##*/}:x"
    fi
  done
  out+="|v${REPO_VERSION:-}|f${#FIXES[@]}|c${#CATEGORIES[@]}"
  # Whether a big installer is on disk is an INPUT to the tree, not a detail of
  # it: Setup greys out the module that needs it. Without this in the key, the
  # greying could not appear until the 30-minute reap, and — the part that
  # actually matters — dropping the Ableton zip into the folder would NOT bring
  # the row back, which is the opposite of what the row promises.
  #
  # Presence only, via the globs in _manual_asset_present. The sha256 in
  # assets.links would be the stronger check but hashing a 4 GB zip to decide
  # whether to draw a row greyed is not a trade worth making; checksum
  # verification stays in `download-assets.sh --check`.
  local gk
  for gk in "${ASSET_GATED_KEYS[@]}"; do
    if _manual_asset_present "$gk"; then out+="|$gk:1"; else out+="|$gk:0"; fi
  done
  # The builder's own mtime. A change to THIS file changes the tree, and the
  # catalog fingerprints above cannot see that: two different versions of the
  # tree builder produced byte-identical fingerprints and the loser of the race
  # won the cache.
  out+="|m$(stat -c %Y "$SCRIPT_SELF" 2>/dev/null || echo 0)"
  # Slashes and spaces would break the filename; this set is enough for a name.
  printf '%s' "${out//[^A-Za-z0-9._|-]/_}"
}

TREE_CACHE_DIR="$HOME/.cache/mosquitomarchy"
TREE_CACHE_TTL_MIN=30 # minutes before a stale fingerprint's file is reaped

# cache_file kind fingerprint -> path. The kind is part of the NAME, not part of
# the key: setup and uninstall produced the same fingerprint for a machine with
# nothing extra installed, and sharing one file meant whichever ran last
# overwrote the other and the TUI decoded the wrong tree.
cache_file(){ printf '%s/tree-%s.%s' "$TREE_CACHE_DIR" "$1" "$2"; }

# cache_key_digest shortens an arbitrary string to a usable filename fragment.
# cksum is one cheap fork and gives 32 bits, which is plenty for "same input as
# last time" in a per-user cache directory.
cache_key_digest(){ printf '%s' "$1" | cksum | tr -d ' -'; }

# cache_read kind fingerprint: prints the cached tree, or returns 1.
cache_read(){
  local f; f="$(cache_file "$1" "$2")"
  [[ -r $f ]] || return 1
  cat "$f"
}

# cache_store kind fingerprint payload: writes it, best effort. Never fails the
# caller — a cache that cannot be written is not an error, it is just slower.
cache_store(){
  local f dir="$TREE_CACHE_DIR" tmp
  [[ -n ${3:-} ]] || return 0
  f="$(cache_file "$1" "$2")"
  mkdir -p "$dir" 2>/dev/null || return 0
  tmp="$dir/.tree.$$.$RANDOM"
  printf '%s\n' "$3" > "$tmp" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 0; }
  mv -f "$tmp" "$f" 2>/dev/null || rm -f "$tmp" 2>/dev/null
  # Reap fingerprints that are no longer current. Swallowed on purpose: this is
  # housekeeping and must never be the status a caller sees.
  { find "$dir" -maxdepth 1 -name 'tree-*' -type f ! -name "$(basename "$f")" \
      -mmin "+$TREE_CACHE_TTL_MIN" -delete; } 2>/dev/null || true
  return 0
}

cmd_setup(){
  TREE_MODE=setup
  local fp
  fp="$(tree_fingerprint)"
  if cache_read setup "$fp"; then return 0; fi
  # Build once, write once. `tee` looked right — stdout and the cache both get
  # the tree — but with a consumer on each end the run that POPSULATED the cache
  # still printed an empty screen, so a caching layer that blanks the screen on
  # a cache miss is worse than no cache at all.
  #
  # So the tree is captured into a variable first and then both emitted and
  # stored from it. $() is a fork, but it is ONE fork per visit rather than one
  # per row, which is the whole difference from before.
  local tree
  tree="$(_setup_tree)"
  [[ -n $tree ]] || return 1
  cache_store setup "$fp" "$tree"
  printf '%s\n' "$tree"
}

_setup_tree(){
  local c id label accent i e name info gate disabled
  local sep='  —  '
  # Categories and their scripts are ALWAYS shown in alphabetical order, so a
  # growing catalog never turns into a hunt. The sort key is the label (or the
  # folder id for a child), never the JSON payload; the payload rides after a
  # TAB and is stripped before printing.
  local -a folders=() items=()

  # REPO_VERSION is sourced once from VERSION at the top of
  # mosquitomarchy-setup.sh, so it is read here for free. module_version()
  # re-read the file per row instead, and with ~46 rows that was ~46 forks
  # before a single character of the tree had been printed.
  local ver="${REPO_VERSION:-1.0.0}"

  for c in "${CATEGORIES[@]}"; do
    id="${c%%|*}"; label="${c#*|}"; label="${label%%|*}"
    # The Omarchy menu registration is shown INSIDE the mosquito folder (see
    # the mosquito case below), never as its own top-level Setup folder.
    [[ $id == menu ]] && continue
    accent=false
    [[ $id == mosquito ]] && accent=true
    json_str_into "$id";    local j_folder=$JS
    json_str_into "$label"; local j_label=$JS
    json_obj_into folder "$j_folder" label "$j_label" accent "$accent"
    folders+=("$label"$'\t'"$JO")
    case $id in
      fixes)
        local fe fid
        json_str_into "$id"; j_folder=$JS
        for fe in "${FIXES[@]:-}"; do
          fid="${fe%%:*}"
          json_str_into "$fid"; local j_fid=$JS
          json_str_into "${fe#*:}"; local j_info=$JS
          json_obj_into folder "$j_folder" key "$j_fid" label "$j_fid" info "$j_info"
          items+=("fixes/$fid"$'\t'"$JO")
        done
        ;;
      *)
        category_candidates "$id"
        local nk=${#CAND_KEYS[@]}
        for ((i=0; i<nk; i++)); do
          name="${CAND_LABELS[$i]}"; info=""
          if [[ $name == *"$sep"* ]]; then
            info="${name#*"$sep"}"
            name="${name%%"$sep"*}"
          fi
          # The Setup leaf for remove-ai must read exactly
          # "bring back omarchy's agentic stuff" (the uninstall label is
          # the "remove" version, but it never shows in this tree).
          if [[ ${CAND_KEYS[$i]} == "remove-ai" ]]; then
            name="bring back omarchy's agentic stuff"
            # No description: the label already says what the row does, and a
            # 100-column blurb under it was one of the two rows that made the
            # Setup page overflow the pane.
            info=""
          fi
          # Catalog shell-plugins used to be relabelled here from the raw
          # id|url|human-label field, which re-inlined the description the split
          # above had just removed (the row read "Monitor Settings — Hyprland
          # display/monitor panel"). category_candidates now returns the human
          # name for PLUG rows, so this override only had to be dropped.
          local vlabel="$name - v$ver"
          # remove-ai's Setup row reads EXACTLY "bring back omarchy's agentic
          # stuff" (no version suffix; it is an action, not a versioned module).
          [[ ${CAND_KEYS[$i]} == remove-ai ]] && vlabel="$name"
          # A module whose big installer is not on this machine yet stays in
          # the tree, greyed, and says which file is missing. The note goes in
          # `info` because that line is already rendered under the label, so
          # the reason is visible without a second row or a tooltip.
          gate="$(_asset_gate "${CAND_KEYS[$i]}")"
          if [[ -n $gate ]]; then
            disabled=true
            info="${info:+$info — }$(_asset_gate_note "${CAND_KEYS[$i]}")"
          else
            disabled=false
          fi
          # Folder may differ from the category: septabee is a catalogued TUI that
          # is filed under Apps, so the folder is resolved per row rather than
          # taken from $id.
          json_str_into "$(setup_folder_for "$id" "${CAND_KEYS[$i]}")"; j_folder=$JS
          json_str_into "${CAND_KEYS[$i]}"; local j_key=$JS
          json_str_into "$vlabel";       local j_vlabel=$JS
          json_str_into "$info";         local j_info=$JS
          json_obj_into folder "$j_folder" key "$j_key" label "$j_vlabel" info "$j_info" \
            disabled "$(json_bool "$disabled")"
          items+=("${j_folder//\"/}/$name"$'\t'"$JO")
        done
        ;;
    esac
  done
  local line
  while IFS= read -r line; do
    [[ -n $line ]] && printf '%s\n' "${line#*$'\t'}"
  done < <(printf '%s\n' "${folders[@]}" | LC_ALL=C sort -f)
  while IFS= read -r line; do
    [[ -n $line ]] && printf '%s\n' "${line#*$'\t'}"
  done < <(printf '%s\n' "${items[@]}" | LC_ALL=C sort -f)
}

# ─── Uninstall tree (installed entries, Setup categories/order) ────────────
# Same folders and order as `setup`, but only the INSTALLED entries. Each item
# carries the exact key the `uninstall` action expects: a module id, or a
# catalog selection line (APP/TUI/WEB) routed to the apps module's uninstaller.
_installed_state(){ # module id -> 0 when installed (ok/partial) and not excluded
  local id="$1" st
  is_excluded "$id" 2>/dev/null && return 1
  st="$(module_state "$id" 2>/dev/null)"; st="${st%%:*}"
  [[ $st == ok || $st == partial ]]
}
cmd_uninstall_tree(){
  TREE_MODE=uninstall
  local fp
  # Installed-state detection is the expensive part here (it stats binaries and
  # prefixes), so it runs BEFORE the fingerprint is taken — otherwise the
  # fingerprint would have to call it, and the cache would save nothing. What
  # is detected is also what the tree depends on, so it belongs in the key.
  load_excluded
  load_catalog 2>/dev/null || true
  detect_installed_apps 2>/dev/null || true
  # The installed-set goes through tree_fingerprint too, and the result is
  # SUMMARISED rather than concatenated. The raw value lists every installed
  # TUI and webapp with its full catalog field — 607 characters here, and a
  # filename is capped at 255 bytes, so the mv failed silently and the cache
  # never once hit. It had been "working" the whole time as a no-op.
  #
  # Summarising is also the right shape: what matters is WHICH are installed,
  # not their descriptions, and a changing description should not invalidate.
  local inst=""
  for e in "${INSTALLED_TUI[@]:-}" "${INSTALLED_WEB[@]:-}"; do
    [[ -n $e ]] && inst+="${e%%|*}|"
  done
  fp="$(tree_fingerprint)$(cache_key_digest "$inst")"
  if cache_read uninstall "$fp"; then return 0; fi
  local tree
  tree="$(_uninstall_tree)"
  [[ -n $tree ]] || return 1
  cache_store uninstall "$fp" "$tree"
  printf '%s\n' "$tree"
}

_uninstall_tree(){
  local c id label accent e name info spec mid
  local -a folders=() items=()
  for c in "${CATEGORIES[@]}"; do
    id="${c%%|*}"; label="${c#*|}"; label="${label%%|*}"
    # `menu` and `fixes` are not modules: nothing to uninstall there.
    [[ $id == menu || $id == fixes ]] && continue
    local -a keys=()
    case $id in
      tuis)
        for e in "${INSTALLED_TUI[@]:-}"; do [[ -n $e ]] && keys+=("TUI $e"); done
        ;;
      webapps)
        for e in "${INSTALLED_WEB[@]:-}"; do [[ -n $e ]] && keys+=("WEB $e"); done
        ;;
      mosquito)
        local pk
        for pk in ableton-move-manager audio-plugin-manager jamjamjam-plugin battery live-mode pipewire-settings mosquitomarchy; do
          case $pk in
            audio-plugin-manager) _installed_state audio && keys+=("$pk") ;;
            *) _installed_state "$pk" && keys+=("$pk") ;;
          esac
        done
        ;;
      *)
        local mid
        for mid in $(category_items "$id"); do
          _installed_state "$mid" && keys+=("$mid")
        done
        ;;
    esac
    ((${#keys[@]})) || continue
    accent=false; [[ $id == mosquito ]] && accent=true
    folders+=("$label"$'\t'"$(printf '{"folder":%s,"label":%s,"accent":%s}' \
      "$(json_str "$id")" "$(json_str "$label")" "$accent")")
    for e in "${keys[@]}"; do
      case $e in
        # A TUI key is "TUI <pkg>|<pkg> — <what it is>" straight from the
        # catalog, so showing it verbatim filled the Uninstall tree with rows
        # like "calcure|calcure — terminal calendar/planner". split_name_desc
        # takes the human name and drops the repetition.
        TUI\ *) local trest tpkg ttext
                trest="${e#TUI }"
                tpkg="${trest%%|*}"; ttext="${trest#*|}"
                [[ $ttext == "$trest" ]] && ttext="$trest"
                split_name_desc "$tpkg" "$ttext"
                name="$CAND_NAME - v$(module_version "$tpkg")"
                info="installed TUI (apps module)$( [[ -n $CAND_DESC ]] && printf ' — %s' "$CAND_DESC")" ;;
        WEB\ *) local wrest wname wurl
                wrest="${e#WEB }"
                wname="${wrest%%|*}"; wurl="${wrest#*|}"; wurl="${wurl%%|*}"
                name="$wname"
                info="installed webapp (apps module)$( [[ -n $wurl && $wurl != "$wrest" ]] && printf ' — %s' "$wurl")" ;;
        *)
          if [[ $e == remove-ai ]]; then
            # Uninstall wording (Setup shows the "bring back…" version).
            name="remove omarchy's agentic stuff"
            info=""
          else
            name="$e - v$(module_version "$e")"
            info="$(module_desc "$e")"
          fi ;;
      esac
      items+=("$(setup_folder_for "$id" "$e")/$name"$'\t'"$(printf '{"folder":%s,"key":%s,"label":%s,"info":%s}' \
        "$(json_str "$(setup_folder_for "$id" "$e")")" "$(json_str "$e")" "$(json_str "$name")" "$(json_str "$info")")")
    done
  done
  # ── Extra uninstall-only categories (not part of Setup) ──
  # Patches: only when at least one installed app has an APPLIED patch.
  local -a pkeys=()
  for mid in $(category_items apps); do
    _installed_state "$mid" || continue
    spec="$(_manual_patch_spec "$mid")"; [[ -n $spec ]] || continue
    [[ -f "$APPS_DIR/$spec" ]] || continue
    _patch_applied "$APPS_DIR/$spec" && pkeys+=("$mid")
  done
  if ((${#pkeys[@]})); then
    folders+=("Patches"$'\t'"$(printf '{"folder":%s,"label":%s,"accent":%s}' \
      "$(json_str patches)" "$(json_str "Patches")" false)")
    for mid in "${pkeys[@]}"; do
      items+=("patches/$mid"$'\t'"$(printf '{"folder":%s,"key":%s,"label":%s,"info":%s}' \
        "$(json_str patches)" "$(json_str "patch:$mid")" \
        "$(json_str "$mid — remove patch")" "$(json_str "restores the original files")")")
    done
  fi
  # Quick fixes that are currently APPLIED (each supports --remove/--uninstall).
  # Listing every removable fix unconditionally put rows in front of users who
  # never applied them, with nothing meaningful for removal to do.
  local -a applied_fixes=()
  local fid
  for fid in hyprland-crash ableton-wine-scroll 1px-seam; do
    fix_applied "$fid" && applied_fixes+=("$fid")
  done
  if ((${#applied_fixes[@]})); then
    folders+=("Quick fixes"$'\t'"$(printf '{"folder":%s,"label":%s,"accent":%s}' \
      "$(json_str fixes)" "$(json_str "Quick fixes")" false)")
    for fid in "${applied_fixes[@]}"; do
      items+=("fixes/$fid"$'\t'"$(printf '{"folder":%s,"key":%s,"label":%s,"info":%s}' \
        "$(json_str fixes)" "$(json_str "fix:$fid")" "$(json_str "$fid")" \
        "$(json_str "$(fix_desc "$fid")")")")
    done
  fi
  # Preinstalls is a row again, and it is TICKABLE. The long description that
  # used to sit under it is gone for good: the page no longer doubles in height
  # when one row carries a sub-line, so a long label is just a long label now
  # and the row says plainly what ticking it is for.
  folders+=("Preinstalls"$'\t'"$(printf '{"folder":%s,"label":%s,"accent":%s}' \
    "$(json_str preinstalls)" "$(json_str "Preinstalls")" false)")
  items+=("preinstalls/choose"$'\t'"$(printf '{"folder":%s,"key":%s,"label":%s,"info":%s,"disabled":%s}' \
    "$(json_str preinstalls)" "$(json_str "preinstalls:choose")" \
    "$(json_str "Choose which Omarchy preinstalls to remove")" \
    "$(json_str "tick it, then the list opens when you apply")" false)")

  local line
  while IFS= read -r line; do [[ -n $line ]] && printf '%s\n' "${line#*$'\t'}"; done \
    < <(printf '%s\n' "${folders[@]}" | LC_ALL=C sort -f)
  while IFS= read -r line; do [[ -n $line ]] && printf '%s\n' "${line#*$'\t'}"; done \
    < <(printf '%s\n' "${items[@]}" | LC_ALL=C sort -f)
}

# ─── Backups present in BACKUP_DIR ────────────────────────────────────────
# Most recent first: {"file":..,"size":..,"date":..}
cmd_backups(){
  local -a files=()
  local f sz name date
  for f in "$BACKUP_DIR"/omarchy-backup-*.tar.gz*; do [[ -f $f ]] && files+=("$f"); done
  for ((i=${#files[@]}-1; i>=0; i--)); do
    f="${files[$i]}"; name="$(basename "$f")"
    sz=$(du -h "$f" | cut -f1)
    date="$(backup_desc "$name")"
    printf '{"file":%s,"size":%s,"date":%s}\n' \
      "$(json_str "$name")" "$(json_str "$sz")" "$(json_str "$date")"
  done
}

# ─── Packages the catalog files as TUIs but mosquitomarchy files as APPS ────
# septabee is a DAW, not a terminal utility. It is cataloged as a TUI because
# that is how it ships (a terminal app needing its own launcher and icon,
# installed by setup-septabee-menu.sh), but everywhere the user CHOOSES something
# — Setup, Uninstall and the backup content screen — it belongs among the
# applications.
#
# One list for all three. It was a backup-only list first, and the other two trees
# kept filing septabee under TUIs until this was generalised: three trees, three
# chances to disagree.
#
# The FOLDER is the only thing that changes. The item key stays "TUI septabee",
# because that is the line apps.selected and --selection= speak — beginBackup
# writes it.Key and ignores the folder, so archives are byte-identical to what
# they were and an old archive still restores like a new one.
AS_APP_PACKAGES=(septabee)

# Modules whose row belongs under the TUIs folder even though they are MODULES.
#
# superfile is not a catalog entry: it has its own script that installs the
# package AND a .desktop menu entry, an icon, a keybind and an Omarchy theme.
# Turning it into a plain `TUI superfile|` catalog line would install the binary
# and silently drop all of that, so it stays a module and only its FOLDER moves.
# The same trade-off, in the other direction, is why septabee is only re-filed
# and never converted.
AS_TUI_MODULES=(superfile)

# 0 when this catalog entry is filed under Apps rather than TUIs.
_filed_under_apps(){ # package name
  local p
  for p in "${AS_APP_PACKAGES[@]}"; do
    [[ $p == "$1" ]] && return 0
  done
  return 1
}

# setup_folder_for <category id> <candidate key> -> the folder to file it under.
# Only TUIs are ever reclassified, in either direction; everything else keeps its
# own category.
setup_folder_for(){
  local cat="$1" key="$2" name p
  name="${key#* }"          # "TUI septabee" -> "septabee"
  name="${name%%|*}"
  if [[ $cat == tuis ]]; then
    if _filed_under_apps "$name"; then printf 'apps'; else printf '%s' "$cat"; fi
    return
  fi
  for p in "${AS_TUI_MODULES[@]}"; do
    if [[ $p == "$name" || $p == "$key" ]]; then printf 'tuis'; return; fi
  done
  printf '%s' "$cat"
}

# ─── Backup content options (installed apps/tuis/webapps + facts) ──────────
# Emits the same content tree the old interactive backup asked about, so the
# TUI can offer it. Each item's key IS the exact "apps.selected" line
# ("APP pkg" / "TUI pkg" / "WEB name|url|icon"); the TUI writes back the
# checked keys and passes the file to `backup --selection=`.
cmd_backup_options(){
  load_catalog || true
  detect_installed_apps
  local had_prev=0
  load_previous_selection 2>/dev/null && had_prev=1
  # The ticks the user last touched on this screen. Stronger than had_prev: an
  # archive is a record of a backup that RAN, while this is a record of an edit
  # that may never have been applied — and it is the newer of the two whenever
  # both exist, because saving happens on every toggle.
  local -a SAVED_SEL=()
  local has_saved=0
  load_saved_selection && has_saved=1

  # true/false for one row. Three sources, most recent first: what the user just
  # ticked, then the last archive, then "everything" on a first run.
  #
  #   $1  the item KEY      — "APP vlc", "TUI septabee", "WEB WhatsApp|…|icon"
  #   $2  the bare package/web name, what PREV_* holds
  #   $3  the NAME of the PREV_* array to walk (${!3[@]} walks an array by name,
  #       which is how one helper serves the APP/TUI/WEB lists)
  #
  # The key and the bare name are both arguments rather than one derived from the
  # other on purpose: the saved selection stores KEYS, and the previous-archive
  # lists store NAMES. Deriving one from the other silently compared "TUI
  # septabee" against "septabee" and reported every row unticked.
  backup_checked(){
    local key="$1" name="$2" listname="$3" p
    if ((has_saved)); then
      for p in "${SAVED_SEL[@]:-}"; do [[ $p == "$key" ]] && { printf true; return; }; done
      printf false; return
    fi
    if ((had_prev)); then
      for p in "${!listname[@]}"; do [[ $p == "$name" ]] && { printf true; return; }; done
      printf false; return
    fi
    printf true
  }
  local keepass=false zen=false
  # The screen only shows a row for what the backup can actually take, and the
  # backup's own conditions are the reference (see do_backup): KeePassXC needs
  # the package AND its config folder, Zen needs the app AND a live profile.
  # A machine without either shows neither row, instead of offering a toggle
  # that silently does nothing.
  if pkg_has keepassxc && [[ -d "$HOME/.config/keepassxc" ]]; then keepass=true; fi
  if pkg_has zen-browser-bin && [[ -f "$HOME/.config/zen/profiles.ini" ]] && [[ -d "$HOME/.config/zen" ]]; then zen=true; fi
  printf '{"opts":true,"keepass":%s,"zen":%s}\n' "$keepass" "$zen"

  local e name label checked p
  # Split the installed TUIs into the ones filed under Apps and the ones that
  # stay in the TUIs folder, so neither folder is emitted empty.
  local -a tui_apps=() tui_tuis=()
  for e in "${INSTALLED_TUI[@]:-}"; do
    if _filed_under_apps "${e%%|*}"; then tui_apps+=("$e"); else tui_tuis+=("$e"); fi
  done

  if ((${#INSTALLED_APP[@]})) || ((${#tui_apps[@]})); then
    printf '{"folder":"apps","label":"Apps"}\n'
    for e in "${INSTALLED_APP[@]:-}"; do
      name="${e%%|*}"; label="${e#*|}"
      checked="$(backup_checked "APP $name" "$name" PREV_APP)"
      printf '{"folder":"apps","key":%s,"label":%s,"checked":%s}\n' \
        "$(json_str "APP $name")" "$(json_str "$label")" "$checked"
    done
    # Cataloged as a TUI, filed under Apps. Its previous-selection check reads
    # PREV_TUI, not PREV_APP, because that is the list its key belongs to.
    for e in ${tui_apps[@]+"${tui_apps[@]}"}; do
      name="${e%%|*}"; label="${e#*|}"
      checked="$(backup_checked "TUI $name" "$name" PREV_TUI)"
      printf '{"folder":"apps","key":%s,"label":%s,"checked":%s}\n' \
        "$(json_str "TUI $name")" "$(json_str "$label")" "$checked"
    done
  fi
  if ((${#tui_tuis[@]})); then
    printf '{"folder":"tuis","label":"TUIs"}\n'
    for e in "${tui_tuis[@]}"; do
      name="${e%%|*}"; label="${e#*|}"
      checked="$(backup_checked "TUI $name" "$name" PREV_TUI)"
      printf '{"folder":"tuis","key":%s,"label":%s,"checked":%s}\n' \
        "$(json_str "TUI $name")" "$(json_str "$label")" "$checked"
    done
  fi
  if ((${#INSTALLED_WEB[@]})); then
    printf '{"folder":"webapps","label":"Webapps"}\n'
    for e in "${INSTALLED_WEB[@]}"; do
      name="${e%%|*}"
      checked="$(backup_checked "WEB $e" "$name" PREV_WEB)"
      printf '{"folder":"webapps","key":%s,"label":%s,"checked":%s}\n' \
        "$(json_str "WEB $e")" "$(json_str "$name")" "$checked"
    done
  fi
}

# ─── Repo update check (read-only mirror of launcher_update) ──────────────
# Single JSON object: {"repo_update":bool,"modules":[{"key":..,"label":..}]}
cmd_update_check(){
  local old_head="" new_head="" p m row id state
  local -a changed=() cand=() ids=()
  local repo_update=false
  [[ -d "$REPO_DIR/.git" ]] && old_head="$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || true)"
  if repo_update_avail; then repo_update=true; fi
  [[ -d "$REPO_DIR/.git" ]] && new_head="$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || true)"
  if [[ -n $old_head && -n $new_head && $old_head != "$new_head" ]]; then
    mapfile -t changed < <(git -C "$REPO_DIR" diff --name-only "$old_head" "$new_head" 2>/dev/null)
  fi
  mapfile -t -O "${#changed[@]}" changed < <(
    git -C "$REPO_DIR" diff --name-only HEAD 2>/dev/null
    git -C "$REPO_DIR" diff --name-only --cached 2>/dev/null
  )
  load_excluded
  apply_includes
  for row in "${MODULES[@]}"; do
    id="${row%%:*}"
    is_excluded "$id" && continue
    state="$(module_state "$id")"; state="${state%%:*}"
    [[ $state == ok || $state == partial ]] || continue
    for p in "${changed[@]:-}"; do
      [[ -n $p && "$(module_of_path "$p")" == "$id" ]] && { cand+=("$id"); break; }
    done
  done
  for row in "${MODULES[@]}"; do
    id="${row%%:*}"
    for m in "${cand[@]:-}"; do [[ $m == "$id" ]] && ids+=("$row") && break; done
  done
  printf '{"repo_update":%s,"repo_version":%s,"modules":[' \
    "$([[ $repo_update == true ]] && echo true || echo false)" "$(json_str "$REPO_VERSION")"
  local i=0
  for row in "${ids[@]}"; do
    ((i)) && printf ','
    printf '{"key":%s,"label":%s}' "$(json_str "${row%%:*}")" "$(json_str "${row#*:}")"
    i=$((i+1))
  done
  printf ']}\n'
}

# ─── Missing manually-downloaded installers for a selection ────────────────
# Emits one JSON record per selected app whose manual installer is absent:
#   {"folder":..,"key":..,"label":..,"file":..,"url":..}
# Nothing when everything is present. This is what lets the TUI prompt, BEFORE
# running anything, with the exact file name to drop in the module folder.
_manual_asset_spec(){ # appkey -> "expected-file|url" (empty: no manual file)
  case "$1" in
    ableton)   printf '%s|%s' 'Ableton_Live_<edition>_<version>_64.zip' 'https://www.ableton.com/en/account/' ;;
    bitwig)    printf '%s|%s' 'bitwig-studio-*.deb' 'https://www.bitwig.com/download/' ;;
    guitarpro) printf '%s|%s' 'guitar-pro-8-setup.exe' 'https://www.guitar-pro.com/' ;;
    davinci|davinci-resolve)   printf '%s|%s' 'DaVinci_Resolve_[Studio_]<version>_Linux.zip' 'https://www.blackmagicdesign.com/support/family/davinci-resolve-and-fusion' ;;
    *)         printf '' ;;
  esac
}
_manual_asset_present(){ # appkey -> 0 if its installer file exists
  local key="$1" f
  case "$key" in
    ableton)
      for f in "$APPS_DIR"/ableton/Ableton*.zip "$APPS_DIR"/ableton/ableton*.zip; do [[ -f $f ]] && return 0; done ;;
    bitwig)
      for f in "$APPS_DIR"/bitwig/bitwig*.deb; do [[ -f $f ]] && return 0; done ;;
    guitarpro)
      [[ -f $APPS_DIR/guitarpro/guitar-pro-8-setup.exe ]] && return 0 ;;
    davinci|davinci-resolve)
      for f in "$APPS_DIR"/davinci/*[Rr]esolve*.zip "$APPS_DIR"/davinci/[Dd]a[Vv]inci*.zip; do [[ -f $f ]] && return 0; done ;;
  esac
  return 1
}
# A Blackmagic zip that is NOT DaVinci Resolve (e.g. Fusion Studio) → a clear
# hint instead of a bare "missing".
_manual_asset_note(){ # appkey -> human note (empty when nothing to add)
  case "$1" in
    davinci|davinci-resolve)
      local bad
      bad="$(compgen -G "$APPS_DIR/davinci/*[Ff]usion*.zip" 2>/dev/null | head -1)"
      [[ -z $bad ]] && bad="$(compgen -G "$APPS_DIR/davinci/Blackmagic_*.zip" 2>/dev/null | head -1)"
      [[ -n $bad ]] && printf '%s is a Blackmagic Fusion Studio installer, not DaVinci Resolve.' "$(basename "$bad")"
      ;;
  esac
}
# ─── Setup grey-out gate ────────────────────────────────────────────────────
# Modules whose installer cannot be fetched by the repo: the row stays VISIBLE
# in Setup but is greyed and refuses Enter, because dropping it from the list
# would leave the user wondering where Ableton went, and offering it would only
# produce a failed install.
#
# The canonical list of module keys whose installer cannot be fetched by the
# repo. ONE list on purpose: both the tree builder and the cache key below need
# it, and two hardcoded copies drift apart silently — davinci got gated while the
# cache key still did not know about it, so its row would have kept whatever
# state the last run wrote until the 30-minute reap.
ASSET_GATED_KEYS=(ableton bitwig guitarpro davinci-resolve)

# Every module in that list: the row stays VISIBLE in Setup but is greyed and
# refuses Enter, because dropping it from the list would leave the user
# wondering where Ableton went, and offering it would only produce a failed
# install.
#
# Presence is decided by GLOBS, never by the sha256 in assets.links: this runs
# inside _setup_tree, i.e. on every render of the Setup screen, and hashing a
# 4 GB zip per row per keystroke would hang the TUI. Checksum verification stays
# where it belongs, in `download-assets.sh --check`, off the render path.
_asset_gate(){ # appkey -> expected filename when gated-and-absent, empty when usable
  local k listed=0
  for k in "${ASSET_GATED_KEYS[@]}"; do
    [[ $k == "$1" ]] && { listed=1; break; }
  done
  ((listed)) || return 0
  _manual_asset_present "$1" && return 0
  _manual_asset_spec "$1" | cut -d'|' -f1
}
# Module id -> the folder its files actually live in. Not always the same string:
# the module is "davinci-resolve" (that is the id in MODULES/CATEGORIES and the
# key the tree emits) while its installer sits in scripts/apps/davinci/. Building
# the note from the id pointed users at a directory that does not exist.
_asset_dir(){ # appkey -> module folder name
  case "$1" in
    davinci|davinci-resolve) printf 'davinci' ;;
    *) printf '%s' "$1" ;;
  esac
}

# The same answer as a sentence, for the row's info line.
_asset_gate_note(){ # appkey -> human sentence when gated, empty when usable
  local expected; expected="$(_asset_gate "$1")"
  [[ -n $expected ]] || return 0
  # No leading dash: the caller joins this onto info with " — ", and a note that
  # starts with its own dash reads as "label — — needs…".
  printf 'needs %s in scripts/apps/%s/' "$expected" "$(_asset_dir "$1")"
}

cmd_missing_assets(){
  local folder="${1:-}"; shift || true
  [[ $folder == apps ]] || return 0
  local key spec expected url note
  for key in "$@"; do
    spec="$(_manual_asset_spec "$key")"
    [[ -n $spec ]] || continue
    expected="${spec%%|*}"; url="${spec#*|}"
    _manual_asset_present "$key" && continue
    note="$(_manual_asset_note "$key")"
    printf '{"folder":%s,"key":%s,"label":%s,"file":%s,"url":%s,"note":%s}\n' \
      "$(json_str "$folder")" "$(json_str "$key")" "$(json_str "$key")" \
      "$(json_str "$expected")" "$(json_str "$url")" "$(json_str "$note")"
  done
}

# ─── Patch scripts present for a selection ────────────────────────────────
# Emits {"folder":..,"key":..,"label":..,"script":..} for each selected app
# whose PATCH script is present in its module folder (nothing when absent).
# This is what the TUI uses to PROPOSE the patch after an install — and to stay
# silent when there is no patch, as the pre-TUI launcher did.
_manual_patch_spec(){ # appkey -> module-relative patch script (empty: none)
  case "$1" in
    ableton)   printf 'ableton/PATCH/patch-ableton.sh' ;;
    bitwig)    printf 'bitwig/PATCH/patch-bitwig.sh' ;;
    guitarpro) printf 'guitarpro/PATCH/patch-guitarpro' ;;
    davinci|davinci-resolve)   printf 'davinci/PATCH/patch-resolve.sh' ;;
    *)         printf '' ;;
  esac
}

# Report whether a patch script says its patch is applied (all four support a
# read-only --check that prints "applied"/"in place"/"patched").
_patch_applied(){
  local out
  out="$(bash "$1" --check 2>/dev/null || true)"
  grep -qiE 'applied|in place|patched' <<<"$out"
}

cmd_patches(){
  local folder="${1:-}"; shift || true
  [[ $folder == apps ]] || return 0
  load_excluded
  local key spec path applied
  for key in "$@"; do
    spec="$(_manual_patch_spec "$key")"
    [[ -n $spec ]] || continue
    # Only propose a patch for an app that is actually INSTALLED: a failed
    # install must never offer the patch (the patch would fail anyway).
    _installed_state "$key" || continue
    path="$APPS_DIR/$spec"
    [[ -f $path ]] || continue
    applied=false
    _patch_applied "$path" && applied=true
    printf '{"folder":%s,"key":%s,"label":%s,"script":%s,"applied":%s}\n' \
      "$(json_str "$folder")" "$(json_str "$key")" "$(json_str "$key")" \
      "$(json_str "$path")" "$applied"
  done
}

# ─── Health check: what drifted from the chosen install ────────────────────
# {"kind":"module|infra","id":..,"label":..,"detail":..} for every installed
# module whose artifacts went missing (state "partial") and every mosquitOmarchy
# piece that must be present (TUI binary, float rule, menu entry, shortcut,
# update hook, crash skill). Nothing when everything matches.
cmd_health(){
  load_excluded
  local row id state raw detail
  for row in "${MODULES[@]}"; do
    id="${row%%:*}"; is_excluded "$id" && continue
    # `apps` is an umbrella over the catalogs and is almost always "partial"
    # by design (you never install every catalog entry): not drift.
    [[ $id == apps ]] && continue
    # `st_*` may answer "partial:<what is missing>". That detail is the whole
    # point of the Health screen: "some files went missing" told the user
    # nothing about which files, or that one of them needs root.
    raw="$(module_state "$id" 2>/dev/null)"
    state="${raw%%:*}"; detail="${raw#*:}"
    [[ $state == partial ]] || continue
    [[ $detail == "$raw" ]] && detail="partially installed — some files went missing"
    printf '{"kind":"module","id":%s,"label":%s,"detail":%s}\n' \
      "$(json_str "$id")" "$(json_str "${row#*:}")" "$(json_str "$detail")"
  done
  [[ -x "$BIN_DIR/mosquitomarchy" && -x "$BIN_DIR/mosquitomarchy-tui" ]] || \
    printf '{"kind":"infra","id":%s,"label":%s,"detail":%s}\n' \
      "$(json_str tui)" "$(json_str "mosquitOmarchy TUI")" "$(json_str "launcher binary missing")"
  [[ -f $HYPRLAND ]] && ! grep -qF 'mosquitomarchy-tui-floating' "$HYPRLAND" && \
    printf '{"kind":"infra","id":%s,"label":%s,"detail":%s}\n' \
      "$(json_str float)" "$(json_str "TUI float rule")" "$(json_str "Hyprland float rule missing")"
  # The menu entry used to be a top-level "install.mosquitomarchy" object. It
  # now lives in the managed Setup > mosquito block as setup.mosquito.manager,
  # so this test reported the entry missing on a perfectly healthy install --
  # the health check had simply never been updated to the new mechanism. Test
  # the key the installer actually writes, via the same marker map the
  # "Menu entries" screen uses, so the two can never disagree again.
  [[ -f $MENU ]] && ! grep -qE "^[[:space:]]*\"$(menu_entries_marker mosquitomarchy)\"[[:space:]]*:" "$MENU" 2>/dev/null && \
    printf '{"kind":"infra","id":%s,"label":%s,"detail":%s}\n' \
      "$(json_str menu)" "$(json_str "Omarchy menu entry")" \
      "$(json_str "the mosquitOmarchy row is missing from the Omarchy menu")"
  [[ -f $HYPR_DIR/bindings.lua ]] && ! grep -q 'mosquitOmarchy' "$HYPR_DIR/bindings.lua" && \
    printf '{"kind":"infra","id":%s,"label":%s,"detail":%s}\n' \
      "$(json_str shortcut)" "$(json_str "Keyboard shortcut")" "$(json_str "SUPER + ALT + M missing")"
  [[ -x "$HOME/.config/omarchy/hooks/post-boot.d/zzz-mosquitomarchy-update-check" ]] || \
    printf '{"kind":"infra","id":%s,"label":%s,"detail":%s}\n' \
      "$(json_str hook)" "$(json_str "Update-check hook")" "$(json_str "post-boot hook missing")"
  [[ -e "$HOME/.agents/skills/mosquitomarchy-crash" ]] || \
    printf '{"kind":"infra","id":%s,"label":%s,"detail":%s}\n' \
      "$(json_str skill)" "$(json_str "Crash skill")" "$(json_str "skill symlink missing")"
  return 0
}

# ─── Heal: re-apply every missing piece of the chosen install ──────────────
# Each infra piece is keyed by its short id (tui, menu, shortcut, hook, skill);
# modules use their module id. With no args, everything found by cmd_health is
# re-applied; with args, only the ticked ids are (the TUI's Health check list
# sends its checked rows).
cmd_heal(){
  local want=("$@")
  [[ ${#want[@]} -gt 0 ]] && msg "Health check: re-applying ${#want[@]} selected piece(s)…"
  YES=1
  MODULE_FAILURES=0
  msg "Health check: re-applying the missing pieces…"

  # `in_want id`: wanted when the user gave a selection and `id` is in it, or
  # when no selection was given (heal everything found).
  in_want(){
    [[ ${#want[@]} -eq 0 ]] && return 0
    local w
    for w in "${want[@]}"; do [[ $w == "$1" ]] && return 0; done
    return 1
  }

  # 1. Launcher infra (idempotent): TUI binary + dispatcher + float rule + crash tool + skill.
  if in_want tui; then
    ensure_mosquitomarchy_tui || warn "Launcher re-deploy reported an issue."
  fi
  # 2. Omarchy menu entry (same key test as cmd_health, so heal only fires on
  # what health actually reported).
  if in_want menu; then
    grep -qE "^[[:space:]]*\"$(menu_entries_marker mosquitomarchy)\"[[:space:]]*:" "$MENU" 2>/dev/null || install_menu_entry || true
  fi
  # 3. Shortcut — only when the user had accepted the prompt.
  if in_want shortcut && [[ -f "$HOME/.local/state/mosquitomarchy/shortcut-prompted" ]]; then
    kb_ensure "SUPER + ALT + M" "mosquitOmarchy" "$HOME/.local/bin/mosquitomarchy" cmd \
      || warn "Shortcut re-add reported an issue."
    if (( KB_CHANGED )); then
      kb_reload || warn "Shortcut re-add reported an issue."
    fi
  fi
  # 4. Update-check hook.
  if in_want hook; then
    [[ -x "$HOME/.config/omarchy/hooks/post-boot.d/zzz-mosquitomarchy-update-check" ]] \
      || run_mosquitomarchy_update >/dev/null 2>&1 || true
  fi
  # 5. Crash skill symlink (the codebase `mosquitomarchy-crash` skill the agent reads).
  # NOTE: the source lives next to THIS script (scripts/apps/mosquitomarchy/),
  # not under APP_DIR (the repo root) — APP_DIR/skills/... dangles, so the
  # heal "succeeded" while `[[ -e ]]` kept failing and health re-reported it.
  if in_want skill; then
    mkdir -p "$HOME/.agents/skills"
    ln -sfn "$ACTIONS_DIR/skills/mosquitomarchy-crash" "$HOME/.agents/skills/mosquitomarchy-crash"
  fi

  # 6. Re-apply the ticked partially-installed modules (or all, when no selection).
  load_excluded
  local row id state raw detail
  SELECTED=()
  RESULTS=()
  for row in "${MODULES[@]}"; do
    id="${row%%:*}"; is_excluded "$id" && continue
    [[ $id == apps ]] && continue   # umbrella, not a single install (see cmd_health)
    if ! in_want "$id"; then
      continue
    fi
    # `|| true` INSIDE the substitution: a failing module_state must not abort
    # the whole heal under `set -e` (a bare `var="$(cmd)"` would).
    state="$(module_state "$id" 2>/dev/null || true)"; state="${state%%:*}"
    [[ $state == partial ]] && SELECTED+=("$id")
  done
  if ((${#SELECTED[@]})); then
    msg "Re-applying ${#SELECTED[@]} partially-installed module(s)…"
    exec_modules
  else
    ok "No partially-installed module to re-apply."
  fi

  if (( MODULE_FAILURES > 0 )); then
    err "Health check finished with errors — see the messages above."
    return 1
  fi
  ok "Health check done — everything is back in place."
  return 0
}

# ─── Actions (streamed to the Runner) ─────────────────────────────────────
# Verify, after an install run, that the selected items are REALLY installed.
# This is the safety net against every silent no-op: a skipped/unknown entry, a
# module that returned 0 without installing, an apps-module run that swallowed
# its failure. A module whose state cannot be read (no module_state function) is
# not flagged, to avoid false negatives.
_verify_selection_installed(){ # cat keys...
  local cat="$1"; shift
  local bad=0 k name st
  for k in "$@"; do
    [[ -n $k ]] || continue
    case $k in
      TUI\ *)  name="${k#TUI }"; name="${name%%|*}"
               pkg_has "$name" || { err "Not installed: $name"; bad=1; } ;;
      WEB\ *)  name="${k#WEB }"; name="${name%%|*}"
               is_webapp_installed "$name" || { err "Not installed: $name"; bad=1; } ;;
      PLUG\ *) : ;;  # Omarchy shell plugin: no simple id check
      theme)   : ;;  # theme build is verified by the script's own output
      *)
               # The FINAL STATE decides (ultra-optimized check: one
               # module_state call per module, direct disk probes). `ok` =
               # fully deployed; `partial` = something declared installed is
               # missing → NOT a success (the Health check re-applies it);
               # `missing` obviously not either.
               st="$(module_state "$k" 2>/dev/null || true)"; st="${st%%:*}"
               if [[ -n $st ]]; then
                 [[ $st == ok ]] || { err "Module '$k' is NOT fully installed (state: $st)."; bad=1; }
               fi
               ;;
    esac
  done
  return $bad
}

# Install a setup category with the given candidate keys.
cmd_install(){
  local cat="${1:-}"
  shift
  CATEGORY_SELECTED=("$@")
  YES=1
  MODULE_FAILURES=0
  # An explicit TUI selection overrides a previous "uninstalled by you": lift
  # the exclusion (persistently) so category_run does not silently skip it and
  # report a false success.
  load_excluded
  local k bad=0
  for k in "${CATEGORY_SELECTED[@]:-}"; do
    [[ -n $k ]] || continue
    is_excluded "$k" && unexclude "$k"
  done
  if ((${#CATEGORY_SELECTED[@]})); then
    category_run "$cat"
    _verify_selection_installed "$cat" "${CATEGORY_SELECTED[@]}" || bad=1
    (( MODULE_FAILURES > 0 )) && bad=1
    if ((bad)); then
      # Name the modules that did not land, so the failure is actionable: the
      # log already says WHICH one, but the summary line is what stays on
      # screen, and "finished with errors" on its own sends the user hunting
      # through a long log. The count distinguishes "one module missed" from
      # "the batch is a mess".
      local -a notok=()
      local nk
      for nk in "${CATEGORY_SELECTED[@]:-}"; do
        [[ -n $nk && $nk != TUI\ * && $nk != WEB\ * && $nk != PLUG\ * && $nk != theme ]] || continue
        local nst; nst="$(module_state "$nk" 2>/dev/null || true)"; nst="${nst%%:*}"
        [[ -z $nst || $nst == ok ]] || notok+=("$nk ($nst)")
      done
      if ((${#notok[@]})); then
        err "Install finished with errors — not fully installed: ${notok[*]}"
      else
        # No module is actually short: something else in the run failed
        # (a script's own non-zero step). Say so rather than blaming a module.
        err "Install finished with errors — see the messages above."
      fi
      return 1
    fi
    ok "Install finished successfully."
  else
    warn "nothing selected for '$cat' — nothing installed."
  fi
}

# Apply quick fixes (ids from cmd_fixes).
cmd_fixes_run(){
  RESULTS=()
  FIXES_SELECTED=("$@")
  YES=1
  MODULE_FAILURES=0
  run_fixes || true
  if (( MODULE_FAILURES > 0 )); then
    err "One or more quick fixes failed — see the messages above."
    return 1
  fi
  final_report
}

# Re-apply the given installed modules (update flow).
cmd_update(){
  SELECTED=("$@")
  YES=1
  RESULTS=()
  MODULE_FAILURES=0
  exec_modules
  if (( MODULE_FAILURES > 0 )); then
    err "One or more modules failed to re-apply."
    return 1
  fi
  final_report
}

# Apply a multi-category Setup selection in ONE streamed run.
# Each argument is one group of TAB-separated fields: "<folder>\t<key>\t…"
# (keys may contain spaces and "|", but never a tab). Groups run in the given
# order. The TUI's Setup tree uses this so a single Runner shows the whole
# batch instead of chaining per-category runs.
# Run the patch script(s) for the selected apps (streamed). Apps without a
# patch script are skipped; the TUI only asks for the ones it found.
cmd_run_patch(){
  local folder="${1:-}"; shift || true
  if [[ $folder != apps ]]; then warn "no patch for '$folder'."; return 0; fi
  YES=1
  local key spec path rc=0
  for key in "$@"; do
    spec="$(_manual_patch_spec "$key")"
    [[ -n $spec ]] || { warn "no patch script for '$key' — skipped."; continue; }
    path="$APPS_DIR/$spec"
    [[ -f $path ]] || { warn "patch script not found for '$key' — skipped."; continue; }
    msg "Applying the $key patch: $(basename "$path")"
    case "$key" in
      ableton) bash "$path" -y || rc=1 ;;
      bitwig)  mq_sudo bash "$path" || rc=1 ;;
      davinci|davinci-resolve) mq_sudo bash "$path" || rc=1 ;;
      *)       bash "$path" || rc=1 ;;
    esac
  done
  if ((rc)); then
    err "One or more patch scripts failed."
  else
    ok "Patch step finished."
  fi
  return $rc
}

# Revert (remove) the patch script(s) for the selected apps (streamed).
cmd_remove_patch(){
  local folder="${1:-}"; shift || true
  if [[ $folder != apps ]]; then warn "no patch for '$folder'."; return 0; fi
  YES=1
  local key spec path rc=0
  for key in "$@"; do
    spec="$(_manual_patch_spec "$key")"
    [[ -n $spec ]] || { warn "no patch script for '$key' — skipped."; continue; }
    path="$APPS_DIR/$spec"
    [[ -f $path ]] || { warn "patch script not found for '$key' — skipped."; continue; }
    msg "Reverting the $key patch: $(basename "$path")"
    case "$key" in
      bitwig|davinci|davinci-resolve) mq_sudo bash "$path" --revert || rc=1 ;;
      *)              bash "$path" --revert || rc=1 ;;
    esac
  done
  if ((rc)); then
    err "One or more patch reverts failed."
  else
    ok "Patch removal finished."
  fi
  return $rc
}

cmd_apply(){
  local group folder
  YES=1
  for group in "$@"; do
    local -a arr=()
    IFS=$'\t' read -r -a arr <<< "$group"
    folder="${arr[0]:-}"
    local -a keys=("${arr[@]:1}")
    case $folder in
      fixes)
        ((${#keys[@]})) && cmd_fixes_run "${keys[@]}"
        ;;
      menu)
        cmd_menu_entry
        ;;
      *)
        # A folder may mix installable keys with the special menu-entry key
        # (the mosquito folder carries it), so route each key.
        local -a inst=()
        local k
        for k in "${keys[@]:-}"; do
          [[ -n $k ]] || continue
          if [[ $k == menu-entry ]]; then
            cmd_menu_entry
          else
            inst+=("$k")
          fi
        done
        ((${#inst[@]})) && cmd_install "$folder" "${inst[@]}"
        ;;
    esac
  done
}

# Git pull the repo (update zone).
cmd_update_repo(){
  YES=1
  if [[ -d "$REPO_DIR/.git" ]] && command -v git >/dev/null 2>&1; then
    update_repo_ff
  else
    err "No git repo at $REPO_DIR (or git missing) — nothing to update."
  fi
}

# Update modules: fast-forward the LOCAL repo from GitHub FIRST (so both
# versions are in sync), then re-apply the installed modules whose files
# changed. With no repo update (or no connection), it re-applies the modules
# changed in the local scripts. This is the single "Update modules" action.
cmd_update_modules(){
  YES=1
  # Optional subset: module ids from the TUI's selectable list. When given,
  # ONLY those modules are re-applied (the repo fast-forward happens as
  # usual, so the scripts themselves are up to date either way).
  local -a only=("$@")
  local before="" after="" p m row id state
  [[ -d "$REPO_DIR/.git" ]] && before="$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || true)"
  if repo_update_avail; then
    msg "Updating the local scripts repo from GitHub first (keeps both versions in sync)…"
    update_repo_ff || warn "Repo update failed — continuing with the local scripts."
  fi
  [[ -d "$REPO_DIR/.git" ]] && after="$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || true)"

  local -a changed=()
  if [[ -n $before && -n $after && $before != "$after" ]]; then
    mapfile -t changed < <(git -C "$REPO_DIR" diff --name-only "$before" "$after" 2>/dev/null)
  fi
  mapfile -t -O "${#changed[@]}" changed < <(
    git -C "$REPO_DIR" diff --name-only HEAD 2>/dev/null
    git -C "$REPO_DIR" diff --name-only --cached 2>/dev/null
  )

  load_excluded
  apply_includes
  local -a ids=()
  for row in "${MODULES[@]}"; do
    id="${row%%:*}"
    is_excluded "$id" && continue
    state="$(module_state "$id")"
    [[ $state == ok || $state == partial ]] || continue
    for p in "${changed[@]:-}"; do
      [[ -n $p && "$(module_of_path "$p")" == "$id" ]] && { ids+=("$id"); break; }
    done
  done

  if ((${#only[@]})); then
    # Re-apply just the subset the user kept selected in the TUI.
    RESULTS=()
    MODULE_FAILURES=0
    SELECTED=("${only[@]}")
    msg "Re-applying ${#only[@]} selected module(s)…"
    exec_modules
    if (( MODULE_FAILURES > 0 )); then
      err "One or more modules failed to update."
      return 1
    fi
    final_report
    return 0
  fi

  if ((${#ids[@]})); then
    RESULTS=()
    MODULE_FAILURES=0
    SELECTED=("${ids[@]}")
    msg "Re-applying ${#ids[@]} changed installed module(s)…"
    exec_modules
    if (( MODULE_FAILURES > 0 )); then
      err "One or more modules failed to update."
      return 1
    fi
    final_report
  else
    ok "No installed module needs re-applying — everything is up to date."
  fi
}

# Uninstall modules one by one (never the gum chooser). Catalog keys from the
# uninstall tree (APP/TUI/WEB …) are routed to the apps module's uninstaller.
cmd_uninstall(){
  local -a modules=() catalog=() patches=() fixids=() menuops=()
  local id
  # Orientation first: elevation prompts (sudo password dialog) open on the
  # DESKTOP, not inside the TUI, so a user staring at the spinner never sees
  # them — which used to read as "uninstalling forever". This line proves the
  # backend is alive, and says where to look.
  if ! sudo -n -v 2>/dev/null; then
    msg "Uninstalling: if a step needs root, answer the password dialog on the desktop (3 min, then it continues without)."
  fi
  for id in "$@"; do
    case "$id" in
      APP\ *|TUI\ *|WEB\ *|PLUG\ *) catalog+=("$id") ;;
      patch:*) patches+=("${id#patch:}") ;;
      fix:*)   fixids+=("${id#fix:}") ;;
      menu:*|shortcut) menuops+=("$id") ;;
      *) modules+=("$id") ;;
    esac
  done
  YES=1
  MODULE_FAILURES=0
  if ((${#modules[@]})); then
    for id in "${modules[@]}"; do
      uninstall_module "$id" || MODULE_FAILURES=$((MODULE_FAILURES + 1))
    done
    un_shared_menu
  fi
  if ((${#patches[@]})); then
    cmd_remove_patch apps "${patches[@]}" || MODULE_FAILURES=$((MODULE_FAILURES + 1))
  fi
  if ((${#fixids[@]})); then
    local fid flag script
    for fid in "${fixids[@]}"; do
      case $fid in
        hyprland-crash)      flag=--remove;    script=scripts/fixes/fix-hyprland-crash.sh ;;
        ableton-wine-scroll) flag=--uninstall; script=scripts/fixes/fix-wine-scroll.sh ;;
        1px-seam)            flag=--remove;    script=scripts/fixes/fix-1px-seam.sh ;;
        *) warn "Quick fix '$fid' is not removable — skipped."; continue ;;
      esac
      if [[ -f "$SCRIPT_DIR/$script" ]] && bash "$SCRIPT_DIR/$script" "$flag" -y; then
        ok "Quick fix '$fid' removed."
      else
        MODULE_FAILURES=$((MODULE_FAILURES + 1)); err "Quick fix '$fid' removal failed."
      fi
    done
  fi
  if ((${#menuops[@]})); then
    for id in "${menuops[@]}"; do
      case $id in
        menu:entry)
          if strip_mosquitomarchy_menu_entry; then ok "mosquitOmarchy menu entry removed."; fi ;;
        shortcut)
          if kb_remove "SUPER + ALT + M"; then
            kb_reload || true
            ok "Keyboard shortcut SUPER + ALT + M removed."
          else
            MODULE_FAILURES=$((MODULE_FAILURES + 1)); err "Shortcut removal failed."
          fi ;;
      esac
    done
  fi
  if ((${#catalog[@]})); then
    local tmpf; tmpf="$(mktemp)"
    printf '%s\n' "${catalog[@]}" > "$tmpf"
    msg "Uninstalling ${#catalog[@]} catalog entr(ies)…"
    if bash "$SCRIPT_DIR/scripts/apps/uninstall-apps.sh" --from-backup="$tmpf" -y; then
      ok "Catalog uninstall done."
    else
      MODULE_FAILURES=$((MODULE_FAILURES + 1))
      err "uninstall-apps.sh ran into problems"
    fi
    rm -f "$tmpf"
  fi
  if (( MODULE_FAILURES > 0 )); then
    err "Uninstall finished with errors — see the messages above."
    return 1
  fi
}

