# ─── Keybindings (mosquitOmarchy-managed SUPER bindings) ───────────────────
# The manager is part of the TUI now; these subcommands are its backend. The
# primitives (kb_ensure/kb_remove/kb_reset/kb_reload) live in
# scripts/lib/keybindings.bash, sourced via mosquitomarchy-setup.sh.
cmd_kb_list(){
  kb_load_ours
  local k label cmd type def
  for k in "${KB_OWN_ORDER[@]}"; do
    [[ -n "$k" ]] || continue
    IFS='|' read -r label cmd type <<<"${KB_OURS[$k]}"
    def="$(kb_friendly_default "$k")"
    printf '{"key":%s,"label":%s,"cmd":%s,"type":%s,"replaces":%s}\n' \
      "$(json_str "$k")" "$(json_str "$label")" "$(json_str "$cmd")" \
      "$(json_str "$type")" "$(json_str "$def")"
  done
  return 0
}

cmd_kb_free(){
  kb_load_ours
  kb_free_keys
  return 0
}

cmd_kb_add(){ # <combo> <label> <cmd> <type>
  (($# >= 4)) || { err "Usage: kb-add <combo> <label> <cmd> <type>"; return 1; }
  local combo="$1" label="$2" cmd="$3" type="$4"
  combo="$(tr 'a-z' 'A-Z' <<< "$combo" | sed -E 's/ *\+ */ + /g; s/^ +//; s/ +$//')"
  [[ "$combo" =~ ^([A-Z0-9_]+( +\+ )?)+[A-Z0-9_]+$ ]] || { err "Invalid combo format: $combo"; return 1; }
  # A combo bound OUTSIDE our managed block would duplicate: refuse and let
  # the TUI tell the user to pick another key.
  if [[ -f "$KB_CONF" ]] && sed "/$KB_BEGIN/,/$KB_END/d" "$KB_CONF" 2>/dev/null \
      | rg -x -F "o.bind(\"$combo\"" -N >/dev/null 2>&1; then
    err "Already bound outside the managed block: $combo"
    return 1
  fi
  kb_ensure "$combo" "$label" "$cmd" "$type"
  ok "Bound: $combo → $label"
}

cmd_kb_remove(){ # combo…
  (($#)) || { err "Usage: kb-remove <combo>…"; return 1; }
  kb_remove "$@"
  ok "Keybinding removal done."
}

cmd_kb_reset(){
  kb_reset
  ok "All mosquitOmarchy-managed keybindings removed."
}

cmd_kb_reload(){
  kb_reload
}

# Register the global shortcut (SUPER + ALT + M) that opens mosquitOmarchy.
# Also marks the first-run prompt as answered.
cmd_add_shortcut(){
  YES=1
  mkdir -p "$HOME/.local/state/mosquitomarchy" 2>/dev/null || true
  : > "$HOME/.local/state/mosquitomarchy/shortcut-prompted" 2>/dev/null || true
  kb_ensure "SUPER + ALT + M" "mosquitOmarchy" "$HOME/.local/bin/mosquitomarchy" cmd
  if (( KB_CHANGED )); then
