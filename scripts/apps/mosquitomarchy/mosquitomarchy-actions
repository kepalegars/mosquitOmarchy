# Dated backup now. Options (all optional):
#   --vst=list|full|none   VST plugin handling (default: list)
#   --keepass=yes|no       include KeePassXC passwords when installed
#   --zen=yes|no           include the Zen browser settings (default: yes)
#   --selection=FILE       apps.selected content (the TUI's checkbox tree)
#   --name=TEXT            label for the archive; sanitised into the filename
cmd_backup(){
  local vst="list" keepass="yes" zen="yes" sel="" name="" a
  for a in "$@"; do
    case $a in
      --vst=*) vst="${a#*=}" ;;
      --keepass=*) keepass="${a#*=}" ;;
      --zen=*) zen="${a#*=}" ;;
      --selection=*) sel="${a#*=}" ;;
      --name=*) name="${a#*=}" ;;
    esac
  done
  YES=1
  VST_MODE="$vst"
  # Plain ifs, never `[[ … ]] && export`: under `set -e` a false condition
  # makes the whole && list return 1, which is a landmine that moves as soon
  # as the caller stops swallowing the status.
  if [[ $keepass == no ]]; then export BACKUP_SKIP_KEEPASS=1; fi
  if [[ $zen == no ]]; then export BACKUP_SKIP_ZEN=1; fi
  if [[ -n $sel && -f $sel ]]; then export BACKUP_APPS_SELECTION_FILE="$sel"; fi
  # Empty is meaningful here (an unnamed backup falls back to the dated name),
  # so it is exported unconditionally rather than only when set.
  export BACKUP_NAME="$name"
  do_backup || true
}

# Restore a backup file by name (from cmd_backups).
cmd_restore(){
  local file="${1:-}"
  [[ -n $file ]] || { err "mosquitomarchy-actions restore: missing backup name."; exit 1; }
  YES=1
  RESTORE_FILE="$file"
  restore_flow || true
}

# ─── Keybindings (mosquitOmarchy-managed SUPER bindings) ───────────────────
# The manager is part of the TUI now; these subcommands are its backend. The
# primitives (kb_ensure/kb_remove/kb_reset/kb_reload) live in
# scripts/lib/keybindings.bash, sourced via mosquitomarchy-setup.sh.
cmd_kb_list(){
  kb_load_ours
  local k label cmd type def
  for k in "${KB_OWN_ORDER[@]}"; do
    [[ -n "$k" ]] || continue
    IFS='|' read -r label cmd type <<<"${KB_OURS[$k]}"
    def="$(kb_friendly_default "$k")"
    printf '{"key":%s,"label":%s,"cmd":%s,"type":%s,"replaces":%s}\n' \
      "$(json_str "$k")" "$(json_str "$label")" "$(json_str "$cmd")" \
      "$(json_str "$type")" "$(json_str "$def")"
  done
  return 0
}

cmd_kb_free(){
  kb_load_ours
  kb_free_keys
  return 0
}

cmd_kb_add(){ # <combo> <label> <cmd> <type>
  (($# >= 4)) || { err "Usage: kb-add <combo> <label> <cmd> <type>"; return 1; }
  local combo="$1" label="$2" cmd="$3" type="$4"
  combo="$(tr 'a-z' 'A-Z' <<< "$combo" | sed -E 's/ *\+ */ + /g; s/^ +//; s/ +$//')"
  [[ "$combo" =~ ^([A-Z0-9_]+( +\+ )?)+[A-Z0-9_]+$ ]] || { err "Invalid combo format: $combo"; return 1; }
  # A combo bound OUTSIDE our managed block would duplicate: refuse and let
  # the TUI tell the user to pick another key.
  if [[ -f "$KB_CONF" ]] && sed "/$KB_BEGIN/,/$KB_END/d" "$KB_CONF" 2>/dev/null \
      | rg -x -F "o.bind(\"$combo\"" -N >/dev/null 2>&1; then
    err "Already bound outside the managed block: $combo"
    return 1
  fi
  kb_ensure "$combo" "$label" "$cmd" "$type"
  ok "Bound: $combo → $label"
}

cmd_kb_remove(){ # combo…
  (($#)) || { err "Usage: kb-remove <combo>…"; return 1; }
  kb_remove "$@"
  ok "Keybinding removal done."
}

cmd_kb_reset(){
  kb_reset
  ok "All mosquitOmarchy-managed keybindings removed."
}

