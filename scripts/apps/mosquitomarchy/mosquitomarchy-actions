# ─── dispatch ──────────────────────────────────────────────────────────────
sub="${1:-}"
shift || true
# Elevation is primed ONCE per action (mq_sudo_prime, called from
# exec_modules/run_fixes/uninstall_module and lazily by mq_sudo): the first root
# step prompts through the GUI askpass, everything after reuses the sudo cache —
# one prompt per install, including "Install selection". The old per-call
# `sudo`->pkexec shim is now only a fallback inside mq_sudo_prime (see
# scripts/lib/elevate.bash), so nothing is enabled here.
# ─── Crash-notification AI-diag toggle ─────────────────────────────────────
# Read or set the "crash notifications with AI diagnosis" switch: the log
# file is ALWAYS written; only the desktop TOAST is off-able. State file:
# ~/.local/state/mosquitomarchy/crash-notify ("off" = no toasts, "on"/absent
# default = clickable toast "diagnose with AI"). The mosquitomarchy TUI's
# Setup screen toggles the flag through this action.
cmd_crash_notify() {
  local flag="$HOME/.local/state/mosquitomarchy/crash-notify"
  mkdir -p "$(dirname "$flag")" 2>/dev/null || true
  local how="${1:-get}"
  case "$how" in
    get|"")
      [[ -f $flag && "$(cat "$flag" 2>/dev/null)" == off ]] && val=false || val=true ;;
    on|enable) printf 'on\n' > "$flag"; val=true ;;
    off|disable) printf 'off\n' > "$flag"; val=false ;;
    *) err "crash-notify <get|on|off>"; return 1 ;;
  esac
  printf '{"crashNotify": %s}\n' "$val"
}

case "$sub" in
  status)                   cmd_status ;;
  categories)               cmd_categories ;;
  candidates)               cmd_candidates "${1:-}" ;;
  missing-assets)           cmd_missing_assets "${1:-}" "${@:2}" ;;
  patches)                  cmd_patches "${1:-}" "${@:2}" ;;
  health)                   cmd_health ;;
  heal)                     cmd_heal ;;
  kb-list)                  cmd_kb_list ;;
  kb-free)                  cmd_kb_free ;;
  kb-add)                   cmd_kb_add "$@" ;;
  kb-remove)                cmd_kb_remove "$@" ;;
  kb-reset)                 cmd_kb_reset ;;
  kb-reload)                cmd_kb_reload ;;
  fixes)                    cmd_fixes ;;
  setup)                    cmd_setup ;;
  uninstall-tree)           cmd_uninstall_tree ;;
  backup-options)           cmd_backup_options ;;
  backups)                  cmd_backups ;;
  update-check)             cmd_update_check ;;
  install)                  cmd_install "${1:-}" "${@:2}" ;;
  apply)                    cmd_apply "$@" ;;
  run-patch)                cmd_run_patch "$@" ;;
  remove-patch)             cmd_remove_patch "$@" ;;
  fixes-run)                cmd_fixes_run "$@" ;;
