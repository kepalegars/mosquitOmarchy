# ─── dispatch ──────────────────────────────────────────────────────────────
sub="${1:-}"
shift || true
# Elevation is primed ONCE per action (mq_sudo_prime, called from
# exec_modules/run_fixes/uninstall_module and lazily by mq_sudo): the first root
# step prompts through the GUI askpass, everything after reuses the sudo cache —
# one prompt per install, including "Install selection". The old per-call
# `sudo`->pkexec shim is now only a fallback inside mq_sudo_prime (see
# scripts/lib/elevate.bash), so nothing is enabled here.
# ─── Crash-notification AI-diag toggle ─────────────────────────────────────
# Read or set the "crash notifications with AI diagnosis" switch: the log
# file is ALWAYS written; only the desktop TOAST is off-able. State file:
# ~/.local/state/mosquitomarchy/crash-notify ("off" = no toasts, "on"/absent
# default = clickable toast "diagnose with AI"). The mosquitomarchy TUI's
# Setup screen toggles the flag through this action.
cmd_crash_notify() {
  local flag="$HOME/.local/state/mosquitomarchy/crash-notify"
  mkdir -p "$(dirname "$flag")" 2>/dev/null || true
  local how="${1:-get}"
  case "$how" in
    get|"")
      [[ -f $flag && "$(cat "$flag" 2>/dev/null)" == off ]] && val=false || val=true ;;
    on|enable) printf 'on\n' > "$flag"; val=true ;;
    off|disable) printf 'off\n' > "$flag"; val=false ;;
    *) err "crash-notify <get|on|off>"; return 1 ;;
  esac
  printf '{"crashNotify": %s}\n' "$val"
}

# ─── is any agentic piece of omarchy still missing? ─────────────────────────
# The Setup row reads "bring back omarchy's agentic stuff", so the only
# question that matters is whether there is anything LEFT to bring back.
#
# It used to answer that with the remove-all-ai marker file, i.e. "did THIS
# module ever run?". That is the wrong question: an Omarchy whose agentic bits
# were removed by other means has nothing to bring back either, yet the marker
# was absent, so the row stayed enabled and offered a restore that could not
# change anything. So probe the machine instead, and treat the marker as only
# one of the signals — it is still the cheapest and most reliable "a removal
# definitely happened" evidence when the user removed the pieces themselves.
cmd_ai_removed() {
  local removed=false

  # What counts as "the agentic stuff" is EXACTLY what Omarchy ships: the
  # omarchy.agents bar widget, the AI-diagnosis crash toasts, and the menu
  # entries that offer to install an agent. Not ollama and not Claude Code --
  # those are tools a user adds on top, they are not part of the default
  # install, and this module must not install more than Omarchy does.
  #
  # 1) the Agents plugin, read from omarchy's own state.
  if ! omarchy plugin list 2>/dev/null | grep -qiE '^omarchy\.agents\b.*\benabled\b'; then
    removed=true
  fi
  # 2) the AI-diagnosis crash toasts.
  if [[ $("$0" crash-notify 2>/dev/null | grep -c '"crashNotify": true') -eq 0 ]]; then
    removed=true
  fi

  # The remove-all-ai marker is deliberately NOT consulted: it records that the
  # removal RAN, not that anything is still missing. Keeping it in the answer
  # meant that once the user (or an uninstall run) had removed the agentic bits
  # and then put them back by other means, the row stayed greyed forever with
  # no way to clear it, and one that was stale the other way offered a restore
  # with nothing to do.
  printf '{"removed": %s}\n' "$removed"
}




# ─── Menu entries toggle (the marked mosquito blocks) ────────────────
# Lets the TUI un-check the menu entries mosquito adds automatically
# (mega caffeine, live-mode Trigger entries, the move converter and
# mosquitomarchy itself): `list` shows name<TAB>present<TAB>label;
# `strip  <name>` removes that marked block from omarchy-menu.jsonc;
# `restore <name>` re-runs the module's menu installer.
# The env override is what lets the TUI's Go tests exercise the real
# strip/restore code path against a throwaway file. Without it, a test that
# pressed "apply" was editing the user's LIVE menu: the suite silently left
# `move-converter` and `live-mode` stripped out of the real
# omarchy-menu.jsonc. Never point this at the live file from a test.
MENU_JSONC="${MOSQUITOMARCHY_MENU_JSONC:-$HOME/.config/omarchy/extensions/omarchy-menu.jsonc}"

# The menu KEY of each entry, which is what the list/strip logic matches on.
# These used to be labels and comment fragments ("mosquitOmarchy setup",
# "managed by setup-battery-management.sh", "ableton-move-converter"), so once
# the entries were regrouped under setup.mosquito.* the Move Manager was
# reported as missing and could not be stripped: the marker it looked for no
# longer existed anywhere in omarchy-menu.jsonc.
menu_entries_marker() {
  case "$1" in
    # Every entry below is a key that really exists in the installed menu.
    # `live-mode` used to map to trigger.music.live-mode, which no longer
    # exists: the Live Mode row moved into the managed Setup > mosquito block
    # as setup.mosquito.live. Pointing at the dead key meant the TUI could
    # only ever report it "not installed" and could never restore it.
    mosquitomarchy) printf 'setup.mosquito.manager' ;;
    audio-plugins) printf 'setup.mosquito.audio-plugins' ;;
    move-converter) printf 'setup.mosquito.move' ;;
    live-mode)      printf 'setup.mosquito.live' ;;
    # The toggle is a SECOND, separate row: setup.mosquito.live only opens the
    # manager TUI, while this one is what actually turns a session on. Listing
    # only the manager is why "Live Mode" was nowhere in Menu entries.
    live-mode-toggle) printf 'trigger.toggle.live-mode' ;;
    jamjamjam)      printf 'setup.mosquito.jam' ;;
    mega-caffeine)  printf 'trigger.toggle.mega-caffeine' ;;
    *)              printf '%s' "$1" ;;
  esac
}

# menu_entry_label <id> -- where the entry actually lives in the menu, as the
# user sees it. Kept next to menu_entries_marker so the two cannot drift.
menu_entry_label() {
  case "$1" in
    mosquitomarchy) printf 'mosquitOmarchy' ;;
    audio-plugins)  printf 'Audio Plugin Manager' ;;
    move-converter) printf 'mosquito Move Manager' ;;
    live-mode)      printf 'Live Mode Manager' ;;
    live-mode-toggle) printf 'Live Mode' ;;
    jamjamjam)      printf 'JamJamJam' ;;
    mega-caffeine)  printf 'Mega caffeine' ;;
    *)              printf '%s' "$1" ;;
  esac
}

# menu_entry_zone <id> -- the menu section the entry sits in.
menu_entry_zone() {
  case "$1" in
    mega-caffeine|live-mode-toggle) printf 'Trigger ▸ Toggle' ;;
    *)             printf 'Setup ▸ mosquito' ;;
  esac
}

# menu_strip_key <jsonc> <key> -- delete the whole top-level object whose key is
# <key>, braces included. The previous implementation took the marker's line
# plus the SECOND line containing the marker as the block bounds, which only
# worked for the two-line comment+key pairs the installer used to emit; a real
# key appears once, so the bounds were empty and the strip always errored out.
menu_strip_key() {
  local file="$1" key="$2"
  python3 - "$file" "$key" <<'PYEOF'
import re, sys
path, key = sys.argv[1], sys.argv[2]
lines = open(path, encoding="utf-8").read().splitlines(keepends=True)
start = None
for i, line in enumerate(lines):
    if re.match(r'\s*"%s"\s*:\s*\{' % re.escape(key), line):
        start = i
        break
if start is None:
    sys.exit(1)
depth, end = 0, None
for j in range(start, len(lines)):
    depth += lines[j].count("{") - lines[j].count("}")
    if depth == 0:
        end = j
        break
if end is None:
    sys.exit(1)
# swallow a trailing comma left behind by the removal
if end + 1 < len(lines) and re.match(r'\s*,\s*$', lines[end + 1]):
    end += 1
del lines[start:end + 1]
open(path, "w", encoding="utf-8").writelines(lines)
PYEOF
}

# Every stock preinstall with its state, so the picker can show the whole Omarchy
# list (as asked) while rendering an already-uninstalled app greyed/unselectable
# instead of silently dropping it from the list.
cmd_preinstalls(){
  local p installed removable protected
  while read -r p; do
    [[ -n $p ]] || continue
    installed=false; removable=false; protected=false
    pkg_has "$p" && installed=true
    preinstall_protected "$p" >/dev/null 2>&1 && protected=true
    preinstall_removable "$p" && removable=true
    printf '{"name":%s,"label":%s,"installed":%s,"protected":%s,"removable":%s}\n' \
      "$(json_str "$p")" "$(json_str "$(preinstall_label "$p")")" \
      "$installed" "$protected" "$removable"
  done < <(stock_preinstalls)
}

cmd_preinstalls_remove(){
  (($#)) || { warn "preinstalls-remove needs the packages to remove."; return 1; }
  run_remove_preinstalls "$@"
}

cmd_menu_entries() {
  local how="${1:-list}" id mark tmp b present label
  # Every entry mosquitOmarchy installs, not just the first four: the menu
  # also carries the Audio Plugin Manager and JamJamJam rows, and a
  # "Menu entries" screen that hides rows the user can see in their own menu
  # is exactly what made it look broken.
  local -a NAMES=(mosquitomarchy audio-plugins move-converter live-mode live-mode-toggle jamjamjam mega-caffeine)
  case "$how" in
    list)
      for b in "${NAMES[@]}"; do
        present=false
        mark="$(menu_entries_marker "$b")"
        grep -qE "^[[:space:]]*\"${mark//./\\.}\"[[:space:]]*:" "$MENU_JSONC" 2>/dev/null && present=true || true
        label="$(menu_entry_label "$b") ($(menu_entry_zone "$b"))"
        printf '%s\t%s\t%s\n' "$b" "$present" "$label"
      done
      ;;
    strip)
      id="${2:?menu id required}"
      mark="$(menu_entries_marker "$id")"
      if menu_strip_key "$MENU_JSONC" "$mark"; then
        (omarchy menu refresh >/dev/null 2>&1 || true)
        ok "menu entry removed: $id"
      else
        err "no entry keyed '$mark' found in $MENU_JSONC"
      fi
      ;;
    restore)
      id="${2:?menu id required}"
      case "$id" in
        # NOT the whole engine: `mosquitomarchy-setup.sh` with no target runs the
        # launcher, does nothing without a tty and still exits 0, so this printed
        # "menu re-added" while the entry stayed missing. The launcher row is part
        # of the setup.mosquito.* block that install_menu_entry rewrites.
        #
        # That block is ATOMIC: install_menu_entry rewrites the whole of it, so
        # restoring any one of its rows brings its siblings back too. The TUI
        # re-lists straight after applying, so the rows show their real state
        # again rather than the one that was asked for.
        mosquitomarchy|audio-plugins|move-converter|live-mode|jamjamjam)
          install_menu_entry >/dev/null 2>&1 \
            && ok "menu re-added: $id" || warn "restore failed: $id" ;;
        mega-caffeine)  bash "$HOME/mosquitOmarchy/scripts/plugins/power-management/setup-battery-management.sh" >/dev/null 2>&1 \
          && ok "menu re-added: mega-caffeine" || warn "restore failed: mega-caffeine" ;;
        # Its own module's installer, but WITHOUT -y: the sudoers part of it
        # needs root and the password prompt is the point. --status is the
        # cheap check first so a healthy install does not prompt for nothing.
        live-mode-toggle)
          if bash "$HOME/mosquitOmarchy/scripts/plugins/live-mode/setup-live-mode.sh" --status >/dev/null 2>&1; then
            bash "$HOME/mosquitOmarchy/scripts/plugins/live-mode/setup-live-mode.sh" >/dev/null 2>&1 \
              && ok "menu re-added: live-mode toggle" || warn "restore failed: live-mode toggle"
          else
            warn "live-mode is not installed — run the live-mode module first"
          fi ;;
        # NOT the module's own setup script: that one needs root (udev rule,
        # chromium policy, ydotool NOPASSWD) so -y opens dialogs and then blocks
        # on `sudo` for a password, and without a flag it refuses to start at
        # all ("stdin without a TTY: a flag is required") -- the restore never
        # worked. The Move Manager row lives in the setup.mosquito.* menu block,
        # which install_menu_entry owns and rewrites idempotently without root.
      esac
      ;;
    *) err "menu-entries <list|strip|restore> <name>"; return 1 ;;
  esac
}

# cmd_theme_list_any — list ALL themes in ~/.config/omarchy/themes, including
# stock symlinks. Used by "Remove Themes (any)" so the user can hide stock
# themes they don't want to see.
cmd_theme_list_any(){
  local dir="$HOME/.config/omarchy/themes" n
  [[ -d $dir ]] || exit 0
  local cur norm n
  cur="$(omarchy-theme-current 2>/dev/null || echo -)"
  norm(){ printf '%s' "${1,,}" | tr -d ' _-'; }
  local want; want="$(norm "$cur")"
  while IFS= read -r n; do
    [[ -n $n ]] || continue
    # Include symlinks (stock themes) — they are marked so the UI can show them
    # differently, and removing one just deletes the symlink.
    local is_symlink=false
    [[ -L "$dir/$n" ]] && is_symlink=true
    jq -nc --arg name "$n" --argjson current "$([[ "$(norm "$n")" == "$want" ]] && echo true || echo false)" \
      --argjson stock "$is_symlink" \
      '{name:$name, current:$current, stock:$stock}'
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort -f)
}

# cmd_theme_remove_any <name...> — remove themes including stock symlinks.
# For regular dirs it uses omarchy-theme-remove; for symlinks it just unlinks.
# If a stock theme is not in the user dir, it is not removable (it lives in
# /usr/share/omarchy/themes and is managed by Omarchy). The action reports this.
cmd_theme_remove_any(){
  local user_dir="$HOME/.config/omarchy/themes" n rc=0
  (($#)) || { err "theme-remove-any: at least one theme required"; return 2; }
  for n in "$@"; do
    if [[ -L "$user_dir/$n" ]]; then
      # Stock symlink in user dir: remove the symlink
      if rm -f "$user_dir/$n" 2>/dev/null; then
        echo "removed (stock): $n"
      else
        rc=1; echo "could not remove: $n" >&2
      fi
    elif [[ -d "$user_dir/$n" ]]; then
      # User theme: use omarchy-theme-remove
      if omarchy-theme-remove "$n" >/dev/null 2>&1; then
        echo "removed: $n"
      else
        rc=1; echo "could not remove: $n" >&2
      fi
    elif [[ -d "/usr/share/omarchy/themes/$n" ]]; then
      # Stock theme exists in Omarchy but not in user dir: cannot remove,
      # it's managed by Omarchy. User would need to hide it via other means.
      echo "stock theme '$n' is not in your theme directory (managed by Omarchy)"
    else
      rc=1; echo "not a theme: $n" >&2
    fi
  done
  return $rc
}


case "$sub" in
  status)                   cmd_status ;;
  categories)               cmd_categories ;;
  candidates)               cmd_candidates "${1:-}" ;;
  missing-assets)           cmd_missing_assets "${1:-}" "${@:2}" ;;
  patches)                  cmd_patches "${1:-}" "${@:2}" ;;
  health)                   cmd_health ;;
  heal)                     cmd_heal "$@" ;;
  kb-list)                  cmd_kb_list ;;
  kb-free)                  cmd_kb_free ;;
  kb-add)                   cmd_kb_add "$@" ;;
  kb-remove)                cmd_kb_remove "$@" ;;
  kb-reset)                 cmd_kb_reset ;;
  kb-reload)                cmd_kb_reload ;;
  fixes)                    cmd_fixes ;;
  setup)                    cmd_setup ;;
  uninstall-tree)           cmd_uninstall_tree ;;
  preinstalls)              cmd_preinstalls ;;
  preinstalls-remove)       cmd_preinstalls_remove "$@" ;;
  backup-options)           cmd_backup_options ;;
  backup-opts)              cmd_backup_opts "${1:-get}" "${2:-}" ;;
  backup-sel)               cmd_backup_sel "${1:-get}" "${2:-}" ;;
  backups)                  cmd_backups ;;
  update-check)             cmd_update_check ;;
  install)                  cmd_install "${1:-}" "${@:2}" ;;
  apply)                    cmd_apply "$@" ;;
  run-patch)                cmd_run_patch "$@" ;;
  remove-patch)             cmd_remove_patch "$@" ;;
  fixes-run)                cmd_fixes_run "$@" ;;
  theme-images)              cmd_theme_images "${1:-}" ;;
  theme-default-dir)         cmd_theme_default_dir "${1:-get}" "${2:-}" ;;
  theme-pick)                cmd_theme_pick "${1:-file}" "${2:-}" ;;
  theme-create)              cmd_theme_create "$@" ;;
  theme-list)                cmd_theme_list ;;
  theme-remove)              cmd_theme_remove "$@" ;;
  theme-restore-stock)       cmd_theme_restore_stock ;;
  theme-list-any)            cmd_theme_list_any ;;
  theme-remove-any)          cmd_theme_remove_any "$@" ;;
  theme-apply)               cmd_theme_apply "${1:-}" ;;
  update)                   cmd_update "$@" ;;
  update-modules)           cmd_update_modules ;;
  update-repo)              cmd_update_repo ;;
  uninstall)                cmd_uninstall "$@" ;;
  menu-entry)               cmd_menu_entry ;;
  add-shortcut)             cmd_add_shortcut ;;
  # "$@" or the backup silently ignores EVERY option it is given: --vst=,
  # --keepass=, --zen= and --selection= were all dropped on the floor, so the
  # TUI's toggles (and the apps.selected tree it writes) never reached
  # do_backup, which fell back to its own defaults.
  backup)                   cmd_backup "$@" ;;
  # No argument means "tell me", not "turn it on". The default was ${1:-on},
  # so `crash-notify` READ as if the toasts were on even when the flag file
  # said off -- which is how the agentic row kept claiming there was something
  # to bring back after it had been taken away.
  crash-notify)             cmd_crash_notify "${1:-get}" ;;
  ai-removed)               cmd_ai_removed ;;
  menu-entries)             cmd_menu_entries "$@" ;;
  restore)                  cmd_restore "${1:-}" ;;
  *) echo "mosquitomarchy-actions: unknown subcommand '$sub'." >&2; exit 2 ;;
esac
