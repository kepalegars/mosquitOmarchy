#!/usr/bin/env bash
# mosquitomarchy-actions — non-interactive backend for the mosquitOmarchy Go
# TUI (tui-go/). NOT an interface at all: it has no interactive UI (no gum /
# launcher prompts) and is never launched directly by a user. It exists so
# the Go program never has to reimplement any of setup-customarchy.sh's
# business logic (modules, categories, status, backup/restore, uninstall,
# repo updates) — it sources the exact same setup-customarchy.sh the launcher
# uses, in LIB_ONLY mode, and calls the same functions the interactive paths
# call.
#
# The split: Go owns every DECISION (which category, which items, confirm/
# cancel) — that is the actual "interface". This script only performs ACTIONS
# once a decision is already made.
#
# Two kinds of subcommands:
#   • read-only queries  → JSON to stdout for Go to parse (one record per
#     line, or a single object — see each case). Nothing else prints.
#   • actions            → thin direct calls into the sourced functions.
#     Output is the modules' own stdout/stderr prose, which the TUI's Runner
#     streams live. YES is forced to 1 so every "ask?" auto-yes and child
#     scripts receive -y; no prompt can ever block a pipe.
set -euo pipefail

SCRIPT_SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SELF")" && pwd)"
SETUP="$SCRIPT_DIR/../../../setup-customarchy.sh"

# gui-run.bash (sourced by setup-customarchy.sh) would `exec foot …` the
# moment it sees a non-tty stdin/stdout — exactly our case (child of the
# TUI's Runner). Tell it we are already "in a terminal" (the TUI is it).
export GUI_RUN_EXEC=1
export MOSQUITOMARCHY_LIB_ONLY=1

# Library-only source: defines every function, skips the flag parsing and the
# auto-run `main "$@"`. `set -e` is transferred by the sourced `set -euo
# pipefail` at its top — every query below must therefore be written to
# succeed even for empty results.
# shellcheck source=../../setup-customarchy.sh
source "$SETUP"

# ── JSON helpers (single-line, no trailing comma, escaped) ────────────────
json_esc(){ printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
json_str(){ printf '"%s"' "$(json_esc "$1")"; }

# ── Route sudo to pkexec (native polkit prompt) for this backend ───────────
# The TUI's Runner gives the child no tty, so a plain `sudo` password prompt
# can never appear. Put a tiny `sudo` shim first on PATH: interactive sudo
# calls become `pkexec` (the same native prompt mq_sudo already prefers),
# while `sudo -n` (a NOPASSWD / cached-credentials probe) still goes to the
# real sudo so scripts that test it keep working. This covers the per-module
# setup scripts that call `sudo` directly instead of mq_sudo.
_ACTIONS_SHIM_DIR=""
_actions_cleanup_shim(){ [[ -n $_ACTIONS_SHIM_DIR ]] && rm -rf "$_ACTIONS_SHIM_DIR"; return 0; }
trap _actions_cleanup_shim EXIT
_actions_enable_pkexec_shim(){
  # Only when pkexec can actually reach a polkit agent (a session bus + a
  # graphical session); otherwise leave sudo alone rather than break it.
  mq_polkit_agent_usable 2>/dev/null || return 0
  local real
  real="$(command -v sudo 2>/dev/null)" || return 0
  [[ -n $real ]] || return 0
  _ACTIONS_SHIM_DIR="$(mktemp -d)"
  cat > "$_ACTIONS_SHIM_DIR/sudo" <<SH
#!/usr/bin/env bash
# sudo -> pkexec shim (generated by mosquitomarchy-actions); real sudo: $real
for a in "\$@"; do [[ \$a == -n ]] && exec "$real" "\$@"; done
args=()
while ((\$#)); do
  case "\$1" in
    --) shift; break ;;
    -u) shift; args+=(--user="\$1"); shift ;;
    -v) exec pkexec true ;;
    -E|--preserve-env|--preserve-env=*|-S|-k|--reset-timestamp|-H|--set-home) shift ;;
    -*) shift ;;
    *) break ;;
  esac
done
exec pkexec "\${args[@]}" "\$@"
SH
  chmod +x "$_ACTIONS_SHIM_DIR/sudo"
  export PATH="$_ACTIONS_SHIM_DIR:$PATH"
}

# ─── Module status ─────────────────────────────────────────────────────────
# One JSON record per line: {"id":..,"label":..,"state":..,"excluded":bool}
cmd_status(){
  load_excluded
  apply_includes
  local row id state label excl
  for row in "${MODULES[@]}"; do
    id="${row%%:*}" label="${row#*:}"
    state="$(module_state "$id")"
    excl=false
    is_excluded "$id" && excl=true
    printf '{"id":%s,"label":%s,"state":%s,"excluded":%s}\n' \
      "$(json_str "$id")" "$(json_str "$label - v$(module_version "$id")")" "$(json_str "$state")" "$excl"
  done
}

# ─── Setup categories ──────────────────────────────────────────────────────
# {"id":..,"label":..}
cmd_categories(){
  local c id label
  for c in "${CATEGORIES[@]}"; do
    id="${c%%|*}"; label="${c#*|}"; label="${label%%|*}"
    printf '{"id":%s,"label":%s}\n' "$(json_str "$id")" "$(json_str "$label")"
  done
}

# ─── Candidate items of one category ──────────────────────────────────────
# Fills CAND_KEYS/CAND_LABELS then prints {"key":..,"label":..}
cmd_candidates(){
  local cat="${1:-}"
  category_candidates "$cat"
  local i
  for ((i=0; i<${#CAND_KEYS[@]}; i++)); do
    printf '{"key":%s,"label":%s}\n' \
      "$(json_str "${CAND_KEYS[$i]}")" "$(json_str "${CAND_LABELS[$i]}")"
  done
}

# ─── Quick fixes ──────────────────────────────────────────────────────────
# Flat list (the TUI groups by its own category logic if needed).
cmd_fixes(){
  local e id
  for e in "${FIXES[@]:-}"; do
    id="${e%%:*}"
    printf '{"key":%s,"label":%s,"cat":%s,"info":%s}\n' \
      "$(json_str "$id")" "$(json_str "${e#*:}")" "$(json_str "$(fix_category "$id")")" \
      "$(json_str "${e#*:}")"
  done
}

# ─── Full setup tree (folders = categories, children = installable items) ──
# One JSON record per line:
#   folder: {"folder":id,"label":label,"accent":bool}
#   item:   {"folder":id,"key":key,"label":name,"info":description}
# The label/info split mirrors the bash launcher's "name  —  description"
# convention (CAND_LABELS) so the TUI shows only the name inline and keeps the
# longer description behind the "i" key instead of crowding the row.
cmd_setup(){
  local c id label accent i e name info
  local sep='  —  '
  for c in "${CATEGORIES[@]}"; do
    id="${c%%|*}"; label="${c#*|}"; label="${label%%|*}"
    # The Omarchy menu registration is shown INSIDE the mosquito folder (see
    # the mosquito case below), never as its own top-level Setup folder.
    [[ $id == menu ]] && continue
    accent=false
    [[ $id == mosquito ]] && accent=true
    printf '{"folder":%s,"label":%s,"accent":%s}\n' \
      "$(json_str "$id")" "$(json_str "$label")" "$accent"
    case $id in
      fixes)
        local fe fid
        for fe in "${FIXES[@]:-}"; do
          fid="${fe%%:*}"
          printf '{"folder":%s,"key":%s,"label":%s,"info":%s}\n' \
            "$(json_str "$id")" "$(json_str "$fid")" "$(json_str "$fid")" \
            "$(json_str "${fe#*:}")"
        done
        ;;
      *)
        category_candidates "$id"
        for ((i=0; i<${#CAND_KEYS[@]}; i++)); do
          name="${CAND_LABELS[$i]}"; info=""
          if [[ $name == *"$sep"* ]]; then
            info="${name#*"$sep"}"
            name="${name%%"$sep"*}"
          fi
          # Catalog shell-plugins (PLUG id|url|human-label) read badly by id:
          # show the human label instead.
          if [[ ${CAND_KEYS[$i]} == PLUG\ * ]]; then
            name="$(printf '%s' "${CAND_KEYS[$i]}" | cut -d'|' -f3)"
          fi
          printf '{"folder":%s,"key":%s,"label":%s,"info":%s}\n' \
            "$(json_str "$id")" "$(json_str "${CAND_KEYS[$i]}")" \
            "$(json_str "$name - v$(module_version "${CAND_KEYS[$i]}")")" "$(json_str "$info")"
        done
        ;;
    esac
  done
}

# ─── Backups present in BACKUP_DIR ────────────────────────────────────────
# Most recent first: {"file":..,"size":..,"date":..}
cmd_backups(){
  local -a files=()
  local f sz name date
  for f in "$BACKUP_DIR"/omarchy-backup-*.tar.gz*; do [[ -f $f ]] && files+=("$f"); done
  for ((i=${#files[@]}-1; i>=0; i--)); do
    f="${files[$i]}"; name="$(basename "$f")"
    sz=$(du -h "$f" | cut -f1)
    date="$(backup_desc "$name")"
    printf '{"file":%s,"size":%s,"date":%s}\n' \
      "$(json_str "$name")" "$(json_str "$sz")" "$(json_str "$date")"
  done
}

# ─── Backup content options (installed apps/tuis/webapps + facts) ──────────
# Emits the same content tree the old interactive backup asked about, so the
# TUI can offer it. Each item's key IS the exact "apps.selected" line
# ("APP pkg" / "TUI pkg" / "WEB name|url|icon"); the TUI writes back the
# checked keys and passes the file to `backup --selection=`.
cmd_backup_options(){
  load_catalog || true
  detect_installed_apps
  local had_prev=0
  load_previous_selection 2>/dev/null && had_prev=1
  local keepass=false
  pkg_has keepassxc && keepass=true
  printf '{"opts":true,"keepass":%s}\n' "$keepass"

  local e name label checked p
  if ((${#INSTALLED_APP[@]})); then
    printf '{"folder":"apps","label":"Apps"}\n'
    for e in "${INSTALLED_APP[@]}"; do
      name="${e%%|*}"; label="${e#*|}"
      checked=true
      if ((had_prev)); then
        checked=false
        for p in "${PREV_APP[@]:-}"; do [[ $p == "$name" ]] && { checked=true; break; }; done
      fi
      printf '{"folder":"apps","key":%s,"label":%s,"checked":%s}\n' \
        "$(json_str "APP $name")" "$(json_str "$label")" "$checked"
    done
  fi
  if ((${#INSTALLED_TUI[@]})); then
    printf '{"folder":"tuis","label":"TUIs"}\n'
    for e in "${INSTALLED_TUI[@]}"; do
      name="${e%%|*}"; label="${e#*|}"
      checked=true
      if ((had_prev)); then
        checked=false
        for p in "${PREV_TUI[@]:-}"; do [[ $p == "$name" ]] && { checked=true; break; }; done
      fi
      printf '{"folder":"tuis","key":%s,"label":%s,"checked":%s}\n' \
        "$(json_str "TUI $name")" "$(json_str "$label")" "$checked"
    done
  fi
  if ((${#INSTALLED_WEB[@]})); then
    printf '{"folder":"webapps","label":"Webapps"}\n'
    for e in "${INSTALLED_WEB[@]}"; do
      name="${e%%|*}"
      checked=true
      if ((had_prev)); then
        checked=false
        for p in "${PREV_WEB[@]:-}"; do [[ $p == "$name" ]] && { checked=true; break; }; done
      fi
      printf '{"folder":"webapps","key":%s,"label":%s,"checked":%s}\n' \
        "$(json_str "WEB $e")" "$(json_str "$name")" "$checked"
    done
  fi
}

# ─── Repo update check (read-only mirror of launcher_update) ──────────────
# Single JSON object: {"repo_update":bool,"modules":[{"key":..,"label":..}]}
cmd_update_check(){
  local old_head="" new_head="" p m row id state
  local -a changed=() cand=() ids=()
  local repo_update=false
  [[ -d "$REPO_DIR/.git" ]] && old_head="$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || true)"
  if repo_update_avail; then repo_update=true; fi
  [[ -d "$REPO_DIR/.git" ]] && new_head="$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || true)"
  if [[ -n $old_head && -n $new_head && $old_head != "$new_head" ]]; then
    mapfile -t changed < <(git -C "$REPO_DIR" diff --name-only "$old_head" "$new_head" 2>/dev/null)
  fi
  mapfile -t -O "${#changed[@]}" changed < <(
    git -C "$REPO_DIR" diff --name-only HEAD 2>/dev/null
    git -C "$REPO_DIR" diff --name-only --cached 2>/dev/null
  )
  load_excluded
  apply_includes
  for row in "${MODULES[@]}"; do
    id="${row%%:*}"
    is_excluded "$id" && continue
    state="$(module_state "$id")"
    [[ $state == ok || $state == partial ]] || continue
    for p in "${changed[@]:-}"; do
      [[ -n $p && "$(module_of_path "$p")" == "$id" ]] && { cand+=("$id"); break; }
    done
  done
  for row in "${MODULES[@]}"; do
    id="${row%%:*}"
    for m in "${cand[@]:-}"; do [[ $m == "$id" ]] && ids+=("$row") && break; done
  done
  printf '{"repo_update":%s,"repo_version":%s,"modules":[' \
    "$([[ $repo_update == true ]] && echo true || echo false)" "$(json_str "$REPO_VERSION")"
  local i=0
  for row in "${ids[@]}"; do
    ((i)) && printf ','
    printf '{"key":%s,"label":%s}' "$(json_str "${row%%:*}")" "$(json_str "${row#*:}")"
    i=$((i+1))
  done
  printf ']}\n'
}

# ─── Actions (streamed to the Runner) ─────────────────────────────────────
# Install a setup category with the given candidate keys.
cmd_install(){
  local cat="${1:-}"
  shift
  CATEGORY_SELECTED=("$@")
  YES=1
  if ((${#CATEGORY_SELECTED[@]})); then
    category_run "$cat"
  else
    warn "nothing selected for '$cat' — nothing installed."
  fi
}

# Apply quick fixes (ids from cmd_fixes).
cmd_fixes_run(){
  RESULTS=()
  FIXES_SELECTED=("$@")
  YES=1
  run_fixes || true
  final_report
}

# Re-apply the given installed modules (update flow).
cmd_update(){
  SELECTED=("$@")
  YES=1
  RESULTS=()
  exec_modules
  final_report
}

# Apply a multi-category Setup selection in ONE streamed run.
# Each argument is one group of TAB-separated fields: "<folder>\t<key>\t…"
# (keys may contain spaces and "|", but never a tab). Groups run in the given
# order. The TUI's Setup tree uses this so a single Runner shows the whole
# batch instead of chaining per-category runs.
cmd_apply(){
  local group folder
  YES=1
  for group in "$@"; do
    local -a arr=()
    IFS=$'\t' read -r -a arr <<< "$group"
    folder="${arr[0]:-}"
    local -a keys=("${arr[@]:1}")
    case $folder in
      fixes)
        ((${#keys[@]})) && cmd_fixes_run "${keys[@]}"
        ;;
      menu)
        cmd_menu_entry
        ;;
      *)
        # A folder may mix installable keys with the special menu-entry key
        # (the mosquito folder carries it), so route each key.
        local -a inst=()
        local k
        for k in "${keys[@]:-}"; do
          [[ -n $k ]] || continue
          if [[ $k == menu-entry ]]; then
            cmd_menu_entry
          else
            inst+=("$k")
          fi
        done
        ((${#inst[@]})) && cmd_install "$folder" "${inst[@]}"
        ;;
    esac
  done
}

# Git pull the repo (update zone).
cmd_update_repo(){
  YES=1
  if [[ -d "$REPO_DIR/.git" ]] && command -v git >/dev/null 2>&1; then
    update_repo_ff
  else
    err "No git repo at $REPO_DIR (or git missing) — nothing to update."
  fi
}

# Update modules: fast-forward the LOCAL repo from GitHub FIRST (so both
# versions are in sync), then re-apply the installed modules whose files
# changed. With no repo update (or no connection), it re-applies the modules
# changed in the local scripts. This is the single "Update modules" action.
cmd_update_modules(){
  YES=1
  local before="" after="" p m row id state
  [[ -d "$REPO_DIR/.git" ]] && before="$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || true)"
  if repo_update_avail; then
    msg "Updating the local scripts repo from GitHub first (keeps both versions in sync)…"
    update_repo_ff || warn "Repo update failed — continuing with the local scripts."
  fi
  [[ -d "$REPO_DIR/.git" ]] && after="$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || true)"

  local -a changed=()
  if [[ -n $before && -n $after && $before != "$after" ]]; then
    mapfile -t changed < <(git -C "$REPO_DIR" diff --name-only "$before" "$after" 2>/dev/null)
  fi
  mapfile -t -O "${#changed[@]}" changed < <(
    git -C "$REPO_DIR" diff --name-only HEAD 2>/dev/null
    git -C "$REPO_DIR" diff --name-only --cached 2>/dev/null
  )

  load_excluded
  apply_includes
  local -a ids=()
  for row in "${MODULES[@]}"; do
    id="${row%%:*}"
    is_excluded "$id" && continue
    state="$(module_state "$id")"
    [[ $state == ok || $state == partial ]] || continue
    for p in "${changed[@]:-}"; do
      [[ -n $p && "$(module_of_path "$p")" == "$id" ]] && { ids+=("$id"); break; }
    done
  done

  if ((${#ids[@]})); then
    RESULTS=()
    SELECTED=("${ids[@]}")
    msg "Re-applying ${#ids[@]} changed installed module(s)…"
    exec_modules
    final_report
  else
    ok "No installed module needs re-applying — everything is up to date."
  fi
}

# Uninstall modules one by one (never the gum chooser).
cmd_uninstall(){
  local id
  YES=1
  for id in "$@"; do
    uninstall_module "$id" || true
  done
  un_shared_menu
}

# Register the mosquitOmarchy menu entry (menu category).
cmd_menu_entry(){
  YES=1
  install_menu_entry || true
}

# Dated backup now. Options (all optional):
#   --vst=list|full|none   VST plugin handling (default: list)
#   --keepass=yes|no       include KeePassXC passwords when installed
#   --selection=FILE       apps.selected content (the TUI's checkbox tree)
cmd_backup(){
  local vst="list" keepass="yes" sel="" a
  for a in "$@"; do
    case $a in
      --vst=*) vst="${a#*=}" ;;
      --keepass=*) keepass="${a#*=}" ;;
      --selection=*) sel="${a#*=}" ;;
    esac
  done
  YES=1
  VST_MODE="$vst"
  [[ $keepass == no ]] && export BACKUP_SKIP_KEEPASS=1
  [[ -n $sel && -f $sel ]] && export BACKUP_APPS_SELECTION_FILE="$sel"
  do_backup || true
}

# Restore a backup file by name (from cmd_backups).
cmd_restore(){
  local file="${1:-}"
  [[ -n $file ]] || { err "mosquitomarchy-actions restore: missing backup name."; exit 1; }
  YES=1
  RESTORE_FILE="$file"
  restore_flow || true
}

# ─── dispatch ──────────────────────────────────────────────────────────────
sub="${1:-}"
shift || true
# Read-only queries never need root; every action may, so route sudo through
# pkexec for them (see _actions_enable_pkexec_shim).
case "$sub" in
  status|categories|candidates|fixes|setup|backup-options|backups|update-check) : ;;
  *) _actions_enable_pkexec_shim ;;
esac
case "$sub" in
  status)                   cmd_status ;;
  categories)               cmd_categories ;;
  candidates)               cmd_candidates "${1:-}" ;;
  fixes)                    cmd_fixes ;;
  setup)                    cmd_setup ;;
  backup-options)           cmd_backup_options ;;
  backups)                  cmd_backups ;;
  update-check)             cmd_update_check ;;
  install)                  cmd_install "${1:-}" "${@:2}" ;;
  apply)                    cmd_apply "$@" ;;
  fixes-run)                cmd_fixes_run "$@" ;;
  update)                   cmd_update "$@" ;;
  update-modules)           cmd_update_modules ;;
  update-repo)              cmd_update_repo ;;
  uninstall)                cmd_uninstall "$@" ;;
  menu-entry)               cmd_menu_entry ;;
  backup)                   cmd_backup ;;
  restore)                  cmd_restore "${1:-}" ;;
  *) echo "mosquitomarchy-actions: unknown subcommand '$sub'." >&2; exit 2 ;;
esac