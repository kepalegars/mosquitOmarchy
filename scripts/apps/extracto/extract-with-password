#!/usr/bin/env bash
# Nautilus script — "Extract with password".
#
# WHY THIS EXISTS. file-roller's own "Extract Here" cannot open every
# ENCRYPTED archive: for RAR it goes through libarchive, which does not prompt
# for a password and silently does nothing — the user clicks Extract and
# nothing happens. This script asks for the password up front and extracts
# with the backend that actually applies it (unrar for RAR, 7z for zip/7z/
# tar and everything else), so a password-protected archive extracts instead
# of failing.
#
# It is a Nautilus SCRIPT (right-click → Scripts → "Extract with password"),
# NOT a desktop entry: nothing is added to the applications menu.
set -euo pipefail

# Nautilus hands the selection either as $1 or via the env var.
archive="${1:-}"
if [[ -z $archive && -n ${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-} ]]; then
  archive=$(head -n1 <<<"$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS")
fi

if [[ -z $archive || ! -f $archive ]]; then
  zenity --error --title="Extract with password" --text="No archive selected." >/dev/null 2>&1 || true
  exit 1
fi

# Ask for the password. Empty means "try without one" — for an unencrypted
# archive, or to see whether it actually is encrypted.
password=$(zenity --password --title="Extract with password" \
  --text="Password for $(basename "$archive") (leave empty for none):" 2>/dev/null || true)

dest=$(dirname "$archive")

extract() {
  local pass="$1"
  case "$archive" in
    *.rar|*.RAR)
      # unrar is the only backend that reliably applies a RAR password;
      # libarchive (file-roller) silently fails on encrypted RAR.
      if command -v unrar >/dev/null 2>&1; then
        if [[ -n $pass ]]; then
          unrar x -p"$pass" -o+ "$archive" "$dest/"
        else
          unrar x -p- -o+ "$archive" "$dest/"
        fi
      else
        7z x ${pass:+-p"$pass"} -o"$dest" "$archive"
      fi
      ;;
    *)
      # zip (incl. AES), 7z, tar, etc.
      7z x ${pass:+-p"$pass"} -o"$dest" "$archive"
      ;;
  esac
}

if ! extract "$password"; then
  zenity --error --title="Extract with password" \
    --text="Extraction failed. Wrong password, or the archive is not supported." >/dev/null 2>&1 || true
  exit 1
fi

command -v notify-send >/dev/null 2>&1 \
  && notify-send "Extract with password" "Extracted $(basename "$archive")" >/dev/null 2>&1 || true
